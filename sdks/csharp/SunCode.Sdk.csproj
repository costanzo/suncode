<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SunCode.Sdk</RootNamespace>
    <AssemblyName>SunCode.Sdk</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SunCodeRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../..'))</SunCodeRepositoryRoot>
    <SunCodeSdkCDirectory>$(SunCodeRepositoryRoot)/sdks/c</SunCodeSdkCDirectory>
    <SunCodeCargoTargetDirectory Condition="'$(SunCodeCargoTargetDirectory)' == '' And '$(CARGO_TARGET_DIR)' != ''">$(CARGO_TARGET_DIR)</SunCodeCargoTargetDirectory>
    <SunCodeCargoTargetDirectory Condition="'$(SunCodeCargoTargetDirectory)' == ''">$(SunCodeRepositoryRoot)/target</SunCodeCargoTargetDirectory>
    <SunCodeResolvedCargoTargetDirectory>$([System.IO.Path]::GetFullPath('$(SunCodeCargoTargetDirectory)', '$(SunCodeRepositoryRoot)'))</SunCodeResolvedCargoTargetDirectory>
    <SunCodeNativeProfile Condition="'$(Configuration)' == 'Release'">release</SunCodeNativeProfile>
    <SunCodeNativeProfile Condition="'$(SunCodeNativeProfile)' == ''">debug</SunCodeNativeProfile>
    <SunCodeNativeDirectory>$(SunCodeResolvedCargoTargetDirectory)/$(SunCodeNativeProfile)</SunCodeNativeDirectory>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(SunCodeNativeDirectory)/libsuncode_agent.dylib"
          Link="libsuncode_agent.dylib"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
    <None Include="$(SunCodeNativeDirectory)/libsuncode_agent.so"
          Link="libsuncode_agent.so"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
    <None Include="$(SunCodeNativeDirectory)/suncode_agent.dll"
          Link="suncode_agent.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>

  <Target Name="BuildSunCodeNative" BeforeTargets="BeforeBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <SunCodeCargoProfileArgument Condition="'$(Configuration)' == 'Release'">--release</SunCodeCargoProfileArgument>
    </PropertyGroup>
    <Exec WorkingDirectory="$(SunCodeRepositoryRoot)"
          Command="cargo build --manifest-path &quot;$(SunCodeSdkCDirectory)/Cargo.toml&quot; --locked --target-dir &quot;$(SunCodeResolvedCargoTargetDirectory)&quot; $(SunCodeCargoProfileArgument)" />
  </Target>
</Project>
