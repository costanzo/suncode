[
  {
    "id": "start-turn",
    "request": {"type":"turn.start","request_id":"request-1","project_id":"project-1","session_id":"session-1","idempotency_key":"turn-1","input":{"role":"user","content":[{"type":"text","text":"Inspect package.json"}]},"model":"deepseek-v4-flash"},
    "expected_events":["turn.state","assistant.delta","turn.completed"]
  },
  {
    "id": "missing-auth",
    "request": {"type":"turn.start","request_id":"request-2","project_id":"project-1","session_id":"session-1","idempotency_key":"turn-2","input":{"role":"user","content":[{"type":"text","text":"hello"}]},"model":"deepseek-v4-flash"},
    "connection_authorized": false,
    "expected_error": "unauthenticated"
  },
  {
    "id": "turn-awaiting-approval",
    "request": {"type":"turn.start","request_id":"request-3","project_id":"project-1","session_id":"session-1","idempotency_key":"turn-3","input":{"role":"user","content":[{"type":"text","text":"Update README.md"}]},"model":"deepseek-v4-flash"},
    "expected_status": 202,
    "expected_response": {"status":"awaiting_approval","turn_id":"turn-1","tool_call_id":"call-1","approval_id":"approval-1"},
    "submission_status": "pending"
  },
  {
    "id": "queue-running-turn-message",
    "request": {"type":"turn.start","request_id":"request-3b","project_id":"project-1","session_id":"session-1","idempotency_key":"queued-1","input":{"role":"user","content":[{"type":"text","text":"Use this extra constraint"}]},"model":"deepseek-v4-flash"},
    "precondition": "session has an active running turn",
    "expected_status": 202,
    "expected_response_shape": {"status":"queued","queued_id":"uuid","active_turn_id":"turn-1","position":1},
    "expected_events": ["turn.queued","message.user"]
  },
  {
    "id": "deny-suspended-turn",
    "request": {"type":"approval.decide","request_id":"request-4","project_id":"project-1","session_id":"session-1","approval_id":"approval-1","decision":"deny","idempotency_key":"approval-decision-1"},
    "expected_events": ["approval.resolved","tool.state","turn.state"],
    "expected_turn_state": "failed",
    "expected_error": "authorization_denied"
  },
  {
    "id": "list-projects",
    "request": {"method":"GET","path":"/projects"},
    "expected_response_shape": {"projects":[{"projectId":"project-1","canonicalRoot":"/project","displayName":"Project","createdAt":"rfc3339","updatedAt":"rfc3339","lastOpenedAt":"rfc3339"}]}
  },
  {
    "id": "list-project-sessions",
    "request": {"method":"GET","path":"/projects/project-1/sessions"},
    "expected_response_shape": {"project_id":"project-1","sessions":[{"sessionId":"session-1","projectId":"project-1","status":"active","createdAt":"rfc3339","updatedAt":"rfc3339","lastActivityAt":"rfc3339"}]}
  },
  {
    "id": "open-project",
    "request": {"method":"POST","path":"/projects","body":{"path":"/project"}},
    "expected_status": 201,
    "expected_response_shape": {"projectId":"project-1","canonicalRoot":"/project","displayName":"project"}
  },
  {
    "id": "create-session",
    "request": {"method":"POST","path":"/projects/project-1/sessions","body":{"title":"New session","model":"deepseek-v4-flash"}},
    "expected_status": 201,
    "expected_response_shape": {"sessionId":"session-1","projectId":"project-1","title":"New session","status":"active"}
  },
  {
    "id": "archive-session",
    "request": {"method":"DELETE","path":"/sessions/session-1"},
    "expected_response_shape": {"sessionId":"session-1","status":"archived","archivedAt":"rfc3339"}
  },
  {
    "id": "session-snapshot",
    "request": {"method":"GET","path":"/sessions/session-1/snapshot?after=0&limit=500"},
    "expected_response_shape": {"session":{"sessionId":"session-1"},"messages":[],"events":[],"latest_sequence":0,"replay_available":true}
  },
  {
    "id": "list-checkpoints",
    "request": {"method":"GET","path":"/sessions/session-1/checkpoints"},
    "expected_response_shape": {"session_id":"session-1","checkpoints":[{"manifestId":"manifest-1","turnId":"turn-1","status":"available","itemCount":2,"paths":["README.md","src/index.ts"],"expiresAt":"rfc3339"}]}
  },
  {
    "id": "restore-turn-checkpoint",
    "request": {"method":"POST","path":"/checkpoints/manifest-1/restore","body":{"session_id":"session-1"}},
    "expected_response_shape": {"manifestId":"manifest-1","status":"restored","paths":["README.md","src/index.ts"]},
    "possible_errors": ["restore_conflict","checkpoint_unavailable","scope_denied"]
  },
  {
    "id": "effective-settings",
    "request": {"method":"GET","path":"/settings?project_id=project-1&session_id=session-1"},
    "expected_response_shape": {"settings":[{"key":"model.default","value":"deepseek-v4-flash","scope":"project","scope_id":"project-1"}]}
  },
  {
    "id": "credential-status",
    "request": {"method":"GET","path":"/credentials"},
    "expected_response_shape": {"credentials":[{"provider":"deepseek","configured":false}]}
  },
  {
    "id": "set-deepseek-credential",
    "request": {"method":"POST","path":"/credentials/deepseek","body":{"api_key":"redacted-secret"}},
    "expected_response_shape": {"provider":"deepseek","configured":true},
    "must_not_contain": ["redacted-secret"]
  },
  {
    "id": "cancel-turn",
    "request": {"method":"POST","path":"/sessions/session-1/turns/turn-1/cancel"},
    "expected_status": 202,
    "expected_response_shape": {"turn_id":"turn-1","status":"cancellation_requested"},
    "possible_errors": ["conflict","not_found"]
  }
]
