[
  {
    "id": "start-turn",
    "call": {"method":"submit_turn","session_id":"session-1","idempotency_key":"turn-1","input":"Inspect package.json","model":"deepseek-v4-flash"},
    "expected_events":["turn.state","assistant.delta","turn.completed"]
  },
  {
    "id": "turn-awaiting-approval",
    "call": {"method":"submit_turn","session_id":"session-1","idempotency_key":"turn-3","input":"Update README.md","model":"deepseek-v4-flash"},
    "expected_response": {"status":"awaiting_approval","turn_id":"turn-1","tool_call_id":"call-1","approval_id":"approval-1"},
    "submission_status": "pending"
  },
  {
    "id": "queue-running-turn-message",
    "call": {"method":"submit_turn","session_id":"session-1","idempotency_key":"queued-1","input":"Use this extra constraint","model":"deepseek-v4-flash"},
    "precondition": "session has an active running turn",
    "expected_response_shape": {"status":"queued","queued_id":"uuid","active_turn_id":"turn-1","position":1},
    "expected_events": ["turn.queued","message.user"]
  },
  {
    "id": "deny-suspended-turn",
    "call": {"method":"resolve_approval","approval_id":"approval-1","decision":"deny"},
    "expected_events": ["approval.resolved","tool.state","turn.state"],
    "expected_turn_state": "failed",
    "expected_error": "authorization_denied"
  },
  {
    "id": "list-projects",
    "call": {"method":"list_projects"},
    "expected_response_shape": {"projects":[{"projectId":"project-1","canonicalRoot":"/project","displayName":"Project","createdAt":"rfc3339","updatedAt":"rfc3339","lastOpenedAt":"rfc3339"}]}
  },
  {
