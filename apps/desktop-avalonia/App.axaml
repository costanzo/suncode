<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
             x:Class="SunCode.Desktop.App"
             Name="SunCode"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />
    <StyleInclude Source="avares://SunCode/Styles/Application/FoundationStyles.axaml" />
    <StyleInclude Source="avares://SunCode/Styles/Application/ControlStyles.axaml" />
    <StyleInclude Source="avares://SunCode/Styles/Application/MarkdownStyles.axaml" />
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://LiveMarkdown.Avalonia/Defaults.axaml" />
        <ResourceInclude Source="avares://SunCode/Styles/Application/ThemeResources.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
