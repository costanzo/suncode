<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
             x:Class="SunCode.Desktop.App"
             Name="SunCode"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />
    <StyleInclude Source="avares://LiveMarkdown.Avalonia/Styles.axaml" />

    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FontFamily" Value="Noto Sans, Noto Sans CJK SC, Noto Sans SC, PingFang SC, Helvetica Neue, Arial, sans-serif" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="TextBlock.section-label">
      <Setter Property="FontFamily" Value="JetBrains Mono, SF Mono, Menlo, Monaco, Consolas, monospace" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="LetterSpacing" Value="0.8" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontFamily" Value="JetBrains Mono, SF Mono, Menlo, Monaco, Consolas, monospace" />
      <Setter Property="FontSize" Value="9" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="LetterSpacing" Value="0.6" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="JetBrains Mono, SF Mono, Menlo, Monaco, Consolas, monospace" />
    </Style>
    <Style Selector="SelectableTextBlock.mono">
      <Setter Property="FontFamily" Value="JetBrains Mono, SF Mono, Menlo, Monaco, Consolas, monospace" />
    </Style>

    <Style Selector="Button">
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceActiveBrush}" />
    </Style>
    <Style Selector="Button.compact">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="10,4" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
    </Style>
    <Style Selector="Button.quiet">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
      <Setter Property="Opacity" Value="0.72" />
    </Style>
    <Style Selector="Button:focus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.icon">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.titlebar">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="5" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.titlebar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.navigation">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.navigation.selected">
      <Setter Property="Background" Value="{DynamicResource SurfaceActiveBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBox, ComboBox">
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="TextBox:focus">
      <Setter Property="Background" Value="{DynamicResource FieldFocusBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="ComboBox:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Border.window-frame">
      <Setter Property="Margin" Value="16" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style Selector="Border.window-content">
      <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Grid.window-titlebar">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
    </Style>
    <Style Selector="TextBlock.window-title">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.raised">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Border.process-card">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Border.process-card.active">
      <Setter Property="Background" Value="{DynamicResource AccentSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
    </Style>
    <Style Selector="Ellipse.process-dot">
      <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="Ellipse.process-dot.active">
      <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.sidebar-card">
      <Setter Property="Background" Value="{DynamicResource SidebarBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Border.workspace-card">
      <Setter Property="Background" Value="{DynamicResource WorkspaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Border.inspector-card">
      <Setter Property="Background" Value="{DynamicResource InspectorBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style Selector="ListBoxItem">
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource SurfaceActiveBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceActiveBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="ListBox.sessions ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="ListBox.git-files ListBoxItem">
      <Setter Property="Margin" Value="4,1" />
    </Style>
    <Style Selector="ListBox.git-files ListBoxItem:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource AccentSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ListBox.git-files ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="ToggleButton.scope">
      <Setter Property="Width" Value="72" />
      <Setter Property="Height" Value="26" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="ToggleButton.scope:checked">
      <Setter Property="Background" Value="{DynamicResource SurfaceActiveBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ToggleButton.scope /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="ToggleButton.scope:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceActiveBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style Selector="md|MarkdownRenderer">
      <Setter Property="MaxWidth" Value="760" />
    </Style>
    <Style Selector="md|MarkdownTextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="FontFamily" Value="Noto Sans, Noto Sans CJK SC, Noto Sans SC, PingFang SC, Helvetica Neue, Arial, sans-serif" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="md|MarkdownTextBlock.H1">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="md|MarkdownTextBlock.H2">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FontSize" Value="19" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="md|MarkdownTextBlock.H3">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="md|MarkdownTextBlock.H4">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="md|MarkdownTextBlock.H5">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="md|MarkdownTextBlock.H6">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="md|CodeBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="FontFamily" Value="JetBrains Mono, SF Mono, Menlo, Monaco, Consolas, monospace" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="16,0" />
      <Setter Property="IsCodeWrapped" Value="False" />
      <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
    </Style>
    <Style Selector="md|CodeInline">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="Margin" Value="6,0" />
    </Style>
    <Style Selector="md|Link">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://LiveMarkdown.Avalonia/Defaults.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <Color x:Key="BorderColor">#292f36</Color>
          <Color x:Key="ForegroundColor">#edf0f3</Color>
          <Color x:Key="CardBackgroundColor">#121519</Color>
          <Color x:Key="SecondaryCardBackgroundColor">#15191e</Color>
          <Color x:Key="CodeInlineColor">#d9e0e6</Color>
          <Color x:Key="QuoteBorderColor">#65717d</Color>
          <x:Double x:Key="FontSizeS">12</x:Double>
          <x:Double x:Key="FontSizeM">14</x:Double>
          <x:Double x:Key="FontSizeL">14</x:Double>
          <x:Double x:Key="FontSizeXl">15</x:Double>
          <x:Double x:Key="FontSize2Xl">19</x:Double>
          <x:Double x:Key="FontSize3Xl">26</x:Double>
          <Color x:Key="SystemAccentColor">#d9e0e6</Color>
          <Color x:Key="SystemAccentColorDark1">#b9c3cc</Color>
          <Color x:Key="SystemAccentColorDark2">#929faa</Color>
          <Color x:Key="SystemAccentColorDark3">#65717d</Color>
          <Color x:Key="SystemAccentColorLight1">#e5eaee</Color>
          <Color x:Key="SystemAccentColorLight2">#edf1f4</Color>
          <Color x:Key="SystemAccentColorLight3">#f3f6f8</Color>
          <Color x:Key="IconColor">#a7afb9</Color>
          <Color x:Key="AccentColor">#d9e0e6</Color>
          <Color x:Key="AccentInkColor">#101317</Color>
          <Color x:Key="TextControlSelectionHighlightColor">#65717d</Color>
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#d9e0e6" />
          <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="#d9e0e6" />
          <x:String x:Key="IconSvgCss">[stroke='#000'] { stroke: #a7afb9; } [fill='#000'] { fill: #a7afb9; } [stroke='currentColor'] { stroke: #a7afb9; }</x:String>
          <x:String x:Key="AccentSvgCss">[stroke='#000'] { stroke: #d9e0e6; } [fill='#000'] { fill: #d9e0e6; } [stroke='currentColor'] { stroke: #d9e0e6; }</x:String>
          <x:String x:Key="AccentInkSvgCss">[stroke='#000'] { stroke: #101317; } [fill='#000'] { fill: #101317; } [stroke='currentColor'] { stroke: #101317; }</x:String>
          <x:String x:Key="SuccessSvgCss">[stroke='#000'] { stroke: #9fb3c3; } [fill='#000'] { fill: #9fb3c3; } [stroke='currentColor'] { stroke: #9fb3c3; }</x:String>
          <SolidColorBrush x:Key="CanvasBrush" Color="#0d0f12" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#121519" />
          <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#181c21" />
          <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#1e2329" />
          <SolidColorBrush x:Key="SurfaceActiveBrush" Color="#242a31" />
          <SolidColorBrush x:Key="SidebarBrush" Color="#0b0e12" />
          <SolidColorBrush x:Key="InspectorBrush" Color="#0c0f13" />
          <SolidColorBrush x:Key="WorkspaceBrush" Color="#13171c" />
          <SolidColorBrush x:Key="ComposerBrush" Color="#181d23" />
          <SolidColorBrush x:Key="FieldBrush" Color="#15191e" />
          <SolidColorBrush x:Key="FieldFocusBrush" Color="#191f24" />
          <SolidColorBrush x:Key="TextBrush" Color="#edf0f3" />
          <SolidColorBrush x:Key="TextSecondaryBrush" Color="#a7afb9" />
          <SolidColorBrush x:Key="TextMutedBrush" Color="#7f8994" />
          <SolidColorBrush x:Key="TextDisabledBrush" Color="#525a64" />
          <SolidColorBrush x:Key="WindowChromeBorderBrush" Color="#1c2126" />
          <SolidColorBrush x:Key="BorderBrush" Color="#292f36" />
          <SolidColorBrush x:Key="BorderStrongBrush" Color="#46505b" />
          <SolidColorBrush x:Key="AccentBrush" Color="#d9e0e6" />
          <SolidColorBrush x:Key="AccentHoverBrush" Color="#f3f6f8" />
          <SolidColorBrush x:Key="AccentPressedBrush" Color="#b9c3cc" />
          <SolidColorBrush x:Key="AccentInkBrush" Color="#101317" />
          <SolidColorBrush x:Key="AccentSurfaceBrush" Color="#20262d" />
          <SolidColorBrush x:Key="AccentBorderBrush" Color="#65717d" />
          <SolidColorBrush x:Key="SuccessBrush" Color="#9fb3c3" />
          <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="#1e2730" />
          <SolidColorBrush x:Key="WarningBrush" Color="#d5ad6f" />
          <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#2a2115" />
          <SolidColorBrush x:Key="WarningBorderBrush" Color="#5d492d" />
          <SolidColorBrush x:Key="DangerBrush" Color="#e68a83" />
          <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#2a1919" />
          <SolidColorBrush x:Key="DangerBorderBrush" Color="#633735" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <Color x:Key="BorderColor">#d5dde4</Color>
          <Color x:Key="ForegroundColor">#17202a</Color>
          <Color x:Key="CardBackgroundColor">#ffffff</Color>
          <Color x:Key="SecondaryCardBackgroundColor">#f4f7f9</Color>
          <Color x:Key="CodeInlineColor">#2c3742</Color>
          <Color x:Key="QuoteBorderColor">#aab8c4</Color>
          <x:Double x:Key="FontSizeS">12</x:Double>
          <x:Double x:Key="FontSizeM">14</x:Double>
          <x:Double x:Key="FontSizeL">14</x:Double>
          <x:Double x:Key="FontSizeXl">15</x:Double>
          <x:Double x:Key="FontSize2Xl">19</x:Double>
          <x:Double x:Key="FontSize3Xl">26</x:Double>
          <Color x:Key="SystemAccentColor">#2c3742</Color>
          <Color x:Key="SystemAccentColorDark1">#1e2730</Color>
          <Color x:Key="SystemAccentColorDark2">#161d24</Color>
          <Color x:Key="SystemAccentColorDark3">#10161b</Color>
          <Color x:Key="SystemAccentColorLight1">#3b4854</Color>
          <Color x:Key="SystemAccentColorLight2">#65717d</Color>
          <Color x:Key="SystemAccentColorLight3">#aab8c4</Color>
          <Color x:Key="IconColor">#44515e</Color>
          <Color x:Key="AccentColor">#2c3742</Color>
          <Color x:Key="AccentInkColor">#ffffff</Color>
          <Color x:Key="TextControlSelectionHighlightColor">#aab8c4</Color>
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#2c3742" />
          <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="#2c3742" />
          <x:String x:Key="IconSvgCss">[stroke='#000'] { stroke: #44515e; } [fill='#000'] { fill: #44515e; } [stroke='currentColor'] { stroke: #44515e; }</x:String>
          <x:String x:Key="AccentSvgCss">[stroke='#000'] { stroke: #2c3742; } [fill='#000'] { fill: #2c3742; } [stroke='currentColor'] { stroke: #2c3742; }</x:String>
          <x:String x:Key="AccentInkSvgCss">[stroke='#000'] { stroke: #ffffff; } [fill='#000'] { fill: #ffffff; } [stroke='currentColor'] { stroke: #ffffff; }</x:String>
          <x:String x:Key="SuccessSvgCss">[stroke='#000'] { stroke: #4f6d82; } [fill='#000'] { fill: #4f6d82; } [stroke='currentColor'] { stroke: #4f6d82; }</x:String>
          <SolidColorBrush x:Key="CanvasBrush" Color="#f3f5f7" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#ffffff" />
          <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#f8fafc" />
          <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#eef2f5" />
          <SolidColorBrush x:Key="SurfaceActiveBrush" Color="#e7edf1" />
          <SolidColorBrush x:Key="SidebarBrush" Color="#e9eef2" />
          <SolidColorBrush x:Key="InspectorBrush" Color="#edf1f4" />
          <SolidColorBrush x:Key="WorkspaceBrush" Color="#f8fafb" />
          <SolidColorBrush x:Key="ComposerBrush" Color="#ffffff" />
          <SolidColorBrush x:Key="FieldBrush" Color="#f4f7f9" />
          <SolidColorBrush x:Key="FieldFocusBrush" Color="#ffffff" />
          <SolidColorBrush x:Key="TextBrush" Color="#17202a" />
          <SolidColorBrush x:Key="TextSecondaryBrush" Color="#44515e" />
          <SolidColorBrush x:Key="TextMutedBrush" Color="#65717d" />
          <SolidColorBrush x:Key="TextDisabledBrush" Color="#a6b0ba" />
          <SolidColorBrush x:Key="WindowChromeBorderBrush" Color="#e5e9ec" />
          <SolidColorBrush x:Key="BorderBrush" Color="#d5dde4" />
          <SolidColorBrush x:Key="BorderStrongBrush" Color="#bac6d0" />
          <SolidColorBrush x:Key="AccentBrush" Color="#2c3742" />
          <SolidColorBrush x:Key="AccentHoverBrush" Color="#1e2730" />
