<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:SunCode.Desktop.Models"
             xmlns:vm="using:SunCode.Desktop.ViewModels"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             x:Class="SunCode.Desktop.Views.Projects.ProjectHub"
             x:DataType="vm:DesktopViewModel">
  <UserControl.Styles>
    <Style Selector="Button.project-row">
      <Setter Property="Height" Value="70" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.project-row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    </Style>
  </UserControl.Styles>

  <Border Classes="window-frame">
    <Border Classes="window-content">
    <Grid RowDefinitions="36,62,*">
      <Grid Grid.Row="0"
            Classes="window-titlebar"
            ColumnDefinitions="*,Auto,*"
            ZIndex="110"
            PointerPressed="TitleBarPressed"
            PointerMoved="TitleBarMoved"
            PointerReleased="TitleBarReleased"
            DoubleTapped="TitleBarDoubleTapped">
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="5,0,0,0" VerticalAlignment="Center">
          <Button x:Name="HubCloseLight" Classes="titlebar" Width="18" Height="18" Padding="2" Click="CloseApplication" PointerEntered="TrafficLightEntered" PointerExited="TrafficLightExited" PointerPressed="TrafficLightPressed" PointerReleased="TrafficLightReleased" ToolTip.Tip="Close window">
            <svg:Svg Path="/Assets/traffic-lights/1-close-1-normal.svg" />
          </Button>
          <Button x:Name="HubMinimizeLight" Classes="titlebar" Width="18" Height="18" Padding="2" Click="MinimizeWindow" PointerEntered="TrafficLightEntered" PointerExited="TrafficLightExited" PointerPressed="TrafficLightPressed" PointerReleased="TrafficLightReleased" ToolTip.Tip="Minimize window">
            <svg:Svg Path="/Assets/traffic-lights/2-minimize-1-normal.svg" />
          </Button>
          <Button x:Name="HubMaximizeLight" Classes="titlebar" Width="18" Height="18" Padding="2" Click="ToggleHubMaximized" PointerEntered="TrafficLightEntered" PointerExited="TrafficLightExited" PointerPressed="TrafficLightPressed" PointerReleased="TrafficLightReleased" ToolTip.Tip="Maximize window">
            <svg:Svg Path="/Assets/traffic-lights/3-maximize-1-normal.svg" />
          </Button>
        </StackPanel>
        <TextBlock Grid.Column="1" Classes="window-title" Text="Welcome to SunCode" VerticalAlignment="Center" />
      </Grid>

      <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
        <Grid Margin="22,0" ColumnDefinitions="Auto,12,Auto,*,Auto,12,Auto" RowDefinitions="*,Auto">
          <Image Grid.Column="0" Width="30" Height="30" Source="/Assets/logo/suncode-logo-small-64.png" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="SunCode" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Grid.Column="4" Classes="compact quiet" Content="Settings" Click="OpenSettings" VerticalAlignment="Center" />
          <Button Grid.Column="6"
                  Classes="compact primary"
                  Click="OpenProject"
                  VerticalAlignment="Center"
                  IsEnabled="{Binding CanOpenProjects}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <svg:Svg Width="13" Height="13" Path="/Assets/icons/plus.svg" Css="{DynamicResource AccentInkSvgCss}" />
              <TextBlock Text="Open project" />
            </StackPanel>
          </Button>
          <TextBlock Grid.Row="1"
                     Grid.ColumnSpan="7"
                     Margin="0,0,0,4"
                     FontSize="11"
                     Foreground="{DynamicResource TextMutedBrush}"
                     Text="{Binding StatusText}"
                     IsVisible="{Binding !CanOpenProjects}" />
        </Grid>
      </Border>

      <Border Grid.Row="2" Margin="24" Classes="raised" Padding="18">
        <Grid RowDefinitions="Auto,14,*">
          <Border Grid.Row="0" Padding="2,0,2,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <TextBlock Classes="section-label" Text="RECENT PROJECTS" />
          </Border>
          <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid>
              <ItemsControl ItemsSource="{Binding Projects}" IsVisible="{Binding HasProjects}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:ProjectItem">
                    <Button Classes="project-row"
                            Margin="0,0,0,8"
                            Click="ProjectClicked"
                            IsEnabled="{Binding $parent[UserControl].DataContext.CanOpenProjects}">
                      <Grid ColumnDefinitions="36,12,*,18">
                        <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource AccentSurfaceBrush}" VerticalAlignment="Center">
                          <TextBlock Text="P" Foreground="{DynamicResource AccentBrush}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                          <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="mono" Text="{Binding CanonicalRoot}" FontSize="11" FontWeight="Normal" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <svg:Svg Grid.Column="3" Width="14" Height="14" Path="/Assets/icons/chevron-right.svg" Css="{DynamicResource IconSvgCss}" VerticalAlignment="Center" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border MinHeight="130"
                      Padding="18"
                      IsVisible="{Binding !HasProjects}"
                      Background="{DynamicResource SurfaceBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="6">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7">
                  <svg:Svg Width="28" Height="28" Path="/Assets/icons/sidebar-project.svg" Css="{DynamicResource IconSvgCss}" HorizontalAlignment="Center" />
                  <TextBlock Text="No projects yet" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                  <TextBlock Text="Open a local folder to create your first project window."
                             FontSize="10"
                             Foreground="{DynamicResource TextMutedBrush}"
                             TextAlignment="Center"
                             TextWrapping="Wrap"
                             HorizontalAlignment="Center" />
                </StackPanel>
              </Border>
            </Grid>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
    </Border>
  </Border>
</UserControl>
