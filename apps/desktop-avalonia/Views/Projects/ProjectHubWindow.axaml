<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SunCode.Desktop.ViewModels"
        xmlns:projects="using:SunCode.Desktop.Views.Projects"
        x:Class="SunCode.Desktop.Views.Projects.ProjectHubWindow"
        x:DataType="vm:DesktopViewModel"
        Title="Welcome to SunCode"
        Width="980" Height="712"
        MinWidth="760" MinHeight="552"
        Background="{DynamicResource CanvasBrush}"
        WindowDecorations="Full"
        WindowStartupLocation="CenterScreen">
  <projects:ProjectHub />
</Window>
