<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:SunCode.Desktop.Models"
             xmlns:vm="using:SunCode.Desktop.ViewModels"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             x:Class="SunCode.Desktop.Views.ProjectSidebar"
             x:DataType="vm:DesktopViewModel">
  <Border Classes="sidebar-card" PointerExited="NavigationPointerExited">
    <Grid Margin="16,14,16,12" RowDefinitions="34,10,*">
      <Grid Grid.Row="0" ColumnDefinitions="*,30">
        <TextBlock Classes="section-label" Text="SESSIONS" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="icon" Click="CreateSession" ToolTip.Tip="New session" IsEnabled="{Binding IsProjectOpen}">
          <svg:Svg Path="/Assets/icons/plus.svg" Css="{DynamicResource IconSvgCss}" />
        </Button>
      </Grid>
      <Grid Grid.Row="2">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <ListBox Classes="sessions"
                   ItemsSource="{Binding Sessions}"
                   SelectedItem="{Binding SelectedSession, Mode=OneWay}"
                   IsVisible="{Binding HasSessions}"
                   Background="Transparent"
                   BorderThickness="0"
                   Padding="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="models:SessionItem">
                <Grid Height="48" ColumnDefinitions="*,28">
                  <Button Grid.Column="0" Classes="quiet" Padding="10,4" HorizontalContentAlignment="Stretch" Click="SessionClicked">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding DisplayTitle}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding RelativeActivity}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                  </Button>
                  <Button Grid.Column="1" Classes="quiet" Width="28" Padding="6" ToolTip.Tip="Session actions">
                    <Button.Flyout>
                      <MenuFlyout>
                        <MenuItem Header="Rename" CommandParameter="{Binding}" Click="RenameSessionItem" />
                        <MenuItem Header="Archive" CommandParameter="{Binding}" Click="ArchiveSessionItem" />
                      </MenuFlyout>
                    </Button.Flyout>
                    <svg:Svg Path="/Assets/icons/more-horizontal.svg" Css="{DynamicResource IconSvgCss}" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </ScrollViewer>
        <StackPanel IsVisible="{Binding !HasSessions}" Margin="0,36,0,0" Spacing="6">
          <TextBlock Text="No sessions yet" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="Use + to create one." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</UserControl>
