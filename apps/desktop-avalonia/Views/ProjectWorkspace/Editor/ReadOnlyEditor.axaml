<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:edit="using:AvaloniaEdit"
             xmlns:editing="using:AvaloniaEdit.Editing"
             xmlns:vm="using:SunCode.Desktop.ViewModels"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             x:Class="SunCode.Desktop.Views.ProjectWorkspace.Editor.ReadOnlyEditor"
             x:DataType="vm:DesktopViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.editor-file-name">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.editor-meta">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
      <Setter Property="FontSize" Value="9" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="Border.editor-read-only">
      <Setter Property="Padding" Value="5,3" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="{DynamicResource SurfaceActiveBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.editor-read-only TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
      <Setter Property="FontSize" Value="8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="0.5" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="StackPanel.editor-state TextBlock.state-title">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="StackPanel.editor-state TextBlock.state-description">
      <Setter Property="MaxWidth" Value="280" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Styles>

  <Border Classes="workspace-card" ClipToBounds="True">
    <Grid RowDefinitions="44,*">
      <Border Grid.Row="0"
              Padding="14,0,12,0"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
          <Grid Grid.Column="0" ColumnDefinitions="16,*" ColumnSpacing="8" MinWidth="0">
            <svg:Svg Grid.Column="0"
                     Width="16"
                     Height="16"
                     Path="{Binding Editor.IconPath}"
                     Css="{DynamicResource IconSvgCss}"
                     VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" MinWidth="0">
              <TextBlock Classes="editor-file-name"
                         Text="{Binding Editor.FileName}"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="editor-meta"
                         Text="{Binding Editor.Path}"
                         TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding Editor.Path}" />
            </StackPanel>
          </Grid>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Classes="editor-meta" Text="{Binding Editor.LanguageLabel}" VerticalAlignment="Center" />
            <Border Classes="editor-read-only">
              <TextBlock Text="{DynamicResource LocReadOnlyStatus}" />
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <edit:TextEditor x:Name="SourceEditor"
                       Grid.Row="1"
                       IsVisible="{Binding Editor.IsReady}"
                       IsReadOnly="True"
                       ShowLineNumbers="True"
                       WordWrap="False"
                       HorizontalScrollBarVisibility="Auto"
                       VerticalScrollBarVisibility="Auto"
                       Background="{DynamicResource FieldBrush}"
                       FontFamily="{DynamicResource MonoFontFamily}"
                       FontSize="11"
                       LineNumbersMargin="14,0,14,0"
                       Padding="0,12,20,18"
                       AutomationProperties.Name="Read-only file content">
        <edit:TextEditor.Styles>
          <Style Selector="editing|LineNumberMargin">
            <Setter Property="MinWidthInDigits" Value="3" />
          </Style>
        </edit:TextEditor.Styles>
      </edit:TextEditor>

      <Grid Grid.Row="1" Background="{DynamicResource FieldBrush}" IsVisible="{Binding Editor.IsLoading}">
        <StackPanel Classes="editor-state" Spacing="7" HorizontalAlignment="Center" VerticalAlignment="Center">
          <ProgressBar Width="80" Height="3" IsIndeterminate="True" />
          <TextBlock Classes="state-title" Text="{DynamicResource LocLoadingFile}" />
          <TextBlock Classes="state-description" Text="{DynamicResource LocReadingFile}" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Background="{DynamicResource FieldBrush}" IsVisible="{Binding Editor.IsEmpty}">
        <StackPanel Classes="editor-state" Spacing="7" HorizontalAlignment="Center" VerticalAlignment="Center">
          <svg:Svg Width="24" Height="24" Path="/Assets/icons/file-text.svg" Css="{DynamicResource IconSvgCss}" />
          <TextBlock Classes="state-title" Text="{DynamicResource LocEmptyDocument}" />
          <TextBlock Classes="state-description" Text="{DynamicResource LocEmptyDocumentHint}" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Background="{DynamicResource FieldBrush}" IsVisible="{Binding Editor.IsError}">
        <StackPanel Classes="editor-state" Spacing="7" HorizontalAlignment="Center" VerticalAlignment="Center">
          <svg:Svg Width="24" Height="24" Path="/Assets/icons/close.svg" Css="{DynamicResource IconSvgCss}" />
          <TextBlock Classes="state-title" Text="{DynamicResource LocUnableReadFile}" />
          <TextBlock Classes="state-description" Text="{Binding Editor.Error}" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</UserControl>
