<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:SunCode.Desktop.Models"
             xmlns:vm="using:SunCode.Desktop.ViewModels"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             x:Class="SunCode.Desktop.Views.ProjectWorkspace.Navigation.ProjectExplorer"
             x:DataType="vm:DesktopViewModel">
  <UserControl.Styles>
    <Style Selector="TreeView.explorer-tree">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.explorer-action">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.explorer-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="TreeView.explorer-tree TreeViewItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
    </Style>
    <Style Selector="TreeView.explorer-tree TreeViewItem /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="TreeView.explorer-tree TreeViewItem /template/ Border#PART_LayoutRoot">
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="TreeView.explorer-tree TreeViewItem:selected">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TreeView.explorer-tree TreeViewItem:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TreeView.explorer-tree TreeViewItem:selected Border.explorer-row-container">
      <Setter Property="Background" Value="{DynamicResource SurfaceActiveBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="TreeView.explorer-tree TreeViewItem:pointerover Border.explorer-row-container">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="Grid.explorer-row">
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Margin" Value="-6,1,6,1" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.explorer-row-container">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Grid.explorer-row.dependency">
      <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
    </Style>
    <Style Selector="Grid.explorer-row.root svg|Svg">
      <Setter Property="Css" Value="{DynamicResource AccentSvgCss}" />
    </Style>
    <Style Selector="Grid.explorer-row.dependency-root svg|Svg">
      <Setter Property="Css" Value="{DynamicResource WarningSvgCss}" />
    </Style>
    <Style Selector="TextBlock.explorer-file-icon">
      <Setter Property="FontFamily" Value="avares://SunCode/Assets/fonts#seti" />
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="FontSize" Value="17.5" />
      <Setter Property="LineHeight" Value="17.5" />
      <Setter Property="Foreground" Value="{DynamicResource FileIconDefaultBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="RenderTransform" Value="translate(-2px, 0)" />
    </Style>
    <Style Selector="Grid.explorer-row.file-icon-blue TextBlock.explorer-file-icon">
      <Setter Property="Foreground" Value="{DynamicResource FileIconBlueBrush}" />
    </Style>
    <Style Selector="Grid.explorer-row.file-icon-yellow TextBlock.explorer-file-icon">
      <Setter Property="Foreground" Value="{DynamicResource FileIconYellowBrush}" />
    </Style>
    <Style Selector="Grid.explorer-row.file-icon-muted TextBlock.explorer-file-icon">
      <Setter Property="Foreground" Value="{DynamicResource FileIconMutedBrush}" />
    </Style>
    <Style Selector="Grid.explorer-row.file-icon-green TextBlock.explorer-file-icon">
      <Setter Property="Foreground" Value="{DynamicResource FileIconGreenBrush}" />
    </Style>
    <Style Selector="Grid.explorer-row.file-icon-purple TextBlock.explorer-file-icon">
      <Setter Property="Foreground" Value="{DynamicResource FileIconPurpleBrush}" />
    </Style>
    <Style Selector="Grid.explorer-row.file-icon-pink TextBlock.explorer-file-icon">
      <Setter Property="Foreground" Value="{DynamicResource FileIconPinkBrush}" />
    </Style>
    <Style Selector="Grid.explorer-row.file-icon-red TextBlock.explorer-file-icon">
      <Setter Property="Foreground" Value="{DynamicResource FileIconRedBrush}" />
    </Style>
    <Style Selector="Grid.explorer-row.file-icon-orange TextBlock.explorer-file-icon">
      <Setter Property="Foreground" Value="{DynamicResource FileIconOrangeBrush}" />
    </Style>
    <Style Selector="Grid.explorer-row.file-icon-ink TextBlock.explorer-file-icon">
      <Setter Property="Foreground" Value="{DynamicResource FileIconInkBrush}" />
    </Style>
    <Style Selector="Grid.explorer-row.file-icon-todo TextBlock.explorer-file-icon">
      <Setter Property="Foreground" Value="{DynamicResource FileIconTodoBrush}" />
    </Style>
    <Style Selector="TextBlock.explorer-name">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Grid.explorer-row.root TextBlock.explorer-name">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Grid.explorer-row.dependency-root TextBlock.explorer-name">
      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
    </Style>
    <Style Selector="TextBlock.explorer-path">
      <Setter Property="FontFamily" Value="JetBrains Mono, SF Mono, Menlo, Monaco, Consolas, monospace" />
      <Setter Property="FontSize" Value="9" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
  </UserControl.Styles>

  <Border Classes="sidebar-card">
    <Grid Margin="0,0,0,10" RowDefinitions="44,0,*">
      <Grid Grid.Row="0" ColumnDefinitions="*,30,30">
        <TextBlock Classes="section-label" Text="EXPLORER" Margin="14,0,0,0" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="icon explorer-action" Width="30" Height="30" Padding="6" Click="RefreshExplorer" ToolTip.Tip="Refresh explorer" AutomationProperties.Name="Refresh explorer">
          <svg:Svg Path="/Assets/icons/refresh.svg" Css="{DynamicResource IconSvgCss}" />
        </Button>
        <Button Grid.Column="2" Classes="icon explorer-action" Width="30" Height="30" Padding="6" Click="AddDependency" ToolTip.Tip="Add dependency folder" AutomationProperties.Name="Add dependency folder">
          <svg:Svg Path="/Assets/icons/plus.svg" Css="{DynamicResource IconSvgCss}" />
        </Button>
      </Grid>

      <TreeView x:Name="ExplorerTree"
                Grid.Row="2"
                Classes="explorer-tree"
                ItemsSource="{Binding ExplorerRoots}"
                SelectedItem="{Binding SelectedEditorFile, Mode=OneWay}"
                SelectionChanged="ExplorerSelectionChanged"
                ScrollViewer.HorizontalScrollBarVisibility="Auto">
        <TreeView.DataTemplates>
          <TreeDataTemplate DataType="models:ExplorerNode" ItemsSource="{Binding Children}">
            <Border Classes="explorer-row-container" IsVisible="{Binding !IsPlaceholder}">
            <Grid Classes="explorer-row"
                  Classes.dependency="{Binding IsDependency}"
                  Classes.root="{Binding IsRoot}"
                  Classes.dependency-root="{Binding IsDependencyRoot}"
                  Classes.file-icon-blue="{Binding IsFileIconBlue}"
                  Classes.file-icon-yellow="{Binding IsFileIconYellow}"
                  Classes.file-icon-muted="{Binding IsFileIconMuted}"
                  Classes.file-icon-green="{Binding IsFileIconGreen}"
                  Classes.file-icon-purple="{Binding IsFileIconPurple}"
                  Classes.file-icon-pink="{Binding IsFileIconPink}"
                  Classes.file-icon-red="{Binding IsFileIconRed}"
                  Classes.file-icon-orange="{Binding IsFileIconOrange}"
                  Classes.file-icon-ink="{Binding IsFileIconInk}"
                  Classes.file-icon-todo="{Binding IsFileIconTodo}"
                  ColumnDefinitions="14,*,24"
                  ColumnSpacing="6"
                  HorizontalAlignment="Stretch">
              <TextBlock Grid.Column="0"
                         Classes="explorer-file-icon"
                         Text="{Binding FileIconGlyph}"
                         IsVisible="{Binding UseSetiFileIcon}"
                         AutomationProperties.Name="{Binding Name, StringFormat=File type icon for {0}}" />
              <svg:Svg Grid.Column="0"
                       Classes="explorer-icon"
                       Width="14"
                       Height="14"
                       Path="{Binding IconPath}"
                       Css="{DynamicResource IconSvgCss}"
                       IsVisible="{Binding !UseSetiFileIcon}" />
              <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                <TextBlock Classes="explorer-name" Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="None" VerticalAlignment="Center" />
                <TextBlock Classes="explorer-path" Text="{Binding PathSubtitle}" IsVisible="{Binding ShowPathSubtitle}" TextWrapping="NoWrap" TextTrimming="None" />
              </StackPanel>
              <Button Grid.Column="2" Classes="quiet" Width="24" Height="24" Padding="5" IsVisible="{Binding CanRemove}" ToolTip.Tip="Dependency actions" AutomationProperties.Name="{Binding Name, StringFormat=Actions for dependency {0}}">
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuItem Header="Delete" CommandParameter="{Binding}" Click="DeleteDependency" />
                  </MenuFlyout>
                </Button.Flyout>
                <svg:Svg Path="/Assets/icons/more-horizontal.svg" Css="{DynamicResource IconSvgCss}" />
              </Button>
            </Grid>
            </Border>
          </TreeDataTemplate>
        </TreeView.DataTemplates>
      </TreeView>

    </Grid>
  </Border>
</UserControl>
