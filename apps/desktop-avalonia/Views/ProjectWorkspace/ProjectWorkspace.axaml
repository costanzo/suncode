<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:SunCode.Desktop.Controls"
             xmlns:vm="using:SunCode.Desktop.ViewModels"
             xmlns:chat="using:SunCode.Desktop.Views.ProjectWorkspace.Chat"
             xmlns:editor="using:SunCode.Desktop.Views.ProjectWorkspace.Editor"
             xmlns:navigation="using:SunCode.Desktop.Views.ProjectWorkspace.Navigation"
             xmlns:review="using:SunCode.Desktop.Views.ProjectWorkspace.Review"
             xmlns:preview="using:SunCode.Desktop.Views.ProjectWorkspace.Preview"
             xmlns:terminal="using:SunCode.Desktop.Views.ProjectWorkspace.Terminal"
             xmlns:workspace="using:SunCode.Desktop.Views.ProjectWorkspace"
             xmlns:chrome="using:Avalonia.Controls.Chrome"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             x:Class="SunCode.Desktop.Views.ProjectWorkspace.ProjectWorkspace"
             x:DataType="vm:DesktopViewModel">
  <UserControl.Styles>
    <Style Selector="Border.terminal-drawer">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="TextBox.expanded-composer-input:focus">
      <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.icon.gutter">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="Button.icon.gutter:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.icon.gutter svg|Svg">
      <Setter Property="Css" Value="{DynamicResource IconSvgCss}" />
    </Style>
    <Style Selector="Button.icon.gutter.active svg|Svg">
      <Setter Property="Css" Value="{DynamicResource AccentSvgCss}" />
    </Style>
    <Style Selector="Button.icon.gutter.active">
      <Setter Property="Background" Value="{DynamicResource SurfaceActiveBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.icon.gutter.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceActiveBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
    </Style>
    <Style Selector="Button.icon.gutter:pointerover svg|Svg">
      <Setter Property="Css" Value="{DynamicResource GutterIconHoverSvgCss}" />
    </Style>
    <Style Selector="Button.icon.gutter.active:pointerover svg|Svg">
      <Setter Property="Css" Value="{DynamicResource AccentSvgCss}" />
    </Style>
    <!-- Resize handles keep a near-transparent fill so they receive pointer
         input without drawing; the workspace root routes their drags. -->
    <Style Selector="Border.resize-handle">
      <Setter Property="Background" Value="{StaticResource HitTestTransparentBrush}" />
    </Style>
    <Style Selector="Border.resize-handle.vertical">
      <Setter Property="Cursor" Value="SizeWestEast" />
    </Style>
    <Style Selector="Border.resize-handle.horizontal">
      <Setter Property="Cursor" Value="SizeNorthSouth" />
    </Style>
    <Style Selector="TextBlock.footer-status">
      <Setter Property="VerticalAlignment" Value="Center" />
      <!-- Monospace glyphs sit optically high even when their line box is mathematically centered. -->
      <Setter Property="Margin" Value="0,1,0,0" />
    </Style>
    <Style Selector="ProgressBar.mcp-progress">
      <Setter Property="Width" Value="44" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Height" Value="3" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceActiveBrush}" />
    </Style>
  </UserControl.Styles>

    <Grid>
    <Grid RowDefinitions="36,Auto,*,20">
        <Grid x:Name="WorkspaceTitleBar" Grid.Row="0"
              Classes="window-titlebar"
              Background="{StaticResource HitTestTransparentBrush}"
              ColumnDefinitions="*,280,*"
              ZIndex="110"
              chrome:WindowDecorationProperties.ElementRole="{Binding $parent[Window].WindowState, Converter={x:Static workspace:WorkspaceWindow.TitleBarRoleConverter}}">
          <StackPanel x:Name="MacTitleBarControls" chrome:WindowDecorationProperties.ElementRole="User" Grid.Column="0" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0" VerticalAlignment="Center">
            <controls:TrafficLightButton x:Name="ProjectCloseLight" Kind="Close" Click="CloseProjectWindow" />
            <controls:TrafficLightButton x:Name="ProjectMinimizeLight" Kind="Minimize" Click="MinimizeWindow" />
            <controls:TrafficLightButton x:Name="ProjectMaximizeLight" Kind="Maximize" Click="ToggleFullScreen" />
          </StackPanel>
          <workspace:ProjectSwitcher x:Name="ProjectSwitcherControl"
                                     chrome:WindowDecorationProperties.ElementRole="User"
                                     Grid.Column="0"
                                     MaxWidth="200"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Margin="84,0,0,0" />
          <svg:Svg x:Name="WindowsMenuLogo" Grid.Column="0" Width="20" Height="20"
                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0"
                   Path="/Assets/logo/suncode-logo-small.svg" IsVisible="False"
                   chrome:WindowDecorationProperties.ElementRole="User" />
          <StackPanel x:Name="WindowsCompactMenu" Grid.Column="0" Orientation="Horizontal" Spacing="8"
                      VerticalAlignment="Center" Margin="32,0,0,0" IsVisible="False"
                      chrome:WindowDecorationProperties.ElementRole="User">
            <Button x:Name="WindowsMenuToggle" Classes="titlebar" Width="36" Height="30"
                    Click="ToggleWindowsMenu" AutomationProperties.Name="Open main menu" ToolTip.Tip="Main menu (F10)">
              <svg:Svg Width="22" Height="22" Path="/Assets/icons/menu-lines.svg" Css="{DynamicResource IconSvgCss}" />
            </Button>
          </StackPanel>
          <Menu x:Name="WindowsMenuBar" Grid.Column="0" Grid.ColumnSpan="3" Classes="windows-menu-bar" IsVisible="False"
                VerticalAlignment="Center" HorizontalAlignment="Left" Margin="36,0,184,0"
                chrome:WindowDecorationProperties.ElementRole="User" />
          <workspace:ContentSwitcher x:Name="ContentSwitcherControl"
                                      chrome:WindowDecorationProperties.ElementRole="User"
                                     Grid.Column="1"
                                     MaxWidth="280"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
          <StackPanel x:Name="MacTitleBarActions" chrome:WindowDecorationProperties.ElementRole="User" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="2" Margin="0,0,6,0">
            <Button Classes="titlebar" Width="26" Height="28" Click="OpenSettings" ToolTip.Tip="{DynamicResource LocOpenSettings}" AutomationProperties.Name="{DynamicResource LocOpenSettings}">
              <svg:Svg Path="/Assets/icons/settings.svg" Css="{DynamicResource IconSvgCss}" />
            </Button>
          </StackPanel>
          <StackPanel x:Name="WindowsTitleBarControls" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
            <Button Classes="windows-titlebar-control" chrome:WindowDecorationProperties.ElementRole="User" Click="OpenSettings" ToolTip.Tip="{DynamicResource LocOpenSettings}" AutomationProperties.Name="{DynamicResource LocOpenSettings}">
              <svg:Svg Width="14" Height="14" Path="/Assets/icons/settings.svg" Css="{DynamicResource IconSvgCss}" />
            </Button>
            <Button Classes="windows-titlebar-control" chrome:WindowDecorationProperties.ElementRole="MinimizeButton" Click="MinimizeWindow" AutomationProperties.Name="{DynamicResource LocMinimizeWindow}">
              <svg:Svg Width="12" Height="12" Path="/Assets/icons/windows-minimize.svg" Css="{DynamicResource IconSvgCss}" />
            </Button>
            <Button x:Name="WindowsMaximizeButton" Classes="windows-titlebar-control" chrome:WindowDecorationProperties.ElementRole="MaximizeButton" Click="ToggleWindowMaximized" AutomationProperties.Name="{DynamicResource LocMaximizeWindow}">
              <svg:Svg x:Name="WindowsMaximizeIcon" Width="12" Height="12" Path="/Assets/icons/windows-maximize.svg" Css="{DynamicResource IconSvgCss}" />
            </Button>
            <Button x:Name="WindowsCloseButton" Classes="windows-titlebar-control close" chrome:WindowDecorationProperties.ElementRole="CloseButton" Click="CloseProjectWindow" PointerEntered="WindowsCloseEntered" PointerExited="WindowsCloseExited" PointerPressed="WindowsClosePressed" PointerReleased="WindowsCloseReleased" AutomationProperties.Name="{DynamicResource LocCloseWindow}">
              <svg:Svg Width="12" Height="12" Path="/Assets/icons/windows-close.svg" Css="{DynamicResource IconSvgCss}" />
            </Button>
          </StackPanel>
        </Grid>

        <Border x:Name="ProjectTabsHost"
                Grid.Row="1"
                Height="0"
                IsVisible="False" />

        <Grid Grid.Row="2" Margin="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding Layout.WorkspaceGutterWidth}" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="{Binding Layout.WorkspaceGutterWidth}" />
          </Grid.ColumnDefinitions>
          <Grid Grid.Column="0" RowDefinitions="Auto,6,Auto,*,Auto" Margin="4,7" IsVisible="{Binding Layout.WorkspaceGuttersVisible}">
            <Button Grid.Row="0" Classes="icon gutter" Classes.active="{Binding Layout.SessionSidebarVisible}" Click="ToggleNavigation" ToolTip.Tip="{DynamicResource LocShowSessions}" AutomationProperties.Name="Show or hide sessions">
              <Grid>
                <svg:Svg Width="15" Height="15" Path="/Assets/icons/panel-left.svg" IsVisible="{Binding !Layout.SessionSidebarVisible}" />
                <svg:Svg Width="15" Height="15" Path="/Assets/icons/panel-left.svg" IsVisible="{Binding Layout.SessionSidebarVisible}" />
              </Grid>
            </Button>
            <Button Grid.Row="2" Classes="icon gutter" Classes.active="{Binding Layout.ExplorerSidebarVisible}" Click="ToggleExplorer" ToolTip.Tip="{DynamicResource LocShowExplorer}" AutomationProperties.Name="Show or hide explorer">
              <Grid>
                <svg:Svg Width="15" Height="15" Path="/Assets/icons/workspace-files.svg" IsVisible="{Binding !Layout.ExplorerSidebarVisible}" />
                <svg:Svg Width="15" Height="15" Path="/Assets/icons/workspace-files.svg" IsVisible="{Binding Layout.ExplorerSidebarVisible}" />
              </Grid>
            </Button>
            <Border Grid.Row="3" chrome:WindowDecorationProperties.ElementRole="{Binding $parent[Window].WindowState, Converter={x:Static workspace:WorkspaceWindow.TitleBarRoleConverter}}" Background="Transparent"/>
            <StackPanel Grid.Row="4" Spacing="6">
              <Button IsVisible="{Binding Git.IsAvailable}" Classes="icon gutter" Classes.active="{Binding Layout.GitVisible}" Click="ToggleGit" ToolTip.Tip="{DynamicResource LocShowSourceControl}" AutomationProperties.Name="{DynamicResource LocShowSourceControl}">
                <Grid>
                  <svg:Svg Width="15" Height="15" Path="/Assets/icons/git-branch.svg" IsVisible="{Binding !Layout.GitVisible}" />
                  <svg:Svg Width="15" Height="15" Path="/Assets/icons/git-branch.svg" IsVisible="{Binding Layout.GitVisible}" />
                </Grid>
              </Button>
              <Button Classes="icon gutter" Classes.active="{Binding Layout.ToolActivityVisible}" Click="ToggleToolActivity" ToolTip.Tip="{DynamicResource LocShowToolActivity}" AutomationProperties.Name="{DynamicResource LocShowToolActivity}">
                <Grid>
                  <svg:Svg Width="15" Height="15" Path="/Assets/icons/tool.svg" IsVisible="{Binding !Layout.ToolActivityVisible}" />
                  <svg:Svg Width="15" Height="15" Path="/Assets/icons/tool.svg" IsVisible="{Binding Layout.ToolActivityVisible}" />
                </Grid>
              </Button>
              <Button Classes="icon gutter" Classes.active="{Binding Layout.ProviderTraceVisible}" Click="ToggleProviderTrace" ToolTip.Tip="{DynamicResource LocShowProviderTrace}" AutomationProperties.Name="{DynamicResource LocShowProviderTrace}">
                <Grid>
                  <svg:Svg Width="15" Height="15" Path="/Assets/icons/activity.svg" IsVisible="{Binding !Layout.ProviderTraceVisible}" />
                  <svg:Svg Width="15" Height="15" Path="/Assets/icons/activity.svg" IsVisible="{Binding Layout.ProviderTraceVisible}" />
                </Grid>
              </Button>
              <Button Classes="icon gutter" Classes.active="{Binding Layout.TerminalVisible}" Click="ToggleTerminal" IsVisible="{Binding IsProjectOpen}" ToolTip.Tip="{DynamicResource LocShowTerminal}" AutomationProperties.Name="{DynamicResource LocShowTerminal}">
                <Grid>
                  <svg:Svg Width="15" Height="15" Path="/Assets/icons/terminal.svg" IsVisible="{Binding !Layout.TerminalVisible}" />
                  <svg:Svg Width="15" Height="15" Path="/Assets/icons/terminal.svg" IsVisible="{Binding Layout.TerminalVisible}" />
                </Grid>
              </Button>
            </StackPanel>
          </Grid>

          <Grid Grid.Column="1">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="{Binding Layout.BottomDrawerGap}" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" MinHeight="360">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding Layout.NavigationWidth}" />
                <ColumnDefinition Width="{Binding Layout.NavigationGap}" />
                <ColumnDefinition Width="{Binding Layout.ConversationWidth}" MinWidth="0" />
                <ColumnDefinition Width="{Binding Layout.PreviewGap}" />
                <ColumnDefinition Width="{Binding Layout.PreviewWidth}" />
                <ColumnDefinition Width="{Binding Layout.ReviewGap}" />
                <ColumnDefinition Width="{Binding Layout.ReviewWidth}" />
              </Grid.ColumnDefinitions>

              <Grid Grid.Column="0" IsVisible="{Binding Layout.EffectiveNavigationVisible}">
                <navigation:ProjectSidebar IsVisible="{Binding Layout.EffectiveSessionSidebarVisible}" />
                <navigation:ProjectExplorer IsVisible="{Binding Layout.EffectiveExplorerSidebarVisible}" />
              </Grid>

              <Border Grid.Column="1" Classes="resize-handle vertical" Tag="Navigation" IsVisible="{Binding Layout.EffectiveNavigationVisible}" />

              <Grid Grid.Column="2" IsVisible="{Binding Layout.PreviewChatVisible}">
                <chat:ChatArea x:Name="ChatArea" IsVisible="{Binding IsConversationVisible}" />
                <editor:ReadOnlyEditor IsVisible="{Binding IsEditorVisible}" />
                <chat:ChildSessionDetail IsVisible="{Binding IsChildSessionVisible}" />
              </Grid>

              <Border Grid.Column="3" Classes="resize-handle vertical" Tag="Preview" IsVisible="{Binding Layout.EffectivePreviewVisible}" />

              <preview:BrowserPreviewPane x:Name="BrowserPreview" Grid.Column="4" IsVisible="{Binding Layout.EffectivePreviewVisible}" />

              <Border Grid.Column="5" Classes="resize-handle vertical" Tag="Review" IsVisible="{Binding Layout.EffectiveReviewVisible}" />

              <Grid Grid.Column="6" IsVisible="{Binding Layout.EffectiveReviewVisible}">
                <review:AgentSidebar IsVisible="{Binding Layout.EffectiveReviewInspectorVisible}" />
                <review:ChildSessionsPanel IsVisible="{Binding Layout.EffectiveChildSessionsVisible}" />
              </Grid>
            </Grid>

            <Border Grid.Row="1" Classes="resize-handle horizontal" Tag="BottomDrawer" IsVisible="{Binding Layout.EffectiveGitVisible}" />
            <Border Grid.Row="1" Classes="resize-handle horizontal" Tag="BottomDrawer" IsVisible="{Binding Layout.EffectiveProviderTraceVisible}" />
            <Border Grid.Row="1" Classes="resize-handle horizontal" Tag="BottomDrawer" IsVisible="{Binding Layout.EffectiveToolActivityVisible}" />
            <Border Grid.Row="1" Classes="resize-handle horizontal" Tag="BottomDrawer" IsVisible="{Binding Layout.EffectiveTerminalVisible}" />

            <Grid Grid.Row="2">
              <Border Classes="card" Height="{Binding Layout.EffectiveBottomDrawerHeight}" ClipToBounds="True" IsVisible="{Binding Layout.EffectiveGitVisible}">
                <review:GitViewer x:Name="GitViewer" VerticalAlignment="Stretch" />
              </Border>
              <Border Classes="card" Height="{Binding Layout.EffectiveBottomDrawerHeight}" ClipToBounds="True" IsVisible="{Binding Layout.EffectiveProviderTraceVisible}">
                <review:ProviderTraceViewer x:Name="ProviderTraceViewer" VerticalAlignment="Stretch" />
              </Border>
              <Border Classes="card" Height="{Binding Layout.EffectiveBottomDrawerHeight}" ClipToBounds="True" IsVisible="{Binding Layout.EffectiveToolActivityVisible}">
                <review:ToolActivityViewer x:Name="ToolActivityViewer" VerticalAlignment="Stretch" />
              </Border>
              <Border Classes="terminal-drawer" Height="{Binding Layout.EffectiveBottomDrawerHeight}" ClipToBounds="True" IsVisible="{Binding Layout.EffectiveTerminalVisible}">
                <terminal:TerminalPanel x:Name="TerminalPanel" VerticalAlignment="Stretch" />
              </Border>
            </Grid>
          </Grid>

          <StackPanel Grid.Column="2" Margin="4,7" IsVisible="{Binding Layout.WorkspaceGuttersVisible}">
            <Button Classes="icon gutter" Classes.active="{Binding Layout.PreviewVisible}" Click="TogglePreview" ToolTip.Tip="{Binding BrowserGutterTip}" AutomationProperties.Name="{Binding BrowserGutterTip}" Margin="0,0,0,6" IsVisible="{Binding IsBrowserAvailable}">
              <Grid>
                <svg:Svg Width="15" Height="15" Path="/Assets/icons/computer.svg" />
                <Grid Classes="gutter-live" IsVisible="{Binding IsBrowserConnected}">
                  <Ellipse Classes="gutter-live-halo" />
                  <Ellipse Classes="gutter-live-core" />
                </Grid>
              </Grid>
            </Button>
            <Button Classes="icon gutter" Classes.active="{Binding Layout.EffectiveReviewInspectorVisible}" Click="ToggleReview" ToolTip.Tip="{DynamicResource LocShowReview}" AutomationProperties.Name="{DynamicResource LocShowReview}">
              <Grid>
                <svg:Svg Width="15" Height="15" Path="/Assets/icons/panel-right.svg" IsVisible="{Binding !Layout.ReviewVisible}" />
                <svg:Svg Width="15" Height="15" Path="/Assets/icons/panel-right.svg" IsVisible="{Binding Layout.ReviewVisible}" />
                <Ellipse Classes="gutter-attention" IsVisible="{Binding ReviewGutterAttention}" />
              </Grid>
            </Button>
            <Button Classes="icon gutter" Classes.active="{Binding Layout.EffectiveChildSessionsVisible}" Click="ToggleChildSessions" ToolTip.Tip="{DynamicResource LocShowChildSessions}" AutomationProperties.Name="{DynamicResource LocShowChildSessions}" Margin="0,6,0,0">
              <Grid>
                <svg:Svg Width="15" Height="15" Path="/Assets/icons/agent.svg" />
                <Ellipse Classes="gutter-attention" IsVisible="{Binding ChildSessionsGutterAttention}" />
              </Grid>
            </Button>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Height="20" MinHeight="20" ColumnDefinitions="*,Auto" Margin="12,0,12,0" VerticalAlignment="Center">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" VerticalAlignment="Center" IsVisible="{Binding Git.IsAvailable}" Height="20">
            <TextBlock Text="{Binding Git.FooterBranchText}" Classes="mono footer-status" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" MaxWidth="180" TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Layout.WorkspaceStatusDetailsVisible}" Height="20" VerticalAlignment="Center">
              <TextBlock Text="{Binding Git.ChangeSummary}" Classes="mono footer-status" FontSize="9" Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding Git.IsClean}" />
              <TextBlock Text="{Binding Git.ChangeSummary}" Classes="mono footer-status" FontSize="9" Foreground="{DynamicResource WarningBrush}" IsVisible="{Binding Git.IsDirty}" />
              <TextBlock Text="{Binding Git.Additions, StringFormat=+{0}}" Classes="mono footer-status" FontSize="9" Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding Git.IsReady}" />
              <TextBlock Text="{Binding Git.Deletions, StringFormat=-{0}}" Classes="mono footer-status" FontSize="9" Foreground="{DynamicResource DangerBrush}" IsVisible="{Binding Git.IsReady}" />
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsProjectOpen}" VerticalAlignment="Center" Height="20">
            <TextBlock Text="{Binding ProviderTraffic.Text}" Classes="mono footer-status" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding IsProviderTrafficVisible}" ToolTip.Tip="{Binding ProviderTraffic.Details}" AutomationProperties.Name="{Binding ProviderTraffic.Details}" />
            <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding Remote.Configured}" Height="20" VerticalAlignment="Center" ToolTip.Tip="{Binding Remote.StatusText}" AutomationProperties.Name="{Binding Remote.StatusText}">
              <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{DynamicResource SuccessBrush}" IsVisible="{Binding Remote.Connected}" />
              <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{DynamicResource TextMutedBrush}" IsVisible="{Binding !Remote.Connected}" />
              <TextBlock Text="{Binding Remote.StatusText}" Classes="mono footer-status" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding Layout.WorkspaceStatusDetailsVisible}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding Mcp.IsLoading}" Height="20" VerticalAlignment="Center" ToolTip.Tip="{Binding Mcp.LoadDetails}">
              <svg:Svg Width="11" Height="11" Path="/Assets/icons/server.svg" Css="{DynamicResource IconSvgCss}" />
              <TextBlock Text="{Binding Mcp.LoadText}" Classes="mono footer-status" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding Layout.WorkspaceStatusDetailsVisible}" />
              <ProgressBar Classes="mcp-progress" Minimum="0" Maximum="100" Value="{Binding Mcp.LoadPercent}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsProjectOpen}" Height="20" VerticalAlignment="Center" ToolTip.Tip="{Binding RunningSessionText}" AutomationProperties.Name="{Binding RunningSessionText}">
              <controls:SCStatusDot Status="{Binding RunningSessionDotStatus}" />
              <TextBlock Text="{Binding RunningSessionText}" Classes="mono footer-status" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding Layout.WorkspaceStatusDetailsVisible}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding HasWaitingSessions}" Height="20" VerticalAlignment="Center" ToolTip.Tip="{Binding WaitingSessionText}" AutomationProperties.Name="{Binding WaitingSessionText}">
              <svg:Svg Width="10" Height="10" Path="/Assets/icons/message.svg" Css="{DynamicResource WarningSvgCss}" />
              <TextBlock Text="{Binding WaitingSessionText}" Classes="mono footer-status" FontSize="9" Foreground="{DynamicResource WarningBrush}" IsVisible="{Binding Layout.WorkspaceStatusDetailsVisible}" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Grid>

    <controls:SCModal x:Name="ExpandedComposerModal"
                      DialogWidth="860"
                      IsOpen="False"
                      HideClose="True"
                      PrimaryButtonText="{DynamicResource LocSendMessage}"
                      SecondaryButtonText="{DynamicResource LocClose}"
                      PrimaryAction="SubmitExpandedComposer"
                      SecondaryAction="CloseExpandedComposer"
                      CloseRequested="CloseExpandedComposer">
      <Grid RowDefinitions="*,Auto" MinHeight="700" Margin="0,4,0,0">
        <TextBox x:Name="ExpandedComposerInput"
                 Classes="expanded-composer-input"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 FontSize="14"
                 LineHeight="22"
                 Background="{DynamicResource FieldBrush}"
                 BorderBrush="{DynamicResource BorderBrush}"
                 BorderThickness="1"
                 CornerRadius="10"
                 Padding="18"
                 TextChanged="ExpandedComposerChanged">
          <TextBox.Resources>
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{DynamicResource BorderColor}" />
          </TextBox.Resources>
        </TextBox>
        <TextBlock x:Name="ExpandedComposerCount"
                   Grid.Row="1"
                   HorizontalAlignment="Left"
                   Margin="0,8,0,0"
                   Classes="mono"
                   FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
      </Grid>
    </controls:SCModal>

    <controls:SCModal x:Name="LongUserMessageModal"
                      DialogWidth="860"
                      IsOpen="False"
                      Title="Message"
                      PrimaryButtonText=""
                      HidePrimaryButton="True"
                      SecondaryButtonText="{DynamicResource LocClose}"
                      SecondaryAction="CloseLongUserMessage"
                      CloseRequested="CloseLongUserMessage">
      <Grid RowDefinitions="*,Auto" Height="620" Margin="0,4,0,0">
        <Border Background="{DynamicResource FieldBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <SelectableTextBlock x:Name="LongUserMessageText"
                                 FontSize="14"
                                 LineHeight="22"
                                 TextWrapping="Wrap" />
          </ScrollViewer>
        </Border>
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,8,0,0">
          <Button x:Name="LongUserMessageCopyButton"
                  Classes="quiet"
                  Width="26"
                  Height="26"
                  MinHeight="26"
                  Padding="5"
                  Click="CopyLongUserMessage"
                  ToolTip.Tip="{DynamicResource LocCopyMessage}"
                  AutomationProperties.Name="{DynamicResource LocCopyMessage}">
            <svg:Svg Path="/Assets/icons/copy.svg" Css="{DynamicResource IconSvgCss}" />
          </Button>
          <TextBlock x:Name="LongUserMessageCount"
                     Grid.Column="1"
                     Margin="8,0,0,0"
                     VerticalAlignment="Center"
                     Classes="mono"
                     FontSize="11"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
        </Grid>
      </Grid>
    </controls:SCModal>

    <TextBlock x:Name="LongUserMessageAnnouncement" IsVisible="False" AutomationProperties.LiveSetting="Polite" />
  </Grid>
</UserControl>
