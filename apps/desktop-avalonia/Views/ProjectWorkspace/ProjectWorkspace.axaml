<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:SunCode.Desktop.Controls"
             xmlns:vm="using:SunCode.Desktop.ViewModels"
             xmlns:chat="using:SunCode.Desktop.Views.ProjectWorkspace.Chat"
             xmlns:navigation="using:SunCode.Desktop.Views.ProjectWorkspace.Navigation"
             xmlns:review="using:SunCode.Desktop.Views.ProjectWorkspace.Review"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             x:Class="SunCode.Desktop.Views.ProjectWorkspace.ProjectWorkspace"
             x:DataType="vm:DesktopViewModel">
  <UserControl.Styles>
    <Style Selector="TextBox.expanded-composer-input:focus">
      <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.icon.gutter">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="Button.icon.gutter:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.icon.gutter svg|Svg">
      <Setter Property="Css" Value="{DynamicResource IconSvgCss}" />
    </Style>
    <Style Selector="Button.icon.gutter.active svg|Svg">
      <Setter Property="Css" Value="{DynamicResource AccentSvgCss}" />
    </Style>
    <Style Selector="Button.icon.gutter.active">
      <Setter Property="Background" Value="{DynamicResource SurfaceActiveBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.icon.gutter.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceActiveBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
    </Style>
    <Style Selector="Button.icon.gutter:pointerover svg|Svg">
      <Setter Property="Css" Value="{DynamicResource GutterIconHoverSvgCss}" />
    </Style>
    <Style Selector="Button.icon.gutter.active:pointerover svg|Svg">
      <Setter Property="Css" Value="{DynamicResource AccentSvgCss}" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <Grid RowDefinitions="36,*,20">
        <Grid Grid.Row="0"
              Classes="window-titlebar"
              Background="#01000000"
              ColumnDefinitions="*,280,*"
              ZIndex="110"
              PointerPressed="TitleBarPressed"
              PointerMoved="TitleBarMoved"
              PointerReleased="TitleBarReleased"
              DoubleTapped="TitleBarDoubleTapped">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0" VerticalAlignment="Center">
            <Button x:Name="ProjectCloseLight" Classes="titlebar" Focusable="False" Width="18" Height="18" Padding="2" Click="CloseProjectWindow" PointerEntered="TrafficLightEntered" PointerExited="TrafficLightExited" PointerPressed="TrafficLightPressed" PointerReleased="TrafficLightReleased" ToolTip.Tip="Close window">
              <svg:Svg Path="/Assets/traffic-lights/1-close-1-normal.svg" />
            </Button>
            <Button x:Name="ProjectMinimizeLight" Classes="titlebar" Focusable="False" Width="18" Height="18" Padding="2" Click="MinimizeWindow" PointerEntered="TrafficLightEntered" PointerExited="TrafficLightExited" PointerPressed="TrafficLightPressed" PointerReleased="TrafficLightReleased" ToolTip.Tip="Minimize window">
              <svg:Svg Path="/Assets/traffic-lights/2-minimize-1-normal.svg" />
            </Button>
            <Button x:Name="ProjectMaximizeLight" Classes="titlebar" Focusable="False" Width="18" Height="18" Padding="2" Click="ToggleFullScreen" PointerEntered="TrafficLightEntered" PointerExited="TrafficLightExited" PointerPressed="TrafficLightPressed" PointerReleased="TrafficLightReleased" ToolTip.Tip="Enter full screen">
              <svg:Svg Path="/Assets/traffic-lights/3-maximize-1-normal.svg" />
            </Button>
          </StackPanel>
          <TextBlock Grid.Column="0"
                     Text="{Binding ProjectTitle}"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     MaxWidth="180"
                     TextTrimming="CharacterEllipsis"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Center"
                     Margin="90,0,0,0" />
          <TextBlock Grid.Column="1"
                     Classes="window-title"
                     Text="{Binding SessionTitle}"
                     TextTrimming="CharacterEllipsis"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     MaxWidth="260"
                     IsVisible="{Binding HasSelectedSession}" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="2" Margin="0,0,6,0">
            <Button Classes="titlebar" Width="26" Height="28" Click="OpenSettings" ToolTip.Tip="Open settings" AutomationProperties.Name="Open settings">
              <svg:Svg Path="/Assets/icons/settings.svg" Css="{DynamicResource IconSvgCss}" />
            </Button>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding WorkspaceGutterWidth}" />
            <ColumnDefinition Width="{Binding WorkspaceGutterGap}" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="{Binding WorkspaceGutterGap}" />
            <ColumnDefinition Width="{Binding WorkspaceGutterWidth}" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="#01000000" PointerPressed="TitleBarPressed" PointerMoved="TitleBarMoved" PointerReleased="TitleBarReleased" />
          <Border Grid.Column="4" Background="#01000000" PointerPressed="TitleBarPressed" PointerMoved="TitleBarMoved" PointerReleased="TitleBarReleased" />
          <Grid Grid.Column="0" RowDefinitions="Auto,6,Auto,*,Auto,6,Auto" Margin="0,7" IsVisible="{Binding WorkspaceGuttersVisible}">
            <Button Grid.Row="0" Classes="icon gutter" Classes.active="{Binding SessionSidebarVisible}" Click="ToggleNavigation" ToolTip.Tip="Show sessions" AutomationProperties.Name="Show or hide sessions">
              <Grid>
                <svg:Svg Width="15" Height="15" Path="/Assets/icons/panel-left.svg" IsVisible="{Binding !SessionSidebarVisible}" />
                <svg:Svg Width="15" Height="15" Path="/Assets/icons/panel-left.svg" IsVisible="{Binding SessionSidebarVisible}" />
              </Grid>
            </Button>
            <Button Grid.Row="2" Classes="icon gutter" Classes.active="{Binding ExplorerSidebarVisible}" Click="ToggleExplorer" ToolTip.Tip="Show explorer" AutomationProperties.Name="Show or hide explorer">
              <Grid>
                <svg:Svg Width="15" Height="15" Path="/Assets/icons/workspace-files.svg" IsVisible="{Binding !ExplorerSidebarVisible}" />
                <svg:Svg Width="15" Height="15" Path="/Assets/icons/workspace-files.svg" IsVisible="{Binding ExplorerSidebarVisible}" />
              </Grid>
            </Button>
            <Button Grid.Row="4" Classes="icon gutter" Classes.active="{Binding GitVisible}" Click="ToggleGit" ToolTip.Tip="Show or hide source control" AutomationProperties.Name="Show or hide source control">
              <Grid>
                <svg:Svg Width="15" Height="15" Path="/Assets/icons/git-branch.svg" IsVisible="{Binding !GitVisible}" />
                <svg:Svg Width="15" Height="15" Path="/Assets/icons/git-branch.svg" IsVisible="{Binding GitVisible}" />
              </Grid>
            </Button>
            <Button Grid.Row="6" Classes="icon gutter" Classes.active="{Binding ProviderTraceVisible}" Click="ToggleProviderTrace" ToolTip.Tip="Show or hide provider trace" AutomationProperties.Name="Show or hide provider trace">
              <Grid>
                <svg:Svg Width="15" Height="15" Path="/Assets/icons/activity.svg" IsVisible="{Binding !ProviderTraceVisible}" />
                <svg:Svg Width="15" Height="15" Path="/Assets/icons/activity.svg" IsVisible="{Binding ProviderTraceVisible}" />
              </Grid>
            </Button>
          </Grid>

          <Grid Grid.Column="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="{Binding BottomDrawerGap}" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding NavigationWidth}" />
                <ColumnDefinition Width="{Binding NavigationGap}" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="{Binding ReviewGap}" />
                <ColumnDefinition Width="{Binding ReviewWidth}" />
              </Grid.ColumnDefinitions>

              <Grid Grid.Column="0" IsVisible="{Binding EffectiveNavigationVisible}">
                <navigation:ProjectSidebar IsVisible="{Binding EffectiveSessionSidebarVisible}" />
                <navigation:ProjectExplorer IsVisible="{Binding EffectiveExplorerSidebarVisible}" />
              </Grid>

              <Border Grid.Column="1" Background="#01000000" Cursor="SizeWestEast" Tag="Navigation" PointerPressed="LayoutResizePressed" PointerMoved="LayoutResizeMoved" PointerReleased="LayoutResizeReleased" IsVisible="{Binding EffectiveNavigationVisible}" />

              <chat:ChatArea x:Name="ChatArea" Grid.Column="2" />

              <Border Grid.Column="3" Background="#01000000" Cursor="SizeWestEast" Tag="Review" PointerPressed="LayoutResizePressed" PointerMoved="LayoutResizeMoved" PointerReleased="LayoutResizeReleased" IsVisible="{Binding EffectiveReviewVisible}" />

              <review:AgentSidebar Grid.Column="4" IsVisible="{Binding EffectiveReviewVisible}" />
            </Grid>

            <Border Grid.Row="1" Background="#01000000" Cursor="SizeNorthSouth" Tag="BottomDrawer" PointerPressed="LayoutResizePressed" PointerMoved="LayoutResizeMoved" PointerReleased="LayoutResizeReleased" IsVisible="{Binding EffectiveGitVisible}" />
            <Border Grid.Row="1" Background="#01000000" Cursor="SizeNorthSouth" Tag="BottomDrawer" PointerPressed="LayoutResizePressed" PointerMoved="LayoutResizeMoved" PointerReleased="LayoutResizeReleased" IsVisible="{Binding EffectiveProviderTraceVisible}" />

            <Grid Grid.Row="2">
              <review:GitViewer x:Name="GitViewer" Height="{Binding BottomDrawerHeight}" IsVisible="{Binding EffectiveGitVisible}" />
              <review:ProviderTraceViewer x:Name="ProviderTraceViewer" Height="{Binding BottomDrawerHeight}" IsVisible="{Binding EffectiveProviderTraceVisible}" />
            </Grid>
          </Grid>

          <StackPanel Grid.Column="4" Margin="0,7,0,0" IsVisible="{Binding WorkspaceGuttersVisible}">
            <Button Classes="icon gutter" Classes.active="{Binding ReviewVisible}" Click="ToggleReview" ToolTip.Tip="Show or hide review" AutomationProperties.Name="Show or hide review">
              <Grid>
                <svg:Svg Width="15" Height="15" Path="/Assets/icons/panel-right.svg" IsVisible="{Binding !ReviewVisible}" />
                <svg:Svg Width="15" Height="15" Path="/Assets/icons/panel-right.svg" IsVisible="{Binding ReviewVisible}" />
              </Grid>
            </Button>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="36,0,12,0">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" VerticalAlignment="Center" IsVisible="{Binding IsProjectOpen}">
            <TextBlock Text="{Binding GitFooterBranchText}" Classes="mono" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" MaxWidth="180" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding WorkspaceStatusDetailsVisible}">
              <TextBlock Text="{Binding GitChangeSummary}" Classes="mono" FontSize="9" Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding IsGitClean}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding GitChangeSummary}" Classes="mono" FontSize="9" Foreground="{DynamicResource WarningBrush}" IsVisible="{Binding IsGitDirty}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding GitAdditions, StringFormat=+{0}}" Classes="mono" FontSize="9" Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding IsGitReady}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding GitDeletions, StringFormat=-{0}}" Classes="mono" FontSize="9" Foreground="{DynamicResource DangerBrush}" IsVisible="{Binding IsGitReady}" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasSelectedSession}" VerticalAlignment="Center">
            <TextBlock Text="{Binding SelectedModelName}" Classes="mono" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" MaxWidth="180" TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding WorkspaceStatusDetailsVisible}">
              <Border Width="1" Height="10" Background="{DynamicResource BorderBrush}" />
              <TextBlock Text="{Binding SessionTokenText}" Classes="mono" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" />
              <Border Width="1" Height="10" Background="{DynamicResource BorderBrush}" />
              <TextBlock Text="{Binding ProviderTraceSummary}" Classes="mono" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Grid>

    <controls:SCModal x:Name="SessionDialogModal"
                      DialogWidth="360"
                      IsOpen="False"
                      PrimaryButtonText="Create"
                      SecondaryButtonText="Cancel"
                      PrimaryAction="SubmitSessionDialog"
                      SecondaryAction="CloseSessionDialog"
                      CloseRequested="CloseSessionDialog">
      <TextBox x:Name="SessionTitleInput"
               PlaceholderText="Session name"
               TextChanged="SessionTitleChanged"
               KeyDown="SessionTitleKeyDown" />
    </controls:SCModal>

    <controls:SCModal x:Name="UndoDialogModal"
                      DialogWidth="520"
                      IsOpen="False"
                      Title="Undo this turn's file changes?"
                      Description="SunCode will restore the files changed during this turn."
                      PrimaryButtonText="Undo changes"
                      SecondaryButtonText="Cancel"
                      CloseOnOverlayPress="False"
                      PrimaryAction="ConfirmUndoDialog"
                      SecondaryAction="CloseUndoDialog"
                      CloseRequested="CloseUndoDialog">
      <StackPanel Spacing="16">
        <Border MaxHeight="150" Padding="12" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="UndoPathsText" Classes="mono" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
          </ScrollViewer>
        </Border>
        <TextBlock Text="External side effects cannot be reversed." FontSize="12" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" />
      </StackPanel>
    </controls:SCModal>

    <controls:SCModal x:Name="DependencyDeleteDialogModal"
                      DialogWidth="420"
                      IsOpen="False"
                      Title="Delete dependency?"
                      PrimaryButtonText="Delete dependency"
                      SecondaryButtonText="Cancel"
                      PrimaryIsDanger="True"
                      PrimaryAction="ConfirmDependencyDeleteDialog"
                      SecondaryAction="CloseDependencyDeleteDialog"
                      CloseRequested="CloseDependencyDeleteDialog">
      <TextBlock TextWrapping="Wrap">
        <Run Text="Remove " />
        <Run x:Name="DependencyDeleteName" FontWeight="SemiBold" />
        <Run Text=" from this project's dependencies? The folder and its files will not be deleted." />
      </TextBlock>
    </controls:SCModal>

    <controls:SCModal x:Name="ExpandedComposerModal"
                      DialogWidth="860"
                      IsOpen="False"
                      HideClose="True"
                      PrimaryButtonText="Send message"
                      SecondaryButtonText="Close"
                      PrimaryAction="SubmitExpandedComposer"
                      SecondaryAction="CloseExpandedComposer"
                      CloseRequested="CloseExpandedComposer">
      <Grid RowDefinitions="*,Auto" MinHeight="420" Margin="0,4,0,0">
        <TextBox x:Name="ExpandedComposerInput"
                 Classes="expanded-composer-input"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 FontSize="14"
                 LineHeight="22"
                 Background="{DynamicResource FieldBrush}"
                 BorderBrush="{DynamicResource BorderBrush}"
                 BorderThickness="1"
                 CornerRadius="10"
                 Padding="18"
                 TextChanged="ExpandedComposerChanged">
          <TextBox.Resources>
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{DynamicResource BorderColor}" />
          </TextBox.Resources>
        </TextBox>
        <TextBlock x:Name="ExpandedComposerCount"
                   Grid.Row="1"
                   HorizontalAlignment="Left"
                   Margin="0,8,0,0"
                   Classes="mono"
                   FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
      </Grid>
    </controls:SCModal>

    <controls:SCModal x:Name="LongUserMessageModal"
                      DialogWidth="860"
                      IsOpen="False"
                      Title="Message"
                      PrimaryButtonText=""
                      HidePrimaryButton="True"
                      SecondaryButtonText="Close"
                      SecondaryAction="CloseLongUserMessage"
                      CloseRequested="CloseLongUserMessage">
      <Grid RowDefinitions="*,Auto" Height="620" Margin="0,4,0,0">
        <Border Background="{DynamicResource FieldBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <SelectableTextBlock x:Name="LongUserMessageText"
                                 FontSize="14"
                                 LineHeight="22"
                                 TextWrapping="Wrap" />
          </ScrollViewer>
        </Border>
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,8,0,0">
          <Button x:Name="LongUserMessageCopyButton"
                  Classes="quiet"
                  Width="26"
                  Height="26"
                  MinHeight="26"
                  Padding="5"
                  Click="CopyLongUserMessage"
                  ToolTip.Tip="Copy message"
                  AutomationProperties.Name="Copy message">
            <svg:Svg Path="/Assets/icons/copy.svg" Css="{DynamicResource IconSvgCss}" />
          </Button>
          <TextBlock x:Name="LongUserMessageCount"
                     Grid.Column="1"
                     Margin="8,0,0,0"
                     VerticalAlignment="Center"
                     Classes="mono"
                     FontSize="11"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
        </Grid>
      </Grid>
    </controls:SCModal>
    <TextBlock x:Name="LongUserMessageAnnouncement" IsVisible="False" AutomationProperties.LiveSetting="Polite" />
  </Grid>
</UserControl>
