<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:SunCode.Desktop.Controls"
             xmlns:models="using:SunCode.Desktop.Models"
             xmlns:vm="using:SunCode.Desktop.ViewModels"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             x:Class="SunCode.Desktop.Views.ProjectWorkspace.Chat.ChatInput"
             x:DataType="vm:DesktopViewModel"
             DragDrop.AllowDrop="True"
             ClipToBounds="False"
             Height="{Binding ComposerPanelHeight}"
             Margin="0"
             VerticalAlignment="Bottom"
             ZIndex="2">
  <UserControl.Styles>
    <Style Selector="TextBox.composer-input:focus">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.composer-input:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.composer-input:pointerover">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.composer-input:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.composer-input">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="MinHeight" Value="52" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="TextBox.composer-input.unavailable">
      <Setter Property="Margin" Value="0,20,0,0" />
    </Style>
    <Style Selector="TextBox.composer-input:disabled">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="TextBox.composer-input:disabled /template/ Border">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.quiet:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.composer-surface">
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    </Style>
    <Style Selector="Border.composer-surface.unavailable">
      <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
    </Style>
    <Style Selector="Border.composer-surface.drop-active">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Background" Value="{DynamicResource AccentSurfaceBrush}" />
    </Style>
    <Style Selector="TextBlock.composer-status">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
    </Style>
    <Style Selector="Button.composer-option">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="controls|SCGroupComboBox.composer-option Button">
      <Setter Property="Height" Value="24" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.attachment-preview">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="Button.attachment-remove">
      <Setter Property="Width" Value="17" />
      <Setter Property="Height" Value="17" />
      <Setter Property="MinWidth" Value="17" />
      <Setter Property="MinHeight" Value="17" />
      <Setter Property="Padding" Value="3" />
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="Background" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ComposerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style Selector="Button.attachment-remove:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ComposerBrush}" />
    </Style>
    <Style Selector="Border.attachment:pointerover Button.attachment-remove">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Button.attachment-remove:focus">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0"
            Margin="24,8,24,0"
            Padding="12,8"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            IsVisible="{Binding HasQueuedInputs}">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <svg:Svg Width="12" Height="12" Path="/Assets/icons/message.svg" Css="{DynamicResource IconSvgCss}" />
            <TextBlock Text="Up next" FontSize="11" FontWeight="SemiBold" />
            <TextBlock Text="{Binding QueuedInputs.Count}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock Text="After this turn" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>
          <Button Grid.Column="1" Classes="quiet" Padding="4,2" Click="UndoRemoveQueuedInput" IsVisible="{Binding HasRemovedQueuedInput}" ToolTip.Tip="Undo remove">
            <TextBlock Text="Undo" FontSize="10" />
          </Button>
          <Button Grid.Column="2" Width="24" Height="24" MinWidth="24" MinHeight="24" Padding="5" Classes="quiet" Click="ToggleQueueCollapsed" ToolTip.Tip="{Binding QueueCollapseLabel}" AutomationProperties.Name="{Binding QueueCollapseLabel}">
            <Grid>
              <svg:Svg Width="12" Height="12" Path="/Assets/icons/arrow-down.svg" Css="{DynamicResource IconSvgCss}" IsVisible="{Binding !QueuedInputsCollapsed}" />
              <svg:Svg Width="12" Height="12" Path="/Assets/icons/arrow-up.svg" Css="{DynamicResource IconSvgCss}" IsVisible="{Binding QueuedInputsCollapsed}" />
            </Grid>
          </Button>
        </Grid>
        <ScrollViewer MaxHeight="180" IsVisible="{Binding !QueuedInputsCollapsed}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding QueuedInputs}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:QueuedInputItem">
                <Grid ColumnDefinitions="20,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,5" ColumnSpacing="6">
                  <TextBlock Grid.RowSpan="2" Text="{Binding Position}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Top" />
                  <TextBlock Grid.Column="1" Text="{Binding PreviewText}" MaxLines="{Binding VisibleLineLimit}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                  <StackPanel Grid.Column="2" Grid.RowSpan="4" Orientation="Horizontal" Spacing="3" VerticalAlignment="Top">
                    <Button Classes="quiet" Padding="6,2" Click="SteerQueuedInput" IsEnabled="{Binding CanSteer}" ToolTip.Tip="Include at the next model request">
                      <TextBlock Text="{Binding SteeringActionText}" FontSize="10" />
                    </Button>
                    <Button Width="22" Height="22" MinWidth="22" MinHeight="22" Padding="4" Classes="quiet" Click="TakeQueuedInput" ToolTip.Tip="Take back and edit" AutomationProperties.Name="Take back and edit queued message">
                      <svg:Svg Width="12" Height="12" Path="/Assets/icons/edit.svg" Css="{DynamicResource IconSvgCss}" />
                    </Button>
                    <Button Width="22" Height="22" MinWidth="22" MinHeight="22" Padding="4" Classes="quiet" Click="RemoveQueuedInput" ToolTip.Tip="Remove from queue" AutomationProperties.Name="Remove queued message">
                      <svg:Svg Width="12" Height="12" Path="/Assets/icons/close.svg" Css="{DynamicResource IconSvgCss}" />
                    </Button>
                  </StackPanel>
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ModeText}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                  <Button Grid.Row="2" Grid.Column="1" Classes="quiet" HorizontalAlignment="Left" Padding="0" Click="ToggleQueuedInputText" IsVisible="{Binding HasLongText}">
                    <TextBlock Text="{Binding DisclosureText}" FontSize="10" TextDecorations="Underline" />
                  </Button>
                  <ItemsControl Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Attachments}" Margin="0,4,0,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:ComposerAttachment">
                        <Border Width="36" Height="32" Padding="1" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                          <Image Source="{Binding Preview}" Stretch="UniformToFill" ToolTip.Tip="{Binding Name}" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ImageSummary}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </Border>

    <Grid Grid.Row="1">
    <ItemsControl x:Name="AttachmentStrip"
                  ItemsSource="{Binding ComposerAttachments}"
                  Margin="28,-46,0,0"
                  VerticalAlignment="Top"
                  HorizontalAlignment="Left"
                  ZIndex="3">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" Spacing="0" />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="models:ComposerAttachment">
        <Grid Width="60" Height="60">
          <Border Classes="attachment" 
                  Width="48"
                  Height="48"
                  HorizontalAlignment="Left"
                  Padding="1"
                  Background="{DynamicResource FieldBrush}"
                  BorderBrush="{DynamicResource BorderStrongBrush}"
                  BorderThickness="1"
                  CornerRadius="5"
                  BoxShadow="0 3 8 0 #40000000">
            <Grid>
              <Button Classes="attachment-preview"
                      Click="PreviewAttachment"
                      ToolTip.Tip="{DynamicResource LocViewImage}">
                <Image Source="{Binding Preview}"
                       Stretch="UniformToFill" />
              </Button>
              <Button Classes="attachment-remove"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Margin="0,-7,-7,0"
                      Click="RemoveAttachment"
                      ToolTip.Tip="{DynamicResource LocRemoveImage}">
                <svg:Svg Path="/Assets/icons/close.svg" Css="{DynamicResource AccentInkSvgCss}" />
              </Button>
            </Grid>
          </Border>
        </Grid>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Border x:Name="ComposerSurface"
            Classes="composer-surface" Classes.unavailable="{Binding IsModelUnavailable}"
          Margin="24,14,24,10"
          Padding="16,12,12,5"
          CornerRadius="16"
          Background="{DynamicResource ComposerBrush}"
          BorderThickness="1"
          BoxShadow="0 6 14 0 #57000000">
    <Grid RowDefinitions="*,Auto" ColumnDefinitions="*,Auto">
      <TextBlock Grid.Row="0"
                 Grid.ColumnSpan="2"
                 Classes="composer-status"
                 Text="{DynamicResource LocConfigureApiKey}"
                 IsVisible="{Binding IsModelUnavailable}"
                 VerticalAlignment="Top" />
      <TextBox x:Name="ComposerInput"
               Classes="composer-input"
               Classes.unavailable="{Binding IsModelUnavailable}"
               Grid.Row="0"
               Grid.ColumnSpan="2"
               Text="{Binding ComposerText, UpdateSourceTrigger=PropertyChanged}"
               Margin="0,0,0,5"
               PlaceholderText="{Binding ComposerPlaceholder}"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               Background="Transparent"
               BorderBrush="Transparent"
               BorderThickness="0"
               Padding="0"
               IsEnabled="{Binding CanCompose}">
               <TextBox.Resources>
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
        </TextBox.Resources>
      </TextBox>

      <StackPanel Grid.Row="1"
                  Grid.Column="0"
                  Orientation="Horizontal"
                  Spacing="4">
        <Button Width="24"
                Height="24"
                MinHeight="24"
                Padding="5"
                Classes="quiet"
                Click="AddAttachment"
                IsEnabled="{Binding CanAttachImages}"
                ToolTip.Tip="{DynamicResource LocAddImage}"
                AutomationProperties.Name="{DynamicResource LocAddImageAttachment}">
          <svg:Svg Path="/Assets/icons/plus.svg" Css="{DynamicResource IconSvgCss}" />
        </Button>

        <Button Width="24"
                Height="24"
                MinHeight="24"
                Padding="0"
                Classes="quiet"
                Click="ExpandComposer"
                IsEnabled="{Binding CanCompose}"
                ToolTip.Tip="{DynamicResource LocOpenExpandedComposer}"
                AutomationProperties.Name="{DynamicResource LocOpenExpandedComposer}">
          <svg:Svg Width="13" Height="13" Path="/Assets/icons/expand.svg" Css="{DynamicResource IconSvgCss}" />
        </Button>
      </StackPanel>

      <StackPanel VerticalAlignment="Bottom"
                  HorizontalAlignment="Right"
                  Grid.Row="1"
                  Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="6">
        <controls:SCGroupComboBox x:Name="ModelSelector"
                             Width="136"
                             MinWidth="136"
                             MaxWidth="136"
                             Height="24"
                             MinHeight="24"
                             Classes="mono composer-option"
                             UseMonospace="True"
                             PlaceholderText="{DynamicResource LocChooseModel}"
                             IsEnabled="{Binding CanChooseModel}"
                             ToolTip.Tip="{DynamicResource LocChooseModel}"
                             SelectionChanged="ModelSelectionChanged" />

        <controls:SCFlatComboBox x:Name="ReasoningSelector"
                             Width="76"
                             Height="24"
                             MinHeight="24"
                             Classes="mono composer-option"
                             UseMonospace="True"
                             PlaceholderText=""
                             IsEnabled="{Binding CanChooseReasoningEffort}"
                             ToolTip.Tip="{DynamicResource LocReasoningEffort}"
                             SelectionChanged="ReasoningSelectionChanged" />

        <Button Width="24"
                Height="24"
                MinHeight="24"
                CornerRadius="12"
                Padding="7"
                Classes.primary="{Binding IsComposerSendAction}"
                Classes.danger="{Binding IsComposerStopAction}"
                Click="ComposerAction"
                IsEnabled="{Binding IsComposerActionEnabled}"
                ToolTip.Tip="{Binding ComposerSubmitLabel}">
          <Grid Width="10" Height="10">
            <svg:Svg Path="/Assets/icons/arrow-up.svg"
                     Css="{DynamicResource AccentInkSvgCss}"
                     IsVisible="{Binding IsComposerSendAction}" />
            <Border Width="8"
                    Height="8"
                    CornerRadius="1.5"
                    Background="{DynamicResource DangerBrush}"
                    IsVisible="{Binding IsComposerStopAction}" />
          </Grid>
        </Button>
      </StackPanel>
    </Grid>
    </Border>
    </Grid>
  </Grid>
</UserControl>
