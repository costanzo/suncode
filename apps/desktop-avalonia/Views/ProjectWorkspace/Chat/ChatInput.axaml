<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:SunCode.Desktop.Controls"
             xmlns:models="using:SunCode.Desktop.Models"
             xmlns:vm="using:SunCode.Desktop.ViewModels"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             x:Class="SunCode.Desktop.Views.ProjectWorkspace.Chat.ChatInput"
             x:DataType="vm:DesktopViewModel"
             Height="126"
             Margin="0"
             VerticalAlignment="Bottom"
             ZIndex="2">
  <UserControl.Styles>
    <Style Selector="TextBox.composer-input:focus">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.composer-input">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="MinHeight" Value="52" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.composer-option">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="controls|SCComboBox.composer-option ComboBox">
      <Setter Property="Height" Value="24" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="controls|SCComboBox.composer-option Button">
      <Setter Property="Height" Value="24" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.attachment-preview">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="Button.attachment-remove">
      <Setter Property="Width" Value="17" />
      <Setter Property="Height" Value="17" />
      <Setter Property="MinWidth" Value="17" />
      <Setter Property="MinHeight" Value="17" />
      <Setter Property="Padding" Value="3" />
      <Setter Property="Background" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ComposerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <ItemsControl x:Name="AttachmentStrip"
                  ItemsSource="{Binding ComposerAttachments}"
                  Margin="28,-42,0,0"
                  VerticalAlignment="Top"
                  HorizontalAlignment="Left"
                  ZIndex="3">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" Spacing="7" />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="models:ComposerAttachment">
        <Border Width="48"
                Height="48"
                Padding="1"
                Background="{DynamicResource FieldBrush}"
                BorderBrush="{DynamicResource BorderStrongBrush}"
                BorderThickness="1"
                CornerRadius="6"
                BoxShadow="0 3 8 0 #40000000">
          <Grid>
            <Button Classes="attachment-preview"
                    Click="PreviewAttachment"
                    ToolTip.Tip="View image">
              <Image Source="{Binding Preview}"
                     Stretch="UniformToFill" />
            </Button>
            <Button Classes="attachment-remove"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,-7,-7,0"
                    Click="RemoveAttachment"
                    ToolTip.Tip="Remove image">
              <svg:Svg Path="/Assets/icons/close.svg" Css="{DynamicResource AccentInkSvgCss}" />
            </Button>
          </Grid>
        </Border>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Border Margin="24,14,24,10"
          Padding="16,12,12,10"
          CornerRadius="16"
          Background="{DynamicResource ComposerBrush}"
          BorderBrush="{DynamicResource BorderStrongBrush}"
          BorderThickness="1"
          BoxShadow="0 6 14 0 #57000000">
    <Grid RowDefinitions="*,Auto" ColumnDefinitions="*,Auto">
      <TextBox x:Name="ComposerInput"
               Classes="composer-input"
               Grid.Row="0"
               Grid.ColumnSpan="2"
               Text="{Binding ComposerText}"
               PlaceholderText="{Binding ComposerPlaceholder}"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               Background="Transparent"
               BorderBrush="Transparent"
               BorderThickness="0"
               Padding="0"
               IsEnabled="{Binding CanCompose}">
               <TextBox.Resources>
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
        </TextBox.Resources>
      </TextBox>

      <StackPanel Grid.Row="1"
                  Grid.Column="0"
                  Orientation="Horizontal"
                  Spacing="4">
        <Button Width="24"
                Height="24"
                MinHeight="24"
                Padding="5"
                Classes="quiet"
                Click="AddAttachment"
                IsEnabled="{Binding CanAttachImages}"
                ToolTip.Tip="Add image (requires a model with image input)"
                AutomationProperties.Name="Add image attachment">
          <svg:Svg Path="/Assets/icons/plus.svg" Css="{DynamicResource IconSvgCss}" />
        </Button>

        <Button Width="24"
                Height="24"
                MinHeight="24"
                Padding="0"
                Classes="quiet"
                Click="ExpandComposer"
                IsEnabled="{Binding CanCompose}"
                ToolTip.Tip="Open expanded composer"
                AutomationProperties.Name="Open expanded composer">
          <svg:Svg Width="13" Height="13" Path="/Assets/icons/expand.svg" Css="{DynamicResource IconSvgCss}" />
        </Button>
      </StackPanel>

      <StackPanel VerticalAlignment="Bottom"
                  HorizontalAlignment="Right"
                  Grid.Row="1"
                  Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="6">
        <controls:SCComboBox x:Name="ModelSelector"
                             Width="136"
                             Height="24"
                             MinHeight="24"
                             Classes="mono composer-option"
                             IsHierarchical="True"
                             UseMonospace="True"
                             PlaceholderText="Choose model"
                             IsEnabled="{Binding CanChooseModel}"
                             ToolTip.Tip="Choose model"
                             SelectionChanged="ModelSelectionChanged" />

        <controls:SCComboBox x:Name="ReasoningSelector"
                             Width="76"
                             Height="24"
                             MinHeight="24"
                             Classes="mono composer-option"
                             UseMonospace="True"
                             PlaceholderText="Effort"
                             IsEnabled="{Binding CanChooseReasoningEffort}"
                             ToolTip.Tip="Reasoning effort"
                             SelectionChanged="ReasoningSelectionChanged" />

        <Button Width="24"
                Height="24"
                MinHeight="24"
                CornerRadius="12"
                Padding="6"
                Classes="primary"
                Click="SubmitTurn"
                IsVisible="{Binding !IsTurnActive}"
                IsEnabled="{Binding CanSubmit}"
                ToolTip.Tip="Send message">
          <svg:Svg Path="/Assets/icons/arrow-up.svg" Css="{DynamicResource AccentInkSvgCss}" />
        </Button>

        <Button Width="24"
                Height="24"
                MinHeight="24"
                CornerRadius="12"
                Padding="7"
                Classes="danger"
                Click="CancelTurn"
                IsVisible="{Binding IsTurnActive}"
                ToolTip.Tip="Stop turn">
          <Border Width="8"
                  Height="8"
                  CornerRadius="1.5"
                  Background="{DynamicResource DangerBrush}" />
        </Button>
      </StackPanel>
    </Grid>
    </Border>
  </Grid>
</UserControl>
