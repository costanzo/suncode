<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:SunCode.Desktop.Models"
             xmlns:vm="using:SunCode.Desktop.ViewModels"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             x:Class="SunCode.Desktop.Views.ProjectWorkspace.Chat.ChildSessionDetail"
             x:DataType="vm:DesktopViewModel">
  <Border Classes="card" IsVisible="{Binding IsChildSessionVisible}">
    <Grid RowDefinitions="52,*">
      <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="28,8,30,8,*,Auto" Margin="10,0,14,0">
        <Button Classes="icon quiet" Width="28" Height="28" Padding="6" Click="BackToParent" ToolTip.Tip="Back to main session" VerticalAlignment="Center">
          <svg:Svg Path="/Assets/icons/chevron-right.svg" Css="{DynamicResource IconSvgCss}" RenderTransformOrigin="50%,50%"><svg:Svg.RenderTransform><RotateTransform Angle="180" /></svg:Svg.RenderTransform></svg:Svg>
        </Button>
        <Border Grid.Column="2" Width="30" Height="30" CornerRadius="6" Background="{DynamicResource SurfaceAccentBrush}" VerticalAlignment="Center">
          <svg:Svg Width="15" Height="15" Path="/Assets/icons/agent.svg" Css="{DynamicResource IconSvgCss}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="4" Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="{Binding SelectedChildSession.Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding SelectedChildSession.AgentDisplayName}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
        </StackPanel>
        <Border Grid.Column="5" Padding="7,4" CornerRadius="5" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding SelectedChildSession.StateText}" Classes="mono" FontSize="9" />
        </Border>
      </Grid>
      </Border>
      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,28" Spacing="18" MaxWidth="760" HorizontalAlignment="Center">
          <Grid ColumnDefinitions="*,*,*,*" Margin="0,0,0,6">
            <StackPanel Spacing="4" Margin="0,0,12,0"><TextBlock Text="AGENT" Classes="eyebrow" /><TextBlock Text="{Binding SelectedChildSession.AgentId}" Classes="mono" FontSize="10" TextTrimming="CharacterEllipsis" /></StackPanel>
            <StackPanel Grid.Column="1" Spacing="4" Margin="12,0"><TextBlock Text="MODEL" Classes="eyebrow" /><TextBlock Text="{Binding SelectedChildSession.ModelId}" Classes="mono" FontSize="10" TextTrimming="CharacterEllipsis" /></StackPanel>
            <StackPanel Grid.Column="2" Spacing="4" Margin="12,0"><TextBlock Text="STATUS" Classes="eyebrow" /><TextBlock Text="{Binding SelectedChildSession.StateText}" FontSize="10" /></StackPanel>
            <StackPanel Grid.Column="3" Spacing="4" Margin="12,0,0,0"><TextBlock Text="CREATED" Classes="eyebrow" /><TextBlock Text="{Binding SelectedChildSession.RelativeActivity}" FontSize="10" /></StackPanel>
          </Grid>
          <Border Padding="14"
                  Margin="0,0,0,6"
                  CornerRadius="6"
                  Background="{DynamicResource WarningSurfaceBrush}"
                  BorderBrush="{DynamicResource WarningBorderBrush}"
                  BorderThickness="1"
                  IsVisible="{Binding HasChildPendingApproval}">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                <StackPanel Spacing="5">
                  <TextBlock Text="{Binding ChildPendingApproval.ActionText}" FontSize="12" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding ChildPendingApproval.OperationText}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                  <Border Margin="0,3,0,0"
                          Padding="10,8"
                          CornerRadius="5"
                          Background="{DynamicResource FieldBrush}"
                          BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="1"
                          IsVisible="{Binding ChildPendingApproval.HasDetail}">
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding ChildPendingApproval.DetailLabel}" Classes="eyebrow" />
                      <SelectableTextBlock Text="{Binding ChildPendingApproval.DetailText}" Classes="mono" FontSize="10" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Grid>
              <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                <Button Classes="compact primary" Content="Allow once" Click="ApproveOnce" />
                <Button Classes="compact" Content="Deny" Click="DenyApproval" />
              </StackPanel>
            </Grid>
          </Border>
          <ItemsControl ItemsSource="{Binding ChildSessionTimeline}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:ChildSessionTimelineItem">
                <Grid ColumnDefinitions="28,12,*" Margin="0,0,0,18">
                  <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource SurfaceAccentBrush}" VerticalAlignment="Top">
                    <svg:Svg Width="13" Height="13" Path="/Assets/icons/agent.svg" Css="{DynamicResource IconSvgCss}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="2" Spacing="6">
                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding State}" Classes="mono" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" /></Grid>
                    <SelectableTextBlock Text="{Binding Detail}" FontSize="12" LineHeight="19" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
