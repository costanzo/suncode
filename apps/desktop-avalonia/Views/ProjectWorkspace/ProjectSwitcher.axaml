<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:SunCode.Desktop.Models"
             xmlns:vm="using:SunCode.Desktop.ViewModels"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             x:Class="SunCode.Desktop.Views.ProjectWorkspace.ProjectSwitcher"
             x:DataType="vm:DesktopViewModel">
  <Button x:Name="ProjectSwitcherButton"
          Classes="project-switcher-trigger"
          MaxWidth="200"
          IsEnabled="{Binding CanOpenProjects}"
          AutomationProperties.Name="Switch project">
    <Grid ColumnDefinitions="14,6,*,6,12" VerticalAlignment="Center">
      <svg:Svg Grid.Column="0"
               Width="14"
               Height="14"
               Path="/Assets/icons/folder.svg"
               Css="{DynamicResource IconSvgCss}"
               IsHitTestVisible="False" />
      <TextBlock Grid.Column="2"
                 Text="{Binding ProjectTitle}"
                 FontSize="12"
                 FontWeight="SemiBold"
                 TextTrimming="CharacterEllipsis"
                 VerticalAlignment="Center" />
      <svg:Svg x:Name="ProjectSwitcherChevron"
               Grid.Column="4"
               Width="12"
               Height="12"
               Path="/Assets/icons/chevron-right.svg"
               Css="{DynamicResource IconSvgCss}"
               RenderTransformOrigin="50%,50%"
               IsHitTestVisible="False">
        <svg:Svg.RenderTransform>
          <RotateTransform Angle="90" />
        </svg:Svg.RenderTransform>
      </svg:Svg>
    </Grid>
    <Button.Flyout>
      <Flyout Placement="BottomEdgeAlignedLeft"
              ShowMode="Standard"
              FlyoutPresenterClasses="project-switcher-flyout"
              Opened="ProjectFlyoutOpened"
              Closed="ProjectFlyoutClosed">
        <Border Width="316" Padding="6">
          <Grid RowDefinitions="Auto,7,1,Auto,Auto">
            <Button Grid.Row="0"
                    Classes="project-switcher-menu-item"
                    Height="42"
                    Padding="8,5"
                    HorizontalContentAlignment="Stretch"
                    Click="OpenProject">
              <Grid ColumnDefinitions="18,8,*,8,14">
                <svg:Svg Grid.Column="0"
                         Width="14"
                         Height="14"
                         Path="/Assets/icons/folder.svg"
                         Css="{DynamicResource AccentSvgCss}"
                         VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="Open project" FontSize="11" FontWeight="SemiBold" />
                  <TextBlock Text="Choose a local folder…"
                             Classes="mono"
                             FontSize="10"
                             Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
                <svg:Svg Grid.Column="4"
                         Width="13"
                         Height="13"
                         Path="/Assets/icons/chevron-right.svg"
                         Css="{DynamicResource IconSvgCss}"
                         VerticalAlignment="Center" />
              </Grid>
            </Button>

            <Border Grid.Row="2" Margin="2,0" Background="{DynamicResource BorderBrush}" />
            <TextBlock Grid.Row="3" Classes="eyebrow" Text="RECENT PROJECTS" Margin="8,8,8,4" />

            <Grid Grid.Row="4">
              <ScrollViewer MaxHeight="240"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            IsVisible="{Binding HasProjects}">
                <ItemsControl ItemsSource="{Binding Projects}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="2" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ProjectItem">
                      <Button Classes="project-switcher-menu-item"
                              MinHeight="44"
                              Padding="8,5"
                              HorizontalContentAlignment="Stretch"
                              CommandParameter="{Binding}"
                              Click="OpenRecentProject">
                        <Grid ColumnDefinitions="18,8,*">
                          <svg:Svg Grid.Column="0"
                                   Width="14"
                                   Height="14"
                                   Path="/Assets/icons/sidebar-project.svg"
                                   Css="{DynamicResource IconSvgCss}"
                                   VerticalAlignment="Center" />
                          <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding CanonicalRoot}"
                                       Classes="mono"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <TextBlock Text="No recent projects"
                         Margin="8,8,8,10"
                         FontSize="11"
                         Foreground="{DynamicResource TextMutedBrush}"
                         IsVisible="{Binding !HasProjects}" />
            </Grid>
          </Grid>
        </Border>
      </Flyout>
    </Button.Flyout>
  </Button>
</UserControl>
