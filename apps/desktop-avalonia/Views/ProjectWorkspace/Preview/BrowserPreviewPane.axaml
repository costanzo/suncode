<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SunCode.Desktop.Views.ProjectWorkspace.Preview.BrowserPreviewPane">
  <Border Classes="card" ClipToBounds="True">
    <Grid RowDefinitions="40,*">
      <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="8" Margin="12,0,10,0">
        <TextBlock Grid.Column="0" Text="Browser preview" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock x:Name="StatusText" Grid.Column="1" Text="Stopped" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
        <TextBox x:Name="AddressInput" Grid.Column="2" Height="28" MinHeight="28" FontSize="11" VerticalAlignment="Center"
                 Text="http://127.0.0.1:5173/" PlaceholderText="Local preview URL" KeyDown="AddressKeyDown" />
        <Button Grid.Column="3" Classes="compact" Content="Open" Click="OpenClicked" ToolTip.Tip="Open local preview URL" />
        <Button Grid.Column="4" Classes="compact" Content="Reload" Click="ReloadClicked" ToolTip.Tip="Reload preview" />
        <Button Grid.Column="5" Classes="compact" Content="Close" Click="CloseClicked" ToolTip.Tip="Close browser preview" />
      </Grid>
      <Grid Grid.Row="1">
        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320" Spacing="8">
          <TextBlock Text="Preview is stopped" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="Start your development server, then open its local URL above to watch changes while you chat."
                     FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>
        <Decorator x:Name="BrowserHost" IsVisible="False" />
      </Grid>
    </Grid>
  </Border>
</UserControl>
