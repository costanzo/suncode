<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:SunCode.Desktop.Models"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             xmlns:vm="using:SunCode.Desktop.ViewModels"
             x:Class="SunCode.Desktop.Views.ProjectWorkspace.Review.AgentSidebar"
             x:DataType="vm:DesktopViewModel">
  <Border Classes="inspector-card">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="12,14" Spacing="12">
        <Border Padding="10" CornerRadius="6" Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" IsVisible="{Binding FullControlEnabled}">
          <Grid ColumnDefinitions="Auto,8,*,Auto">
            <svg:Svg Width="16" Height="16" Path="/Assets/icons/unlock.svg" Css="{DynamicResource IconSvgCss}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="Full Control enabled" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="3" Classes="compact danger" Content="Turn off" Click="DisableFullControl" Margin="8,0,0,0" />
          </Grid>
        </Border>
        <TextBlock Classes="section-label" Text="REVIEW" />
        <Border Padding="11" CornerRadius="6" Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" IsVisible="{Binding HasPendingApproval}">
          <StackPanel Spacing="11">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="3">
                <TextBlock Text="Approval required" Foreground="{DynamicResource WarningBrush}" FontSize="12" FontWeight="SemiBold" />
                <TextBlock Text="{Binding PendingApproval.ActionText}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
              </StackPanel>
              <Border Grid.Column="1" Background="{DynamicResource WarningBrush}" CornerRadius="5" Padding="7,4" VerticalAlignment="Top">
                <TextBlock Text="REVIEW" Classes="mono" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource WarningSurfaceBrush}" />
              </Border>
            </Grid>
            <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10" IsVisible="{Binding PendingApproval.HasDetail}">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding PendingApproval.DetailLabel}" Classes="eyebrow" />
                <ScrollViewer MaxHeight="148" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                  <SelectableTextBlock Text="{Binding PendingApproval.DetailText}" Classes="mono" FontSize="11" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                </ScrollViewer>
              </StackPanel>
            </Border>
            <StackPanel Spacing="4" IsVisible="{Binding PendingApproval.HasWorkingDirectory}">
              <TextBlock Text="Working directory" Classes="eyebrow" />
              <TextBlock Text="{Binding PendingApproval.WorkingDirectoryText}" Classes="mono" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <Expander Header="View raw request" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
              <Border Margin="0,7,0,0" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="9">
                <ScrollViewer MaxHeight="130" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                  <SelectableTextBlock Text="{Binding PendingApproval.Arguments}" Classes="mono" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                </ScrollViewer>
              </Border>
            </Expander>
            <Grid ColumnDefinitions="*,8,*">
              <Button Grid.Column="0" Classes="compact primary" Content="Allow once" Click="ApproveOnce" />
              <Button Grid.Column="2" Classes="compact danger" Content="Deny" Click="DenyApproval" />
            </Grid>
            <Button Classes="compact" Content="Allow for session" Foreground="{DynamicResource WarningBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" Click="ApproveForSession" />
          </StackPanel>
        </Border>
        <Border Padding="11" CornerRadius="6" Background="{DynamicResource AccentSurfaceBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" IsVisible="{Binding HasPendingQuestion}">
          <StackPanel Spacing="11">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="3">
                <TextBlock Text="Clarification needed" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" />
                <TextBlock Text="The agent is waiting for your answer" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
              </StackPanel>
              <Border Grid.Column="1" Background="{DynamicResource AccentBrush}" CornerRadius="5" Padding="7,4" VerticalAlignment="Top">
                <TextBlock Text="ANSWER" Classes="mono" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource SurfaceBrush}" />
              </Border>
            </Grid>
            <ItemsControl ItemsSource="{Binding PendingQuestion.Questions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:QuestionPromptItem">
                  <StackPanel Spacing="7">
                    <TextBlock Text="{Binding Header}" Classes="eyebrow" />
                    <TextBlock Text="{Binding Question}" FontSize="11" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Options}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:QuestionOptionItem">
                          <RadioButton Classes="compact" GroupName="QuestionOption" HorizontalContentAlignment="Left" Margin="0,0,0,4" Click="SelectQuestionOption" IsChecked="{Binding IsSelected, Mode=OneWay}" AutomationProperties.Name="{Binding Label}">
                            <StackPanel Spacing="2">
                              <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                              <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                          </RadioButton>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox Text="{Binding CustomAnswer, Mode=TwoWay}" PlaceholderText="Add a custom answer" IsVisible="{Binding AllowCustom}" TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid ColumnDefinitions="*,8,*">
              <Button Grid.Column="0" Classes="compact primary" Content="Submit answers" Click="ReplyQuestion" />
              <Button Grid.Column="2" Classes="compact danger" Content="Skip" Click="RejectQuestion" />
            </Grid>
          </StackPanel>
        </Border>
        <TextBlock Text="No pending approvals" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !HasPendingApproval}" />
        <Button Classes="raised" Padding="11" HorizontalContentAlignment="Stretch" Click="ViewTurnChanges" AutomationProperties.Name="View changes from this turn" IsVisible="{Binding HasChangedPaths}">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
            <svg:Svg Width="14" Height="14" Path="/Assets/icons/git-branch.svg" Css="{DynamicResource IconSvgCss}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Text="Turn changes" FontSize="12" FontWeight="SemiBold" />
              <TextBlock Text="{Binding TurnChangeSummary}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
            <svg:Svg Grid.Column="2" Width="12" Height="12" Path="/Assets/icons/chevron-right.svg" Css="{DynamicResource IconSvgCss}" VerticalAlignment="Center" />
          </Grid>
        </Button>
        <StackPanel Spacing="7">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="section-label" Text="TOUCHED FILES" />
            <TextBlock Grid.Column="1" Text="{Binding ChangedPaths.Count}" Classes="mono" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
          </Grid>
          <ItemsControl ItemsSource="{Binding ChangedPaths}" IsVisible="{Binding HasChangedPaths}">
            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Classes="mono" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding}" Margin="2,3" /></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="No files touched yet" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !HasChangedPaths}" />
        </StackPanel>
        <Border Classes="process-card" Classes.active="{Binding IsTurnActive}" Padding="11" CornerRadius="6" IsVisible="{Binding !HasFailedTurn}">
          <StackPanel Spacing="7">
            <Grid ColumnDefinitions="Auto,8,*,Auto">
              <Border Width="13" Height="13" CornerRadius="7" Background="{DynamicResource AccentSurfaceBrush}" IsVisible="{Binding IsTurnActive}" VerticalAlignment="Center">
                <Ellipse Width="7" Height="7" Classes="process-dot" Classes.active="{Binding IsTurnActive}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <Ellipse Width="7" Height="7" Classes="process-dot" VerticalAlignment="Center" IsVisible="{Binding !IsTurnActive}" />
              <TextBlock Grid.Column="2" Text="Runtime health" FontWeight="SemiBold" />
              <TextBlock Grid.Column="3" Text="Running" FontSize="10" Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding IsTurnActive}" />
              <TextBlock Grid.Column="3" Text="Ready" FontSize="10" Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding !IsTurnActive}" />
            </Grid>
            <TextBlock Text="{Binding RuntimeHealthSummary}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Text="{Binding SelectedModelName, StringFormat=Model  {0}}" Classes="mono" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding LatestActivityText}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MaxLines="2" IsVisible="{Binding IsTurnActive}" />
          </StackPanel>
        </Border>
        <Border Padding="11" CornerRadius="6" Background="{DynamicResource DangerSurfaceBrush}" BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1" IsVisible="{Binding HasFailedTurn}">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="TURN STOPPED" Classes="eyebrow" Foreground="{DynamicResource DangerBrush}" />
              <TextBlock Grid.Column="1" Text="FAILED" Classes="mono" FontSize="9" Foreground="{DynamicResource DangerBrush}" />
            </Grid>
            <TextBlock Text="The turn ended before completion. No further tool calls will run." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
            <Button Classes="compact primary" Content="Retry turn" Click="RetryTurn" />
          </StackPanel>
        </Border>
        <Expander Header="Current turn details" IsVisible="{Binding HasCurrentTodos}">
          <ItemsControl ItemsSource="{Binding CurrentTodos}" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="models:TodoItem"><Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2"><TextBlock Text="{Binding StatusMarker}" Classes="mono" /><TextBlock Grid.Column="1" Text="{Binding Content}" FontSize="10" TextWrapping="Wrap" Margin="6,0" /><TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" /></Grid></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </Expander>
        <ItemsControl ItemsSource="{Binding Checkpoints}" IsVisible="{Binding HasCheckpoints}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:CheckpointItem">
              <Border Classes="raised" Padding="9" Margin="0,0,0,6" CornerRadius="6">
                <StackPanel Spacing="5">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding FileCount}" FontSize="12" />
                    <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource WarningBrush}" />
                  </Grid>
                  <TextBlock Classes="mono" Text="{Binding PathsText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" MaxLines="2" />
                  <Button Classes="compact" Content="Undo" HorizontalAlignment="Left" Click="RestoreCheckpoint" IsEnabled="{Binding CanReview}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
