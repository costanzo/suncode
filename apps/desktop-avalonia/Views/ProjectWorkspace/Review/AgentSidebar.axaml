<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:SunCode.Desktop.Models"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             xmlns:vm="using:SunCode.Desktop.ViewModels"
             xmlns:controls="using:SunCode.Desktop.Controls"
             xmlns:review="using:SunCode.Desktop.Views.ProjectWorkspace.Review"
             x:Class="SunCode.Desktop.Views.ProjectWorkspace.Review.AgentSidebar"
             x:DataType="vm:DesktopViewModel">
  <UserControl.Styles>
    <Style Selector="svg|Svg.todo-marker">
      <Setter Property="Css" Value="{DynamicResource MutedIconSvgCss}" />
    </Style>
    <Style Selector="svg|Svg.todo-marker.completed">
      <Setter Property="Css" Value="{DynamicResource SuccessSvgCss}" />
    </Style>
    <Style Selector="svg|Svg.todo-marker.in-progress">
      <Setter Property="Css" Value="{DynamicResource AccentSvgCss}" />
    </Style>
    <Style Selector="svg|Svg.todo-marker.cancelled">
      <Setter Property="Css" Value="{DynamicResource DangerSvgCss}" />
    </Style>
    <Style Selector="Border.context-usage">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Border.context-usage.warning">
      <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
    </Style>
    <Style Selector="Border.context-usage.danger">
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
    </Style>
    <Style Selector="Border.context-usage.unknown">
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    </Style>
    <Style Selector="ToggleButton.context-usage-toggle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ToggleButton.context-usage-toggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.context-usage-toggle:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ProgressBar.context-usage">
      <Setter Property="Height" Value="4" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceActiveBrush}" />
    </Style>
    <Style Selector="ProgressBar.context-usage.warning">
      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
    </Style>
    <Style Selector="ProgressBar.context-usage.danger">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="TextBlock.context-usage-percent.warning">
      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
    </Style>
    <Style Selector="TextBlock.context-usage-percent.danger">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
    <!-- Turn change rows highlight only the path on hover, without a row fill. -->
    <Style Selector="Button.turn-change-row">
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="Padding" Value="0,3"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.turn-change-row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    </Style>
    <Style Selector="TextBlock.turn-change-path">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.turn-change-row:pointerover TextBlock.turn-change-path">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style Selector="ContentPresenter:nth-last-child(1) > Button.turn-change-row">
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.failure-summary">
      <Setter Property="Padding" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.failure-summary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
    </Style>
    <Style Selector="Button.failure-summary:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.failure-summary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceActiveBrush}" />
    </Style>
  </UserControl.Styles>
  <Border Classes="inspector-card">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="12,14" Spacing="12">
        <Grid ColumnDefinitions="*,Auto" MinHeight="24" Margin="0,0,0, -2">
          <TextBlock x:Name="ReviewHeading" Focusable="True" Text="{Binding ReviewHeadingText}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
          <controls:SCStatusDot Grid.Column="1" Status="{Binding ReviewStatusState}" ToolTip.Tip="{Binding ReviewStatusText}" />
        </Grid>
        <Border Classes="context-usage"
                Classes.warning="{Binding ContextUsage.IsWarning}"
                Classes.danger="{Binding ContextUsage.IsDanger}"
                Classes.unknown="{Binding ContextUsage.IsUnknown}"
                IsVisible="{Binding HasSelectedSession}"
                Padding="10,9,10,10">
          <StackPanel Spacing="7">
            <ToggleButton Classes="context-usage-toggle"
                          IsChecked="{Binding ContextUsage.Expanded, Mode=TwoWay}"
                          AutomationProperties.Name="{DynamicResource LocContextWindow}"
                          AutomationProperties.HelpText="{DynamicResource LocContextWindowUsage}">
              <Grid ColumnDefinitions="*,Auto,14" ColumnSpacing="8">
                <StackPanel Spacing="3">
                  <TextBlock Text="{DynamicResource LocContextWindow}" Classes="mono" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" />
                  <TextBlock Text="{Binding ContextUsage.Text}" Classes="mono" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding ContextUsage.PercentText}" Classes="mono context-usage-percent" Classes.warning="{Binding ContextUsage.IsWarning}" Classes.danger="{Binding ContextUsage.IsDanger}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                <svg:Svg Grid.Column="2" Width="12" Height="12" Path="/Assets/icons/chevron-right.svg" Css="{DynamicResource IconSvgCss}" VerticalAlignment="Center" />
              </Grid>
            </ToggleButton>
            <ProgressBar Classes="context-usage"
                         Classes.warning="{Binding ContextUsage.IsWarning}"
                         Classes.danger="{Binding ContextUsage.IsDanger}"
                         Minimum="0"
                         Maximum="100"
                         Value="{Binding ContextUsage.Percent}"
                         AutomationProperties.Name="{DynamicResource LocContextWindowUsage}" />
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="4" IsVisible="{Binding ContextUsage.Expanded}">
              <TextBlock Text="{DynamicResource LocInput}" Classes="mono" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" />
              <TextBlock Grid.Column="1" Text="{Binding ContextUsage.InputTokenText}" Classes="mono" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Grid.Row="1" Text="{DynamicResource LocOutput}" Classes="mono" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ContextUsage.OutputTokenText}" Classes="mono" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Grid.Row="2" Text="{DynamicResource LocCached}" Classes="mono" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ContextUsage.CachedTokenText}" Classes="mono" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>
          </StackPanel>
        </Border>
        <Border Padding="16,30" MinHeight="150" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="6" IsVisible="{Binding IsReviewIdle}">
          <StackPanel Spacing="7" HorizontalAlignment="Center">
            <svg:Svg Width="22" Height="22" Path="/Assets/icons/activity.svg" Css="{DynamicResource IconSvgCss}" HorizontalAlignment="Center" />
            <TextBlock Text="{DynamicResource LocAgentIdle}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="{DynamicResource LocStartTurnHint}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" />
          </StackPanel>
        </Border>
        <Border Padding="10" CornerRadius="6" Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" IsVisible="{Binding FullControlEnabled}">
          <Grid ColumnDefinitions="Auto,8,*,Auto">
            <svg:Svg Width="16" Height="16" Path="/Assets/icons/unlock.svg" Css="{DynamicResource IconSvgCss}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{DynamicResource LocFullControlEnabled}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="3" Classes="compact danger" Content="{DynamicResource LocTurnOff}" Click="DisableFullControl" Margin="8,0,0,0" />
          </Grid>
        </Border>
        <Border Height="1" Margin="0,2" Background="{DynamicResource BorderBrush}" IsVisible="{Binding IsReviewWaiting}" />
        <TextBlock Classes="section-label" Text="{DynamicResource LocReviewQueue}" IsVisible="{Binding IsReviewWaiting}" />
        <Border x:Name="PendingApprovalCard" Focusable="True" AutomationProperties.Name="{DynamicResource LocApprovalRequired}" Padding="11" CornerRadius="6" Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" IsVisible="{Binding HasPendingApproval}">
          <StackPanel Spacing="11">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="3">
                <TextBlock Text="{DynamicResource LocApprovalRequired}" Foreground="{DynamicResource WarningBrush}" FontSize="12" FontWeight="SemiBold" />
                <TextBlock Text="{Binding PendingApproval.ActionText}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
              </StackPanel>
              <Border Grid.Column="1" Background="{DynamicResource WarningBrush}" CornerRadius="4" Padding="5,3" VerticalAlignment="Top">
                <TextBlock Text="{DynamicResource LocReviewCaps}" Classes="mono" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource WarningSurfaceBrush}" />
              </Border>
            </Grid>
            <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="7" IsVisible="{Binding PendingApproval.HasDetail}">
              <ScrollViewer MaxHeight="148" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <SelectableTextBlock Text="{Binding PendingApproval.DetailText}" Classes="mono" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
              </ScrollViewer>
            </Border>
            <StackPanel Spacing="4" IsVisible="{Binding PendingApproval.HasWorkingDirectory}">
              <TextBlock Text="{DynamicResource LocWorkingDirectory}" Classes="eyebrow" />
              <TextBlock Text="{Binding PendingApproval.WorkingDirectoryText}" Classes="mono" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <Grid ColumnDefinitions="*,5,*">
              <Button Grid.Column="0" Classes="compact primary" Content="{DynamicResource LocAllowOnce}" Click="ApproveOnce" HorizontalAlignment="Stretch" FontSize="9"/>
              <Button Grid.Column="2" Classes="compact danger" Content="{DynamicResource LocDeny}" Click="DenyApproval" HorizontalAlignment="Stretch" FontSize="9" />
            </Grid>
            <Button Classes="compact" Content="{DynamicResource LocAllowForSession}" Foreground="{DynamicResource WarningBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" Click="ApproveForSession" HorizontalAlignment="Stretch" FontSize="9"/>
          </StackPanel>
        </Border>
        <Border x:Name="PendingQuestionCard" Focusable="True" AutomationProperties.Name="{DynamicResource LocClarificationNeeded}" Padding="11" CornerRadius="6" Background="{DynamicResource AccentSurfaceBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" IsVisible="{Binding HasPendingQuestion}">
          <StackPanel Spacing="11">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="3">
                <TextBlock Text="{DynamicResource LocClarificationNeeded}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource LocWaitingForAnswer}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
              </StackPanel>
              <Button x:Name="ExpandQuestionButton" Grid.Column="1" Classes="sc-button icon-only quiet" Click="ExpandQuestion"
                      VerticalAlignment="Top" ToolTip.Tip="{DynamicResource LocExpandQuestions}" AutomationProperties.Name="{DynamicResource LocExpandQuestions}">
                <svg:Svg Width="15" Height="15" Path="/Assets/icons/expand.svg" Css="{DynamicResource IconSvgCss}" />
              </Button>
            </Grid>
            <review:QuestionFields DataContext="{Binding PendingQuestion}" />
            <Border Padding="12" CornerRadius="6" Background="{DynamicResource DangerSurfaceBrush}" BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1" IsVisible="{Binding PendingQuestion.HasError}">
              <TextBlock Text="{Binding PendingQuestion.ErrorText}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" AutomationProperties.LiveSetting="Assertive" />
            </Border>
            <Grid ColumnDefinitions="*,5,*">
              <Button Grid.Column="0" Classes="compact primary" Content="{DynamicResource LocSubmitAnswers}" IsEnabled="{Binding PendingQuestion.CanSubmit}" Click="ReplyQuestion" HorizontalAlignment="Stretch" FontSize="9" />
              <Button Grid.Column="2" Classes="compact danger" Content="{DynamicResource LocSkip}" IsEnabled="{Binding PendingQuestion.IsEditable}" Click="RejectQuestion" HorizontalAlignment="Stretch" FontSize="9" />
            </Grid>
            <TextBlock Text="{DynamicResource LocSubmittingAnswers}" FontSize="11" IsVisible="{Binding PendingQuestion.IsSubmitting}" />
            <TextBlock Text="{DynamicResource LocSkippingQuestions}" FontSize="11" IsVisible="{Binding PendingQuestion.IsSkipping}" />
          </StackPanel>
        </Border>
        <!-- Net file changes of the latest turn; rows open the turn diff drawer. -->
        <Border Classes="raised" CornerRadius="6" IsVisible="{Binding IsReviewChangesVisible}">
          <StackPanel>
            <Button Classes="quiet" MinHeight="40" Padding="10,6" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Click="ToggleTurnChanges" AutomationProperties.Name="{DynamicResource LocTurnChanges}">
              <WrapPanel ItemSpacing="10" LineSpacing="4">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                  <TextBlock Text="{DynamicResource LocChangesCaps}" Classes="mono" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  <TextBlock Text="{Binding TurnChangeFileCountText}" Classes="mono" FontSize="9" Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Classes="mono" FontSize="9" Foreground="{DynamicResource SuccessBrush}">
                    <Run Text="{Binding TurnChangeAddedCount}" /><Run Text=" "/><Run Text="{DynamicResource LocAdded}"/>
                  </TextBlock>
                  <TextBlock Classes="mono" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}">
                    <Run Text="{Binding TurnChangeEditedCount}" /><Run Text=" "/><Run Text="{DynamicResource LocEdited}"/>
                  </TextBlock>
                  <TextBlock Classes="mono" FontSize="9" Foreground="{DynamicResource DangerBrush}" IsVisible="{Binding HasTurnChangeDeletions}">
                    <Run Text="{Binding TurnChangeDeletedCount}" /><Run Text=" "/><Run Text="{DynamicResource LocDeleted}"/>
                  </TextBlock>
                  <TextBlock Text="{DynamicResource LocLiveCaps}" Classes="mono" FontSize="9" Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding IsReviewRunning}"/>
                </StackPanel>
              </WrapPanel>
            </Button>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="10,0,10,8" IsVisible="{Binding TurnChangesExpanded}">
              <ScrollViewer MaxHeight="164" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding TurnChanges}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:TurnChangeItem">
                      <Button Classes="turn-change-row" Click="OpenTurnChange" ToolTip.Tip="{Binding Path}" AutomationProperties.Name="{Binding Path}">
                        <Grid ColumnDefinitions="14,*,Auto" ColumnSpacing="6">
                          <TextBlock Text="{Binding StatusLetter}" Classes="mono" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource GitSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsAdded}" />
                          <TextBlock Text="{Binding StatusLetter}" Classes="mono" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsModified}" />
                          <TextBlock Text="{Binding StatusLetter}" Classes="mono" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource GitDangerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsDeleted}" />
                          <TextBlock Grid.Column="1" Text="{Binding Path}" Classes="mono turn-change-path" FontSize="9" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Classes="mono" FontSize="8" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center">
                            <Run Text="{Binding AdditionsText}" /> <Run Text=" " /> <Run Text="{Binding DeletionsText}" />
                          </TextBlock>
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>
          </StackPanel>
        </Border>
        <Border Classes="process-card" Padding="11" CornerRadius="6" IsVisible="{Binding IsReviewRunning}">
          <StackPanel Spacing="7">
            <Grid ColumnDefinitions="7,7,*,Auto">
              <Ellipse Width="7" Height="7" Classes="process-dot" Classes.active="{Binding IsTurnActive}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{DynamicResource LocAgentLoop}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="3" Text="{DynamicResource LocRunning}" FontSize="9" Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding IsTurnActive}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="3" Text="{DynamicResource LocReady}" FontSize="9" Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding !IsTurnActive}" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Text="{Binding LastTurnId, StringFormat=Turn  {0}}" Classes="mono" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding SelectedModelName, StringFormat=Model  {0}}" Classes="mono" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding LatestActivityText}" FontSize="9" Classes="mono" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" IsVisible="{Binding IsReviewRunning}" />
          </StackPanel>
        </Border>
        <Border Padding="11" CornerRadius="6" Background="{DynamicResource DangerSurfaceBrush}" BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1" IsVisible="{Binding HasFailedTurn}">
          <StackPanel Spacing="9">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{DynamicResource LocTurnStopped}" Classes="eyebrow" Foreground="{DynamicResource DangerBrush}" />
              <Border Grid.Column="1" Background="{DynamicResource DangerBrush}" CornerRadius="4" Padding="5,3">
                <TextBlock Text="{DynamicResource LocFailedCaps}" Classes="mono" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource DangerSurfaceBrush}" />
              </Border>
            </Grid>
            <Button x:Name="FailureSummaryButton" Classes="failure-summary" Click="InspectFailure"
                    IsEnabled="{Binding !ProviderTrace.IsRevealingFailure}"
                    AutomationProperties.Name="{DynamicResource LocViewRequestDetails}">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding ReviewFailure.Title}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ReviewFailure.ProviderModel}" IsVisible="{Binding ReviewFailure.HasProviderModel}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ReviewFailure.Summary}" Classes="mono" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ReviewFailure.Summary}" />
                <Grid ColumnDefinitions="*,12" ColumnSpacing="8">
                  <TextBlock Text="{DynamicResource LocViewRequestDetails}" FontSize="10" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" IsVisible="{Binding !ProviderTrace.IsRevealingFailure}" />
                  <TextBlock Text="{DynamicResource LocLoadingRequestDetails}" FontSize="10" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" IsVisible="{Binding ProviderTrace.IsRevealingFailure}" AutomationProperties.LiveSetting="Polite" />
                  <svg:Svg Grid.Column="1" Width="12" Height="12" Path="/Assets/icons/chevron-right.svg" Css="{DynamicResource DangerSvgCss}" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>
            </Button>
            <Border Height="1" Background="{DynamicResource DangerBorderBrush}" Opacity="0.72" />
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Text="{DynamicResource LocTurn}" Classes="eyebrow" />
              <TextBlock Grid.Column="1" Text="{Binding ReviewFailure.TurnId}" Classes="mono" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
            </Grid>
            <Button Classes="compact primary" Content="{DynamicResource LocRetryTurn}" Click="RetryTurn" HorizontalAlignment="Stretch"/>
          </StackPanel>
        </Border>
        <Border x:Name="TodoCard" Classes="process-card" Padding="11" CornerRadius="6" IsVisible="{Binding IsReviewTodosVisible}">
          <StackPanel Spacing="7">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock x:Name="TodoHeading" Text="{DynamicResource LocTodo}" Classes="mono" FontSize="9" FontWeight="Normal" LetterSpacing="0.54" Foreground="{DynamicResource TextMutedBrush}" />
              <TextBlock Grid.Column="1" Text="{Binding CurrentTodos.Count, StringFormat={}{0} items}" FontFamily="{DynamicResource SansFontFamily}" FontSize="8" Foreground="{DynamicResource TextMutedBrush}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding CurrentTodos}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="7" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:TodoItem">
                  <Grid Classes="todo-row" ColumnDefinitions="13,*" ColumnSpacing="6" MinHeight="16" Opacity="{Binding Opacity}" ToolTip.Tip="{Binding StatusText}" AutomationProperties.Name="{Binding Content}" AutomationProperties.HelpText="{Binding StatusText}">
                    <Grid Width="13" Height="16" VerticalAlignment="Center">
                      <svg:Svg Classes="todo-marker" Classes.completed="{Binding IsCompleted}" Classes.in-progress="{Binding IsInProgress}" Classes.cancelled="{Binding IsCancelled}"
                               Width="11" Height="11" Path="{Binding StatusIconPath}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <svg:Svg.RenderTransform>
                          <TranslateTransform Y="{DynamicResource TodoMarkerOffsetY}" />
                        </svg:Svg.RenderTransform>
                      </svg:Svg>
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{Binding Content}" FontFamily="{DynamicResource SansFontFamily}" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
