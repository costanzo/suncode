<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:SunCode.Desktop.Models"
             xmlns:vm="using:SunCode.Desktop.ViewModels"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             x:Class="SunCode.Desktop.Views.ProjectWorkspace.Review.GitViewer"
             x:DataType="vm:DesktopViewModel"
             Height="340"
             MinHeight="240">
  <UserControl.Styles>
    <Style Selector="ListBox.diff-lines ListBoxItem">
      <Setter Property="Height" Value="22" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBox.git-files">
      <Setter Property="Padding" Value="0,0,4,8" />
    </Style>
    <Style Selector="ListBox.git-files ListBoxItem:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource AccentSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <Border Classes="card" BorderThickness="0" ClipToBounds="True">
      <Grid RowDefinitions="36,1,*">
      <Grid Grid.Row="0" Margin="12,0,8,0" ColumnDefinitions="Auto,8,Auto,8,Auto,8,Auto,*,Auto,8,26,8,26,8,26">
        <svg:Svg Grid.Column="0" Width="16" Height="16" Path="/Assets/icons/git-branch.svg" Css="{DynamicResource AccentSvgCss}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{Binding GitBranch}" Classes="mono" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" MaxWidth="190" TextTrimming="CharacterEllipsis" />
        <Border Grid.Column="4" Width="1" Height="18" Background="{DynamicResource BorderBrush}" />
        <Border Grid.Column="6" Height="28" Padding="1" CornerRadius="6" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
          <StackPanel Orientation="Horizontal">
            <ToggleButton Classes="scope" Content="All" IsChecked="{Binding ScopeAll}" Click="GitScopeAll"
                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            <ToggleButton Classes="scope" Content="Staged" IsChecked="{Binding ScopeStaged}" Click="GitScopeStaged"
                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            <ToggleButton Classes="scope" Content="Unstaged" IsChecked="{Binding ScopeUnstaged}" Click="GitScopeUnstaged"
                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
          </StackPanel>
        </Border>
        <TextBox Grid.Column="8" Width="210" Height="28" MinHeight="28" Padding="10,3" PlaceholderText="Filter changed files" TextChanged="GitFilterChanged" />
        <Button Grid.Column="10" Classes="icon" Width="26" Height="26" MinHeight="26" Padding="6" Click="RefreshGit" ToolTip.Tip="Refresh Git status" AutomationProperties.Name="Refresh Git status">
          <svg:Svg Path="/Assets/icons/refresh.svg" Css="{DynamicResource IconSvgCss}" />
        </Button>
        <Button Grid.Column="12" Classes="icon" Width="26" Height="26" MinHeight="26" Padding="6" Click="CopyPatch" ToolTip.Tip="Copy patch" AutomationProperties.Name="Copy patch">
          <svg:Svg Path="/Assets/icons/copy.svg" Css="{DynamicResource IconSvgCss}" />
        </Button>
        <Button Grid.Column="14" Classes="icon" Width="26" Height="26" MinHeight="26" Padding="6" Click="CloseGit" ToolTip.Tip="Close source control" AutomationProperties.Name="Close source control">
          <svg:Svg Path="/Assets/icons/close.svg" Css="{DynamicResource IconSvgCss}" />
        </Button>
      </Grid>
      <Border Grid.Row="1" Background="{DynamicResource BorderBrush}" />
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="{Binding GitFileListWidth}" />
          <ColumnDefinition Width="1" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Background="{DynamicResource SidebarBrush}" RowDefinitions="30,*">
          <Grid Grid.Row="0" Margin="12,0,10,0" ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding GitFileCountText}" Classes="eyebrow" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="LIMITED" Classes="mono" FontSize="11" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" IsVisible="{Binding GitStatusTruncated}" />
          </Grid>
          <ListBox Grid.Row="1" Classes="git-files" ItemsSource="{Binding FilteredGitFiles}" SelectedItem="{Binding SelectedGitFile}" SelectionChanged="GitFileSelected" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="models:GitFileItem">
                <Grid Height="28" ColumnDefinitions="18,8,*,Auto" Margin="0,0,4,0">
                  <Grid>
                    <TextBlock Text="{Binding StatusLetter}" Classes="mono" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsSuccess}" />
                    <TextBlock Text="{Binding StatusLetter}" Classes="mono" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsDanger}" />
                    <TextBlock Text="{Binding StatusLetter}" Classes="mono" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsWarning}" />
                  </Grid>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Path}" Classes="mono" FontSize="11" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding OldPath, StringFormat=from {0}}" Classes="mono" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding HasOldPath}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Column="3" Text="{Binding Summary}" Classes="mono" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
        <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" />
        <Grid Grid.Column="2" Background="{DynamicResource WorkspaceBrush}" RowDefinitions="30,1,*">
          <Grid Grid.Row="0" Margin="10,0" ColumnDefinitions="*,Auto,10,Auto">
            <TextBlock Text="{Binding SelectedGitPath}" Classes="mono" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Text="{Binding GitDiffAdditions, StringFormat=+{0}}" Classes="mono" FontSize="11" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" IsVisible="{Binding ShowGitDiffStats}" />
            <TextBlock Grid.Column="3" Text="{Binding GitDiffDeletions, StringFormat=-{0}}" Classes="mono" FontSize="11" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" IsVisible="{Binding ShowGitDiffStats}" />
          </Grid>
          <Border Grid.Row="1" Background="{DynamicResource BorderBrush}" />
          <Grid Grid.Row="2">
            <ListBox ItemsSource="{Binding DiffLines}" Classes="mono diff-lines" FontSize="11" Background="Transparent" BorderThickness="0" Padding="0" IsVisible="{Binding HasGitDiffLines}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:DiffLineItem">
                  <Grid ColumnDefinitions="34,34,1,*">
                    <Border Grid.ColumnSpan="4" Background="{DynamicResource SuccessSurfaceBrush}" IsVisible="{Binding IsAddition}" />
                    <Border Grid.ColumnSpan="4" Background="{DynamicResource DangerSurfaceBrush}" IsVisible="{Binding IsDeletion}" />
                    <Border Grid.ColumnSpan="4" Background="{DynamicResource AccentSurfaceBrush}" IsVisible="{Binding IsHunk}" />
                    <TextBlock Text="{Binding OldLine}" Classes="mono" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1" Text="{Binding NewLine}" Classes="mono" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Border Grid.Column="2" Background="{DynamicResource BorderBrush}" />
                    <TextBlock Grid.Column="3" Text="{Binding DisplayText}" Classes="mono" FontSize="11" Margin="10,0,16,0" VerticalAlignment="Center" TextWrapping="NoWrap" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Width="420" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" IsVisible="{Binding ShowGitDiffEmpty}">
              <ProgressBar Width="120" Height="3" IsIndeterminate="True" IsVisible="{Binding IsGitLoading}" />
              <TextBlock Text="{Binding GitEmptyMessage}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
            <Border Height="24" VerticalAlignment="Bottom" Background="{DynamicResource WarningSurfaceBrush}" IsVisible="{Binding GitDiffTruncated}">
              <TextBlock Text="Diff truncated at the review limit" FontSize="11" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Grid>
        </Grid>
      </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
