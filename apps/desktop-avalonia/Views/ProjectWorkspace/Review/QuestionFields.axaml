<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:SunCode.Desktop.Models"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             x:Class="SunCode.Desktop.Views.ProjectWorkspace.Review.QuestionFields"
             x:DataType="models:PendingQuestionItem">
  <UserControl.Resources>
    <DataTemplate x:Key="OptionContent" x:DataType="models:QuestionOptionItem">
      <StackPanel Spacing="2">
        <TextBlock Classes="option-label" Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Classes="option-description" Text="{Binding Description}" TextWrapping="Wrap" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="TextBlock.question-text">
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="TextBlock.option-label">
      <Setter Property="FontSize" Value="10" />
    </Style>
    <Style Selector="TextBlock.option-description">
      <Setter Property="FontSize" Value="9" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBox.question-custom">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="9,7" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="RadioButton.question-choice, CheckBox.question-choice">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="8,7" />
    </Style>
    <Style Selector="RadioButton.question-choice">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Padding="{TemplateBinding Padding}" Background="Transparent">
            <Grid ColumnDefinitions="16,*" ColumnSpacing="12">
              <Border x:Name="ChoiceIndicator" Width="16" Height="16" Margin="0,1,0,0" VerticalAlignment="Top"
                      CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderStrongBrush}">
                <Ellipse x:Name="SelectedDot" Width="8" Height="8" Fill="{DynamicResource AccentBrush}" IsVisible="False" />
              </Border>
              <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="CheckBox.question-choice">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Padding="{TemplateBinding Padding}" Background="Transparent">
            <Grid ColumnDefinitions="16,*" ColumnSpacing="12">
              <Border x:Name="ChoiceIndicator" Width="16" Height="16" Margin="0,1,0,0" VerticalAlignment="Top"
                      CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource BorderStrongBrush}">
                <svg:Svg x:Name="SelectedCheck" Width="12" Height="12" Path="/Assets/icons/check.svg" Css="{DynamicResource AccentInkSvgCss}" IsVisible="False" />
              </Border>
              <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.question-choice:checked /template/ Ellipse#SelectedDot, CheckBox.question-choice:checked /template/ svg|Svg#SelectedCheck">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="RadioButton.question-choice:checked /template/ Border#ChoiceIndicator, CheckBox.question-choice:checked /template/ Border#ChoiceIndicator">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="CheckBox.question-choice:checked /template/ Border#ChoiceIndicator">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="RadioButton.question-choice:disabled, CheckBox.question-choice:disabled">
      <Setter Property="Opacity" Value="0.65" />
    </Style>
    <Style Selector=":is(UserControl).expanded TextBlock.question-text">
      <Setter Property="FontSize" Value="{DynamicResource QuestionWindowTextSize}" />
    </Style>
    <Style Selector=":is(UserControl).expanded TextBlock.option-label, :is(UserControl).expanded TextBlock.option-description">
      <Setter Property="FontSize" Value="{DynamicResource QuestionWindowOptionSize}" />
    </Style>
    <Style Selector=":is(UserControl).expanded TextBox.question-custom">
      <Setter Property="FontSize" Value="{DynamicResource QuestionWindowOptionSize}" />
      <Setter Property="MinHeight" Value="80" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector=":is(UserControl).expanded Border.question-option">
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="Border.question-option">
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector=":is(UserControl).expanded RadioButton.question-choice, :is(UserControl).expanded CheckBox.question-choice">
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Border.question-option:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="Border.question-option:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
  </UserControl.Styles>
  <ItemsControl ItemsSource="{Binding Questions}" IsEnabled="{Binding IsEditable}">
    <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="models:QuestionPromptItem">
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,20" Margin="0,0,0,24">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding NumberedHeader}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
            <TextBlock Classes="question-text" Text="{Binding Question}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{DynamicResource LocChooseOneAnswer}" IsVisible="{Binding !Multiple}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Text="{DynamicResource LocChooseAllAnswers}" IsVisible="{Binding Multiple}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
            <ItemsControl ItemsSource="{Binding Options}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:QuestionOptionItem">
                  <Border Classes="question-option" Classes.selected="{Binding IsSelected}" Margin="0,0,0,4">
                    <Grid>
                      <RadioButton Classes="question-choice" IsVisible="{Binding !Multiple}" GroupName="{Binding GroupName}"
                                   IsChecked="{Binding IsSingleSelected, Mode=TwoWay}" Content="{Binding}"
                                   ContentTemplate="{StaticResource OptionContent}" AutomationProperties.Name="{Binding Label}" />
                      <CheckBox Classes="question-choice" IsVisible="{Binding Multiple}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                Content="{Binding}" ContentTemplate="{StaticResource OptionContent}" AutomationProperties.Name="{Binding Label}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBox Classes="question-custom" Text="{Binding CustomAnswer, Mode=TwoWay}"
                     PlaceholderText="{DynamicResource LocWriteOwnAnswer}" AutomationProperties.Name="{Binding Header}"
                     IsVisible="{Binding AllowCustom}" AcceptsReturn="True" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
