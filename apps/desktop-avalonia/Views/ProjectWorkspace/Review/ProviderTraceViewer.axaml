<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:SunCode.Desktop.Models"
             xmlns:vm="using:SunCode.Desktop.ViewModels"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             x:Class="SunCode.Desktop.Views.ProjectWorkspace.Review.ProviderTraceViewer"
             x:DataType="vm:DesktopViewModel"
             Height="440"
             MinHeight="300">
  <UserControl.Styles>
    <Style Selector="TreeView.trace-tree">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,2" />
    </Style>
    <Style Selector="TreeView.trace-tree TreeViewItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
    </Style>
    <Style Selector="TreeView.trace-tree TreeViewItem /template/ Border#PART_LayoutRoot">
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="TreeView.trace-tree TreeViewItem:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource AccentSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.trace-metric">
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
      <Setter Property="Padding" Value="12,7" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <Border Classes="card" BorderThickness="0" ClipToBounds="True">
      <Grid RowDefinitions="38,1,*">
        <Grid Grid.Row="0" Margin="12,0,8,0" ColumnDefinitions="Auto,8,Auto,8,Auto,8,*,Auto,8,26,8,26,8,26">
          <svg:Svg Grid.Column="0" Width="16" Height="16" Path="/Assets/icons/activity.svg" Css="{DynamicResource AccentSvgCss}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="Provider trace" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Border Grid.Column="4" Width="1" Height="18" Background="{DynamicResource BorderBrush}" />
          <TextBlock Grid.Column="6" Text="{Binding ProviderTraceSummary}" Classes="mono" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <TextBox Grid.Column="7" Width="240" Height="28" MinHeight="28" Padding="10,3" PlaceholderText="Filter turns, calls, models, or tools" TextChanged="TraceFilterChanged" />
          <Button Grid.Column="9" Classes="icon" Width="26" Height="26" MinHeight="26" Padding="6" Click="RefreshTrace" ToolTip.Tip="Refresh session trace" AutomationProperties.Name="Refresh session trace">
            <svg:Svg Path="/Assets/icons/refresh.svg" Css="{DynamicResource IconSvgCss}" />
          </Button>
          <Button Grid.Column="11" Classes="icon" Width="26" Height="26" MinHeight="26" Padding="6" Click="CopyTrace" IsEnabled="{Binding HasSelectedProviderTrace}" ToolTip.Tip="Copy selected call details" AutomationProperties.Name="Copy selected provider call details">
            <svg:Svg Path="/Assets/icons/copy.svg" Css="{DynamicResource IconSvgCss}" />
          </Button>
          <Button Grid.Column="13" Classes="icon" Width="26" Height="26" MinHeight="26" Padding="6" Click="CloseTrace" ToolTip.Tip="Close session trace" AutomationProperties.Name="Close provider trace">
            <svg:Svg Path="/Assets/icons/close.svg" Css="{DynamicResource IconSvgCss}" />
          </Button>
        </Grid>
        <Border Grid.Row="1" Background="{DynamicResource BorderBrush}" />

        <Grid Grid.Row="2" ColumnDefinitions="230,1,*">
          <Grid Grid.Column="0" Background="{DynamicResource SidebarBrush}" RowDefinitions="32,1,*">
            <Grid Grid.Row="0" Margin="12,0,10,0" ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding ProviderTraceCountText}" Classes="eyebrow" VerticalAlignment="Center" />
              <ProgressBar Grid.Column="1" Width="88" Height="3" IsIndeterminate="True" IsVisible="{Binding IsProviderTraceLoading}" VerticalAlignment="Center" />
            </Grid>
            <Border Grid.Row="1" Background="{DynamicResource BorderBrush}" />
            <Grid Grid.Row="2">
              <TreeView x:Name="TraceTree" Classes="trace-tree" ItemsSource="{Binding FilteredProviderTraceTurns}" SelectionChanged="TraceSelected">
                <TreeView.DataTemplates>
                  <TreeDataTemplate DataType="models:ProviderTraceTurnItem" ItemsSource="{Binding Calls}">
                    <Grid Height="54" ColumnDefinitions="12,*,Auto" Margin="2,0,8,0">
                      <Grid Grid.Column="0">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" IsVisible="{Binding IsRunning}" />
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" IsVisible="{Binding IsCompleted}" />
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource DangerBrush}" IsVisible="{Binding IsFailed}" />
                      </Grid>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                          <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding IdentifierText}" Classes="mono" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                          <TextBlock Text="{Binding StateText}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding ModelId}" Classes="mono" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding DurationText}" Classes="mono" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding MetricsText}" Classes="mono" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" />
                      </StackPanel>
                    </Grid>
                  </TreeDataTemplate>
                  <TreeDataTemplate DataType="models:ProviderTraceItem" ItemsSource="{Binding Contents}">
                    <Grid Height="48" ColumnDefinitions="10,*,Auto" Margin="2,0,8,0">
                      <Border Grid.Column="0" Width="1" Height="28" Background="{DynamicResource BorderStrongBrush}" HorizontalAlignment="Center" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                          <TextBlock Text="{Binding CallText}" FontSize="11" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding IdentifierText}" Classes="mono" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Title}" Classes="mono" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding StatusText}" Classes="mono" FontSize="10" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" IsVisible="{Binding IsRunning}" />
                        <TextBlock Text="{Binding StatusText}" Classes="mono" FontSize="10" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Right" IsVisible="{Binding IsCompleted}" />
                        <TextBlock Text="{Binding StatusText}" Classes="mono" FontSize="10" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Right" IsVisible="{Binding IsFailed}" />
                        <TextBlock Text="{Binding TokenSummary}" Classes="mono" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" />
                      </StackPanel>
                    </Grid>
                  </TreeDataTemplate>
                  <DataTemplate DataType="models:ProviderTraceContentItem">
                    <Grid Height="40" ColumnDefinitions="10,72,*,Auto" Margin="2,0,8,0">
                      <Border Grid.Column="0" Width="1" Height="24" Background="{DynamicResource BorderBrush}" HorizontalAlignment="Center" />
                      <Grid Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="USER" Classes="mono" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding IsUser}" />
                        <TextBlock Text="ASSISTANT" Classes="mono" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding IsAssistant}" />
                        <TextBlock Text="THINKING" Classes="mono" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" IsVisible="{Binding IsThinking}" />
                        <TextBlock Text="TOOL USE" Classes="mono" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding IsTool}" />
                        <TextBlock Text="CONTEXT" Classes="mono" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding IsContext}" />
                      </Grid>
                      <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="10" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Summary}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" IsVisible="{Binding !IsPlaceholder}" />
                      </StackPanel>
                      <TextBlock Grid.Column="3" Text="{Binding TimeText}" Classes="mono" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </TreeView.DataTemplates>
              </TreeView>
              <StackPanel Width="300" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" IsVisible="{Binding !HasFilteredProviderTraces}">
                <TextBlock Text="{Binding ProviderTraceEmptyMessage}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />
              </StackPanel>
            </Grid>
          </Grid>

          <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" />

          <Grid Grid.Column="2" Background="{DynamicResource WorkspaceBrush}" RowDefinitions="34,1,58,1,*">
            <Grid Grid.Row="0" Margin="12,0" ColumnDefinitions="*,Auto,12,Auto">
              <TextBlock Text="{Binding SelectedProviderTraceTitle}" Classes="mono" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" Text="{Binding SelectedProviderTraceDetails.TimingText}" Classes="mono" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="3" Text="{Binding SelectedProviderTraceDetails.WireModel}" Classes="mono" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>
            <Border Grid.Row="1" Background="{DynamicResource BorderBrush}" />

            <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*,*,*" IsVisible="{Binding HasSelectedProviderTrace}">
              <Border Classes="trace-metric"><StackPanel><TextBlock Text="INPUT" Classes="eyebrow" /><TextBlock Text="{Binding SelectedProviderTraceDetails.InputTokenText}" Classes="mono" FontSize="14" FontWeight="SemiBold" /></StackPanel></Border>
              <Border Grid.Column="1" Classes="trace-metric"><StackPanel><TextBlock Text="OUTPUT" Classes="eyebrow" /><TextBlock Text="{Binding SelectedProviderTraceDetails.OutputTokenText}" Classes="mono" FontSize="14" FontWeight="SemiBold" /></StackPanel></Border>
              <Border Grid.Column="2" Classes="trace-metric"><StackPanel><TextBlock Text="CACHE READ" Classes="eyebrow" /><TextBlock Text="{Binding SelectedProviderTraceDetails.CacheReadTokenText}" Classes="mono" FontSize="14" FontWeight="SemiBold" /></StackPanel></Border>
              <Border Grid.Column="3" Classes="trace-metric"><StackPanel><TextBlock Text="CACHE WRITE" Classes="eyebrow" /><TextBlock Text="{Binding SelectedProviderTraceDetails.CacheWriteTokenText}" Classes="mono" FontSize="14" FontWeight="SemiBold" /></StackPanel></Border>
              <Border Grid.Column="4" Classes="trace-metric"><StackPanel><TextBlock Text="CACHE HIT" Classes="eyebrow" /><TextBlock Text="{Binding SelectedProviderTraceDetails.CacheHitRateText}" Classes="mono" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" /></StackPanel></Border>
              <Border Grid.Column="5" Padding="12,7"><StackPanel><TextBlock Text="DURATION" Classes="eyebrow" /><TextBlock Text="{Binding SelectedProviderTraceDetails.DurationText}" Classes="mono" FontSize="14" FontWeight="SemiBold" /></StackPanel></Border>
            </Grid>
            <Border Grid.Row="3" Background="{DynamicResource BorderBrush}" />

            <Grid Grid.Row="4">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsVisible="{Binding ShowSelectedProviderTraceOverview}">
                <StackPanel Margin="14,12,16,18" Spacing="16">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                      <TextBlock Text="{Binding SelectedProviderTraceDetails.TurnText}" Classes="mono" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                      <TextBlock Text="{Binding SelectedProviderTraceDetails.ExchangeId}" Classes="mono" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding SelectedProviderTraceDetails.ProviderRequestId, StringFormat={}request  {0}}" Classes="mono" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" IsVisible="{Binding SelectedProviderTraceDetails.HasProviderRequestId}" />
                      <TextBlock Text="{Binding SelectedProviderTraceDetails.ProviderResponseId, StringFormat={}response {0}}" Classes="mono" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" IsVisible="{Binding SelectedProviderTraceDetails.HasProviderResponseId}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                      <TextBlock Text="{Binding SelectedProviderTraceDetails.StatusText}" Classes="mono" FontSize="11" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" IsVisible="{Binding SelectedProviderTraceDetails.IsRunning}" />
                      <TextBlock Text="{Binding SelectedProviderTraceDetails.StatusText}" Classes="mono" FontSize="11" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Right" IsVisible="{Binding SelectedProviderTraceDetails.IsCompleted}" />
                      <TextBlock Text="{Binding SelectedProviderTraceDetails.StatusText}" Classes="mono" FontSize="11" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Right" IsVisible="{Binding SelectedProviderTraceDetails.IsFailed}" />
                      <TextBlock Text="{Binding SelectedProviderTraceDetails.TotalTokenText, StringFormat={}{0} total}" Classes="mono" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                  </Grid>

                  <StackPanel Spacing="6" IsVisible="{Binding SelectedProviderTraceDetails.HasMessages}">
                    <TextBlock Text="Messages" FontSize="12" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding SelectedProviderTraceDetails.Messages}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ProviderTraceMessageItem">
                          <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="2,9">
                            <Grid ColumnDefinitions="76,*">
                              <StackPanel>
                                <TextBlock Text="{Binding RoleText}" Classes="mono" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding IsAssistant}" />
                                <TextBlock Text="{Binding RoleText}" Classes="mono" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding IsUser}" />
                                <TextBlock Text="{Binding RoleText}" Classes="mono" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" IsVisible="{Binding IsThinking}" />
                                <TextBlock Text="{Binding RoleText}" Classes="mono" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding IsTool}" />
                                <TextBlock Text="{Binding TimeText}" Classes="mono" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" />
                              </StackPanel>
                              <SelectableTextBlock Grid.Column="1" Text="{Binding Content}" FontSize="11" TextWrapping="Wrap" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                  <StackPanel Spacing="6" IsVisible="{Binding SelectedProviderTraceDetails.HasTools}">
                    <TextBlock Text="Tool Uses" FontSize="12" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding SelectedProviderTraceDetails.Tools}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ProviderTraceToolItem">
                          <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="2,9">
                            <StackPanel Spacing="7">
                              <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                  <TextBlock Text="{Binding Name}" Classes="mono" FontSize="11" FontWeight="SemiBold" />
                                  <TextBlock Text="{Binding ToolCallId}" Classes="mono" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                  <TextBlock Text="{Binding StateText}" Classes="mono" FontSize="10" Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding IsSucceeded}" />
                                  <TextBlock Text="{Binding StateText}" Classes="mono" FontSize="10" Foreground="{DynamicResource DangerBrush}" IsVisible="{Binding IsFailed}" />
                                  <TextBlock Text="{Binding StateText}" Classes="mono" FontSize="10" Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding IsActive}" />
                                  <TextBlock Text="{Binding TimeText}" Classes="mono" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                              </Grid>
                              <Grid ColumnDefinitions="*,12,*">
                                <StackPanel Spacing="4" IsVisible="{Binding HasRequest}">
                                  <TextBlock Text="REQUEST" Classes="eyebrow" />
                                  <SelectableTextBlock Text="{Binding Request}" Classes="mono" FontSize="10" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="4" IsVisible="{Binding HasResult}">
                                  <TextBlock Text="RESULT" Classes="eyebrow" />
                                  <SelectableTextBlock Text="{Binding Result}" Classes="mono" FontSize="10" TextWrapping="Wrap" />
                                </StackPanel>
                              </Grid>
                              <TextBlock Text="{Binding ErrorCode}" Classes="mono" FontSize="10" Foreground="{DynamicResource DangerBrush}" IsVisible="{Binding HasError}" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                  <StackPanel Spacing="6">
                    <TextBlock Text="Model Request" FontSize="12" FontWeight="SemiBold" />
                    <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                      <SelectableTextBlock Text="{Binding SelectedProviderTraceDetails.InputText}" Classes="mono" FontSize="10" TextWrapping="Wrap" />
                    </Border>
                  </StackPanel>

                  <StackPanel Spacing="6" IsVisible="{Binding SelectedProviderTraceDetails.HasOutput}">
                    <TextBlock Text="Model Response" FontSize="12" FontWeight="SemiBold" />
                    <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                      <SelectableTextBlock Text="{Binding SelectedProviderTraceDetails.OutputText}" Classes="mono" FontSize="10" TextWrapping="Wrap" />
                    </Border>
                  </StackPanel>

                  <StackPanel Spacing="6" IsVisible="{Binding SelectedProviderTraceDetails.HasError}">
                    <TextBlock Text="Provider Error" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" />
                    <Border Background="{DynamicResource DangerSurfaceBrush}" BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                      <SelectableTextBlock Text="{Binding SelectedProviderTraceDetails.ErrorText}" Classes="mono" FontSize="10" TextWrapping="Wrap" />
                    </Border>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>

              <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasSelectedProviderTraceContent}">
                <StackPanel Margin="14,12,16,18" Spacing="14">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding SelectedProviderTraceContent.KindText}" Classes="mono" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding SelectedProviderTraceContent.IsAssistant}" />
                      <TextBlock Text="{Binding SelectedProviderTraceContent.KindText}" Classes="mono" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding SelectedProviderTraceContent.IsUser}" />
                      <TextBlock Text="{Binding SelectedProviderTraceContent.KindText}" Classes="mono" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" IsVisible="{Binding SelectedProviderTraceContent.IsThinking}" />
                                <TextBlock Text="{Binding SelectedProviderTraceContent.KindText}" Classes="mono" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding SelectedProviderTraceContent.IsTool}" />
                                <TextBlock Text="{Binding SelectedProviderTraceContent.KindText}" Classes="mono" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding SelectedProviderTraceContent.IsContext}" />
                      <TextBlock Text="{Binding SelectedProviderTraceContent.Title}" FontSize="14" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding SelectedProviderTraceContent.TimeText}" Classes="mono" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Top" />
                  </Grid>

                  <StackPanel Spacing="6" IsVisible="{Binding SelectedProviderTraceContent.HasContent}">
                    <TextBlock Text="Content" FontSize="12" FontWeight="SemiBold" />
                    <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                      <SelectableTextBlock Text="{Binding SelectedProviderTraceContent.Content}" FontSize="11" TextWrapping="Wrap" />
                    </Border>
                  </StackPanel>

                  <StackPanel Spacing="6" IsVisible="{Binding SelectedProviderTraceContent.HasRequest}">
                    <TextBlock Text="Request" FontSize="12" FontWeight="SemiBold" />
                    <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                      <SelectableTextBlock Text="{Binding SelectedProviderTraceContent.Request}" Classes="mono" FontSize="10" TextWrapping="Wrap" />
                    </Border>
                  </StackPanel>

                  <StackPanel Spacing="6" IsVisible="{Binding SelectedProviderTraceContent.HasResult}">
                    <TextBlock Text="Result" FontSize="12" FontWeight="SemiBold" />
                    <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                      <SelectableTextBlock Text="{Binding SelectedProviderTraceContent.Result}" Classes="mono" FontSize="10" TextWrapping="Wrap" />
                    </Border>
                  </StackPanel>

                  <StackPanel Spacing="6" IsVisible="{Binding SelectedProviderTraceContent.HasError}">
                    <TextBlock Text="Error" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" />
                    <Border Background="{DynamicResource DangerSurfaceBrush}" BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                      <SelectableTextBlock Text="{Binding SelectedProviderTraceContent.ErrorCode}" Classes="mono" FontSize="10" TextWrapping="Wrap" />
                    </Border>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>

              <StackPanel Width="420" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" IsVisible="{Binding !HasSelectedProviderTrace}">
                <svg:Svg Width="22" Height="22" Path="/Assets/icons/activity.svg" Css="{DynamicResource IconSvgCss}" HorizontalAlignment="Center" IsVisible="{Binding !IsProviderTraceLoading}" />
                <ProgressBar Width="120" Height="3" IsIndeterminate="True" IsVisible="{Binding IsProviderTraceLoading}" />
                <TextBlock Text="{Binding ProviderTraceEmptyMessage}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />
              </StackPanel>
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
