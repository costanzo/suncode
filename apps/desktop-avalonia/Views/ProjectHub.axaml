<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:SunCode.Desktop.Models"
             xmlns:vm="using:SunCode.Desktop.ViewModels"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             x:Class="SunCode.Desktop.Views.ProjectHub"
             x:DataType="vm:DesktopViewModel">
  <Border Margin="16"
          Background="{DynamicResource CanvasBrush}"
          BorderBrush="{DynamicResource WindowChromeBorderBrush}"
          BorderThickness="0.5"
          CornerRadius="12"
          Padding="1.5">
    <Border Background="{DynamicResource CanvasBrush}"
            CornerRadius="11"
            ClipToBounds="True">
    <Grid RowDefinitions="32,62,*">
      <Grid Grid.Row="0"
            Background="{DynamicResource CanvasBrush}"
            ColumnDefinitions="Auto,*,Auto"
            ZIndex="110"
            PointerPressed="TitleBarPressed"
            PointerMoved="TitleBarMoved"
            PointerReleased="TitleBarReleased"
            DoubleTapped="TitleBarDoubleTapped">
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="5,0,0,0" VerticalAlignment="Center">
          <Button x:Name="HubCloseLight" Classes="titlebar" Width="18" Height="18" Padding="2" Click="CloseApplication" PointerEntered="TrafficLightEntered" PointerExited="TrafficLightExited" PointerPressed="TrafficLightPressed" PointerReleased="TrafficLightReleased" ToolTip.Tip="Close window">
            <svg:Svg Path="/Assets/traffic-lights/1-close-1-normal.svg" />
          </Button>
          <Button x:Name="HubMinimizeLight" Classes="titlebar" Width="18" Height="18" Padding="2" Click="MinimizeWindow" PointerEntered="TrafficLightEntered" PointerExited="TrafficLightExited" PointerPressed="TrafficLightPressed" PointerReleased="TrafficLightReleased" ToolTip.Tip="Minimize window">
            <svg:Svg Path="/Assets/traffic-lights/2-minimize-1-normal.svg" />
          </Button>
          <Button x:Name="HubMaximizeLight" Classes="titlebar" Width="18" Height="18" Padding="2" Click="ToggleHubMaximized" PointerEntered="TrafficLightEntered" PointerExited="TrafficLightExited" PointerPressed="TrafficLightPressed" PointerReleased="TrafficLightReleased" ToolTip.Tip="Maximize window">
            <svg:Svg Path="/Assets/traffic-lights/3-maximize-1-normal.svg" />
          </Button>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="Welcome to SunCode" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" 
                   Margin="12, 0, 0, 0" />
      </Grid>

      <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
        <Grid Margin="22,0" ColumnDefinitions="Auto,12,Auto,*,Auto,12,Auto">
          <Image Grid.Column="0" Width="30" Height="30" Source="/Assets/logo/suncode-logo-small-64.png" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="SunCode" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Grid.Column="4" Classes="compact" Content="Settings" Click="OpenSettings" VerticalAlignment="Center" />
          <Button Grid.Column="6" Classes="compact primary" Content="Open project" Click="OpenProject" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <Border Grid.Row="2" Margin="28" Classes="card" Padding="18">
        <Grid RowDefinitions="Auto,12,*">
          <TextBlock Grid.Row="0" Classes="section-label" Text="RECENT PROJECTS" Margin="14,0" />
          <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
            <Grid>
              <ItemsControl ItemsSource="{Binding Projects}" IsVisible="{Binding HasProjects}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:ProjectItem">
                    <Button Height="70" Margin="0,0,0,8" Padding="14,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="ProjectClicked">
                      <Grid ColumnDefinitions="34,12,*">
                        <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource AccentSurfaceBrush}" VerticalAlignment="Center">
                          <TextBlock Text="P" Foreground="{DynamicResource AccentBrush}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="mono" Text="{Binding CanonicalRoot}" FontSize="11" FontWeight="Normal" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel IsVisible="{Binding !HasProjects}" Margin="0,48,0,0" Spacing="10">
                <TextBlock Text="No projects yet" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Open a local folder to create your first project window." Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
    </Border>
  </Border>
</UserControl>
