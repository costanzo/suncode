<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:SunCode.Desktop.Models"
             xmlns:vm="using:SunCode.Desktop.ViewModels"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             x:Class="SunCode.Desktop.Views.ProviderTraceViewer"
             x:DataType="vm:DesktopViewModel"
             Height="360"
             MinHeight="260">
  <Border Classes="card" ClipToBounds="True" Padding="1">
    <Grid RowDefinitions="36,1,*">
      <Grid Grid.Row="0" Margin="12,0,8,0" ColumnDefinitions="Auto,8,Auto,8,Auto,8,*,Auto,8,26,8,26,8,26">
        <svg:Svg Grid.Column="0" Width="16" Height="16" Path="/Assets/icons/activity.svg" Css="{DynamicResource AccentSvgCss}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="Provider Trace" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Border Grid.Column="4" Width="1" Height="18" Background="{DynamicResource BorderBrush}" />
        <TextBlock Grid.Column="6" Text="{Binding ProviderTraceSummary}" Classes="mono" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <TextBox Grid.Column="7" Width="230" Height="28" MinHeight="28" Padding="10,3" PlaceholderText="Filter requests" TextChanged="TraceFilterChanged" />
        <Button Grid.Column="9" Classes="icon" Width="26" Height="26" MinHeight="26" Padding="6" Click="RefreshTrace" ToolTip.Tip="Refresh provider trace">
          <svg:Svg Path="/Assets/icons/refresh.svg" Css="{DynamicResource IconSvgCss}" />
        </Button>
        <Button Grid.Column="11" Classes="icon" Width="26" Height="26" MinHeight="26" Padding="6" Click="CopyTrace" ToolTip.Tip="Copy selected trace">
          <svg:Svg Path="/Assets/icons/copy.svg" Css="{DynamicResource IconSvgCss}" />
        </Button>
        <Button Grid.Column="13" Classes="icon" Width="26" Height="26" MinHeight="26" Padding="6" Click="CloseTrace" ToolTip.Tip="Close provider trace">
          <svg:Svg Path="/Assets/icons/close.svg" Css="{DynamicResource IconSvgCss}" />
        </Button>
      </Grid>
      <Border Grid.Row="1" Background="{DynamicResource BorderBrush}" />
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="320" />
          <ColumnDefinition Width="1" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{DynamicResource SidebarBrush}" RowDefinitions="30,*">
          <Grid Grid.Row="0" Margin="12,0,10,0" ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding ProviderTraceCountText}" Classes="eyebrow" VerticalAlignment="Center" />
            <ProgressBar Grid.Column="1" Width="90" Height="3" IsIndeterminate="True" IsVisible="{Binding IsProviderTraceLoading}" VerticalAlignment="Center" />
          </Grid>
          <ListBox Grid.Row="1" Classes="git-files" ItemsSource="{Binding FilteredProviderTraces}" SelectedItem="{Binding SelectedProviderTrace}" SelectionChanged="TraceSelected" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="models:ProviderTraceItem">
                <Grid MinHeight="58" RowDefinitions="Auto,4,Auto" ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" Classes="mono" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding TurnText}" Classes="mono" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding StatusText}" Classes="mono" FontSize="10" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" IsVisible="{Binding IsRunning}" />
                    <TextBlock Text="{Binding StatusText}" Classes="mono" FontSize="10" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Right" IsVisible="{Binding IsCompleted}" />
                    <TextBlock Text="{Binding StatusText}" Classes="mono" FontSize="10" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Right" IsVisible="{Binding IsFailed}" />
                    <TextBlock Text="{Binding TokenSummary}" Classes="mono" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                  </StackPanel>
                  <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding UsageSummary}" Classes="mono" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>

        <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" />

        <Grid Grid.Column="2" Background="{DynamicResource WorkspaceBrush}" RowDefinitions="30,1,*">
          <Grid Grid.Row="0" Margin="12,0" ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding SelectedProviderTraceTitle}" Classes="mono" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Text="{Binding SelectedProviderTrace.WireModel}" Classes="mono" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </Grid>
          <Border Grid.Row="1" Background="{DynamicResource BorderBrush}" />
          <Grid Grid.Row="2">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasSelectedProviderTrace}">
              <StackPanel Margin="14,12,16,16" Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="{Binding SelectedProviderTrace.TurnText}" Classes="mono" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding SelectedProviderTrace.UsageSummary}" Classes="mono" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding SelectedProviderTrace.StatusText}" Classes="mono" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                </Grid>

                <StackPanel Spacing="6">
                  <TextBlock Text="Input" Classes="eyebrow" />
                  <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                    <SelectableTextBlock Text="{Binding SelectedProviderTrace.InputText}" Classes="mono" FontSize="11" TextWrapping="Wrap" />
                  </Border>
                </StackPanel>

                <StackPanel Spacing="6" IsVisible="{Binding SelectedProviderTrace.HasOutput}">
                  <TextBlock Text="Output" Classes="eyebrow" />
                  <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                    <SelectableTextBlock Text="{Binding SelectedProviderTrace.OutputText}" Classes="mono" FontSize="11" TextWrapping="Wrap" />
                  </Border>
                </StackPanel>

                <StackPanel Spacing="6" IsVisible="{Binding SelectedProviderTrace.HasToolCalls}">
                  <TextBlock Text="Tool Calls" Classes="eyebrow" />
                  <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                    <SelectableTextBlock Text="{Binding SelectedProviderTrace.ToolCallsText}" Classes="mono" FontSize="11" TextWrapping="Wrap" />
                  </Border>
                </StackPanel>

                <StackPanel Spacing="6" IsVisible="{Binding SelectedProviderTrace.HasError}">
                  <TextBlock Text="Error" Classes="eyebrow" Foreground="{DynamicResource DangerBrush}" />
                  <Border Background="{DynamicResource DangerSurfaceBrush}" BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                    <SelectableTextBlock Text="{Binding SelectedProviderTrace.ErrorText}" Classes="mono" FontSize="11" TextWrapping="Wrap" />
                  </Border>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
            <StackPanel Width="420" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" IsVisible="{Binding !HasSelectedProviderTrace}">
              <ProgressBar Width="120" Height="3" IsIndeterminate="True" IsVisible="{Binding IsProviderTraceLoading}" />
              <TextBlock Text="{Binding ProviderTraceEmptyMessage}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</UserControl>
