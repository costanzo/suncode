<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:SunCode.Desktop.Controls"
        x:Class="SunCode.Desktop.Views.Settings.McpServerEditorWindow"
        Title="{DynamicResource LocAddMcpServer}"
        Width="620" Height="610"
        MinWidth="520" MinHeight="520"
        Background="{DynamicResource SurfaceBrush}"
        WindowDecorations="Full"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="StackPanel.mcp-field">
      <Setter Property="Spacing" Value="6" />
    </Style>
    <Style Selector="StackPanel.mcp-field TextBlock.label">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBox.mono-input">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
      <!-- Keep machine-data fields aligned with Settings' .mono inputs and
           the design-system field text size. -->
      <Setter Property="FontSize" Value="14" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto">
    <StackPanel Margin="28,24,28,18" Spacing="4">
      <TextBlock x:Name="HeadingText" Text="{DynamicResource LocAddMcpServer}" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="{DynamicResource LocMcpEditorHint}"
                 FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="28,0,28,20" ColumnDefinitions="*,*" ColumnSpacing="18" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="16">
        <StackPanel Classes="mcp-field">
          <TextBlock Classes="label" Text="{DynamicResource LocServerName}" />
          <TextBox x:Name="ServerNameInput" PlaceholderText="GitHub" />
        </StackPanel>
        <StackPanel Grid.Column="1" Classes="mcp-field">
          <TextBlock Classes="label" Text="{DynamicResource LocTransport}" />
          <controls:SCFlatComboBox x:Name="TransportSelector" HorizontalAlignment="Stretch" SelectionChanged="TransportChanged" />
        </StackPanel>

        <StackPanel x:Name="StdioCommandField" Grid.Row="1" Grid.ColumnSpan="2" Classes="mcp-field">
          <TextBlock Classes="label" Text="{DynamicResource LocExecutable}" />
          <TextBox x:Name="CommandInput" Classes="mono-input" PlaceholderText="uvx" />
        </StackPanel>
        <StackPanel x:Name="HttpUrlField" Grid.Row="1" Grid.ColumnSpan="2" Classes="mcp-field" IsVisible="False">
          <TextBlock Classes="label" Text="{DynamicResource LocServerUrlLabel}" />
          <TextBox x:Name="UrlInput" Classes="mono-input" PlaceholderText="https://mcp.example.com/v1" />
        </StackPanel>

        <StackPanel x:Name="WorkingDirectoryField" Grid.Row="2" Classes="mcp-field">
          <TextBlock Classes="label" Text="{DynamicResource LocWorkingDirectory}" />
          <controls:SCFlatComboBox x:Name="WorkingDirectorySelector" HorizontalAlignment="Stretch" />
        </StackPanel>
        <StackPanel x:Name="ArgumentsField" Grid.Row="2" Grid.Column="1" Classes="mcp-field">
          <TextBlock Classes="label" Text="{DynamicResource LocArguments}" />
          <TextBox x:Name="ArgumentsInput" Classes="mono-input" AcceptsReturn="True" Height="72"
                   TextWrapping="NoWrap" PlaceholderText="{DynamicResource LocOneArgumentPerLine}" />
        </StackPanel>

        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Classes="mcp-field">
          <TextBlock x:Name="SecretsLabel" Classes="label" Text="{DynamicResource LocEnvironment}" />
          <TextBox x:Name="SecretsInput" Classes="mono-input" AcceptsReturn="True" Height="74"
                   TextWrapping="NoWrap" PlaceholderText="{DynamicResource LocNameValue}" />
          <TextBlock x:Name="StoredKeysText" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                     TextWrapping="Wrap" IsVisible="False" />
          <TextBlock Text="{DynamicResource LocEnvironmentHint}"
                     FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="4" Classes="mcp-field">
          <TextBlock Classes="label" Text="{DynamicResource LocStartupTimeout}" />
          <TextBox x:Name="StartupTimeoutInput" Classes="mono-input" Text="30" />
        </StackPanel>
        <StackPanel Grid.Row="4" Grid.Column="1" Classes="mcp-field">
          <TextBlock Classes="label" Text="{DynamicResource LocRequestTimeout}" />
          <TextBox x:Name="RequestTimeoutInput" Classes="mono-input" Text="60" />
        </StackPanel>

        <Border Grid.Row="5" Grid.ColumnSpan="2" Padding="0,14,0,0"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
            <StackPanel Spacing="4">
              <TextBlock Text="{DynamicResource LocEnableServer}" FontSize="11" FontWeight="SemiBold" />
              <TextBlock x:Name="EnableHintText" Text="{DynamicResource LocLocalProcessHint}"
                         FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch x:Name="EnabledToggle" Grid.Column="1" Classes="sc-toggle-switch settings-switch"
                          IsChecked="True" OnContent="{DynamicResource LocOn}" OffContent="{DynamicResource LocOff}" />
          </Grid>
        </Border>
      </Grid>
    </ScrollViewer>

    <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
            Background="{DynamicResource SurfaceBrush}" Padding="28,14">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <TextBlock x:Name="ValidationText" FontSize="10" Foreground="{DynamicResource DangerBrush}"
                   VerticalAlignment="Center" TextWrapping="Wrap" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Classes="compact" Content="{DynamicResource LocCancel}" Click="CancelClicked" />
          <Button x:Name="SaveButton" Classes="compact primary sc-button" Content="{DynamicResource LocAddServer}" Click="SaveClicked" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
