<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:SunCode.Desktop.Models"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             x:Class="SunCode.Desktop.Views.Settings.Controls.ModelProviderSettingsControl"
             x:CompileBindings="False">
  <UserControl.Styles>
    <Style Selector="Button.provider-overview-row">
      <Setter Property="MinHeight" Value="58" />
      <Setter Property="Padding" Value="4,9" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.provider-overview-row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="Border.provider-model-chip">
      <Setter Property="Padding" Value="9,7" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="RadioButton.credential-option">
      <Setter Property="MinHeight" Value="62" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="OptionBorder"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <Grid ColumnDefinitions="14,*" ColumnSpacing="12">
              <Border Width="13" Height="13" CornerRadius="7"
                      BorderThickness="1" BorderBrush="{DynamicResource TextSecondaryBrush}"
                      VerticalAlignment="Center">
                <Ellipse x:Name="SelectedDot" Width="7" Height="7"
                         Fill="{DynamicResource AccentBrush}" IsVisible="False" />
              </Border>
              <ContentPresenter x:Name="PART_ContentPresenter" Grid.Column="1"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Center" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.credential-option:checked">
      <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    </Style>
    <Style Selector="RadioButton.credential-option:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    </Style>
    <Style Selector="RadioButton.credential-option:disabled">
      <Setter Property="Opacity" Value="0.62" />
    </Style>
    <Style Selector="RadioButton.credential-option:checked /template/ Ellipse#SelectedDot">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="RadioButton.credential-option:focus-visible /template/ Border#OptionBorder">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TextBlock.credential-option-description">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="16" />
    </Style>
    <Style Selector="TextBlock.credential-option-recommended">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.credential-input-label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.credential-mask">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
  </UserControl.Styles>

  <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <ScrollViewer x:Name="OverviewPanel"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
      <StackPanel Classes="settings-panel-content" HorizontalAlignment="Stretch">
        <StackPanel Classes="settings-panel-heading">
          <TextBlock Text="{DynamicResource LocModelProviders}" Classes="sc-text-title" />
          <TextBlock Text="{DynamicResource LocModelProvidersHint}" Classes="sc-text-hint" />
        </StackPanel>
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
          <ItemsControl x:Name="ProviderItemsControl"
                        HorizontalAlignment="Stretch">
            <ItemsControl.Styles>
              <Style Selector="ContentPresenter">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              </Style>
            </ItemsControl.Styles>
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel HorizontalAlignment="Stretch" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:ProviderItem">
                <Button Classes="provider-overview-row"
                        Tag="{Binding Id}"
                        Click="SelectProvider"
                        AutomationProperties.Name="{Binding DisplayName, StringFormat=Open {0} provider settings}">
                  <Grid ColumnDefinitions="8,*,Auto,16" ColumnSpacing="11">
                    <Ellipse Width="7"
                             Height="7"
                             Fill="{DynamicResource WarningBrush}"
                             VerticalAlignment="Center"
                             IsVisible="{Binding !Configured}" />
                    <Ellipse Width="7"
                             Height="7"
                             Fill="{DynamicResource SuccessBrush}"
                             VerticalAlignment="Center"
                             IsVisible="{Binding Configured}" />
                    <StackPanel Grid.Column="1" Spacing="4">
                      <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding ApiBase}"
                                 Classes="mono sc-text-hint"
                                 FontSize="10"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               Text="{Binding StatusText}"
                               Foreground="{DynamicResource WarningBrush}"
                               FontSize="10"
                               VerticalAlignment="Center"
                               IsVisible="{Binding !Configured}" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding StatusText}"
                               Foreground="{DynamicResource SuccessBrush}"
                               FontSize="10"
                               VerticalAlignment="Center"
                               IsVisible="{Binding Configured}" />
                    <svg:Svg Grid.Column="3"
                             Width="14"
                             Height="14"
                             Path="/Assets/icons/chevron-right.svg"
                             Css="{DynamicResource IconSvgCss}"
                             VerticalAlignment="Center" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <ScrollViewer x:Name="DetailPanel"
                  IsVisible="False"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
      <StackPanel Classes="settings-panel-content" HorizontalAlignment="Stretch">
        <StackPanel Classes="settings-panel-heading">
          <TextBlock x:Name="ProviderTitleText" Classes="sc-text-title" />
          <TextBlock x:Name="ProviderDescriptionText" Classes="sc-text-hint" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Classes="settings-panel-section">
          <TextBlock Text="{DynamicResource LocProviderUrl}" Classes="section-label" />
          <Grid Classes="settings-row" ColumnDefinitions="*,220">
            <StackPanel Classes="settings-row-copy">
              <TextBlock Text="{DynamicResource LocApiBaseUrl}" Classes="settings-row-title" />
              <TextBlock Text="{DynamicResource LocApiBaseUrlHint}" Classes="settings-row-hint" />
            </StackPanel>
            <TextBox x:Name="EndpointInput"
                     Grid.Column="1"
                     Classes="mono settings-provider-input"
                     PlaceholderText="https://api.example.com/v1"
                     TextChanged="EndpointInputChanged"
                     AutomationProperties.Name="{DynamicResource LocProviderUrlAutomation}" />
          </Grid>
        </StackPanel>
        <StackPanel Classes="settings-actions">
          <Button x:Name="SaveEndpointButton"
                  Classes="compact primary sc-button"
                  Content="{DynamicResource LocSaveUrl}"
                  Click="SaveEndpoint"
                  IsEnabled="False" />
          <Button x:Name="ResetEndpointButton"
                  Classes="compact sc-button"
                  Content="{DynamicResource LocResetDefault}"
                  Click="ResetEndpoint"
                  IsEnabled="False" />
          <TextBlock x:Name="EndpointStatusTextBlock"
                     Classes="sc-text-status"
                     VerticalAlignment="Center" />
        </StackPanel>

        <Border Classes="settings-divider" />

        <StackPanel x:Name="CredentialFields" Classes="settings-panel-section">
          <TextBlock Text="{DynamicResource LocCredentialSectionLabel}" Classes="eyebrow" FontSize="10" />
          <Grid ColumnDefinitions="7,*" ColumnSpacing="9">
            <Ellipse x:Name="CredentialWarningDot"
                     Width="7"
                     Height="7"
                     Margin="0,5,0,0"
                     Fill="{DynamicResource WarningBrush}"
                     VerticalAlignment="Top" />
            <Ellipse x:Name="CredentialSuccessDot"
                     Width="7"
                     Height="7"
                     Margin="0,5,0,0"
                     Fill="{DynamicResource SuccessBrush}"
                     VerticalAlignment="Top"
                     IsVisible="False" />
            <StackPanel Grid.Column="1" Spacing="5">
              <TextBlock x:Name="CredentialStatusTextBlock"
                         Text="{DynamicResource LocNoApiKeyConfigured}"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource TextBrush}"
                         MinHeight="16"
                         VerticalAlignment="Top"
                         TextWrapping="Wrap" />
              <Border x:Name="CredentialMaskBorder"
                      Classes="credential-mask"
                      IsVisible="False">
                <TextBlock x:Name="CredentialMaskTextBlock"
                           Classes="mono"
                           FontSize="11" />
              </Border>
              <TextBlock x:Name="CredentialLocationTextBlock" Classes="settings-row-hint" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
          <StackPanel Spacing="8">
            <TextBlock Text="{DynamicResource LocCredentialStorageLabel}" FontSize="12" FontWeight="SemiBold" />
            <StackPanel x:Name="CredentialModeInput" Spacing="8">
              <RadioButton x:Name="CredentialModeKeychainInput"
                           Classes="credential-option"
                           GroupName="CredentialStorageMode"
                           Tag="keychain"
                           IsCheckedChanged="CredentialModeChanged"
                           AutomationProperties.Name="System keychain storage">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="3">
                    <WrapPanel Orientation="Horizontal">
                      <TextBlock Text="{DynamicResource LocCredentialKeychainOption}" FontSize="12" FontWeight="SemiBold" />
                      <TextBlock Text="{DynamicResource LocRecommended}" Classes="credential-option-recommended" Margin="8,0,0,0" />
                    </WrapPanel>
                    <TextBlock x:Name="CredentialKeychainDescriptionTextBlock" Classes="credential-option-description" />
                  </StackPanel>
                  <svg:Svg Grid.Column="1"
                           Width="16"
                           Height="16"
                           Path="/Assets/icons/lock.svg"
                           Css="{DynamicResource IconSvgCss}"
                           VerticalAlignment="Center" />
                </Grid>
              </RadioButton>
              <RadioButton x:Name="CredentialModePlaintextInput"
                           Classes="credential-option"
                           GroupName="CredentialStorageMode"
                           Tag="plaintext"
                           IsCheckedChanged="CredentialModeChanged"
                           AutomationProperties.Name="Plaintext SQLite storage">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="3">
                    <TextBlock Text="{DynamicResource LocCredentialPlaintextOption}" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource LocCredentialPlaintextDescription}"
                               Classes="credential-option-description" />
                  </StackPanel>
                  <svg:Svg Grid.Column="1"
                           Width="16"
                           Height="16"
                           Path="/Assets/icons/file-config.svg"
                           Css="{DynamicResource IconSvgCss}"
                           VerticalAlignment="Center" />
                </Grid>
              </RadioButton>
            </StackPanel>
          </StackPanel>
          <Border x:Name="CredentialPlaintextWarning" Classes="settings-warning"
                  Background="{DynamicResource WarningSurfaceBrush}"
                  BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" IsVisible="False">
            <StackPanel Spacing="4">
              <TextBlock Text="{DynamicResource LocCredentialPlaintextWarningTitle}" Classes="credential-input-label" />
              <TextBlock Text="{DynamicResource LocCredentialPlaintextHint}" Classes="credential-option-description" />
            </StackPanel>
          </Border>
          <StackPanel Spacing="8">
            <TextBlock x:Name="CredentialInputLabelTextBlock" Classes="credential-input-label" />
            <TextBox x:Name="ApiKeyInput"
                     Classes="mono sc-secret-input settings-provider-input"
                     TextChanged="ApiKeyInputChanged" />
            <TextBlock x:Name="CredentialHelpTextBlock"
                       Classes="settings-row-hint"
                       TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
        <WrapPanel x:Name="CredentialActions" Orientation="Horizontal" Margin="0,16,0,0">
          <Button x:Name="SaveCredentialButton"
                  Classes="compact primary sc-button"
                  Content="{DynamicResource LocSaveKey}"
                  Click="SaveCredential"
                  Margin="0,0,10,0"
                  IsEnabled="False" />
          <Button x:Name="CancelCredentialButton"
                  Classes="compact sc-button"
                  Content="{DynamicResource LocCancel}"
                  Margin="0,0,10,0"
                  Click="CancelCredential" />
          <Button x:Name="RetryCredentialButton" Classes="compact sc-button"
                  Content="{DynamicResource LocCredentialRetry}" Click="RetryCredential"
                  Margin="0,0,10,0" />
          <Button x:Name="RemoveCredentialButton"
                  Classes="compact danger sc-button"
                  Content="{DynamicResource LocRemoveKey}"
                  Click="RemoveCredential" />
        </WrapPanel>

        <TextBlock x:Name="CredentialFeedbackTextBlock" Classes="settings-row-hint" TextWrapping="Wrap" IsVisible="False" />
        <Border Classes="settings-divider" />

        <StackPanel Classes="settings-panel-section">
          <TextBlock Text="{DynamicResource LocAvailableModels}" Classes="section-label" />
          <ItemsControl x:Name="ProviderModelsItemsControl">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:ProviderModelItem">
                <Border Classes="provider-model-chip">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Text="{Binding Display}" Classes="mono" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusText}"
                               FontSize="10"
                               Foreground="{DynamicResource WarningBrush}"
                               VerticalAlignment="Center"
                               IsVisible="{Binding !Configured}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusText}"
                               FontSize="10"
                               Foreground="{DynamicResource SuccessBrush}"
                               VerticalAlignment="Center"
                               IsVisible="{Binding Configured}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="NoProviderModelsText"
                     Text="{DynamicResource LocNoModelsAvailable}"
                     Classes="settings-row-hint"
                     IsVisible="False" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
