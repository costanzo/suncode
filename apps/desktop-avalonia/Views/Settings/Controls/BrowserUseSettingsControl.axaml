<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             xmlns:vm="using:SunCode.Desktop.ViewModels"
             xmlns:infra="using:SunCode.Desktop.Infrastructure"
             x:Class="SunCode.Desktop.Views.Settings.Controls.BrowserUseSettingsControl"
             x:DataType="vm:BrowserRuntimeViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Classes="settings-panel-content">
      <StackPanel Classes="settings-panel-heading">
        <TextBlock Text="{DynamicResource LocBrowserUse}" Classes="sc-text-title" />
        <TextBlock Classes="settings-hint" TextWrapping="Wrap"
                   Text="{DynamicResource LocBrowserUseHint}" />
      </StackPanel>

      <StackPanel Classes="settings-panel-section">
        <TextBlock Classes="section-label" Text="{DynamicResource LocAvailability}" />
        <Grid Classes="settings-row" ColumnDefinitions="*,220">
          <StackPanel Classes="settings-row-copy">
            <TextBlock Classes="settings-row-title" Text="{DynamicResource LocEnableBrowserUse}" />
            <TextBlock Classes="settings-row-hint" TextWrapping="Wrap"
                       Text="{DynamicResource LocEnableBrowserUseHint}" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" Classes="sc-toggle-switch" IsChecked="{Binding EnabledChecked}"
                        OnContent="{DynamicResource LocOn}" OffContent="{DynamicResource LocOff}" HorizontalAlignment="Right"
                        Command="{Binding SetEnabledCommand}" />
        </Grid>
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1" Padding="0,13" Margin="0,6,0,0">
          <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
            <Grid ColumnDefinitions="10,*" ColumnSpacing="9">
              <Ellipse Width="7" Height="7" infra:StatusToneProperties.Tone="{Binding InstallationTone}" VerticalAlignment="Top" Margin="0,5,0,0" />
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Text="{Binding InstallationStateText}" FontSize="12" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource LocBundledInstallation}" Classes="settings-row-hint" />
              </StackPanel>
            </Grid>
            <Grid Grid.Column="1" ColumnDefinitions="10,*" ColumnSpacing="9">
              <Ellipse Width="7" Height="7" infra:StatusToneProperties.Tone="{Binding RuntimeTone}" VerticalAlignment="Top" Margin="0,5,0,0" />
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Text="{Binding RuntimeStateText}" FontSize="12" FontWeight="SemiBold" />
                <TextBlock Text="{Binding RuntimeScopeText}" Classes="settings-row-hint" />
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
        <TextBlock Text="{Binding StatusText}" Classes="sc-text-status" Margin="0,16,0,0" TextWrapping="Wrap" />
      </StackPanel>

      <Border Classes="settings-divider" />
      <Border IsVisible="{Binding HasNoProject}">
        <StackPanel Classes="settings-panel-section">
          <TextBlock Classes="section-label" Text="{DynamicResource LocCurrentProjectBrowser}" />
          <Border Background="{DynamicResource SurfaceInsetBrush}" BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1" CornerRadius="8" Padding="12">
            <TextBlock Classes="settings-row-hint" TextWrapping="Wrap"
                       Text="{DynamicResource LocOpenSettingsFromProject}" />
          </Border>
        </StackPanel>
      </Border>
      <Border IsVisible="{Binding HasProject}">
        <StackPanel Classes="settings-panel-section">
          <TextBlock Classes="section-label" Text="{DynamicResource LocCurrentProjectBrowser}" />
          <Border Background="{DynamicResource SurfaceInsetBrush}" BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1" CornerRadius="8" Padding="12,10">
            <Grid ColumnDefinitions="18,*" ColumnSpacing="9">
              <svg:Svg Width="15" Height="15" Path="/Assets/icons/lock.svg" Css="{DynamicResource IconSvgCss}" />
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Text="{Binding ControlTitleText}" FontSize="11" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ControlHintText}" Classes="settings-row-hint" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>
          <WrapPanel Classes="settings-actions">
            <Button Classes="compact quiet sc-button" Content="{DynamicResource LocShowBrowserTakeControl}" Command="{Binding TakeControlCommand}" IsVisible="{Binding IsTakeControlVisible}" IsEnabled="{Binding CanTakeControl}" />
            <Button Classes="compact primary sc-button" Content="{DynamicResource LocReturnControlToAgent}" Command="{Binding ReturnControlCommand}" IsVisible="{Binding IsReturnControlVisible}" />
            <Button Classes="compact quiet sc-button" Content="{DynamicResource LocStop}" Command="{Binding StopCommand}" IsEnabled="{Binding CanStop}" />
            <Button Classes="compact danger sc-button" Content="{DynamicResource LocClearBrowserData}" Command="{Binding ClearCommand}" IsEnabled="{Binding CanClear}" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <Expander x:Name="AdvancedDiagnosticsExpander" Header="{DynamicResource LocAdvancedDiagnostics}" Margin="0,28,0,0">
        <StackPanel Classes="settings-panel-section" Margin="0,16,0,0">
          <StackPanel Classes="settings-actions" Margin="0">
            <Button Classes="compact quiet sc-button" Content="{DynamicResource LocVerifyRuntime}" Command="{Binding VerifyCommand}" IsEnabled="{Binding CanVerify}" />
            <Button Classes="compact quiet sc-button" Content="{DynamicResource LocStartBrowserRecovery}" Command="{Binding StartCommand}" IsVisible="{Binding IsStartVisible}" IsEnabled="{Binding CanStart}" />
            <Button Classes="compact quiet sc-button" Content="{DynamicResource LocRestart}" Command="{Binding RestartCommand}" IsVisible="{Binding IsRestartVisible}" IsEnabled="{Binding CanRestart}" />
          </StackPanel>
          <StackPanel Classes="settings-panel-section">
            <TextBlock Classes="section-label" Text="{DynamicResource LocBundledRuntime}" />
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="112,*,32">
              <TextBlock Text="{DynamicResource LocTarget}" Classes="settings-row-hint" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="3" Margin="0,9">
                <TextBlock Classes="mono" FontSize="10" Text="{Binding TargetText}" />
                <TextBlock Text="{DynamicResource LocBundledForInstallation}" Classes="settings-row-hint" />
              </StackPanel>
              <TextBlock Grid.Row="3" Text="{DynamicResource LocChromium}" Classes="settings-row-hint" VerticalAlignment="Center" />
              <StackPanel Grid.Row="3" Grid.Column="1" Spacing="3" Margin="0,9">
                <TextBlock Classes="mono" FontSize="10" Text="{Binding ChromiumVersionText}" />
                <TextBlock Text="{Binding ChromiumPathText}" ToolTip.Tip="{Binding ChromiumPathTip}" Classes="mono" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Button Grid.Row="3" Grid.Column="2" Classes="icon quiet sc-button" ToolTip.Tip="{DynamicResource LocCopyChromiumPath}"
                      AutomationProperties.Name="{DynamicResource LocCopyChromiumPath}" Command="{Binding CopyChromiumPathCommand}" IsEnabled="{Binding CanCopyChromiumPath}">
                <svg:Svg Width="14" Height="14" Path="/Assets/icons/copy.svg" Css="{DynamicResource IconSvgCss}" />
              </Button>
              <TextBlock Grid.Row="4" Text="{DynamicResource LocWorkerProtocol}" Classes="settings-row-hint" VerticalAlignment="Center" />
              <TextBlock Grid.Row="4" Grid.Column="1" Classes="mono" FontSize="10" Margin="0,13" Text="{Binding WorkerProtocolText}" />
            </Grid>
            <Border Background="{DynamicResource SurfaceInsetBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
              <Grid ColumnDefinitions="18,*" ColumnSpacing="9">
                <svg:Svg Width="15" Height="15" Path="/Assets/icons/lock.svg" Css="{DynamicResource IconSvgCss}" />
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock Text="{Binding IntegrityText}" FontSize="11" FontWeight="SemiBold" />
                  <TextBlock Classes="settings-row-hint" Text="{DynamicResource LocIntegrityHint}" />
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
          <StackPanel Classes="settings-panel-section" IsVisible="{Binding HasProject}">
            <TextBlock Classes="section-label" Text="{DynamicResource LocProjectBrowserDiagnostics}" />
            <Grid Classes="settings-row" ColumnDefinitions="*,220">
              <StackPanel Classes="settings-row-copy">
                <TextBlock Classes="settings-row-title" Text="{DynamicResource LocProfilePath}" />
                <TextBlock Classes="settings-row-hint" Text="{DynamicResource LocProfilePathHint}" />
              </StackPanel>
              <Grid Grid.Column="1" ColumnDefinitions="*,32">
                <TextBlock Text="{Binding ProfilePathText}" ToolTip.Tip="{Binding ProfilePathTip}" Classes="mono" FontSize="9" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="icon quiet sc-button" ToolTip.Tip="{DynamicResource LocCopyProfilePath}"
                        AutomationProperties.Name="{DynamicResource LocCopyProfilePath}" Command="{Binding CopyProfilePathCommand}" IsEnabled="{Binding CanCopyProfilePath}">
                  <svg:Svg Width="14" Height="14" Path="/Assets/icons/copy.svg" Css="{DynamicResource IconSvgCss}" />
                </Button>
              </Grid>
            </Grid>
            <Grid Classes="settings-row" ColumnDefinitions="*,220">
              <StackPanel Classes="settings-row-copy">
                <TextBlock Classes="settings-row-title" Text="{DynamicResource LocProfileUsage}" />
                <TextBlock Classes="settings-row-hint" Text="{DynamicResource LocProfileUsageHint}" />
              </StackPanel>
              <TextBlock Text="{Binding ProfileUsageText}" Grid.Column="1" Classes="mono" FontSize="10" HorizontalAlignment="Right" />
            </Grid>
            <Grid Classes="settings-row" ColumnDefinitions="*,220">
              <StackPanel Classes="settings-row-copy">
                <TextBlock Classes="settings-row-title" Text="{DynamicResource LocWindowControl}" />
                <TextBlock Classes="settings-row-hint" TextWrapping="Wrap" Text="{DynamicResource LocWindowControlHint}" />
              </StackPanel>
              <TextBlock Text="{Binding VisibilityText}" Grid.Column="1" Classes="mono" FontSize="10" HorizontalAlignment="Right" />
            </Grid>
            <TextBlock Text="{Binding ErrorText}" IsVisible="{Binding HasError}" Foreground="{DynamicResource DangerBrush}"
                       FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
          </StackPanel>
        </StackPanel>
      </Expander>

      <Border Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource WarningBorderBrush}"
              BorderThickness="1" Classes="settings-warning" Margin="0,28,0,0">
        <Grid ColumnDefinitions="18,*" ColumnSpacing="9">
          <svg:Svg Width="15" Height="15" Path="/Assets/icons/lock.svg" Css="{DynamicResource IconSvgCss}" />
          <StackPanel Grid.Column="1" Spacing="3">
            <TextBlock Text="{DynamicResource LocBrowserWarningTitle}" FontSize="11" FontWeight="SemiBold" />
            <TextBlock Classes="settings-row-hint" TextWrapping="Wrap"
                       Text="{DynamicResource LocBrowserWarning}" />
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
