<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SunCode.Desktop.ViewModels" xmlns:controls="using:SunCode.Desktop.Controls"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             xmlns:infra="using:SunCode.Desktop.Infrastructure"
             x:Class="SunCode.Desktop.Views.Settings.Controls.BrowserUseSettingsControl" x:DataType="vm:BrowserRuntimeViewModel">
  <UserControl.Styles>
    <Style Selector="controls|SCFlatComboBox.browser-source ComboBox">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Classes="settings-panel-content">
      <StackPanel Classes="settings-panel-heading">
        <TextBlock Text="{DynamicResource LocBrowserUse}" Classes="sc-text-title" />
        <TextBlock Text="{DynamicResource LocBrowserUseHint}" Classes="settings-hint" TextWrapping="Wrap" />
      </StackPanel>
      <Grid Classes="settings-row" ColumnDefinitions="*,220">
        <StackPanel Classes="settings-row-copy">
          <TextBlock Text="{DynamicResource LocEnableBrowserUse}" Classes="settings-row-title" />
          <TextBlock Text="{DynamicResource LocEnableBrowserUseHint}" Classes="settings-row-hint" TextWrapping="Wrap" />
        </StackPanel>
        <ToggleSwitch Grid.Column="1" Classes="sc-toggle-switch" IsChecked="{Binding EnabledChecked}"
                      OnContent="{DynamicResource LocOn}" OffContent="{DynamicResource LocOff}" HorizontalAlignment="Right" Command="{Binding SetEnabledCommand}" />
      </Grid>
      <Border Classes="settings-divider" />
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <TextBlock Text="{DynamicResource LocChromium}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Ellipse Width="7" Height="7" infra:StatusToneProperties.Tone="{Binding ComponentTone}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ComponentStateText}" FontSize="11" infra:StatusToneProperties.Tone="{Binding ComponentTone}" />
          </StackPanel>
        </Grid>
        <TextBlock Text="{DynamicResource LocBrowserComponentDescription}" Classes="settings-row-hint" TextWrapping="Wrap" />
        <TextBlock Text="{Binding RequiredComponentText}" Classes="mono" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
        <Grid Classes="settings-row" ColumnDefinitions="*,220">
          <TextBlock Text="{DynamicResource LocBrowserDownloadSource}" Classes="settings-row-title" VerticalAlignment="Center" />
          <controls:SCFlatComboBox Grid.Column="1" Classes="browser-source" ItemsSource="{Binding DownloadSources}" SelectedItem="{Binding SelectedDownloadSource}"
                                   IsEnabled="{Binding CanSelectDownloadSource}" HorizontalAlignment="Stretch" AutomationProperties.Name="{DynamicResource LocBrowserDownloadSource}" />
        </Grid>
        <SelectableTextBlock Text="{Binding DownloadSourceUrl}" Classes="mono" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding ComponentMessage}" Classes="settings-row-hint" TextWrapping="Wrap" infra:StatusToneProperties.Tone="{Binding ComponentTone}" />
        <StackPanel Spacing="8" IsVisible="{Binding ComponentBusy}">
          <ProgressBar Value="{Binding ComponentProgress}" IsIndeterminate="{Binding ComponentIndeterminate}" Maximum="100" Height="4" AutomationProperties.Name="{Binding ComponentStateText}" />
          <TextBlock Text="{Binding ComponentProgressText}" Classes="mono" FontSize="10" />
          <Button Classes="compact sc-button" Content="{DynamicResource LocBrowserCancelInstallation}" Command="{Binding CancelComponentCommand}" HorizontalAlignment="Left" />
        </StackPanel>
        <Button Classes="compact sc-button" Classes.primary="{Binding InstallComponentPrimary}" Content="{Binding InstallComponentLabel}" Command="{Binding InstallComponentCommand}"
                IsVisible="{Binding ShowComponentInstall}" IsEnabled="{Binding CanInstallComponent}" HorizontalAlignment="Left" />
        <Button Classes="compact primary sc-button" Content="{DynamicResource LocBrowserRestartAction}" Command="{Binding RestartComponentCommand}"
                IsVisible="{Binding ComponentRestartRequired}" HorizontalAlignment="Left" />
        <TextBlock Text="{DynamicResource LocBrowserComponentChecks}" Classes="settings-row-hint" TextWrapping="Wrap" />
      </StackPanel>
      <Border Classes="settings-divider" />
      <StackPanel Spacing="12">
        <TextBlock Text="{DynamicResource LocCurrentProjectBrowser}" FontSize="12" FontWeight="SemiBold" />
        <TextBlock Text="{DynamicResource LocOpenSettingsFromProject}" IsVisible="{Binding HasNoProject}" Classes="settings-row-hint" TextWrapping="Wrap" />
        <StackPanel Spacing="12" IsVisible="{Binding HasProject}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding RuntimeScopeText}" FontSize="11" FontWeight="SemiBold" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Ellipse Width="7" Height="7" infra:StatusToneProperties.Tone="{Binding RuntimeTone}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding RuntimeStateText}" Classes="settings-row-hint" />
            </StackPanel>
          </Grid>
          <TextBlock Text="{Binding ControlHintText}" Classes="settings-row-hint" TextWrapping="Wrap" />
          <WrapPanel Orientation="Horizontal">
            <Button Classes="compact sc-button" Content="{DynamicResource LocStartBrowserRecovery}" Command="{Binding StartCommand}" IsVisible="{Binding IsStartVisible}" IsEnabled="{Binding CanStart}" Margin="0,0,10,8" />
            <Button Classes="compact sc-button" Content="{DynamicResource LocShowBrowserTakeControl}" Command="{Binding TakeControlCommand}" IsVisible="{Binding IsTakeControlVisible}" IsEnabled="{Binding CanTakeControl}" Margin="0,0,10,8" />
            <Button Classes="compact sc-button" Content="{DynamicResource LocReturnControlToAgent}" Command="{Binding ReturnControlCommand}" IsVisible="{Binding IsReturnControlVisible}" Margin="0,0,10,8" />
            <Button Classes="compact sc-button" Content="{DynamicResource LocStop}" Command="{Binding StopCommand}" IsEnabled="{Binding CanStop}" Margin="0,0,10,8" />
            <Button Classes="compact danger sc-button" Content="{DynamicResource LocClearBrowserData}" Command="{Binding ClearCommand}" IsEnabled="{Binding CanClear}" Margin="0,0,0,8" />
          </WrapPanel>
          <TextBlock Text="{Binding ErrorText}" IsVisible="{Binding HasError}" Foreground="{DynamicResource DangerBrush}" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>
      <Expander x:Name="AdvancedDiagnosticsExpander" Classes="settings-expander" Header="{DynamicResource LocAdvancedDiagnostics}" Margin="0,28,0,0">
        <StackPanel Spacing="16">
          <Button Classes="compact sc-button" Content="{DynamicResource LocBrowserVerifyFiles}" Command="{Binding VerifyCommand}" IsEnabled="{Binding CanVerify}" HorizontalAlignment="Left" />
          <ItemsControl ItemsSource="{Binding ComponentDiagnostics}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:BrowserComponentIdentity">
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" MinHeight="58" Padding="0,10">
                  <Grid ColumnDefinitions="112,*,30" ColumnSpacing="14">
                    <TextBlock Text="{Binding Label}" Classes="settings-row-hint" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" ToolTip.Tip="{Binding Value}" Classes="mono" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Classes="icon quiet sc-button" Command="{Binding CopyCommand}" ToolTip.Tip="{Binding CopyLabel}" AutomationProperties.Name="{Binding CopyLabel}">
                      <svg:Svg Width="14" Height="14" Path="/Assets/icons/copy.svg" Css="{DynamicResource IconSvgCss}" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{DynamicResource LocBrowserTrustedDigestHint}" Classes="settings-row-hint" TextWrapping="Wrap" />
          <StackPanel Spacing="12" IsVisible="{Binding HasProject}">
            <Grid Classes="settings-row" ColumnDefinitions="*,220">
              <TextBlock Text="{DynamicResource LocProfilePath}" Classes="settings-row-title" />
              <Grid Grid.Column="1" ColumnDefinitions="*,30">
                <SelectableTextBlock Text="{Binding ProfilePathText}" ToolTip.Tip="{Binding ProfilePathTip}" Classes="mono" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="icon quiet sc-button" Command="{Binding CopyProfilePathCommand}" IsEnabled="{Binding CanCopyProfilePath}"
                        ToolTip.Tip="{DynamicResource LocCopyProfilePath}" AutomationProperties.Name="{DynamicResource LocCopyProfilePath}">
                  <svg:Svg Width="14" Height="14" Path="/Assets/icons/copy.svg" Css="{DynamicResource IconSvgCss}" />
                </Button>
              </Grid>
            </Grid>
            <Grid Classes="settings-row" ColumnDefinitions="*,220">
              <TextBlock Text="{DynamicResource LocProfileUsage}" Classes="settings-row-title" />
              <TextBlock Grid.Column="1" Text="{Binding ProfileUsageText}" Classes="mono" FontSize="10" />
            </Grid>
            <Grid Classes="settings-row" ColumnDefinitions="*,220">
              <TextBlock Text="{DynamicResource LocWindowControl}" Classes="settings-row-title" />
              <TextBlock Grid.Column="1" Text="{Binding VisibilityText}" Classes="mono" FontSize="10" TextWrapping="Wrap" />
            </Grid>
          </StackPanel>
        </StackPanel>
      </Expander>
      <TextBlock Text="{DynamicResource LocBrowserComponentAuthority}" Classes="settings-row-hint" TextWrapping="Wrap" Margin="0,20,0,0" />
      <TextBlock Text="{Binding StatusText}" Classes="sc-text-status" TextWrapping="Wrap" Margin="0,16,0,0" IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
