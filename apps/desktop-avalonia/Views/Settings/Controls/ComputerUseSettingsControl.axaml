<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             x:Class="SunCode.Desktop.Views.Settings.Controls.ComputerUseSettingsControl">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Classes="settings-panel-content">
      <StackPanel Classes="settings-panel-heading">
        <TextBlock Text="{DynamicResource Loc_ComputerUse}" Classes="sc-text-title" />
        <TextBlock Classes="settings-hint" TextWrapping="Wrap"
                   Text="{DynamicResource Loc_ComputerUseHint}" />
      </StackPanel>

      <StackPanel Classes="settings-panel-section">
        <TextBlock Classes="section-label" Text="{DynamicResource Loc_Availability}" />
        <Grid Classes="settings-row" ColumnDefinitions="*,220">
          <StackPanel Classes="settings-row-copy">
            <TextBlock Classes="settings-row-title" Text="{DynamicResource Loc_EnableComputerUse}" />
            <TextBlock Classes="settings-row-hint" TextWrapping="Wrap"
                       Text="{DynamicResource Loc_EnableComputerUseHint}" />
          </StackPanel>
          <ToggleSwitch x:Name="EnabledToggle" Grid.Column="1" Classes="sc-toggle-switch"
                        OnContent="{DynamicResource Loc_On}" OffContent="{DynamicResource Loc_Off}" HorizontalAlignment="Right"
                        Click="OnEnabledChanged" />
        </Grid>
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1" Padding="0,13" Margin="0,6,0,0">
          <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
            <Grid ColumnDefinitions="10,*" ColumnSpacing="9">
              <Ellipse x:Name="ModelStatusDot" Width="7" Height="7" Fill="{DynamicResource TextMutedBrush}" VerticalAlignment="Top" Margin="0,5,0,0" />
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock x:Name="ModelSupportText" Text="{DynamicResource Loc_Unknown}" FontSize="12" FontWeight="SemiBold" />
                <TextBlock x:Name="ModelNameText" Text="{DynamicResource Loc_NoModelSelected}" Classes="settings-row-hint" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>
            <Grid Grid.Column="1" ColumnDefinitions="10,*" ColumnSpacing="9">
              <Ellipse x:Name="BackendStatusDot" Width="7" Height="7" Fill="{DynamicResource TextMutedBrush}" VerticalAlignment="Top" Margin="0,5,0,0" />
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock x:Name="BackendStateText" Text="{DynamicResource Loc_Unavailable}" FontSize="12" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource Loc_BuiltInDesktopBackend}" Classes="settings-row-hint" />
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
        <TextBlock x:Name="StatusText" Classes="sc-text-status" TextWrapping="Wrap" />
      </StackPanel>

      <Border Classes="settings-divider" />
      <StackPanel Classes="settings-panel-section">
        <TextBlock Classes="section-label" Text="{DynamicResource Loc_DesktopAccess}" />
        <Grid Classes="settings-row" ColumnDefinitions="*,220">
          <StackPanel Classes="settings-row-copy">
            <TextBlock Classes="settings-row-title" Text="{DynamicResource Loc_PrimaryDisplay}" />
            <TextBlock Classes="settings-row-hint" Text="{DynamicResource Loc_PrimaryDisplayHint}" />
          </StackPanel>
          <TextBlock x:Name="TargetDisplayText" Grid.Column="1" Classes="mono" FontSize="10" HorizontalAlignment="Right" Text="—" />
        </Grid>
        <Grid Classes="settings-row" ColumnDefinitions="*,220">
          <StackPanel Classes="settings-row-copy">
            <TextBlock Classes="settings-row-title" Text="{DynamicResource Loc_ScreenCapture}" />
            <TextBlock Classes="settings-row-hint" TextWrapping="Wrap" Text="{DynamicResource Loc_ScreenCaptureHint}" />
          </StackPanel>
          <Grid Grid.Column="1" ColumnDefinitions="10,Auto" ColumnSpacing="8" HorizontalAlignment="Right">
            <Ellipse x:Name="CapturePermissionDot" Width="7" Height="7" Fill="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
            <TextBlock x:Name="CapturePermissionText" Grid.Column="1" Text="{DynamicResource Loc_Unknown}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
          </Grid>
        </Grid>
        <Grid Classes="settings-row" ColumnDefinitions="*,220">
          <StackPanel Classes="settings-row-copy">
            <TextBlock Classes="settings-row-title" Text="{DynamicResource Loc_InputControl}" />
            <TextBlock Classes="settings-row-hint" TextWrapping="Wrap" Text="{DynamicResource Loc_InputControlHint}" />
          </StackPanel>
          <Grid Grid.Column="1" ColumnDefinitions="10,Auto" ColumnSpacing="8" HorizontalAlignment="Right">
            <Ellipse x:Name="InputPermissionDot" Width="7" Height="7" Fill="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
            <TextBlock x:Name="InputPermissionText" Grid.Column="1" Text="{DynamicResource Loc_Unknown}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
          </Grid>
        </Grid>
        <Grid Classes="settings-row" ColumnDefinitions="*,220">
          <StackPanel Classes="settings-row-copy">
            <TextBlock Classes="settings-row-title" Text="{DynamicResource Loc_CurrentControlOwner}" />
            <TextBlock Classes="settings-row-hint" TextWrapping="Wrap" Text="{DynamicResource Loc_ControlOwnerHint}" />
          </StackPanel>
          <TextBlock x:Name="ControlOwnerText" Grid.Column="1" Classes="mono" FontSize="10" HorizontalAlignment="Right" Text="{DynamicResource Loc_User}" />
        </Grid>
        <WrapPanel Classes="settings-actions">
          <Button x:Name="TakeControlButton" Classes="compact quiet sc-button" Content="{DynamicResource Loc_TakeControl}" Click="OnTakeControl" />
          <Button x:Name="ReturnControlButton" Classes="compact primary sc-button" Content="{DynamicResource Loc_ReturnControlToAgent}" Click="OnReturnControl" />
        </WrapPanel>
        <WrapPanel Classes="settings-actions">
          <Button x:Name="CapturePermissionButton" Classes="compact quiet sc-button" Content="{DynamicResource Loc_RequestScreenCapture}" Click="OnRequestCapturePermission" />
          <Button x:Name="InputPermissionButton" Classes="compact quiet sc-button" Content="{DynamicResource Loc_RequestInputControl}" Click="OnRequestInputPermission" />
        </WrapPanel>
      </StackPanel>

      <Border Classes="settings-divider" />
      <StackPanel Classes="settings-panel-section">
        <TextBlock Classes="section-label" Text="{DynamicResource Loc_SafetyAndLimits}" />
        <Grid Classes="settings-row" ColumnDefinitions="*,220">
          <StackPanel Classes="settings-row-copy">
            <TextBlock Classes="settings-row-title" Text="{DynamicResource Loc_InputApproval}" />
            <TextBlock Classes="settings-row-hint" TextWrapping="Wrap" Text="{DynamicResource Loc_InputApprovalHint}" />
          </StackPanel>
          <TextBlock Grid.Column="1" Classes="mono" FontSize="10" HorizontalAlignment="Right" Text="{DynamicResource Loc_OncePerInputBatch}" />
        </Grid>
        <Grid Classes="settings-row" ColumnDefinitions="*,220">
          <StackPanel Classes="settings-row-copy">
            <TextBlock Classes="settings-row-title" Text="{DynamicResource Loc_ExecutionMode}" />
            <TextBlock Classes="settings-row-hint" TextWrapping="Wrap" Text="{DynamicResource Loc_ExecutionModeHint}" />
          </StackPanel>
          <TextBlock Grid.Column="1" Classes="mono" FontSize="10" HorizontalAlignment="Right" Text="{DynamicResource Loc_InteractiveOnly}" />
        </Grid>
        <Grid Classes="settings-row" ColumnDefinitions="*,220">
          <StackPanel Classes="settings-row-copy">
            <TextBlock Classes="settings-row-title" Text="{DynamicResource Loc_EmergencyStop}" />
            <TextBlock Classes="settings-row-hint" TextWrapping="Wrap" Text="{DynamicResource Loc_EmergencyStopHint}" />
          </StackPanel>
          <Button x:Name="EmergencyStopButton" Grid.Column="1" Classes="compact danger sc-button" HorizontalAlignment="Right" Content="{DynamicResource Loc_StopComputerUse}" Click="OnEmergencyStop" />
        </Grid>
        <Grid Classes="settings-row" ColumnDefinitions="*,220">
          <StackPanel Classes="settings-row-copy">
            <TextBlock Classes="settings-row-title" Text="{DynamicResource Loc_TemporaryScreenshots}" />
            <TextBlock Classes="settings-row-hint" TextWrapping="Wrap" Text="{DynamicResource Loc_TemporaryScreenshotsHint}" />
          </StackPanel>
          <Button Grid.Column="1" Classes="compact quiet sc-button" HorizontalAlignment="Right" Content="{DynamicResource Loc_ClearTemporaryScreenshots}" IsEnabled="False" />
        </Grid>
      </StackPanel>

      <Border Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource WarningBorderBrush}"
              BorderThickness="1" Classes="settings-warning" Margin="0,28,0,0">
        <Grid ColumnDefinitions="18,*" ColumnSpacing="9">
          <svg:Svg Width="15" Height="15" Path="/Assets/icons/lock.svg" Css="{DynamicResource IconSvgCss}" />
          <StackPanel Grid.Column="1" Spacing="3">
            <TextBlock Text="{DynamicResource Loc_ComputerUseWarningTitle}" FontSize="11" FontWeight="SemiBold" />
            <TextBlock Classes="settings-row-hint" TextWrapping="Wrap"
                       Text="{DynamicResource Loc_ComputerUseWarning}" />
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
