<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             xmlns:vm="using:SunCode.Desktop.ViewModels"
             xmlns:infra="using:SunCode.Desktop.Infrastructure"
             x:Class="SunCode.Desktop.Views.Settings.Controls.ComputerUseSettingsControl"
             x:DataType="vm:ComputerRuntimeViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Classes="settings-panel-content">
      <StackPanel Classes="settings-panel-heading">
        <TextBlock Text="{DynamicResource LocComputerUse}" Classes="sc-text-title" />
        <TextBlock Classes="settings-hint" TextWrapping="Wrap"
                   Text="{DynamicResource LocComputerUseHint}" />
      </StackPanel>

      <StackPanel Classes="settings-panel-section">
        <TextBlock Classes="section-label" Text="{DynamicResource LocAvailability}" />
        <Grid Classes="settings-row" ColumnDefinitions="*,220">
          <StackPanel Classes="settings-row-copy">
            <TextBlock Classes="settings-row-title" Text="{DynamicResource LocEnableComputerUse}" />
            <TextBlock Classes="settings-row-hint" TextWrapping="Wrap"
                       Text="{DynamicResource LocEnableComputerUseHint}" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" Classes="sc-toggle-switch"
                        IsChecked="{Binding EnabledChecked}"
                        OnContent="{DynamicResource LocOn}" OffContent="{DynamicResource LocOff}" HorizontalAlignment="Right"
                        Command="{Binding SetEnabledCommand}" />
        </Grid>
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1" Padding="0,13" Margin="0,6,0,0">
          <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
            <Grid ColumnDefinitions="10,*" ColumnSpacing="9">
              <Ellipse Width="7" Height="7" infra:StatusToneProperties.Tone="{Binding ModelTone}" VerticalAlignment="Top" Margin="0,5,0,0" />
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Text="{Binding ModelSupportText}" FontSize="12" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ModelNameText}" Classes="settings-row-hint" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>
            <Grid Grid.Column="1" ColumnDefinitions="10,*" ColumnSpacing="9">
              <Ellipse Width="7" Height="7" infra:StatusToneProperties.Tone="{Binding BackendTone}" VerticalAlignment="Top" Margin="0,5,0,0" />
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Text="{Binding BackendStateText}" FontSize="12" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource LocBuiltInDesktopBackend}" Classes="settings-row-hint" />
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
        <TextBlock Text="{Binding PageStatusText}" Classes="sc-text-status" TextWrapping="Wrap" />
      </StackPanel>

      <Border Classes="settings-divider" />
      <StackPanel Classes="settings-panel-section">
        <TextBlock Classes="section-label" Text="{DynamicResource LocDesktopAccess}" />
        <Grid Classes="settings-row" ColumnDefinitions="*,220">
          <StackPanel Classes="settings-row-copy">
            <TextBlock Classes="settings-row-title" Text="{DynamicResource LocPrimaryDisplay}" />
            <TextBlock Classes="settings-row-hint" Text="{DynamicResource LocPrimaryDisplayHint}" />
          </StackPanel>
          <TextBlock Grid.Column="1" Classes="mono" FontSize="10" HorizontalAlignment="Right" Text="{Binding TargetDisplayText}" />
        </Grid>
        <Grid Classes="settings-row" ColumnDefinitions="*,220">
          <StackPanel Classes="settings-row-copy">
            <TextBlock Classes="settings-row-title" Text="{DynamicResource LocScreenCapture}" />
            <TextBlock Classes="settings-row-hint" TextWrapping="Wrap" Text="{DynamicResource LocScreenCaptureHint}" />
          </StackPanel>
          <Grid Grid.Column="1" ColumnDefinitions="10,Auto" ColumnSpacing="8" HorizontalAlignment="Right">
            <Ellipse Width="7" Height="7" infra:StatusToneProperties.Tone="{Binding CapturePermissionTone}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding CapturePermissionText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
          </Grid>
        </Grid>
        <Grid Classes="settings-row" ColumnDefinitions="*,220">
          <StackPanel Classes="settings-row-copy">
            <TextBlock Classes="settings-row-title" Text="{DynamicResource LocInputControl}" />
            <TextBlock Classes="settings-row-hint" TextWrapping="Wrap" Text="{DynamicResource LocInputControlHint}" />
          </StackPanel>
          <Grid Grid.Column="1" ColumnDefinitions="10,Auto" ColumnSpacing="8" HorizontalAlignment="Right">
            <Ellipse Width="7" Height="7" infra:StatusToneProperties.Tone="{Binding InputPermissionTone}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding InputPermissionText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
          </Grid>
        </Grid>
        <Grid Classes="settings-row" ColumnDefinitions="*,220">
          <StackPanel Classes="settings-row-copy">
            <TextBlock Classes="settings-row-title" Text="{DynamicResource LocCurrentControlOwner}" />
            <TextBlock Classes="settings-row-hint" TextWrapping="Wrap" Text="{DynamicResource LocControlOwnerHint}" />
          </StackPanel>
          <TextBlock Grid.Column="1" Classes="mono" FontSize="10" HorizontalAlignment="Right" Text="{Binding ControlOwnerText}" />
        </Grid>
        <WrapPanel Classes="settings-actions">
          <Button Classes="compact quiet sc-button" Content="{DynamicResource LocTakeControl}" Command="{Binding TakeControlCommand}"
                  IsVisible="{Binding IsTakeControlVisible}" IsEnabled="{Binding CanTransferControl}" />
          <Button Classes="compact primary sc-button" Content="{DynamicResource LocReturnControlToAgent}" Command="{Binding ReturnControlCommand}"
                  IsVisible="{Binding IsReturnControlVisible}" IsEnabled="{Binding CanTransferControl}" />
        </WrapPanel>
        <WrapPanel Classes="settings-actions">
          <Button Classes="compact quiet sc-button" Content="{Binding CapturePermissionButtonText}" Command="{Binding RequestCapturePermissionCommand}"
                  IsEnabled="{Binding CanRequestCapturePermission}" />
          <Button Classes="compact quiet sc-button" Content="{Binding InputPermissionButtonText}" Command="{Binding RequestInputPermissionCommand}"
                  IsEnabled="{Binding CanRequestInputPermission}" />
        </WrapPanel>
      </StackPanel>

      <Border Classes="settings-divider" />
      <StackPanel Classes="settings-panel-section">
        <TextBlock Classes="section-label" Text="{DynamicResource LocSafetyAndLimits}" />
        <Grid Classes="settings-row" ColumnDefinitions="*,220">
          <StackPanel Classes="settings-row-copy">
            <TextBlock Classes="settings-row-title" Text="{DynamicResource LocInputApproval}" />
            <TextBlock Classes="settings-row-hint" TextWrapping="Wrap" Text="{DynamicResource LocInputApprovalHint}" />
          </StackPanel>
          <TextBlock Grid.Column="1" Classes="mono" FontSize="10" HorizontalAlignment="Right" Text="{DynamicResource LocOncePerInputBatch}" />
        </Grid>
        <Grid Classes="settings-row" ColumnDefinitions="*,220">
          <StackPanel Classes="settings-row-copy">
            <TextBlock Classes="settings-row-title" Text="{DynamicResource LocExecutionMode}" />
            <TextBlock Classes="settings-row-hint" TextWrapping="Wrap" Text="{DynamicResource LocExecutionModeHint}" />
          </StackPanel>
          <TextBlock Grid.Column="1" Classes="mono" FontSize="10" HorizontalAlignment="Right" Text="{DynamicResource LocInteractiveOnly}" />
        </Grid>
        <Grid Classes="settings-row" ColumnDefinitions="*,220">
          <StackPanel Classes="settings-row-copy">
            <TextBlock Classes="settings-row-title" Text="{DynamicResource LocEmergencyStop}" />
            <TextBlock Classes="settings-row-hint" TextWrapping="Wrap" Text="{DynamicResource LocEmergencyStopHint}" />
          </StackPanel>
          <Button Grid.Column="1" Classes="compact danger sc-button" HorizontalAlignment="Right" Content="{DynamicResource LocStopComputerUse}"
                  Command="{Binding EmergencyStopCommand}" IsEnabled="{Binding CanEmergencyStop}" />
        </Grid>
        <Grid Classes="settings-row" ColumnDefinitions="*,220">
          <StackPanel Classes="settings-row-copy">
            <TextBlock Classes="settings-row-title" Text="{DynamicResource LocTemporaryScreenshots}" />
            <TextBlock Classes="settings-row-hint" TextWrapping="Wrap" Text="{DynamicResource LocTemporaryScreenshotsHint}" />
          </StackPanel>
          <Button Grid.Column="1" Classes="compact quiet sc-button" HorizontalAlignment="Right" Content="{DynamicResource LocClearTemporaryScreenshots}" IsEnabled="False" />
        </Grid>
      </StackPanel>

      <Border Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource WarningBorderBrush}"
              BorderThickness="1" Classes="settings-warning" Margin="0,28,0,0">
        <Grid ColumnDefinitions="18,*" ColumnSpacing="9">
          <svg:Svg Width="15" Height="15" Path="/Assets/icons/lock.svg" Css="{DynamicResource IconSvgCss}" />
          <StackPanel Grid.Column="1" Spacing="3">
            <TextBlock Text="{DynamicResource LocComputerUseWarningTitle}" FontSize="11" FontWeight="SemiBold" />
            <TextBlock Classes="settings-row-hint" TextWrapping="Wrap"
                       Text="{DynamicResource LocComputerUseWarning}" />
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
