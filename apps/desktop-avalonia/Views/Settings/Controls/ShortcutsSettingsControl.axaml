<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             x:Class="SunCode.Desktop.Views.Settings.Controls.ShortcutsSettingsControl">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Classes="settings-panel-content">
      <Grid Classes="settings-panel-heading settings-shortcuts-heading" ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Classes="settings-panel-heading-copy">
          <TextBlock Text="{DynamicResource LocKeyboardShortcuts}" Classes="sc-text-title" />
          <TextBlock Classes="settings-hint" Text="{DynamicResource LocViewShortcuts}" />
        </StackPanel>
        <Border Grid.Column="1" Classes="settings-read-only-badge">
          <TextBlock Text="{DynamicResource LocReadOnly}" />
        </Border>
      </Grid>

      <StackPanel Classes="settings-panel-section">
        <TextBlock Classes="section-label" Text="{DynamicResource LocAvailableShortcuts}" />
        <StackPanel Classes="settings-shortcut-list">
          <Border Classes="settings-shortcut-row">
            <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="settings-shortcut-action" Text="{DynamicResource LocOpenSettings}" />
            <StackPanel Grid.Column="1" Classes="settings-key-chord">
              <Border Classes="settings-keycap"><TextBlock x:Name="OpenSettingsModifier" Classes="mono" Text="⌘" /></Border>
              <Border Classes="settings-keycap"><TextBlock Classes="mono" Text="," /></Border>
            </StackPanel>
            </Grid>
          </Border>
          <Border Classes="settings-shortcut-row">
            <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="settings-shortcut-action" Text="{DynamicResource LocToggleProjectNavigation}" />
            <StackPanel Grid.Column="1" Classes="settings-key-chord">
              <Border Classes="settings-keycap"><TextBlock x:Name="ToggleNavigationModifier" Classes="mono" Text="⌘" /></Border>
              <Border Classes="settings-keycap"><TextBlock Classes="mono" Text="1" /></Border>
            </StackPanel>
            </Grid>
          </Border>
          <Border Classes="settings-shortcut-row">
            <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="settings-shortcut-action" Text="{DynamicResource LocToggleGitViewer}" />
            <StackPanel Grid.Column="1" Classes="settings-key-chord">
              <Border Classes="settings-keycap"><TextBlock x:Name="ToggleGitModifier" Classes="mono" Text="⌘" /></Border>
              <Border Classes="settings-keycap"><TextBlock Classes="mono" Text="9" /></Border>
            </StackPanel>
            </Grid>
          </Border>
          <Border Classes="settings-shortcut-row">
            <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="settings-shortcut-action" Text="{DynamicResource LocSendMessage}" />
            <StackPanel Grid.Column="1" Classes="settings-key-chord">
              <Border Classes="settings-keycap"><TextBlock Classes="mono" Text="Enter" /></Border>
            </StackPanel>
            </Grid>
          </Border>
          <Border Classes="settings-shortcut-row">
            <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="settings-shortcut-action" Text="{DynamicResource LocSubmitSessionDialog}" />
            <StackPanel Grid.Column="1" Classes="settings-key-chord">
              <Border Classes="settings-keycap"><TextBlock Classes="mono" Text="Enter" /></Border>
            </StackPanel>
            </Grid>
          </Border>
          <Border Classes="settings-shortcut-row">
            <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="settings-shortcut-action" Text="{DynamicResource LocStopCurrentTurn}" />
            <StackPanel Grid.Column="1" Classes="settings-key-chord">
              <Border Classes="settings-keycap"><TextBlock Classes="mono" Text="Escape" /></Border>
            </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
