<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:SunCode.Desktop.Controls"
             x:Class="SunCode.Desktop.Views.Settings.Controls.DefaultsSettingsControl">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Classes="settings-panel-content">
      <StackPanel Classes="settings-panel-heading">
      <TextBlock Text="{DynamicResource Loc_Defaults}" Classes="sc-text-title" />
        <TextBlock Classes="settings-hint" Text="{DynamicResource Loc_ConfigureModelTurnDefaults}" />
      </StackPanel>
      <StackPanel Classes="settings-panel-section">
        <TextBlock Classes="section-label" Text="{DynamicResource Loc_DefaultModel}" />
        <Grid Classes="settings-row" ColumnDefinitions="*,220">
          <StackPanel Classes="settings-row-copy">
            <TextBlock Classes="settings-row-title" Text="{DynamicResource Loc_Model}" />
            <TextBlock Classes="settings-row-hint" Text="{DynamicResource Loc_RegisteredModelsOnly}" />
          </StackPanel>
          <controls:SCFlatComboBox x:Name="DefaultModelSelector"
                                   Grid.Column="1"
                                   HorizontalAlignment="Stretch"
                                   PlaceholderText="{DynamicResource Loc_ChooseModel}"
                                   SelectionChanged="OnDefaultModelChanged" />
        </Grid>
      </StackPanel>
      <Border Classes="settings-divider" />
      <StackPanel Classes="settings-panel-section">
        <TextBlock Classes="section-label" Text="{DynamicResource Loc_TurnExecution}" />
        <Grid Classes="settings-row" ColumnDefinitions="*,220">
          <StackPanel Classes="settings-row-copy">
            <TextBlock Classes="settings-row-title" Text="{DynamicResource Loc_ToolCallLimit}" />
            <TextBlock Classes="settings-row-hint" Text="{DynamicResource Loc_MaxToolCalls}" />
          </StackPanel>
          <controls:SCNumericInput x:Name="ToolCallLimitInput"
                                   Grid.Column="1"
                                   HorizontalAlignment="Stretch"
                                   Minimum="1"
                                   Maximum="256"
                                   Increment="1"
                                   FormatString="0" 
                                   ValueChanged="OnToolCallLimitChanged"/>
        </Grid>
      </StackPanel>
      <StackPanel Classes="settings-actions">
        <Button x:Name="SaveToolCallLimitButton"
                Classes="compact primary sc-button"
                Content="{DynamicResource Loc_SaveProjectLimit}"
                Click="OnSaveToolCallLimit" />
        <TextBlock x:Name="ToolCallLimitScope" Classes="sc-text-status" VerticalAlignment="Center" />
        <TextBlock x:Name="ToolCallLimitStatus" Classes="sc-text-status" VerticalAlignment="Center" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
