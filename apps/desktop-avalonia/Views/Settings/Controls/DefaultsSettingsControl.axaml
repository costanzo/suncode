<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:SunCode.Desktop.Controls"
             xmlns:vm="using:SunCode.Desktop.ViewModels"
             xmlns:infra="using:SunCode.Desktop.Infrastructure"
             x:Class="SunCode.Desktop.Views.Settings.Controls.DefaultsSettingsControl"
             x:DataType="vm:DefaultsSettingsViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Classes="settings-panel-content">
      <StackPanel Classes="settings-panel-heading">
      <TextBlock Text="{DynamicResource LocDefaults}" Classes="sc-text-title" />
        <TextBlock Classes="settings-hint" Text="{DynamicResource LocConfigureModelTurnDefaults}" />
      </StackPanel>
      <StackPanel Classes="settings-panel-section">
        <TextBlock Classes="section-label" Text="{DynamicResource LocDefaultModel}" />
        <Grid Classes="settings-row" ColumnDefinitions="*,220">
          <StackPanel Classes="settings-row-copy">
            <TextBlock Classes="settings-row-title" Text="{DynamicResource LocModel}" />
            <TextBlock Classes="settings-row-hint" Text="{DynamicResource LocRegisteredModelsOnly}" />
          </StackPanel>
          <controls:SCFlatComboBox Grid.Column="1"
                                   ItemsSource="{Binding ModelOptions}"
                                   SelectedItem="{Binding SelectedModel}"
                                   HorizontalAlignment="Stretch"
                                   PlaceholderText="{DynamicResource LocChooseModel}" />
        </Grid>
      </StackPanel>
      <Border Classes="settings-divider" />
      <StackPanel Classes="settings-panel-section">
        <TextBlock Classes="section-label" Text="{DynamicResource LocTurnExecution}" />
        <Grid Classes="settings-row" ColumnDefinitions="*,220">
          <StackPanel Classes="settings-row-copy">
            <TextBlock Classes="settings-row-title" Text="{DynamicResource LocToolCallLimit}" />
            <TextBlock Classes="settings-row-hint" Text="{DynamicResource LocMaxToolCalls}" />
          </StackPanel>
          <controls:SCNumericInput Grid.Column="1"
                                   Value="{Binding ToolCallLimit}"
                                   IsEnabled="{Binding CanEditToolCallLimit}"
                                   HorizontalAlignment="Stretch"
                                   Minimum="1"
                                   Maximum="256"
                                   Increment="1"
                                   FormatString="0" />
        </Grid>
      </StackPanel>
      <StackPanel Classes="settings-actions">
        <Button Classes="compact primary sc-button"
                Content="{DynamicResource LocSaveProjectLimit}"
                Command="{Binding SaveToolCallLimitCommand}" />
        <TextBlock Text="{Binding ToolCallLimitScopeText}" Classes="sc-text-status" VerticalAlignment="Center" />
        <TextBlock Text="{Binding StatusText}" infra:StatusToneProperties.Tone="{Binding StatusTone}"
                   Classes="sc-text-status" VerticalAlignment="Center" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
