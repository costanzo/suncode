<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:SunCode.Desktop.Models"
             xmlns:vm="using:SunCode.Desktop.ViewModels"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             x:Class="SunCode.Desktop.Views.Settings.Controls.LanguageServersSettingsControl"
             x:DataType="vm:DesktopViewModel">
  <UserControl.Styles>
    <Style Selector="Border.lsp-row">
      <Setter Property="MinHeight" Value="78" />
      <Setter Property="Padding" Value="4,11" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="Button.lsp-action">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="6" />
    </Style>
    <Style Selector="Border.lsp-language">
      <Setter Property="Padding" Value="5,3" />
      <Setter Property="Margin" Value="0,0,4,4" />
      <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Classes="settings-panel-content" MaxWidth="840">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18" Margin="0,0,0,26">
        <StackPanel Spacing="4">
          <TextBlock Text="Language servers" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="Manage project-scoped semantic analysis used by the coding agent."
                     FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
        </StackPanel>
        <Button Grid.Column="1" Classes="compact primary sc-button" Click="AddClicked">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <svg:Svg Width="14" Height="14" Path="/Assets/icons/plus.svg" Css="{DynamicResource AccentInkSvgCss}" />
            <TextBlock Text="Add server" />
          </StackPanel>
        </Button>
      </Grid>

      <StackPanel x:Name="RegularList" IsVisible="False">
        <Grid ColumnDefinitions="*,105,105,70,94" ColumnSpacing="10" MinHeight="31" Margin="4,0">
          <TextBlock Text="SERVER" Classes="eyebrow" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="LANGUAGES" Classes="eyebrow" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="STATUS" Classes="eyebrow" VerticalAlignment="Center" />
          <TextBlock Grid.Column="3" Text="ENABLED" Classes="eyebrow" VerticalAlignment="Center" />
          <TextBlock Grid.Column="4" Text="ACTIONS" Classes="eyebrow" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>
        <ItemsControl ItemsSource="{Binding LanguageServers}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:LanguageServerItem">
              <Border Classes="lsp-row">
                <Grid ColumnDefinitions="*,105,105,70,94" ColumnSpacing="10">
                  <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding CommandSummary}" Classes="mono" FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Error}" FontSize="10" Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap" MaxLines="2" IsVisible="{Binding HasError}" />
                  </StackPanel>
                  <ItemsControl Grid.Column="1" ItemsSource="{Binding LanguageIds}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Classes="lsp-language">
                          <TextBlock Text="{Binding}" Classes="mono" FontSize="9" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Grid Grid.Column="2" ColumnDefinitions="7,*" ColumnSpacing="7" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" IsVisible="{Binding IsReady}" />
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" IsVisible="{Binding IsStarting}" />
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" IsVisible="{Binding IsIndexing}" />
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource DangerBrush}" IsVisible="{Binding IsFailed}" />
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource TextMutedBrush}" IsVisible="{Binding IsInactive}" />
                    <StackPanel Grid.Column="1" Spacing="3">
                      <TextBlock Text="{Binding StatusLabel}" FontSize="10" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding StatusDetail}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                  <ToggleSwitch Grid.Column="3" Classes="sc-toggle-switch settings-switch"
                                IsChecked="{Binding Enabled, Mode=OneWay}"
                                OnContent="On" OffContent="Off"
                                IsEnabled="{Binding CanToggle}"
                                Tag="{Binding}" Click="ToggleClicked" />
                  <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Classes="lsp-action quiet" Tag="{Binding}" Click="RetryClicked"
                            IsVisible="{Binding CanRetry}" ToolTip.Tip="Retry server">
                      <svg:Svg Width="14" Height="14" Path="/Assets/icons/refresh.svg" Css="{DynamicResource IconSvgCss}" />
                    </Button>
                    <Button Classes="lsp-action quiet" Tag="{Binding}" Click="EditClicked"
                            IsEnabled="{Binding !IsPending}" ToolTip.Tip="Edit server">
                      <svg:Svg Width="14" Height="14" Path="/Assets/icons/pencil.svg" Css="{DynamicResource IconSvgCss}" />
                    </Button>
                    <Button Classes="lsp-action quiet" Tag="{Binding}" Click="DeleteClicked"
                            IsEnabled="{Binding !IsPending}" ToolTip.Tip="Delete server">
                      <svg:Svg Width="14" Height="14" Path="/Assets/icons/trash-2.svg" Css="{DynamicResource IconSvgCss}" />
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <ItemsControl x:Name="CompactList" ItemsSource="{Binding LanguageServers}" IsVisible="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:LanguageServerItem">
            <Border Classes="lsp-row">
              <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto" RowSpacing="12" ColumnSpacing="14">
                <StackPanel Grid.ColumnSpan="2" Spacing="4">
                  <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding CommandSummary}" Classes="mono" FontSize="10"
                             Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Error}" FontSize="10" Foreground="{DynamicResource DangerBrush}"
                             TextWrapping="Wrap" MaxLines="2" IsVisible="{Binding HasError}" />
                </StackPanel>
                <ItemsControl Grid.Column="2" ItemsSource="{Binding LanguageIds}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Classes="lsp-language"><TextBlock Text="{Binding}" Classes="mono" FontSize="9" /></Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid Grid.Row="1" ColumnDefinitions="7,*" ColumnSpacing="7" VerticalAlignment="Center">
                  <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" IsVisible="{Binding IsReady}" />
                  <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" IsVisible="{Binding IsStarting}" />
                  <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" IsVisible="{Binding IsIndexing}" />
                  <Ellipse Width="6" Height="6" Fill="{DynamicResource DangerBrush}" IsVisible="{Binding IsFailed}" />
                  <Ellipse Width="6" Height="6" Fill="{DynamicResource TextMutedBrush}" IsVisible="{Binding IsInactive}" />
                  <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Text="{Binding StatusLabel}" FontSize="10" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusDetail}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" />
                  </StackPanel>
                </Grid>
                <ToggleSwitch Grid.Row="1" Grid.Column="1" Classes="sc-toggle-switch settings-switch"
                              IsChecked="{Binding Enabled, Mode=OneWay}" OnContent="On" OffContent="Off"
                              IsEnabled="{Binding CanToggle}" Tag="{Binding}" Click="ToggleClicked" />
                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right">
                  <Button Classes="lsp-action quiet" Tag="{Binding}" Click="RetryClicked" IsVisible="{Binding CanRetry}" ToolTip.Tip="Retry server">
                    <svg:Svg Width="14" Height="14" Path="/Assets/icons/refresh.svg" Css="{DynamicResource IconSvgCss}" />
                  </Button>
                  <Button Classes="lsp-action quiet" Tag="{Binding}" Click="EditClicked" IsEnabled="{Binding !IsPending}" ToolTip.Tip="Edit server">
                    <svg:Svg Width="14" Height="14" Path="/Assets/icons/pencil.svg" Css="{DynamicResource IconSvgCss}" />
                  </Button>
                  <Button Classes="lsp-action quiet" Tag="{Binding}" Click="DeleteClicked" IsEnabled="{Binding !IsPending}" ToolTip.Tip="Delete server">
                    <svg:Svg Width="14" Height="14" Path="/Assets/icons/trash-2.svg" Css="{DynamicResource IconSvgCss}" />
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border IsVisible="{Binding HasNoLanguageServers}" Padding="24" Margin="0,8,0,0"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
        <StackPanel Spacing="7" HorizontalAlignment="Center">
          <svg:Svg Width="22" Height="22" Path="/Assets/icons/file-code.svg" Css="{DynamicResource IconSvgCss}" />
          <TextBlock Text="No language servers configured" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="Add a local language server to give the agent project-aware semantic context."
                     FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <TextBlock Text="{Binding LanguageServerStatusText}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                 TextWrapping="Wrap" Margin="0,14,0,0" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
