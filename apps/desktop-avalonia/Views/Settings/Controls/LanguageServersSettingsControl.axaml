<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:SunCode.Desktop.Controls"
             xmlns:models="using:SunCode.Desktop.Models"
             xmlns:vm="using:SunCode.Desktop.ViewModels"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             x:Class="SunCode.Desktop.Views.Settings.Controls.LanguageServersSettingsControl"
             x:DataType="vm:LanguageServersViewModel">
  <UserControl.Styles>
    <Style Selector="Border.lsp-context">
      <Setter Property="Padding" Value="4,12" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="0,1" />
    </Style>
    <Style Selector="Border.lsp-catalog-row">
      <Setter Property="MinHeight" Value="108" />
      <Setter Property="Padding" Value="4,14" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="Border.lsp-mark">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <Grid>
      <StackPanel x:Name="CatalogPanel" Classes="settings-panel-content" MaxWidth="840">
        <StackPanel Classes="settings-panel-heading">
          <TextBlock Text="{DynamicResource LocLanguageServers}" Classes="sc-text-title" />
          <TextBlock Text="{DynamicResource LocLanguageServersProjectHint}" Classes="settings-hint" />
        </StackPanel>

        <Border Classes="lsp-context" IsVisible="{Binding HasProject}" Margin="0,0,0,26">
          <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
            <svg:Svg Width="16" Height="16" Path="/Assets/icons/folder.svg" Css="{DynamicResource IconSvgCss}" />
            <StackPanel Grid.Column="1" Spacing="3">
              <TextBlock Text="{DynamicResource LocCurrentProject}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding ProjectName}" FontSize="12" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ProjectPath}" Classes="mono" FontSize="10"
                           Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>
        <Border IsVisible="{Binding !HasProject}" Padding="12" Margin="0,0,0,26"
                Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="6">
          <TextBlock Text="{DynamicResource LocOpenLspSettingsFromProject}" FontSize="11"
                     Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
        </Border>

        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
          <TextBlock Text="{DynamicResource LocAvailableForProject}" FontSize="11" FontWeight="SemiBold" />
          <TextBlock Grid.Column="1" Text="{Binding Servers.Count, StringFormat={}{0} supported}"
                     Classes="mono" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Servers}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:LanguageServerItem">
              <Border Classes="lsp-catalog-row">
                <Grid ColumnDefinitions="34,*,130,68,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                  <Border Classes="lsp-mark">
                    <svg:Svg Width="17" Height="17" Path="/Assets/icons/file-code.svg" Css="{DynamicResource IconSvgCss}" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="5">
                    <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap" MaxLines="2" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock Text="{Binding Kind}" Classes="mono" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBlock Text="{Binding Language}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" />
                      <TextBlock Text="{Binding DetectionLabel}" FontSize="9" Foreground="{DynamicResource SuccessBrush}" />
                    </StackPanel>
                  </StackPanel>
                  <Grid Grid.Column="2" ColumnDefinitions="7,*" ColumnSpacing="7">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" IsVisible="{Binding IsReady}" />
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" IsVisible="{Binding IsStarting}" />
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" IsVisible="{Binding IsIndexing}" />
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource DangerBrush}" IsVisible="{Binding IsFailed}" />
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource TextMutedBrush}" IsVisible="{Binding IsInactive}" />
                    <StackPanel Grid.Column="1" Spacing="3">
                      <TextBlock Text="{Binding StatusLabel}" FontSize="10" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding StatusDetail}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                  <ToggleSwitch Grid.Column="3" Classes="sc-toggle-switch settings-switch"
                                IsChecked="{Binding Enabled, Mode=OneWay}" IsEnabled="{Binding CanToggle}"
                                OnContent="{DynamicResource LocOn}" OffContent="{DynamicResource LocOff}"
                                Tag="{Binding}" Click="ToggleClicked" />
                  <Button Grid.Column="4" Classes="compact sc-button" Content="{DynamicResource LocConfigure}"
                          IsEnabled="{Binding CanConfigure}" Tag="{Binding}" Click="ConfigureClicked" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{DynamicResource LocLspAuthorityHint}"
                   Margin="0,14,0,0" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel x:Name="DetailPanel" Classes="settings-panel-content" MaxWidth="840" IsVisible="False">
        <Button Classes="quiet compact sc-button" HorizontalAlignment="Left" Click="BackClicked" Margin="-8,0,0,18">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <svg:Svg Width="12" Height="12" Path="/Assets/icons/chevron-right.svg"
                     Css="{DynamicResource IconSvgCss}" RenderTransform="rotate(180deg)" />
            <TextBlock Text="{DynamicResource LocLanguageServers}" />
          </StackPanel>
        </Button>
        <Grid ColumnDefinitions="38,*,160" ColumnSpacing="12" Margin="0,0,0,26">
          <Border Classes="lsp-mark">
            <svg:Svg Width="18" Height="18" Path="/Assets/icons/file-code.svg" Css="{DynamicResource IconSvgCss}" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock x:Name="DetailTitle" Classes="sc-text-title" />
            <TextBlock x:Name="DetailSubtitle" Classes="settings-hint" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="3">
            <TextBlock x:Name="DetailStatus" FontSize="10" FontWeight="SemiBold" />
            <TextBlock x:Name="DetailStatusText" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>

        <Border x:Name="FailureBanner"
                IsVisible="False"
                Margin="0,0,0,24"
                Padding="12,10"
                Background="{DynamicResource DangerSurfaceBrush}"
                BorderBrush="{DynamicResource DangerBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="3">
              <TextBlock x:Name="FailureTitle"
                         FontSize="11"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource DangerBrush}" />
              <TextBlock x:Name="DetailErrorText"
                         Classes="mono"
                         FontSize="10"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         TextWrapping="Wrap" />
            </StackPanel>
            <Button x:Name="RetryButton"
                    Grid.Column="1"
                    Classes="compact sc-button"
                    Content="{DynamicResource LocRetry}"
                    VerticalAlignment="Center"
                    Click="RetryClicked" />
          </Grid>
        </Border>

        <StackPanel Classes="settings-panel-section">
          <TextBlock Text="{DynamicResource LocProjectAvailabilityCaps}" Classes="section-label" />
          <Grid Classes="settings-row" ColumnDefinitions="*,220">
            <StackPanel Classes="settings-row-copy">
              <TextBlock Text="{DynamicResource LocEnableForProject}" Classes="settings-row-title" />
              <TextBlock x:Name="EnableHint" Classes="settings-row-hint" />
            </StackPanel>
            <ToggleSwitch x:Name="EnabledToggle" Grid.Column="1" Classes="sc-toggle-switch settings-switch"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          OnContent="{DynamicResource LocOn}" OffContent="{DynamicResource LocOff}" />
          </Grid>
          <Grid Classes="settings-row" ColumnDefinitions="*,220">
            <StackPanel Classes="settings-row-copy">
              <TextBlock Text="{DynamicResource LocProjectDetection}" Classes="settings-row-title" />
              <TextBlock Text="{DynamicResource LocProjectDetectionHint}" Classes="settings-row-hint" />
            </StackPanel>
            <TextBlock x:Name="MatchedRootMarkerText" Grid.Column="1" Classes="mono"
                       FontSize="10" Foreground="{DynamicResource SuccessBrush}"
                       VerticalAlignment="Center" TextWrapping="Wrap" />
          </Grid>
        </StackPanel>

        <Border Classes="settings-divider" />
        <StackPanel Classes="settings-panel-section">
          <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <TextBlock Text="{DynamicResource LocInstallationCaps}" Classes="section-label" />
            <Button Grid.Column="1" Classes="compact sc-button" Click="DetectClicked">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <svg:Svg Width="13" Height="13" Path="/Assets/icons/refresh.svg" Css="{DynamicResource IconSvgCss}" />
                <TextBlock Text="{DynamicResource LocDetectAgain}" />
              </StackPanel>
            </Button>
          </Grid>
          <Grid Classes="settings-row" ColumnDefinitions="*,220">
            <StackPanel Classes="settings-row-copy">
              <TextBlock x:Name="ExecutableLabel" Classes="settings-row-title" />
              <TextBlock x:Name="ExecutableHint" Classes="settings-row-hint" />
            </StackPanel>
            <controls:SCFileSelector x:Name="ExecutableInput" Grid.Column="1"
                                     SelectionMode="File" DialogTitle="Choose jdtls executable" />
          </Grid>
          <Grid x:Name="JavaRuntimeRow" Classes="settings-row" ColumnDefinitions="*,220">
            <StackPanel Classes="settings-row-copy">
              <TextBlock Text="{DynamicResource LocJavaRuntime}" Classes="settings-row-title" />
              <TextBlock Text="{DynamicResource LocJavaRuntimeHint}" Classes="settings-row-hint" />
            </StackPanel>
            <controls:SCFileSelector x:Name="JavaHomeInput" Grid.Column="1"
                                     SelectionMode="Folder" DialogTitle="Choose Java runtime" />
          </Grid>
          <Grid x:Name="NodeRuntimeRow" Classes="settings-row" ColumnDefinitions="*,220" IsVisible="False">
            <StackPanel Classes="settings-row-copy">
              <TextBlock Text="{DynamicResource LocNodeRuntime}" Classes="settings-row-title" />
              <TextBlock x:Name="NodeRuntimeHint" Classes="settings-row-hint" />
            </StackPanel>
            <controls:SCFileSelector x:Name="NodePathInput" Grid.Column="1"
                                     SelectionMode="File" DialogTitle="Choose Node.js executable" />
          </Grid>
        </StackPanel>

        <Border x:Name="PythonEnvironmentDivider" Classes="settings-divider" IsVisible="False" />
        <StackPanel x:Name="PythonEnvironmentSection" Classes="settings-panel-section" IsVisible="False">
          <TextBlock Text="{DynamicResource LocPythonEnvironmentCaps}" Classes="section-label" />
          <Grid Classes="settings-row" ColumnDefinitions="*,220">
            <StackPanel Classes="settings-row-copy">
              <TextBlock Text="{DynamicResource LocPythonInterpreter}" Classes="settings-row-title" />
              <TextBlock x:Name="PythonInterpreterHint" Classes="settings-row-hint" />
            </StackPanel>
            <controls:SCFileSelector x:Name="PythonPathInput" Grid.Column="1"
                                     SelectionMode="File" DialogTitle="Choose Python interpreter" />
          </Grid>
        </StackPanel>

        <Border Classes="settings-divider" />
        <StackPanel Classes="settings-panel-section">
          <TextBlock x:Name="ProjectConfigurationLabel" Text="{DynamicResource LocProjectIndexCaps}" Classes="section-label" />
          <Grid x:Name="DataPathModeRow" Classes="settings-row" ColumnDefinitions="*,220">
            <StackPanel Classes="settings-row-copy">
              <TextBlock Text="{DynamicResource LocDataDirectory}" Classes="settings-row-title" />
              <TextBlock Text="{DynamicResource LocJdtlsDataHint}" Classes="settings-row-hint" />
            </StackPanel>
            <controls:SCFlatComboBox x:Name="DataPathModeSelector" Grid.Column="1"
                                     HorizontalAlignment="Stretch" SelectionChanged="DataPathModeChanged" />
          </Grid>
          <Grid x:Name="DataPathRow" Classes="settings-row" ColumnDefinitions="*,220">
            <StackPanel Classes="settings-row-copy">
              <TextBlock Text="{DynamicResource LocResolvedDataPath}" Classes="settings-row-title" />
              <TextBlock Text="{DynamicResource LocResolvedDataPathHint}" Classes="settings-row-hint" />
            </StackPanel>
            <controls:SCFileSelector x:Name="DataPathInput" Grid.Column="1"
                                     SelectionMode="Folder" DialogTitle="Choose jdtls data directory" />
          </Grid>
          <Grid Classes="settings-row" ColumnDefinitions="*,220" VerticalAlignment="Top">
            <StackPanel Classes="settings-row-copy">
              <TextBlock Text="{DynamicResource LocRootMarkers}" Classes="settings-row-title" />
              <TextBlock x:Name="RootMarkersHint" Classes="settings-row-hint" />
            </StackPanel>
            <TextBox x:Name="RootMarkersInput" Grid.Column="1" Classes="mono settings-proxy-bypass"
                     AcceptsReturn="True" Height="84" TextWrapping="NoWrap" />
          </Grid>
          <Grid x:Name="TypeScriptSdkModeRow" Classes="settings-row" ColumnDefinitions="*,220" IsVisible="False">
            <StackPanel Classes="settings-row-copy">
              <TextBlock Text="{DynamicResource LocTypeScriptSdk}" Classes="settings-row-title" />
              <TextBlock Text="{DynamicResource LocTypeScriptSdkHint}" Classes="settings-row-hint" />
            </StackPanel>
            <controls:SCFlatComboBox x:Name="TypeScriptSdkModeSelector" Grid.Column="1"
                                     HorizontalAlignment="Stretch" SelectionChanged="TypeScriptSdkModeChanged" />
          </Grid>
          <Grid x:Name="TypeScriptSdkPathRow" Classes="settings-row" ColumnDefinitions="*,220" IsVisible="False">
            <StackPanel Classes="settings-row-copy">
              <TextBlock Text="{DynamicResource LocTypeScriptSdkPath}" Classes="settings-row-title" />
              <TextBlock Text="{DynamicResource LocTypeScriptSdkPathHint}" Classes="settings-row-hint" />
            </StackPanel>
            <controls:SCFileSelector x:Name="TypeScriptSdkPathInput" Grid.Column="1"
                                     SelectionMode="Folder" DialogTitle="Choose TypeScript SDK lib directory" />
          </Grid>
          <Grid x:Name="TsServerMemoryRow" Classes="settings-row" ColumnDefinitions="*,220" IsVisible="False">
            <StackPanel Classes="settings-row-copy">
              <TextBlock Text="{DynamicResource LocTsServerMemory}" Classes="settings-row-title" />
              <TextBlock Text="{DynamicResource LocTsServerMemoryHint}" Classes="settings-row-hint" />
            </StackPanel>
            <controls:SCNumericInput x:Name="TsServerMemoryInput" Grid.Column="1"
                                     Minimum="512" Maximum="16384" Increment="256" Unit="MIB" />
          </Grid>
        </StackPanel>

        <Border x:Name="PythonAnalysisDivider" Classes="settings-divider" IsVisible="False" />
        <StackPanel x:Name="PythonAnalysisSection" Classes="settings-panel-section" IsVisible="False">
          <TextBlock Text="{DynamicResource LocPythonAnalysisCaps}" Classes="section-label" />
          <Grid Classes="settings-row" ColumnDefinitions="*,220">
            <StackPanel Classes="settings-row-copy">
              <TextBlock Text="{DynamicResource LocDiagnosticScope}" Classes="settings-row-title" />
              <TextBlock x:Name="DiagnosticModeHint" Classes="settings-row-hint" />
            </StackPanel>
            <controls:SCFlatComboBox x:Name="DiagnosticModeSelector" Grid.Column="1"
                                     HorizontalAlignment="Stretch" SelectionChanged="BasedpyrightOptionChanged" />
          </Grid>
          <Grid Classes="settings-row" ColumnDefinitions="*,220">
            <StackPanel Classes="settings-row-copy">
              <TextBlock Text="{DynamicResource LocTypeChecking}" Classes="settings-row-title" />
              <TextBlock Text="{DynamicResource LocTypeCheckingHint}" Classes="settings-row-hint" />
            </StackPanel>
            <controls:SCFlatComboBox x:Name="TypeCheckingModeSelector" Grid.Column="1"
                                     HorizontalAlignment="Stretch" SelectionChanged="BasedpyrightOptionChanged" />
          </Grid>
          <Grid Classes="settings-row" ColumnDefinitions="*,220">
            <StackPanel Classes="settings-row-copy">
              <TextBlock Text="{DynamicResource LocConfigurationLocation}" Classes="settings-row-title" />
              <TextBlock x:Name="ConfigPathModeHint" Classes="settings-row-hint" />
            </StackPanel>
            <controls:SCFlatComboBox x:Name="ConfigPathModeSelector" Grid.Column="1"
                                     HorizontalAlignment="Stretch" SelectionChanged="ConfigPathModeChanged" />
          </Grid>
          <Grid x:Name="CustomConfigPathRow" Classes="settings-row" ColumnDefinitions="*,220" IsVisible="False">
            <StackPanel Classes="settings-row-copy">
              <TextBlock Text="{DynamicResource LocConfigurationFileOrDirectory}" Classes="settings-row-title" />
              <TextBlock Text="{DynamicResource LocConfigurationFileOrDirectoryHint}" Classes="settings-row-hint" />
            </StackPanel>
            <controls:SCFileSelector x:Name="ConfigPathInput" Grid.Column="1"
                                     SelectionMode="Folder" DialogTitle="Choose basedpyright configuration location" />
          </Grid>
        </StackPanel>

        <Expander Classes="settings-expander" Header="{DynamicResource LocAdvancedConfiguration}" Margin="0,28,0,0">
          <StackPanel Classes="settings-panel-section">
            <Grid Classes="settings-row" ColumnDefinitions="*,220" VerticalAlignment="Top">
              <StackPanel Classes="settings-row-copy">
                <TextBlock Text="{DynamicResource LocEnvironment}" Classes="settings-row-title" />
                <TextBlock Text="{DynamicResource LocEnvironmentEntriesHint}" Classes="settings-row-hint" />
              </StackPanel>
              <TextBox x:Name="EnvironmentInput" Grid.Column="1" Classes="mono settings-proxy-bypass"
                       AcceptsReturn="True" Height="84" TextWrapping="NoWrap" PlaceholderText="NAME=value" />
            </Grid>
            <Grid Classes="settings-row" ColumnDefinitions="*,220">
              <StackPanel Classes="settings-row-copy">
                <TextBlock Text="{DynamicResource LocStartupTimeoutSeconds}" Classes="settings-row-title" />
              </StackPanel>
              <controls:SCNumericInput x:Name="StartupTimeoutInput" Grid.Column="1"
                                       Minimum="1" Maximum="120" Increment="1" Unit="SEC" />
            </Grid>
            <Grid Classes="settings-row" ColumnDefinitions="*,220">
              <StackPanel Classes="settings-row-copy">
                <TextBlock Text="{DynamicResource LocRequestTimeoutSeconds}" Classes="settings-row-title" />
              </StackPanel>
              <controls:SCNumericInput x:Name="RequestTimeoutInput" Grid.Column="1"
                                       Minimum="1" Maximum="600" Increment="1" Unit="SEC" />
            </Grid>
          </StackPanel>
        </Expander>

        <TextBlock x:Name="ValidationText" Classes="sc-text-status" Margin="0,16,0,0"
                   Foreground="{DynamicResource DangerBrush}" />
        <StackPanel Classes="settings-actions" HorizontalAlignment="Right">
          <Button x:Name="ResetButton" Classes="compact sc-button"
                  Content="{DynamicResource LocResetChanges}" Click="ResetClicked" IsEnabled="False" />
          <Button x:Name="SaveButton" Classes="compact primary sc-button"
                  Content="{DynamicResource LocSaveConfiguration}" Click="SaveClicked" IsEnabled="False" />
        </StackPanel>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
