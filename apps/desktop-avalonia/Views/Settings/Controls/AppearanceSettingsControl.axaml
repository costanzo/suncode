<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:SunCode.Desktop.Controls"
             x:Class="SunCode.Desktop.Views.Settings.Controls.AppearanceSettingsControl">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Classes="settings-panel-content">
      <StackPanel Classes="settings-panel-heading">
        <TextBlock Text="{DynamicResource Loc_Appearance}" Classes="sc-text-title" />
        <TextBlock Classes="settings-hint" Text="{DynamicResource Loc_AppearanceHint}" />
      </StackPanel>
      <StackPanel Classes="settings-panel-section">
        <TextBlock Classes="section-label" Text="{DynamicResource Loc_Theme}" />
        <Grid Classes="settings-row" ColumnDefinitions="*,220">
          <StackPanel Classes="settings-row-copy">
            <TextBlock Classes="settings-row-title" Text="{DynamicResource Loc_ColorTheme}" />
            <TextBlock Classes="settings-row-hint" Text="{DynamicResource Loc_ChangesApplyImmediately}" />
          </StackPanel>
          <controls:SCFlatComboBox x:Name="ThemeSelector"
                                   Grid.Column="1"
                                   HorizontalAlignment="Stretch"
                                   PlaceholderText="{DynamicResource Loc_ChooseTheme}"
                                   SelectionChanged="OnThemeChanged" />
        </Grid>
      </StackPanel>
      <Border Classes="settings-divider" />
      <StackPanel Classes="settings-panel-section">
        <TextBlock Classes="section-label" Text="{DynamicResource Loc_Language}" />
        <Grid Classes="settings-row" ColumnDefinitions="*,220">
          <StackPanel Classes="settings-row-copy">
            <TextBlock Classes="settings-row-title" Text="{DynamicResource Loc_InterfaceLanguage}" />
            <TextBlock Classes="settings-row-hint" Text="{DynamicResource Loc_LanguageHint}" />
          </StackPanel>
          <controls:SCFlatComboBox x:Name="LanguageSelector"
                                   Grid.Column="1"
                                   HorizontalAlignment="Stretch"
                                   PlaceholderText="{DynamicResource Loc_ChooseLanguage}"
                                   SelectionChanged="OnLanguageChanged" />
        </Grid>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
