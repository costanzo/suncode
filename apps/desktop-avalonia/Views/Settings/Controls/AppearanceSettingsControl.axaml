<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:SunCode.Desktop.Controls"
             x:Class="SunCode.Desktop.Views.Settings.Controls.AppearanceSettingsControl">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Classes="settings-panel-content">
      <StackPanel Classes="settings-panel-heading">
        <TextBlock Text="{DynamicResource LocAppearance}" Classes="sc-text-title" />
        <TextBlock Classes="settings-hint" Text="{DynamicResource LocAppearanceHint}" />
      </StackPanel>
      <StackPanel Classes="settings-panel-section">
        <TextBlock Classes="section-label" Text="{DynamicResource LocTheme}" />
        <Grid Classes="settings-row" ColumnDefinitions="*,220">
          <StackPanel Classes="settings-row-copy">
            <TextBlock Classes="settings-row-title" Text="{DynamicResource LocColorTheme}" />
            <TextBlock Classes="settings-row-hint" Text="{DynamicResource LocChangesApplyImmediately}" />
          </StackPanel>
          <controls:SCFlatComboBox x:Name="ThemeSelector"
                                   Grid.Column="1"
                                   HorizontalAlignment="Stretch"
                                   PlaceholderText="{DynamicResource LocChooseTheme}"
                                   SelectionChanged="OnThemeChanged" />
        </Grid>
      </StackPanel>
      <Border Classes="settings-divider" />
      <StackPanel Classes="settings-panel-section">
        <TextBlock Classes="section-label" Text="{DynamicResource LocLanguage}" />
        <Grid Classes="settings-row" ColumnDefinitions="*,220">
          <StackPanel Classes="settings-row-copy">
            <TextBlock Classes="settings-row-title" Text="{DynamicResource LocInterfaceLanguage}" />
            <TextBlock Classes="settings-row-hint" Text="{DynamicResource LocLanguageHint}" />
          </StackPanel>
          <controls:SCFlatComboBox x:Name="LanguageSelector"
                                   Grid.Column="1"
                                   HorizontalAlignment="Stretch"
                                   PlaceholderText="{DynamicResource LocChooseLanguage}"
                                   SelectionChanged="OnLanguageChanged" />
        </Grid>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
