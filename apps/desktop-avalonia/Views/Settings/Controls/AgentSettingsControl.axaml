<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:SunCode.Desktop.Models"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             x:Class="SunCode.Desktop.Views.Settings.Controls.AgentSettingsControl"
             x:CompileBindings="False">
  <UserControl.Styles>
    <Style Selector="Button.agent-overview-row">
      <Setter Property="MinHeight" Value="74" />
      <Setter Property="Padding" Value="4,10" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.agent-overview-row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid>
      <StackPanel x:Name="OverviewPanel" Classes="settings-panel-content">
        <StackPanel Classes="settings-panel-heading">
          <TextBlock Text="Agents" Classes="sc-text-title" />
          <TextBlock Text="Built-in agents available for delegation from the main session."
                     Classes="sc-text-hint" />
        </StackPanel>
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
        <ItemsControl x:Name="AgentItemsControl" HorizontalAlignment="Stretch">
          <ItemsControl.Styles><Style Selector="ContentPresenter"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ItemsControl.Styles>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:AgentItem">
              <Button Classes="agent-overview-row"
                      CommandParameter="{Binding}" Click="SelectAgent">
                <Grid ColumnDefinitions="34,12,*,16" VerticalAlignment="Center">
                  <Border Width="32" Height="32" CornerRadius="6" Background="{DynamicResource SurfaceAccentBrush}">
                    <svg:Svg Width="15" Height="15" Path="/Assets/icons/agent.svg" Css="{DynamicResource IconSvgCss}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="2" Spacing="3">
                    <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Name}" Classes="mono" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" />
                  </StackPanel>
                  <svg:Svg Grid.Column="3" Width="13" Height="13" Path="/Assets/icons/chevron-right.svg" Css="{DynamicResource IconSvgCss}" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        </Border>
      </StackPanel>

      <StackPanel x:Name="DetailPanel" Classes="settings-panel-content" Spacing="0" IsVisible="False">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,30">
          <StackPanel Spacing="5">
            <TextBlock x:Name="DetailTitle" FontSize="22" FontWeight="SemiBold" />
            <TextBlock x:Name="DetailDescription" MaxWidth="580" FontSize="12" LineHeight="18" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
          </StackPanel>
          <Border Grid.Column="1" Classes="settings-read-only-badge" Margin="18,2,0,0">
            <TextBlock Text="READ ONLY" Classes="mono" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
          </Border>
        </Grid>

        <Grid ColumnDefinitions="42,12,*" Margin="0,0,0,26">
          <Border Width="42" Height="42" CornerRadius="6" Background="{DynamicResource SurfaceAccentBrush}">
            <svg:Svg Width="19" Height="19" Path="/Assets/icons/agent.svg" Css="{DynamicResource IconSvgCss}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
            <TextBlock x:Name="DetailDisplayName" FontSize="13" FontWeight="SemiBold" />
            <TextBlock x:Name="DetailName" Classes="mono" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,0,0,28">
          <Border Padding="12" MinHeight="58" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,0,0">
            <StackPanel Spacing="5"><TextBlock Text="STABLE ID" Classes="eyebrow" /><TextBlock x:Name="DetailId" Classes="mono" FontSize="10" /></StackPanel>
          </Border>
          <Border Grid.Column="1" Padding="12" MinHeight="58" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,1,0">
            <StackPanel Spacing="5"><TextBlock Text="VERSION" Classes="eyebrow" /><TextBlock x:Name="DetailVersion" Classes="mono" FontSize="10" /></StackPanel>
          </Border>
          <Border Grid.Row="1" Padding="12" MinHeight="58" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel Spacing="5"><TextBlock Text="MODEL" Classes="eyebrow" /><TextBlock x:Name="DetailModelPolicy" FontSize="10" /></StackPanel>
          </Border>
          <Border Grid.Row="1" Grid.Column="1" Padding="12" MinHeight="58" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,1,1">
            <StackPanel Spacing="5"><TextBlock Text="TOOL LIMIT" Classes="eyebrow" /><TextBlock x:Name="DetailToolLimit" FontSize="10" /></StackPanel>
          </Border>
        </Grid>

        <StackPanel Spacing="12" Margin="0,0,0,30">
          <TextBlock Text="ALLOWED TOOLS" Classes="eyebrow" />
          <ItemsControl x:Name="AllowedTools">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate><Border Margin="0,0,8,8" Padding="8,6" CornerRadius="5" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><TextBlock Text="{Binding}" Classes="mono" FontSize="10" /></Border></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="12">
          <TextBlock Text="BOUNDARIES" Classes="eyebrow" />
          <Grid RowDefinitions="42,42,42">
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="MCP tools" FontSize="11" VerticalAlignment="Center" /><TextBlock Grid.Column="1" x:Name="DetailMcp" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" /></Grid></Border>
            <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Delegate again" FontSize="11" VerticalAlignment="Center" /><TextBlock Grid.Column="1" x:Name="DetailDelegate" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" /></Grid></Border>
            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Direct user chat" FontSize="11" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="Not allowed" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" /></Grid></Border>
          </Grid>
        </StackPanel>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
