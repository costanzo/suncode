<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             x:Class="SunCode.Desktop.Views.Settings.Controls.RemoteServerSettingsControl">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Classes="settings-panel-content">
      <StackPanel Classes="settings-panel-heading">
        <TextBlock Text="{DynamicResource LocRemoteServer}" Classes="sc-text-title" />
        <TextBlock Classes="settings-hint" Text="{DynamicResource LocRemoteServerHint}" />
      </StackPanel>
      <StackPanel Classes="settings-panel-section">
        <TextBlock Classes="section-label" Text="{DynamicResource LocConnection}" />
        <Grid Classes="settings-row" ColumnDefinitions="*,260">
          <StackPanel Classes="settings-row-copy"><TextBlock Classes="settings-row-title" Text="{DynamicResource LocServerUrl}" /><TextBlock Classes="settings-row-hint" Text="{DynamicResource LocServerUrlHint}" /></StackPanel>
          <TextBox x:Name="ServerUrlInput" Grid.Column="1" PlaceholderText="{DynamicResource LocRemoteUrlPlaceholder}" />
        </Grid>
        <Grid Classes="settings-row" ColumnDefinitions="*,260">
          <StackPanel Classes="settings-row-copy"><TextBlock Classes="settings-row-title" Text="{DynamicResource LocPairingCode}" /><TextBlock Classes="settings-row-hint" Text="{DynamicResource LocPairingCodeHint}" /></StackPanel>
          <TextBox x:Name="PairingCodeInput" Grid.Column="1" PasswordChar="•" PlaceholderText="{DynamicResource LocPairingCodePlaceholder}" />
        </Grid>
        <Grid Classes="settings-row" ColumnDefinitions="*,260">
          <StackPanel Classes="settings-row-copy"><TextBlock Classes="settings-row-title" Text="{DynamicResource LocRemoteE2e}" /><TextBlock Classes="settings-row-hint" Text="{DynamicResource LocRemoteE2eHint}" TextWrapping="Wrap" /></StackPanel>
          <ToggleSwitch x:Name="E2eToggle" Grid.Column="1" Classes="sc-toggle-switch settings-switch" IsChecked="True" OnContent="{DynamicResource LocOn}" OffContent="{DynamicResource LocOff}" />
        </Grid>
      </StackPanel>
      <StackPanel Classes="settings-actions">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="SaveButton" Classes="compact primary sc-button" Content="{DynamicResource LocSaveAndConnect}" Click="OnSave" />
          <Button x:Name="DisconnectButton" Classes="compact sc-button" Content="{DynamicResource LocDisconnect}" Click="OnDisconnect" IsVisible="False" />
          <Button x:Name="ClearButton" Classes="compact sc-button" Content="{DynamicResource LocClear}" Click="OnClear" />
        </StackPanel>
        <TextBlock x:Name="StatusText" Classes="sc-text-status" />
      </StackPanel>
      <Border Classes="settings-divider" />
      <StackPanel Classes="settings-panel-section" IsVisible="False" x:Name="PairingSection">
        <TextBlock Classes="section-label" Text="{DynamicResource LocPhonePairing}" />
        <TextBlock Classes="settings-row-hint" Text="{DynamicResource LocScanMobilePayload}" TextWrapping="Wrap" />
        <Grid RowDefinitions="Auto,Auto" Margin="0,12,0,0">
          <Border Width="160" Height="160" Background="White" Padding="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Image x:Name="PairingQrImage" Stretch="Uniform" />
          </Border>
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,12,0,0">
            <TextBlock x:Name="PairingPayloadText" TextWrapping="Wrap" FontFamily="monospace" VerticalAlignment="Center" />
            <Button x:Name="CopyPairingButton" Grid.Column="1" Classes="icon quiet sc-button"
                    ToolTip.Tip="{DynamicResource LocCopyPairingLink}"
                    AutomationProperties.Name="{DynamicResource LocCopyPairingLink}" Click="OnCopyPairing">
              <svg:Svg Width="14" Height="14" Path="/Assets/icons/copy.svg" Css="{DynamicResource IconSvgCss}" />
            </Button>
          </Grid>
        </Grid>
        <TextBlock x:Name="PairingMetadataText" Margin="0,12,0,0" Classes="settings-hint" TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
