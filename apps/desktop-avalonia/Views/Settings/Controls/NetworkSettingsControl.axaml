<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:SunCode.Desktop.Controls"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             xmlns:vm="using:SunCode.Desktop.ViewModels"
             x:Class="SunCode.Desktop.Views.Settings.Controls.NetworkSettingsControl" x:DataType="vm:NetworkSettingsViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Classes="settings-panel-content">
      <StackPanel Classes="settings-panel-heading">
        <TextBlock Text="{DynamicResource Loc_Network}" Classes="sc-text-title" />
        <TextBlock Classes="settings-hint" Text="{DynamicResource Loc_NetworkHint}" />
      </StackPanel>
      <StackPanel Classes="settings-panel-section">
        <TextBlock Classes="section-label" Text="{DynamicResource Loc_Proxy}" />
        <Grid Classes="settings-row" ColumnDefinitions="*,220">
          <StackPanel Classes="settings-row-copy">
            <TextBlock Classes="settings-row-title" Text="{DynamicResource Loc_ProxyMode}" />
            <TextBlock Classes="settings-row-hint"
                       Text="{DynamicResource Loc_ProxyModeHint}" />
          </StackPanel>
          <controls:SCFlatComboBox x:Name="ProxyModeSelector" Grid.Column="1" HorizontalAlignment="Stretch"
                                   SelectionChanged="OnProxyModeChanged" />
        </Grid>
        <Border x:Name="CustomProxySection" Classes="settings-subsection" IsVisible="False">
          <StackPanel Spacing="14">
            <TextBlock Text="{DynamicResource Loc_CustomProxy}" Classes="section-label" />
            <Grid Classes="settings-row" ColumnDefinitions="*,220">
              <StackPanel Classes="settings-row-copy">
                <TextBlock Classes="settings-row-title" Text="{DynamicResource Loc_ProxyUrl}" />
                <TextBlock Classes="settings-row-hint" Text="{DynamicResource Loc_ProxyUrlHint}" />
              </StackPanel>
              <TextBox x:Name="ProxyUrlInput" Grid.Column="1" Classes="mono settings-provider-input"
                       PlaceholderText="http://proxy.example.com:8080" TextChanged="OnProxyTextChanged" />
            </Grid>
            <Grid Classes="settings-row" ColumnDefinitions="*,220">
              <StackPanel Classes="settings-row-copy">
                <TextBlock Classes="settings-row-title" Text="{DynamicResource Loc_Username}" />
                <TextBlock Classes="settings-row-hint" Text="{DynamicResource Loc_ProxyUsernameHint}" />
              </StackPanel>
              <TextBox x:Name="ProxyUsernameInput" Grid.Column="1" Classes="mono settings-provider-input"
                       TextChanged="OnProxyTextChanged" />
            </Grid>
            <Grid Classes="settings-row" ColumnDefinitions="*,220">
              <StackPanel Classes="settings-row-copy">
                <TextBlock Classes="settings-row-title" Text="{DynamicResource Loc_Password}" />
                <TextBlock x:Name="ProxyPasswordHint" Classes="settings-row-hint"
                           Text="{DynamicResource Loc_ProxyPasswordHint}" />
              </StackPanel>
              <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox x:Name="ProxyPasswordInput" Classes="mono sc-secret-input settings-provider-input"
                         PlaceholderText="{DynamicResource Loc_Optional}" TextChanged="OnProxyTextChanged" />
                <Button x:Name="RemoveProxyPasswordButton" Grid.Column="1" Classes="compact quiet sc-button"
                        Content="{DynamicResource Loc_Remove}" IsVisible="False" Click="OnRemoveProxyPassword" />
              </Grid>
            </Grid>
            <Grid Classes="settings-row" ColumnDefinitions="*,220" VerticalAlignment="Top">
              <StackPanel Classes="settings-row-copy">
                <TextBlock Classes="settings-row-title" Text="{DynamicResource Loc_BypassRules}" />
                <TextBlock Classes="settings-row-hint"
                           Text="{DynamicResource Loc_BypassRulesHint}" />
              </StackPanel>
              <TextBox x:Name="ProxyBypassInput" Grid.Column="1" Classes="mono settings-proxy-bypass"
                       AcceptsReturn="True" TextWrapping="NoWrap" Height="92"
                       PlaceholderText=".internal.example.com&#10;10.0.0.0/8" TextChanged="OnProxyTextChanged" />
            </Grid>
          </StackPanel>
        </Border>
        <StackPanel Classes="settings-actions">
          <Button x:Name="SaveProxyButton" Classes="compact primary sc-button" Content="{DynamicResource Loc_SaveProxySettings}"
                  Click="OnSaveProxy" IsEnabled="False" />
          <TextBlock x:Name="ProxyStatus" Classes="sc-text-status" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
      <Border Classes="settings-divider" />
      <StackPanel Classes="settings-panel-section">
        <TextBlock Classes="section-label" Text="{DynamicResource Loc_HttpsSecurity}" />
        <Grid Classes="settings-row" ColumnDefinitions="*,220">
          <StackPanel Classes="settings-row-copy">
            <TextBlock Classes="settings-row-title" Text="{DynamicResource Loc_VerifyServerCertificates}" />
            <TextBlock Classes="settings-row-hint"
                       Text="{DynamicResource Loc_VerifyServerCertificatesHint}" />
          </StackPanel>
          <ToggleSwitch x:Name="VerifyHttpsCertificatesToggle" Grid.Column="1" Classes="sc-toggle-switch" OnContent="{DynamicResource Loc_On}"
                        OffContent="{DynamicResource Loc_Off}" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="OnHttpsCertificateVerificationChanged" />
        </Grid>
        <Border x:Name="CertificateTrustSection" Classes="settings-subsection">
          <StackPanel Spacing="14">
            <TextBlock Text="{DynamicResource Loc_CertificateTrustSource}" Classes="section-label" />
            <Grid Classes="settings-row" ColumnDefinitions="*,220">
              <StackPanel Classes="settings-row-copy">
                <TextBlock Classes="settings-row-title" Text="{DynamicResource Loc_UseSystemCertificates}" />
                <TextBlock Classes="settings-row-hint"
                           Text="{DynamicResource Loc_UseSystemCertificatesHint}" />
              </StackPanel>
              <ToggleSwitch x:Name="UseSystemCertificatesToggle" Grid.Column="1" Classes="sc-toggle-switch"
                            OnContent="{DynamicResource Loc_On}" OffContent="{DynamicResource Loc_Off}" IsChecked="True" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Click="OnSystemCertificatesChanged" />
            </Grid>
            <Grid Classes="settings-row" ColumnDefinitions="*,220">
              <StackPanel Classes="settings-row-copy">
                <TextBlock Classes="settings-row-title" Text="{DynamicResource Loc_CertificatePath}" />
                <TextBlock x:Name="CertificatePathHint" Classes="settings-row-hint"
                           Text="{DynamicResource Loc_CertificatePathHint}" />
              </StackPanel>
              <controls:SCFileSelector x:Name="CertificatePathInput" Grid.Column="1"
                                       Text="{Binding CertificatePath, Mode=TwoWay}"
                                       IsEnabled="{Binding !UseSystemCertificates}"
                                       PlaceholderText="{DynamicResource Loc_UsingSystemCertificates}"
                                       DialogTitle="Choose certificate file" FileTypeName="Certificates"
                                       AllowedExtensions="pem,crt,cer,der" SelectionMode="File" />
            </Grid>
          </StackPanel>
        </Border>
        <Border x:Name="HttpsCertificateWarning" IsVisible="False" Background="{DynamicResource WarningSurfaceBrush}"
                BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" Classes="settings-warning">
          <Grid ColumnDefinitions="18,*" ColumnSpacing="9">
            <svg:Svg Width="16" Height="16" Path="/Assets/icons/platform.svg" Css="{DynamicResource IconSvgCss}"
                     VerticalAlignment="Top" />
            <StackPanel Grid.Column="1" Spacing="3">
              <TextBlock Text="{DynamicResource Loc_CertificateVerificationOff}" FontSize="12" FontWeight="SemiBold" />
              <TextBlock Classes="settings-row-hint" Foreground="{DynamicResource TextSecondaryBrush}"
                         Text="{DynamicResource Loc_CertificateVerificationWarning}" />
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
      <StackPanel Classes="settings-actions">
        <Button x:Name="SaveHttpsCertificateButton" Classes="compact primary sc-button" Content="{DynamicResource Loc_SaveHttpsSetting}"
                Click="OnSaveHttpsCertificateVerification" 
                IsEnabled="False"/>
        <TextBlock x:Name="HttpsCertificateStatus" Classes="sc-text-status" VerticalAlignment="Center" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
