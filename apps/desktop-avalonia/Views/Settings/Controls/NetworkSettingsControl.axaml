<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:SunCode.Desktop.Controls"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             xmlns:vm="using:SunCode.Desktop.ViewModels"
             x:Class="SunCode.Desktop.Views.Settings.Controls.NetworkSettingsControl" x:DataType="vm:DesktopViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Classes="settings-panel-content">
      <StackPanel Classes="settings-panel-heading">
        <TextBlock Text="Network" Classes="sc-text-title" />
        <TextBlock Classes="settings-hint" Text="Configure how the embedded Rust agent reaches HTTP and HTTPS services." />
      </StackPanel>
      <StackPanel Classes="settings-panel-section">
        <TextBlock Classes="section-label" Text="PROXY" />
        <Grid Classes="settings-row" ColumnDefinitions="*,220">
          <StackPanel Classes="settings-row-copy">
            <TextBlock Classes="settings-row-title" Text="Proxy mode" />
            <TextBlock Classes="settings-row-hint"
                       Text="Applies to model providers, WebFetch, and remote HTTP MCP servers." />
          </StackPanel>
          <controls:SCFlatComboBox x:Name="ProxyModeSelector" Grid.Column="1" HorizontalAlignment="Stretch"
                                   SelectionChanged="OnProxyModeChanged" />
        </Grid>
        <Border x:Name="CustomProxySection" Classes="settings-subsection" IsVisible="False">
          <StackPanel Spacing="14">
            <TextBlock Text="CUSTOM PROXY" Classes="section-label" />
            <Grid Classes="settings-row" ColumnDefinitions="*,220">
              <StackPanel Classes="settings-row-copy">
                <TextBlock Classes="settings-row-title" Text="Proxy URL" />
                <TextBlock Classes="settings-row-hint" Text="Use an HTTP or HTTPS URL without embedded credentials." />
              </StackPanel>
              <TextBox x:Name="ProxyUrlInput" Grid.Column="1" Classes="mono settings-provider-input"
                       PlaceholderText="http://proxy.example.com:8080" TextChanged="OnProxyTextChanged" />
            </Grid>
            <Grid Classes="settings-row" ColumnDefinitions="*,220">
              <StackPanel Classes="settings-row-copy">
                <TextBlock Classes="settings-row-title" Text="Username" />
                <TextBlock Classes="settings-row-hint" Text="Optional Basic proxy authentication username." />
              </StackPanel>
              <TextBox x:Name="ProxyUsernameInput" Grid.Column="1" Classes="mono settings-provider-input"
                       TextChanged="OnProxyTextChanged" />
            </Grid>
            <Grid Classes="settings-row" ColumnDefinitions="*,220">
              <StackPanel Classes="settings-row-copy">
                <TextBlock Classes="settings-row-title" Text="Password" />
                <TextBlock x:Name="ProxyPasswordHint" Classes="settings-row-hint"
                           Text="Optional Basic proxy authentication password." />
              </StackPanel>
              <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox x:Name="ProxyPasswordInput" Classes="mono sc-secret-input settings-provider-input"
                         PlaceholderText="Optional" TextChanged="OnProxyTextChanged" />
                <Button x:Name="RemoveProxyPasswordButton" Grid.Column="1" Classes="compact quiet sc-button"
                        Content="Remove" IsVisible="False" Click="OnRemoveProxyPassword" />
              </Grid>
            </Grid>
            <Grid Classes="settings-row" ColumnDefinitions="*,220" VerticalAlignment="Top">
              <StackPanel Classes="settings-row-copy">
                <TextBlock Classes="settings-row-title" Text="Bypass rules" />
                <TextBlock Classes="settings-row-hint"
                           Text="One hostname, domain suffix, IP address, CIDR range, or * per line. Loopback is always direct." />
              </StackPanel>
              <TextBox x:Name="ProxyBypassInput" Grid.Column="1" Classes="mono settings-proxy-bypass"
                       AcceptsReturn="True" TextWrapping="NoWrap" Height="92"
                       PlaceholderText=".internal.example.com&#10;10.0.0.0/8" TextChanged="OnProxyTextChanged" />
            </Grid>
          </StackPanel>
        </Border>
        <StackPanel Classes="settings-actions">
          <Button x:Name="SaveProxyButton" Classes="compact primary sc-button" Content="Save proxy settings"
                  Click="OnSaveProxy" IsEnabled="False" />
          <TextBlock x:Name="ProxyStatus" Classes="sc-text-status" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
      <Border Classes="settings-divider" />
      <StackPanel Classes="settings-panel-section">
        <TextBlock Classes="section-label" Text="HTTPS SECURITY" />
        <Grid Classes="settings-row" ColumnDefinitions="*,220">
          <StackPanel Classes="settings-row-copy">
            <TextBlock Classes="settings-row-title" Text="Verify server certificates" />
            <TextBlock Classes="settings-row-hint"
                       Text="Validate certificate chains and hostnames for model provider and WebFetch requests." />
          </StackPanel>
          <ToggleSwitch x:Name="VerifyHttpsCertificatesToggle" Grid.Column="1" Classes="sc-toggle-switch" OnContent="On"
                        OffContent="Off" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="OnHttpsCertificateVerificationChanged" />
        </Grid>
        <Border x:Name="CertificateTrustSection" Classes="settings-subsection">
          <StackPanel Spacing="14">
            <TextBlock Text="CERTIFICATE TRUST SOURCE" Classes="section-label" />
            <Grid Classes="settings-row" ColumnDefinitions="*,220">
              <StackPanel Classes="settings-row-copy">
                <TextBlock Classes="settings-row-title" Text="Use system certificates" />
                <TextBlock Classes="settings-row-hint"
                           Text="Trust the operating system certificate store for provider and WebFetch HTTPS requests." />
              </StackPanel>
              <ToggleSwitch x:Name="UseSystemCertificatesToggle" Grid.Column="1" Classes="sc-toggle-switch"
                            OnContent="On" OffContent="Off" IsChecked="True" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Click="OnSystemCertificatesChanged" />
            </Grid>
            <Grid Classes="settings-row" ColumnDefinitions="*,220">
              <StackPanel Classes="settings-row-copy">
                <TextBlock Classes="settings-row-title" Text="Certificate path" />
                <TextBlock x:Name="CertificatePathHint" Classes="settings-row-hint"
                           Text="Disable system certificates to provide a custom certificate file." />
              </StackPanel>
              <controls:SCFileSelector x:Name="CertificatePathInput" Grid.Column="1"
                                       Text="{Binding CertificatePath, Mode=TwoWay}"
                                       IsEnabled="{Binding !UseSystemCertificates}"
                                       PlaceholderText="Using system certificates"
                                       DialogTitle="Choose certificate file" FileTypeName="Certificates"
                                       AllowedExtensions="pem,crt,cer,der" SelectionMode="File" />
            </Grid>
          </StackPanel>
        </Border>
        <Border x:Name="HttpsCertificateWarning" IsVisible="False" Background="{DynamicResource WarningSurfaceBrush}"
                BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" Classes="settings-warning">
          <Grid ColumnDefinitions="18,*" ColumnSpacing="9">
            <svg:Svg Width="16" Height="16" Path="/Assets/icons/platform.svg" Css="{DynamicResource IconSvgCss}"
                     VerticalAlignment="Top" />
            <StackPanel Grid.Column="1" Spacing="3">
              <TextBlock Text="Certificate verification is off" FontSize="12" FontWeight="SemiBold" />
              <TextBlock Classes="settings-row-hint" Foreground="{DynamicResource TextSecondaryBrush}"
                         Text="SunCode will accept invalid certificates and hostnames, similar to curl -k. This can expose provider credentials and fetched content to man-in-the-middle attacks." />
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
      <StackPanel Classes="settings-actions">
        <Button x:Name="SaveHttpsCertificateButton" Classes="compact primary sc-button" Content="Save HTTPS setting"
                Click="OnSaveHttpsCertificateVerification" 
                IsEnabled="False"/>
        <TextBlock x:Name="HttpsCertificateStatus" Classes="sc-text-status" VerticalAlignment="Center" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
