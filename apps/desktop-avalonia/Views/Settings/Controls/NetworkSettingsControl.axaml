<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:SunCode.Desktop.Controls"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             xmlns:vm="using:SunCode.Desktop.ViewModels"
             xmlns:infra="using:SunCode.Desktop.Infrastructure"
             x:Class="SunCode.Desktop.Views.Settings.Controls.NetworkSettingsControl" x:DataType="vm:NetworkSettingsEditorViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Classes="settings-panel-content">
      <StackPanel Classes="settings-panel-heading">
        <TextBlock Text="{DynamicResource LocNetwork}" Classes="sc-text-title" />
        <TextBlock Classes="settings-hint" Text="{DynamicResource LocNetworkHint}" />
      </StackPanel>
      <StackPanel Classes="settings-panel-section">
        <TextBlock Classes="section-label" Text="{DynamicResource LocProxy}" />
        <Grid Classes="settings-row" ColumnDefinitions="*,220">
          <StackPanel Classes="settings-row-copy">
            <TextBlock Classes="settings-row-title" Text="{DynamicResource LocProxyMode}" />
            <TextBlock Classes="settings-row-hint"
                       Text="{DynamicResource LocProxyModeHint}" />
          </StackPanel>
          <controls:SCFlatComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                   ItemsSource="{Binding ProxyModeOptions}" SelectedItem="{Binding SelectedProxyMode}" />
        </Grid>
        <Border Classes="settings-subsection" IsVisible="{Binding IsCustomProxy}">
          <StackPanel Spacing="14">
            <TextBlock Text="{DynamicResource LocCustomProxy}" Classes="section-label" />
            <Grid Classes="settings-row" ColumnDefinitions="*,220">
              <StackPanel Classes="settings-row-copy">
                <TextBlock Classes="settings-row-title" Text="{DynamicResource LocProxyUrl}" />
                <TextBlock Classes="settings-row-hint" Text="{DynamicResource LocProxyUrlHint}" />
              </StackPanel>
              <TextBox Grid.Column="1" Classes="mono settings-provider-input" Text="{Binding ProxyUrl}"
                       PlaceholderText="http://proxy.example.com:8080" />
            </Grid>
            <Grid Classes="settings-row" ColumnDefinitions="*,220">
              <StackPanel Classes="settings-row-copy">
                <TextBlock Classes="settings-row-title" Text="{DynamicResource LocUsername}" />
                <TextBlock Classes="settings-row-hint" Text="{DynamicResource LocProxyUsernameHint}" />
              </StackPanel>
              <TextBox Grid.Column="1" Classes="mono settings-provider-input" Text="{Binding ProxyUsername}" />
            </Grid>
            <Grid Classes="settings-row" ColumnDefinitions="*,220">
              <StackPanel Classes="settings-row-copy">
                <TextBlock Classes="settings-row-title" Text="{DynamicResource LocPassword}" />
                <TextBlock Classes="settings-row-hint" Text="{Binding ProxyPasswordHint}" />
              </StackPanel>
              <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Classes="mono sc-secret-input settings-provider-input" Text="{Binding ProxyPassword}"
                         PlaceholderText="{Binding ProxyPasswordPlaceholder}" />
                <Button Grid.Column="1" Classes="compact quiet sc-button" Content="{DynamicResource LocRemove}"
                        IsVisible="{Binding IsProxyPasswordStored}" Command="{Binding RemoveProxyPasswordCommand}" />
              </Grid>
            </Grid>
            <Grid Classes="settings-row" ColumnDefinitions="*,220" VerticalAlignment="Top">
              <StackPanel Classes="settings-row-copy">
                <TextBlock Classes="settings-row-title" Text="{DynamicResource LocBypassRules}" />
                <TextBlock Classes="settings-row-hint"
                           Text="{DynamicResource LocBypassRulesHint}" />
              </StackPanel>
              <TextBox Grid.Column="1" Classes="mono settings-proxy-bypass" Text="{Binding ProxyBypass}"
                       AcceptsReturn="True" TextWrapping="NoWrap" Height="92"
                       PlaceholderText=".internal.example.com&#10;10.0.0.0/8" />
            </Grid>
          </StackPanel>
        </Border>
        <StackPanel Classes="settings-actions">
          <Button Classes="compact primary sc-button" Content="{DynamicResource LocSaveProxySettings}"
                  Command="{Binding SaveProxyCommand}" />
          <TextBlock Text="{Binding ProxyStatusText}" infra:StatusToneProperties.Tone="{Binding ProxyStatusTone}"
                     Classes="sc-text-status" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
      <Border Classes="settings-divider" />
      <StackPanel Classes="settings-panel-section">
        <TextBlock Classes="section-label" Text="{DynamicResource LocHttpsSecurity}" />
        <Grid Classes="settings-row" ColumnDefinitions="*,220">
          <StackPanel Classes="settings-row-copy">
            <TextBlock Classes="settings-row-title" Text="{DynamicResource LocVerifyServerCertificates}" />
            <TextBlock Classes="settings-row-hint"
                       Text="{DynamicResource LocVerifyServerCertificatesHint}" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" Classes="sc-toggle-switch" OnContent="{DynamicResource LocOn}"
                        OffContent="{DynamicResource LocOff}" HorizontalAlignment="Right" VerticalAlignment="Center"
                        IsChecked="{Binding VerifyHttpsCertificates}" />
        </Grid>
        <Border Classes="settings-subsection" IsVisible="{Binding VerifyHttpsCertificates}">
          <StackPanel Spacing="14">
            <TextBlock Text="{DynamicResource LocCertificateTrustSource}" Classes="section-label" />
            <Grid Classes="settings-row" ColumnDefinitions="*,220">
              <StackPanel Classes="settings-row-copy">
                <TextBlock Classes="settings-row-title" Text="{DynamicResource LocUseSystemCertificates}" />
                <TextBlock Classes="settings-row-hint"
                           Text="{DynamicResource LocUseSystemCertificatesHint}" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" Classes="sc-toggle-switch"
                            OnContent="{DynamicResource LocOn}" OffContent="{DynamicResource LocOff}" HorizontalAlignment="Right"
                            VerticalAlignment="Center" IsChecked="{Binding UseSystemCertificates}" />
            </Grid>
            <Grid Classes="settings-row" ColumnDefinitions="*,220">
              <StackPanel Classes="settings-row-copy">
                <TextBlock Classes="settings-row-title" Text="{DynamicResource LocCertificatePath}" />
                <TextBlock Classes="settings-row-hint" Text="{Binding CertificatePathHint}" />
              </StackPanel>
              <controls:SCFileSelector Grid.Column="1"
                                       Text="{Binding CertificatePath}"
                                       IsEnabled="{Binding !UseSystemCertificates}"
                                       PlaceholderText="{DynamicResource LocUsingSystemCertificates}"
                                       DialogTitle="Choose certificate file" FileTypeName="Certificates"
                                       AllowedExtensions="pem,crt,cer,der" SelectionMode="File" />
            </Grid>
          </StackPanel>
        </Border>
        <Border IsVisible="{Binding IsCertificateVerificationOff}" Background="{DynamicResource WarningSurfaceBrush}"
                BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" Classes="settings-warning">
          <Grid ColumnDefinitions="18,*" ColumnSpacing="9">
            <svg:Svg Width="16" Height="16" Path="/Assets/icons/platform.svg" Css="{DynamicResource IconSvgCss}"
                     VerticalAlignment="Top" />
            <StackPanel Grid.Column="1" Spacing="3">
              <TextBlock Text="{DynamicResource LocCertificateVerificationOff}" FontSize="12" FontWeight="SemiBold" />
              <TextBlock Classes="settings-row-hint" Foreground="{DynamicResource TextSecondaryBrush}"
                         Text="{DynamicResource LocCertificateVerificationWarning}" />
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
      <StackPanel Classes="settings-actions">
        <Button Classes="compact primary sc-button" Content="{DynamicResource LocSaveHttpsSetting}"
                Command="{Binding SaveHttpsCommand}" />
        <TextBlock Text="{Binding HttpsStatusText}" infra:StatusToneProperties.Tone="{Binding HttpsStatusTone}"
                   Classes="sc-text-status" VerticalAlignment="Center" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
