<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:SunCode.Desktop.Models"
        xmlns:vm="using:SunCode.Desktop.ViewModels"
        xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
        x:Class="SunCode.Desktop.Views.Settings.SettingsWindow"
        x:DataType="vm:DesktopViewModel"
        Title="Settings"
        Width="900" Height="672"
        MinWidth="720" MinHeight="552"
        Background="{DynamicResource CanvasBrush}"
        WindowDecorations="Full"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="Button.navigation">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="Button.navigation:selected">
      <Setter Property="Background" Value="{DynamicResource SurfaceActiveBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.settings-hint">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.settings-warning">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="11,10" />
    </Style>
    <Style Selector="Border.settings-provider-status">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,7" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="58,*">
    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="22,0" ColumnDefinitions="*,Auto">
        <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="compact primary" Content="Done" Click="CloseSettings" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="238,*">
      <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="16,18" Spacing="4">
            <TextBlock Classes="section-label" Text="GENERAL" Margin="10,0,0,0" />
            <Button x:Name="DefaultsNavigation" Classes="navigation selected" Content="Defaults" Click="ShowDefaults" />
            <Button x:Name="AppearanceNavigation" Classes="navigation" Content="Appearance" Click="ShowAppearance" />
            <Button x:Name="NetworkNavigation" Classes="navigation" Content="Network" Click="ShowNetwork" />
            <Button x:Name="LoggingNavigation" Classes="navigation" Content="Logging" Click="ShowLogging" />
            <Border Height="12" />
            <TextBlock Classes="section-label" Text="MODELS" Margin="10,0,0,0" />
            <Button x:Name="ProvidersNavigation" Classes="navigation" Click="ShowProviders">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <svg:Svg x:Name="ProvidersChevron" Width="10" Height="10" Path="/Assets/icons/chevron-right.svg" Css="{DynamicResource IconSvgCss}" />
                <TextBlock Text="Model providers" FontWeight="SemiBold" />
              </StackPanel>
            </Button>
            <StackPanel x:Name="ProviderNavigation" Spacing="4">
              <Button Classes="navigation" Content="DeepSeek" Tag="deepseek" Margin="18,0,0,0" Click="ShowProvider" />
              <Button Classes="navigation" Content="Zhipu GLM" Tag="zhipu" Margin="18,0,0,0" Click="ShowProvider" />
              <Button Classes="navigation" Content="OpenAI" Tag="openai" Margin="18,0,0,0" Click="ShowProvider" />
              <Button Classes="navigation" Content="Kimi" Tag="kimi" Margin="18,0,0,0" Click="ShowProvider" />
              <Button Classes="navigation" Content="Claude" Tag="claude" Margin="18,0,0,0" Click="ShowProvider" />
              <Button Classes="navigation" Content="Gemini" Tag="gemini" Margin="18,0,0,0" Click="ShowProvider" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Grid Grid.Column="1">
        <ScrollViewer x:Name="DefaultsPage" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="32,28,32,34" Spacing="16" MaxWidth="720">
            <StackPanel Spacing="4">
              <TextBlock Text="Defaults" FontSize="22" FontWeight="SemiBold" />
              <TextBlock Classes="settings-hint" Text="Configure model and turn defaults." />
            </StackPanel>
            <TextBlock Classes="section-label" Text="DEFAULT MODEL" />
            <ComboBox x:Name="DefaultModelSelector" HorizontalAlignment="Stretch" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" SelectionChanged="DefaultModelChanged">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="models:ModelItem"><TextBlock Classes="mono" Text="{Binding Id}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Classes="settings-hint" Text="Only models registered by the local agent appear here." />
            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4" />
            <TextBlock Classes="section-label" Text="TURN EXECUTION" />
            <Grid ColumnDefinitions="*,140">
              <StackPanel Spacing="3">
                <TextBlock Text="Tool-call limit" FontWeight="SemiBold" />
                <TextBlock x:Name="ToolCallLimitScope" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
              </StackPanel>
              <NumericUpDown x:Name="ToolCallLimitInput"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Minimum="1"
                            Maximum="256"
                            Increment="1"
                            FormatString="0" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Button x:Name="SaveToolCallLimitButton" Classes="compact primary" Content="Save project limit" Click="SaveToolCallLimit" />
              <TextBlock x:Name="ToolCallLimitStatus" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="AppearancePage" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="32,28,32,34" Spacing="16" MaxWidth="720">
            <StackPanel Spacing="4">
              <TextBlock Text="Appearance" FontSize="22" FontWeight="SemiBold" />
              <TextBlock Classes="settings-hint" Text="Adjust how SunCode looks across every open window." />
            </StackPanel>
            <TextBlock Classes="section-label" Text="THEME" />
            <Grid ColumnDefinitions="*,160">
              <TextBlock Text="Color theme" FontWeight="SemiBold" VerticalAlignment="Center" />
              <ComboBox x:Name="ThemeSelector" Grid.Column="1" SelectionChanged="ThemeChanged">
                <ComboBoxItem Content="Dark" Tag="dark" />
                <ComboBoxItem Content="Light" Tag="light" />
              </ComboBox>
            </Grid>
            <TextBlock Classes="settings-hint" Text="Changes apply immediately." />
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="LoggingPage" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="32,28,32,34" Spacing="16" MaxWidth="720">
            <StackPanel Spacing="4">
              <TextBlock Text="Logging" FontSize="22" FontWeight="SemiBold" />
              <TextBlock Classes="settings-hint" Text="Control diagnostic detail and how long local log files are kept." />
            </StackPanel>

            <TextBlock Classes="section-label" Text="DIAGNOSTIC OUTPUT" />
            <Grid ColumnDefinitions="*,180" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="14">
              <StackPanel Spacing="3">
                <TextBlock Text="Minimum level" FontWeight="SemiBold" />
                <TextBlock Classes="settings-hint" Text="Lower levels include more diagnostic detail." />
              </StackPanel>
              <ComboBox x:Name="LogLevelSelector" Grid.Column="1" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="TRACE" Tag="TRACE" />
                <ComboBoxItem Content="DEBUG" Tag="DEBUG" />
                <ComboBoxItem Content="INFO" Tag="INFO" />
                <ComboBoxItem Content="WARN" Tag="WARN" />
                <ComboBoxItem Content="ERROR" Tag="ERROR" />
                <ComboBoxItem Content="OFF" Tag="OFF" />
              </ComboBox>

              <StackPanel Grid.Row="1" Spacing="3">
                <TextBlock Text="Log directory" FontWeight="SemiBold" />
                <TextBlock Classes="settings-hint" Text="Leave empty to use the data directory's logs folder." />
              </StackPanel>
              <TextBox x:Name="LogDirectoryInput" Grid.Row="1" Grid.Column="1" Classes="mono" PlaceholderText="Default logs folder" />

              <StackPanel Grid.Row="2" Spacing="3">
                <TextBlock Text="Maximum file size" FontWeight="SemiBold" />
                <TextBlock Classes="settings-hint" Text="Rotate each log file when it reaches this size." />
              </StackPanel>
              <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto">
                <TextBox x:Name="LogMaxMegabytesInput" Grid.ColumnSpan="2" Classes="mono" Padding="12,7,42,7" PlaceholderText="10" AutomationProperties.Name="Maximum file size in megabytes" />
                <TextBlock Grid.Column="1" Text="MB" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False" />
              </Grid>

              <StackPanel Grid.Row="3" Spacing="3">
                <TextBlock Text="Retained backups" FontWeight="SemiBold" />
                <TextBlock Classes="settings-hint" Text="Number of rotated backups to keep, from 0 to 100." />
              </StackPanel>
              <TextBox x:Name="LogRetentionInput" Grid.Row="3" Grid.Column="1" Classes="mono" PlaceholderText="5" />
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Button Classes="compact primary" Content="Save logging settings" Click="SaveLogging" />
              <TextBlock x:Name="LoggingStatus" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4" />
            <TextBlock Classes="section-label" Text="IMAGE STORAGE" />
            <Grid ColumnDefinitions="*,180" ColumnSpacing="14">
              <StackPanel Spacing="3">
                <TextBlock Text="Image directory" FontWeight="SemiBold" />
                <TextBlock Classes="settings-hint" Text="Leave empty to use the data directory's images folder." />
              </StackPanel>
              <TextBox x:Name="ImageDirectoryInput" Grid.Column="1" Classes="mono" PlaceholderText="Default images folder" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Button Classes="compact primary" Content="Save image location" Click="SaveImageDirectory" />
              <TextBlock x:Name="ImageDirectoryStatus" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="ProvidersPage" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="32,28,32,34" Spacing="20" MaxWidth="720">
            <StackPanel Spacing="4">
              <TextBlock Text="Model providers" FontSize="22" FontWeight="SemiBold" />
              <TextBlock Classes="settings-hint" Text="Built-in providers available to the local agent." />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Providers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:ProviderItem">
                  <Button Classes="navigation" Tag="{Binding Id}" Click="ShowProvider" Padding="4,10" MinHeight="58" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding DisplayName, StringFormat=Open {0} provider settings}">
                    <Grid ColumnDefinitions="8,*,16" ColumnSpacing="11">
                      <Ellipse Width="7" Height="7" Fill="{DynamicResource WarningBrush}" VerticalAlignment="Center" IsVisible="{Binding !Configured}" />
                      <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" IsVisible="{Binding Configured}" />
                      <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ApiBase}" Classes="mono" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <svg:Svg Grid.Column="2" Width="12" Height="12" Path="/Assets/icons/chevron-right.svg" Css="{DynamicResource IconSvgCss}" VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="NetworkPage" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="32,28,32,34" Spacing="16" MaxWidth="720">
            <StackPanel Spacing="4">
              <TextBlock Text="Network" FontSize="22" FontWeight="SemiBold" />
              <TextBlock Classes="settings-hint" Text="Configure how Rust HTTPS clients establish secure connections." />
            </StackPanel>

            <TextBlock Classes="section-label" Text="HTTPS SECURITY" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
              <StackPanel Spacing="3">
                <TextBlock Text="Verify server certificates" FontWeight="SemiBold" />
                <TextBlock Classes="settings-hint" Text="Validate certificate chains and hostnames for model provider and WebFetch requests." />
              </StackPanel>
              <ToggleSwitch x:Name="VerifyHttpsCertificatesToggle"
                            Grid.Column="1"
                            OnContent="On"
                            OffContent="Off"
                            VerticalAlignment="Center"
                            Click="HttpsCertificateVerificationChanged" />
            </Grid>

            <Border x:Name="HttpsCertificateWarning"
                    IsVisible="False"
                    Background="{DynamicResource WarningSurfaceBrush}"
                    BorderBrush="{DynamicResource WarningBorderBrush}"
                    BorderThickness="1"
                    Classes="settings-warning"
                    CornerRadius="6"
                    Padding="12,10">
              <StackPanel Spacing="4">
                <TextBlock Text="Certificate verification is off" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
                <TextBlock Classes="settings-hint" Text="SunCode will accept invalid certificates and hostnames, similar to curl -k. This can expose provider credentials and fetched content to man-in-the-middle attacks." />
              </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Button Classes="compact primary" Content="Save HTTPS setting" Click="SaveHttpsCertificateVerification" />
              <TextBlock x:Name="HttpsCertificateStatus" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="ProviderPage" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="32,28,32,34" Spacing="16" MaxWidth="720">
            <StackPanel Spacing="4">
              <TextBlock x:Name="ProviderTitle" FontSize="22" FontWeight="SemiBold" />
              <TextBlock x:Name="ProviderDescription" Classes="settings-hint" />
            </StackPanel>
            <TextBlock Classes="section-label" Text="CREDENTIAL" />
            <Border Classes="settings-provider-status" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
              <TextBlock x:Name="CredentialStatus" TextWrapping="Wrap" FontSize="11" />
            </Border>
            <TextBox x:Name="ProviderApiKey" PlaceholderText="Paste API key" PasswordChar="●" Classes="mono" TextChanged="ProviderApiKeyChanged" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="SaveCredentialButton" Classes="compact primary" Content="Save key" Click="SaveCredential" IsEnabled="False" />
              <Button x:Name="RemoveCredentialButton" Classes="compact danger" Content="Remove key" Click="RemoveCredential" />
            </StackPanel>
            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4" />
            <TextBlock Classes="section-label" Text="AVAILABLE MODELS" />
            <TextBlock x:Name="ProviderModelsText" Classes="mono" TextWrapping="Wrap" />
            <TextBlock Classes="settings-hint" Text="The agent owns provider availability and model registration." />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Window>
