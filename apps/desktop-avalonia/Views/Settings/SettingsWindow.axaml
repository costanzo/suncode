<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:SunCode.Desktop.Controls"
        xmlns:models="using:SunCode.Desktop.Models"
        xmlns:settings="using:SunCode.Desktop.Views.Settings.Controls"
        xmlns:vm="using:SunCode.Desktop.ViewModels"
        xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
        x:Class="SunCode.Desktop.Views.Settings.SettingsWindow"
        x:DataType="vm:DesktopViewModel"
        Title="Settings"
        Width="900" Height="672"
        MinWidth="720" MinHeight="552"
        Background="{DynamicResource SurfaceBrush}"
        WindowDecorations="Full"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="Button.navigation">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Width" Value="200" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.Navigation2Style">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Width" Value="170" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.navigation:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.navigation:selected">
      <Setter Property="Background" Value="{DynamicResource SurfaceActiveBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.navigation:focus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.navigation.provider">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Ellipse.provider-nav-status">
      <Setter Property="Width" Value="6" />
      <Setter Property="Height" Value="6" />
      <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleSwitch.settings-switch">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <!-- Provider fields match the specimen's resting border after a pointer click. -->
    <Style Selector="TextBox.settings-provider-input:focus">
      <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="58,*" Background="{DynamicResource SurfaceBrush}">
    <Border Grid.Row="0"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid Margin="22,0" ColumnDefinitions="*,Auto">
        <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button Grid.Column="1"
                Classes="compact primary sc-button"
                Content="Done"
                Click="CloseSettings"
                VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="238,*">
      <Border Grid.Column="0"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,1,0">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="16,20" Spacing="4">
            <Button x:Name="DefaultsNavigation" Classes="navigation selected" Click="ShowDefaults">
              <Grid ColumnDefinitions="15,*" ColumnSpacing="9">
                <svg:Svg Width="15" Height="15" Path="/Assets/icons/foundation.svg" Css="{DynamicResource IconSvgCss}" />
                <TextBlock Grid.Column="1" Text="Defaults" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button x:Name="AppearanceNavigation" Classes="navigation" Click="ShowAppearance">
              <Grid ColumnDefinitions="15,*" ColumnSpacing="9">
                <svg:Svg Width="15" Height="15" Path="/Assets/icons/sun.svg" Css="{DynamicResource IconSvgCss}" />
                <TextBlock Grid.Column="1" Text="Appearance" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button x:Name="NetworkNavigation" Classes="navigation" Click="ShowNetwork">
              <Grid ColumnDefinitions="15,*" ColumnSpacing="9">
                <svg:Svg Width="15" Height="15" Path="/Assets/icons/platform.svg" Css="{DynamicResource IconSvgCss}" />
                <TextBlock Grid.Column="1" Text="Network" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button x:Name="LoggingNavigation" Classes="navigation" Click="ShowLogging">
              <Grid ColumnDefinitions="15,*" ColumnSpacing="9">
                <svg:Svg Width="15" Height="15" Path="/Assets/icons/assets.svg" Css="{DynamicResource IconSvgCss}" />
                <TextBlock Grid.Column="1" Text="Logging" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button x:Name="ProvidersNavigation" Classes="navigation" Click="ShowProviders">
              <Grid ColumnDefinitions="15,*,13" ColumnSpacing="9">
                <svg:Svg Width="15" Height="15" Path="/Assets/icons/components.svg" Css="{DynamicResource IconSvgCss}" />
                <TextBlock Grid.Column="1" Text="Model providers" VerticalAlignment="Center" />
                <svg:Svg x:Name="ProvidersChevron"
                         Grid.Column="2"
                         Width="13"
                         Height="13"
                         Path="/Assets/icons/chevron-right.svg"
                         Css="{DynamicResource IconSvgCss}"
                         VerticalAlignment="Center"
                         RenderTransformOrigin="50%,50%" />
              </Grid>
            </Button>
            <ItemsControl x:Name="ProviderNavigation"
                          Margin="30,0,0,0"
                          ItemsSource="{Binding Providers}">
              <ItemsControl.Styles>
                <Style Selector="ContentPresenter">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
              </ItemsControl.Styles>
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="3" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:ProviderItem">
                  <Button Classes="Navigation2Style provider"
                          Tag="{Binding Id}"
                          Click="ShowProvider"
                          AutomationProperties.Name="{Binding DisplayName, StringFormat=Open {0} provider settings}">
                    <Grid ColumnDefinitions="*,13" ColumnSpacing="9">
                      <Ellipse Grid.Column="1"
                               Classes="provider-nav-status"
                               Fill="{DynamicResource WarningBrush}"
                               IsVisible="{Binding !Configured}" />
                      <Ellipse Grid.Column="1"
                               Classes="provider-nav-status"
                               Fill="{DynamicResource SuccessBrush}"
                               IsVisible="{Binding Configured}" />
                      <TextBlock Grid.Column="0"
                                 Text="{Binding DisplayName}"
                                 VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Grid Grid.Column="1" Background="{DynamicResource SurfaceBrush}">
        <settings:DefaultsSettingsControl x:Name="DefaultsPage" />

        <settings:AppearanceSettingsControl x:Name="AppearancePage" IsVisible="False" />

        <settings:LoggingSettingsControl x:Name="LoggingPage" IsVisible="False" />

        <Grid x:Name="ProvidersPage" IsVisible="False">
          <controls:SCModelProvider x:Name="ProviderManager"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Providers="{Binding Providers}"
                                    ProviderSelected="ProviderSelected"
                                    EndpointTextChanged="ProviderEndpointChanged"
                                    ApiKeyTextChanged="ProviderApiKeyChanged"
                                    SaveEndpointRequested="SaveProviderEndpoint"
                                    ResetEndpointRequested="ResetProviderEndpoint"
                                    SaveCredentialRequested="SaveCredential"
                                    RemoveCredentialRequested="RemoveCredential" />
        </Grid>

        <settings:NetworkSettingsControl x:Name="NetworkPage" IsVisible="False" />
      </Grid>
    </Grid>
  </Grid>
</Window>
