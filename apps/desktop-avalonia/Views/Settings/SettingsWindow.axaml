<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:SunCode.Desktop.Models"
        xmlns:settings="using:SunCode.Desktop.Views.Settings.Controls"
        xmlns:vm="using:SunCode.Desktop.ViewModels"
        xmlns:local="using:SunCode.Desktop.Views.Settings"
        xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
        x:Class="SunCode.Desktop.Views.Settings.SettingsWindow"
        x:DataType="vm:DesktopViewModel"
        Title="{DynamicResource LocSettings}"
        Width="900" Height="672"
        MinWidth="720" MinHeight="552"
        Background="{DynamicResource SurfaceBrush}"
        WindowDecorations="Full"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <StyleInclude Source="avares://SunCode/Views/Settings/Controls/ModelProviderSettingsControlStyles.axaml" />
    <Style Selector="Button.navigation">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Width" Value="200" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.navigation.provider">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Width" Value="170" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.navigation:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.navigation.selected">
      <Setter Property="Background" Value="{DynamicResource SurfaceActiveBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.navigation.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceActiveBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.navigation:focus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Ellipse.provider-nav-status">
      <Setter Property="Width" Value="6" />
      <Setter Property="Height" Value="6" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleSwitch.settings-switch">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
  </Window.Styles>

  <Grid x:Name="SettingsRoot" x:DataType="vm:SettingsWindowViewModel"
        RowDefinitions="58,*" Background="{DynamicResource SurfaceBrush}">
    <Border Grid.Row="0"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid Margin="22,0" ColumnDefinitions="*,Auto">
        <TextBlock Text="{DynamicResource LocSettings}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button Grid.Column="1"
                Classes="compact primary sc-button"
                Content="{DynamicResource LocDone}"
                Click="CloseSettings"
                VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="238,*">
      <Border Grid.Column="0"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,1,0">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="16,20" Spacing="4">
            <Button Classes="navigation"
                    Classes.selected="{Binding Navigation.HighlightedNavigation, Converter={x:Static local:SettingsConverters.EqualsParameter}, ConverterParameter={x:Static vm:SettingsPage.Defaults}}"
                    Command="{Binding Navigation.NavigateCommand}"
                    CommandParameter="{x:Static vm:SettingsPage.Defaults}">
              <Grid ColumnDefinitions="15,*" ColumnSpacing="9">
                <svg:Svg Width="15" Height="15" Path="/Assets/icons/foundation.svg" Css="{DynamicResource IconSvgCss}" />
                <TextBlock Grid.Column="1" Text="{DynamicResource LocDefaults}" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button Classes="navigation"
                    Classes.selected="{Binding Navigation.HighlightedNavigation, Converter={x:Static local:SettingsConverters.EqualsParameter}, ConverterParameter={x:Static vm:SettingsPage.Appearance}}"
                    Command="{Binding Navigation.NavigateCommand}"
                    CommandParameter="{x:Static vm:SettingsPage.Appearance}">
              <Grid ColumnDefinitions="15,*" ColumnSpacing="9">
                <svg:Svg Width="15" Height="15" Path="/Assets/icons/sun.svg" Css="{DynamicResource IconSvgCss}" />
                <TextBlock Grid.Column="1" Text="{DynamicResource LocAppearance}" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button Classes="navigation"
                    Classes.selected="{Binding Navigation.HighlightedNavigation, Converter={x:Static local:SettingsConverters.EqualsParameter}, ConverterParameter={x:Static vm:SettingsPage.Shortcuts}}"
                    Command="{Binding Navigation.NavigateCommand}"
                    CommandParameter="{x:Static vm:SettingsPage.Shortcuts}">
              <Grid ColumnDefinitions="15,*" ColumnSpacing="9">
                <svg:Svg Width="15" Height="15" Path="/Assets/icons/keyboard.svg" Css="{DynamicResource IconSvgCss}" />
                <TextBlock Grid.Column="1" Text="{DynamicResource LocKeyboardShortcuts}" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button Classes="navigation"
                    Classes.selected="{Binding Navigation.HighlightedNavigation, Converter={x:Static local:SettingsConverters.EqualsParameter}, ConverterParameter={x:Static vm:SettingsPage.Network}}"
                    Command="{Binding Navigation.NavigateCommand}"
                    CommandParameter="{x:Static vm:SettingsPage.Network}">
              <Grid ColumnDefinitions="15,*" ColumnSpacing="9">
                <svg:Svg Width="15" Height="15" Path="/Assets/icons/platform.svg" Css="{DynamicResource IconSvgCss}" />
                <TextBlock Grid.Column="1" Text="{DynamicResource LocNetwork}" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button Classes="navigation"
                    Classes.selected="{Binding Navigation.HighlightedNavigation, Converter={x:Static local:SettingsConverters.EqualsParameter}, ConverterParameter={x:Static vm:SettingsPage.Remote}}"
                    Command="{Binding Navigation.NavigateCommand}"
                    CommandParameter="{x:Static vm:SettingsPage.Remote}">
              <Grid ColumnDefinitions="15,*" ColumnSpacing="9">
                <svg:Svg Width="15" Height="15" Path="/Assets/icons/server.svg" Css="{DynamicResource IconSvgCss}" />
                <TextBlock Grid.Column="1" Text="{DynamicResource LocRemoteServer}" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button Classes="navigation"
                    Classes.selected="{Binding Navigation.HighlightedNavigation, Converter={x:Static local:SettingsConverters.EqualsParameter}, ConverterParameter={x:Static vm:SettingsPage.Computer}}"
                    Command="{Binding Navigation.NavigateCommand}"
                    CommandParameter="{x:Static vm:SettingsPage.Computer}">
              <Grid ColumnDefinitions="15,*" ColumnSpacing="9">
                <svg:Svg Width="15" Height="15" Path="/Assets/icons/computer.svg" Css="{DynamicResource IconSvgCss}" />
                <TextBlock Grid.Column="1" Text="{DynamicResource LocComputerUse}" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button Classes="navigation"
                    Classes.selected="{Binding Navigation.HighlightedNavigation, Converter={x:Static local:SettingsConverters.EqualsParameter}, ConverterParameter={x:Static vm:SettingsPage.Browser}}"
                    Command="{Binding Navigation.NavigateCommand}"
                    CommandParameter="{x:Static vm:SettingsPage.Browser}">
              <Grid ColumnDefinitions="15,*" ColumnSpacing="9">
                <svg:Svg Width="15" Height="15" Path="/Assets/icons/tool.svg" Css="{DynamicResource IconSvgCss}" />
                <TextBlock Grid.Column="1" Text="{DynamicResource LocBrowserUse}" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button x:Name="McpNavigation" Classes="navigation"
                    Classes.selected="{Binding Navigation.HighlightedNavigation, Converter={x:Static local:SettingsConverters.EqualsParameter}, ConverterParameter={x:Static vm:SettingsPage.Mcp}}"
                    Command="{Binding Navigation.NavigateCommand}"
                    CommandParameter="{x:Static vm:SettingsPage.Mcp}">
              <Grid ColumnDefinitions="15,*" ColumnSpacing="9">
                <svg:Svg Width="15" Height="15" Path="/Assets/icons/server.svg" Css="{DynamicResource IconSvgCss}" />
                <TextBlock Grid.Column="1" Text="{DynamicResource LocMcpServers}" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button x:Name="LanguageServersNavigation" Classes="navigation"
                    Classes.selected="{Binding Navigation.HighlightedNavigation, Converter={x:Static local:SettingsConverters.EqualsParameter}, ConverterParameter={x:Static vm:SettingsPage.LanguageServers}}"
                    Command="{Binding Navigation.NavigateCommand}"
                    CommandParameter="{x:Static vm:SettingsPage.LanguageServers}">
              <Grid ColumnDefinitions="15,*" ColumnSpacing="9">
                <svg:Svg Width="15" Height="15" Path="/Assets/icons/file-code.svg" Css="{DynamicResource IconSvgCss}" />
                <TextBlock Grid.Column="1" Text="{DynamicResource LocLanguageServers}" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button Classes="navigation"
                    Classes.selected="{Binding Navigation.HighlightedNavigation, Converter={x:Static local:SettingsConverters.EqualsParameter}, ConverterParameter={x:Static vm:SettingsPage.Agents}}"
                    Command="{Binding Navigation.NavigateCommand}"
                    CommandParameter="{x:Static vm:SettingsPage.Agents}">
              <Grid ColumnDefinitions="15,*,13" ColumnSpacing="9">
                <svg:Svg Width="15" Height="15" Path="/Assets/icons/agent.svg" Css="{DynamicResource IconSvgCss}" />
                <TextBlock Grid.Column="1" Text="{DynamicResource LocAgents}" VerticalAlignment="Center" />
                <svg:Svg Grid.Column="2" Width="13" Height="13" Path="/Assets/icons/chevron-right.svg" Css="{DynamicResource IconSvgCss}" VerticalAlignment="Center" RenderTransformOrigin="50%,50%">
                  <svg:Svg.RenderTransform>
                    <RotateTransform Angle="{Binding Navigation.AgentsExpanded, Converter={x:Static local:SettingsConverters.ExpandedAngle}}" />
                  </svg:Svg.RenderTransform>
                </svg:Svg>
              </Grid>
            </Button>
            <ItemsControl Margin="30,0,0,0" ItemsSource="{Binding Desktop.Agents}" IsVisible="{Binding Navigation.AgentsExpanded}">
              <ItemsControl.Styles><Style Selector="ContentPresenter"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ItemsControl.Styles>
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:AgentItem">
                  <Button Classes="navigation provider"
                          Command="{Binding $parent[ItemsControl].((vm:SettingsWindowViewModel)DataContext).Navigation.ShowAgentCommand}"
                          CommandParameter="{Binding Id}"
                          local:NavigationHighlight.Key="{Binding Id}"
                          local:NavigationHighlight.Current="{Binding $parent[ItemsControl].((vm:SettingsWindowViewModel)DataContext).Navigation.HighlightedAgentId}"
                          AutomationProperties.Name="{Binding DisplayName, StringFormat=Open {0} agent details}">
                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="navigation"
                    Classes.selected="{Binding Navigation.HighlightedNavigation, Converter={x:Static local:SettingsConverters.EqualsParameter}, ConverterParameter={x:Static vm:SettingsPage.Logging}}"
                    Command="{Binding Navigation.NavigateCommand}"
                    CommandParameter="{x:Static vm:SettingsPage.Logging}">
              <Grid ColumnDefinitions="15,*" ColumnSpacing="9">
                <svg:Svg Width="15" Height="15" Path="/Assets/icons/assets.svg" Css="{DynamicResource IconSvgCss}" />
                <TextBlock Grid.Column="1" Text="{DynamicResource LocLogging}" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button Classes="navigation"
                    Classes.selected="{Binding Navigation.HighlightedNavigation, Converter={x:Static local:SettingsConverters.EqualsParameter}, ConverterParameter={x:Static vm:SettingsPage.Providers}}"
                    Command="{Binding Navigation.NavigateCommand}"
                    CommandParameter="{x:Static vm:SettingsPage.Providers}">
              <Grid ColumnDefinitions="15,*,13" ColumnSpacing="9">
                <svg:Svg Width="15" Height="15" Path="/Assets/icons/components.svg" Css="{DynamicResource IconSvgCss}" />
                <TextBlock Grid.Column="1" Text="{DynamicResource LocModelProviders}" VerticalAlignment="Center" />
                <svg:Svg
                         Grid.Column="2"
                         Width="13"
                         Height="13"
                         Path="/Assets/icons/chevron-right.svg"
                         Css="{DynamicResource IconSvgCss}"
                         VerticalAlignment="Center"
                         RenderTransformOrigin="50%,50%">
                  <svg:Svg.RenderTransform>
                    <RotateTransform Angle="{Binding Navigation.ProvidersExpanded, Converter={x:Static local:SettingsConverters.ExpandedAngle}}" />
                  </svg:Svg.RenderTransform>
                </svg:Svg>
              </Grid>
            </Button>
            <ItemsControl Margin="30,0,0,0"
                          ItemsSource="{Binding Desktop.Providers}"
                          IsVisible="{Binding Navigation.ProvidersExpanded}">
              <ItemsControl.Styles>
                <Style Selector="ContentPresenter">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
              </ItemsControl.Styles>
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="3" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:ProviderItem">
                  <Button Classes="navigation provider"
                          Command="{Binding $parent[ItemsControl].((vm:SettingsWindowViewModel)DataContext).Navigation.ShowProviderCommand}"
                          CommandParameter="{Binding Id}"
                          local:NavigationHighlight.Key="{Binding Id}"
                          local:NavigationHighlight.Current="{Binding $parent[ItemsControl].((vm:SettingsWindowViewModel)DataContext).Navigation.HighlightedProviderId}"
                          AutomationProperties.Name="{Binding DisplayName, StringFormat=Open {0} provider settings}">
                    <Grid ColumnDefinitions="*,13" ColumnSpacing="9">
                      <Ellipse Grid.Column="1"
                               Classes="provider-nav-status"
                               Fill="{DynamicResource WarningBrush}"
                               IsVisible="{Binding !Configured}" />
                      <Ellipse Grid.Column="1"
                               Classes="provider-nav-status"
                               Fill="{DynamicResource SuccessBrush}"
                               IsVisible="{Binding Configured}" />
                      <TextBlock Grid.Column="0"
                                 Text="{Binding DisplayName}"
                                 VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Grid Grid.Column="1" Background="{DynamicResource SurfaceBrush}">
        <Panel IsVisible="{Binding Navigation.SelectedPage, Converter={x:Static local:SettingsConverters.EqualsParameter}, ConverterParameter={x:Static vm:SettingsPage.Defaults}}">
          <settings:DefaultsSettingsControl DataContext="{Binding Defaults}" />
        </Panel>

        <Panel IsVisible="{Binding Navigation.SelectedPage, Converter={x:Static local:SettingsConverters.EqualsParameter}, ConverterParameter={x:Static vm:SettingsPage.Appearance}}">
          <settings:AppearanceSettingsControl DataContext="{Binding Appearance}" />
        </Panel>

        <settings:ShortcutsSettingsControl IsVisible="{Binding Navigation.SelectedPage, Converter={x:Static local:SettingsConverters.EqualsParameter}, ConverterParameter={x:Static vm:SettingsPage.Shortcuts}}" />

        <Panel IsVisible="{Binding Navigation.SelectedPage, Converter={x:Static local:SettingsConverters.EqualsParameter}, ConverterParameter={x:Static vm:SettingsPage.Computer}}">
          <settings:ComputerUseSettingsControl DataContext="{Binding Computer}" />
        </Panel>

        <Panel IsVisible="{Binding Navigation.SelectedPage, Converter={x:Static local:SettingsConverters.EqualsParameter}, ConverterParameter={x:Static vm:SettingsPage.Browser}}">
          <settings:BrowserUseSettingsControl DataContext="{Binding Browser}" />
        </Panel>

        <Panel IsVisible="{Binding Navigation.SelectedPage, Converter={x:Static local:SettingsConverters.EqualsParameter}, ConverterParameter={x:Static vm:SettingsPage.Logging}}">
          <settings:LoggingSettingsControl DataContext="{Binding Logging}" />
        </Panel>

        <Panel IsVisible="{Binding Navigation.SelectedPage, Converter={x:Static local:SettingsConverters.EqualsParameter}, ConverterParameter={x:Static vm:SettingsPage.Mcp}}">
          <settings:McpServersSettingsControl x:Name="McpPage" DataContext="{Binding Mcp}" />
        </Panel>

        <Panel IsVisible="{Binding Navigation.SelectedPage, Converter={x:Static local:SettingsConverters.EqualsParameter}, ConverterParameter={x:Static vm:SettingsPage.LanguageServers}}">
          <settings:LanguageServersSettingsControl x:Name="LanguageServersPage" DataContext="{Binding LanguageServers}" />
        </Panel>

        <settings:AgentSettingsControl IsVisible="{Binding Navigation.SelectedPage, Converter={x:Static local:SettingsConverters.EqualsParameter}, ConverterParameter={x:Static vm:SettingsPage.Agents}}"
                                       Agents="{Binding Desktop.Agents}"
                                       SelectedAgentId="{Binding Navigation.SelectedAgentId}"
                                       AgentSelected="AgentSelected" />

        <Grid IsVisible="{Binding Navigation.SelectedPage, Converter={x:Static local:SettingsConverters.EqualsParameter}, ConverterParameter={x:Static vm:SettingsPage.Providers}}">
          <settings:ModelProviderSettingsControl x:Name="ProviderManager"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Providers="{Binding Desktop.Providers}"
                                    ProviderSelected="ProviderSelected"
                                    EndpointTextChanged="ProviderEndpointChanged"
                                    ApiKeyTextChanged="ProviderApiKeyChanged"
                                    SaveEndpointRequested="SaveProviderEndpoint"
                                    ResetEndpointRequested="ResetProviderEndpoint"
                                    SaveCredentialRequested="SaveCredential"
                                    RemoveCredentialRequested="RemoveCredential" />
        </Grid>

        <Panel IsVisible="{Binding Navigation.SelectedPage, Converter={x:Static local:SettingsConverters.EqualsParameter}, ConverterParameter={x:Static vm:SettingsPage.Network}}">
          <settings:NetworkSettingsControl DataContext="{Binding NetworkEditor}" />
        </Panel>
        <Panel IsVisible="{Binding Navigation.SelectedPage, Converter={x:Static local:SettingsConverters.EqualsParameter}, ConverterParameter={x:Static vm:SettingsPage.Remote}}">
          <settings:RemoteServerSettingsControl DataContext="{Binding RemoteEditor}" />
        </Panel>
      </Grid>
    </Grid>
  </Grid>
</Window>
