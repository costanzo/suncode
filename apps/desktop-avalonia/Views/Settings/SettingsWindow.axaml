<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:SunCode.Desktop.Models"
        xmlns:vm="using:SunCode.Desktop.ViewModels"
        xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
        x:Class="SunCode.Desktop.Views.Settings.SettingsWindow"
        x:DataType="vm:DesktopViewModel"
        Title="Settings"
        Width="900" Height="672"
        MinWidth="720" MinHeight="552"
        Background="Transparent"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="CenterOwner">
  <Border x:Name="SettingsChrome"
          Margin="16"
          Background="{DynamicResource CanvasBrush}"
          BorderBrush="{DynamicResource WindowChromeBorderBrush}"
          BorderThickness="0.5"
          CornerRadius="12"
          Padding="1.5">
  <Border Background="{DynamicResource CanvasBrush}"
          CornerRadius="11"
          ClipToBounds="True">
  <Grid RowDefinitions="32,*">
    <Grid Grid.Row="0" Background="{DynamicResource CanvasBrush}" ColumnDefinitions="Auto,*" PointerPressed="SettingsTitleBarPressed" DoubleTapped="SettingsTitleBarDoubleTapped">
      <StackPanel Orientation="Horizontal" Spacing="6" Margin="5,0,0,0" VerticalAlignment="Center">
        <Button x:Name="SettingsCloseLight" Classes="titlebar" Width="18" Height="18" Padding="2" Click="CloseSettings" PointerEntered="TrafficLightEntered" PointerExited="TrafficLightExited" PointerPressed="TrafficLightPressed" PointerReleased="TrafficLightReleased" ToolTip.Tip="Close window"><svg:Svg Path="/Assets/traffic-lights/1-close-1-normal.svg" /></Button>
        <Button x:Name="SettingsMinimizeLight" Classes="titlebar" Width="18" Height="18" Padding="2" Click="MinimizeSettings" PointerEntered="TrafficLightEntered" PointerExited="TrafficLightExited" PointerPressed="TrafficLightPressed" PointerReleased="TrafficLightReleased" ToolTip.Tip="Minimize window"><svg:Svg Path="/Assets/traffic-lights/2-minimize-1-normal.svg" /></Button>
        <Button x:Name="SettingsMaximizeLight" Classes="titlebar" Width="18" Height="18" Padding="2" Click="ToggleSettingsMaximized" PointerEntered="TrafficLightEntered" PointerExited="TrafficLightExited" PointerPressed="TrafficLightPressed" PointerReleased="TrafficLightReleased" ToolTip.Tip="Maximize window"><svg:Svg Path="/Assets/traffic-lights/3-maximize-1-normal.svg" /></Button>
      </StackPanel>
      <TextBlock Grid.Column="1" Text="Settings" FontSize="13" FontWeight="SemiBold" Margin="4,0,0,0" VerticalAlignment="Center" />
    </Grid>
  <Grid Grid.Row="1" RowDefinitions="58,*">
    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="22,0" ColumnDefinitions="*,Auto">
        <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="compact primary" Content="Done" Click="CloseSettings" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="238,*">
      <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="16,20" Spacing="4">
            <TextBlock Classes="section-label" Text="GENERAL" Margin="10,0,0,0" />
            <Button x:Name="DefaultsNavigation" Classes="navigation selected" Content="Defaults" Click="ShowDefaults" />
            <Button x:Name="AppearanceNavigation" Classes="navigation" Content="Appearance" Click="ShowAppearance" />
            <Button x:Name="NetworkNavigation" Classes="navigation" Content="Network" Click="ShowNetwork" />
            <Button x:Name="LoggingNavigation" Classes="navigation" Content="Logging" Click="ShowLogging" />
            <Border Height="12" />
            <TextBlock Classes="section-label" Text="MODELS" Margin="10,0,0,0" />
            <Button x:Name="ProvidersNavigation" Classes="navigation" Click="ToggleProviders">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <svg:Svg x:Name="ProvidersChevron" Width="10" Height="10" Path="/Assets/icons/chevron-right.svg" Css="{DynamicResource IconSvgCss}" />
                <TextBlock Text="Model providers" FontWeight="SemiBold" />
              </StackPanel>
            </Button>
            <StackPanel x:Name="ProviderNavigation" Spacing="4">
              <Button Classes="navigation" Content="DeepSeek" Tag="deepseek" Margin="18,0,0,0" Click="ShowProvider" />
              <Button Classes="navigation" Content="Zhipu GLM" Tag="zhipu" Margin="18,0,0,0" Click="ShowProvider" />
              <Button Classes="navigation" Content="OpenAI" Tag="openai" Margin="18,0,0,0" Click="ShowProvider" />
              <Button Classes="navigation" Content="Kimi" Tag="kimi" Margin="18,0,0,0" Click="ShowProvider" />
              <Button Classes="navigation" Content="Claude" Tag="claude" Margin="18,0,0,0" Click="ShowProvider" />
              <Button Classes="navigation" Content="Gemini" Tag="gemini" Margin="18,0,0,0" Click="ShowProvider" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Grid Grid.Column="1">
        <ScrollViewer x:Name="DefaultsPage" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="32,28" Spacing="18">
            <StackPanel Spacing="4">
              <TextBlock Text="Defaults" FontSize="22" FontWeight="SemiBold" />
              <TextBlock Text="Configure model and turn defaults." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Classes="section-label" Text="DEFAULT MODEL" />
            <ComboBox x:Name="DefaultModelSelector" HorizontalAlignment="Stretch" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" SelectionChanged="DefaultModelChanged">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="models:ModelItem"><TextBlock Classes="mono" Text="{Binding Id}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="Only models registered by the local agent appear here." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4" />
            <TextBlock Classes="section-label" Text="TURN EXECUTION" />
            <Grid ColumnDefinitions="*,140">
              <StackPanel Spacing="3">
                <TextBlock Text="Tool-call limit" FontWeight="SemiBold" />
                <TextBlock x:Name="ToolCallLimitScope" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
              </StackPanel>
              <NumericUpDown x:Name="ToolCallLimitInput"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Minimum="1"
                            Maximum="256"
                            Increment="1"
                            FormatString="0" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Button x:Name="SaveToolCallLimitButton" Classes="compact primary" Content="Save project limit" Click="SaveToolCallLimit" />
              <TextBlock x:Name="ToolCallLimitStatus" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="AppearancePage" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="32,28" Spacing="18">
            <StackPanel Spacing="4">
              <TextBlock Text="Appearance" FontSize="22" FontWeight="SemiBold" />
              <TextBlock Text="Adjust how SunCode looks across every open window." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Classes="section-label" Text="THEME" />
            <Grid ColumnDefinitions="*,160">
              <TextBlock Text="Color theme" FontWeight="SemiBold" VerticalAlignment="Center" />
              <ComboBox x:Name="ThemeSelector" Grid.Column="1" SelectionChanged="ThemeChanged">
                <ComboBoxItem Content="Dark" Tag="dark" />
                <ComboBoxItem Content="Light" Tag="light" />
              </ComboBox>
            </Grid>
            <TextBlock Text="Changes apply immediately." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="LoggingPage" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="32,28" Spacing="18">
            <StackPanel Spacing="4">
              <TextBlock Text="Logging" FontSize="22" FontWeight="SemiBold" />
              <TextBlock Text="Control diagnostic detail and how long local log files are kept." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock Classes="section-label" Text="DIAGNOSTIC OUTPUT" />
            <Grid ColumnDefinitions="*,180" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="14">
              <StackPanel Spacing="3">
                <TextBlock Text="Minimum level" FontWeight="SemiBold" />
                <TextBlock Text="Lower levels include more diagnostic detail." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
              </StackPanel>
              <ComboBox x:Name="LogLevelSelector" Grid.Column="1" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="TRACE" Tag="TRACE" />
                <ComboBoxItem Content="DEBUG" Tag="DEBUG" />
                <ComboBoxItem Content="INFO" Tag="INFO" />
                <ComboBoxItem Content="WARN" Tag="WARN" />
                <ComboBoxItem Content="ERROR" Tag="ERROR" />
                <ComboBoxItem Content="OFF" Tag="OFF" />
              </ComboBox>

              <StackPanel Grid.Row="1" Spacing="3">
                <TextBlock Text="Log directory" FontWeight="SemiBold" />
                <TextBlock Text="Leave empty to use the data directory's logs folder." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
              </StackPanel>
              <TextBox x:Name="LogDirectoryInput" Grid.Row="1" Grid.Column="1" Classes="mono" PlaceholderText="Default logs folder" />

              <StackPanel Grid.Row="2" Spacing="3">
                <TextBlock Text="Maximum file size" FontWeight="SemiBold" />
                <TextBlock Text="Rotate each file after it reaches this many bytes. Minimum 1024." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
              </StackPanel>
              <TextBox x:Name="LogMaxBytesInput" Grid.Row="2" Grid.Column="1" Classes="mono" PlaceholderText="10485760" />

              <StackPanel Grid.Row="3" Spacing="3">
                <TextBlock Text="Retained backups" FontWeight="SemiBold" />
                <TextBlock Text="Number of rotated backups to keep, from 0 to 100." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
              </StackPanel>
              <TextBox x:Name="LogRetentionInput" Grid.Row="3" Grid.Column="1" Classes="mono" PlaceholderText="5" />
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Button Classes="compact primary" Content="Save logging settings" Click="SaveLogging" />
              <TextBlock x:Name="LoggingStatus" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="NetworkPage" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="32,28" Spacing="18">
            <StackPanel Spacing="4">
              <TextBlock Text="Network" FontSize="22" FontWeight="SemiBold" />
              <TextBlock Text="Configure how Rust HTTPS clients establish secure connections." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock Classes="section-label" Text="HTTPS SECURITY" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
              <StackPanel Spacing="3">
                <TextBlock Text="Verify server certificates" FontWeight="SemiBold" />
                <TextBlock Text="Validate certificate chains and hostnames for model provider and WebFetch requests." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
              </StackPanel>
              <ToggleSwitch x:Name="VerifyHttpsCertificatesToggle"
                            Grid.Column="1"
                            OnContent="On"
                            OffContent="Off"
                            VerticalAlignment="Center"
                            Click="HttpsCertificateVerificationChanged" />
            </Grid>

            <Border x:Name="HttpsCertificateWarning"
                    IsVisible="False"
                    Background="{DynamicResource WarningSurfaceBrush}"
                    BorderBrush="{DynamicResource WarningBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,10">
              <StackPanel Spacing="4">
                <TextBlock Text="Certificate verification is off" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
                <TextBlock Text="SunCode will accept invalid certificates and hostnames, similar to curl -k. This can expose provider credentials and fetched content to man-in-the-middle attacks." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Button Classes="compact primary" Content="Save HTTPS setting" Click="SaveHttpsCertificateVerification" />
              <TextBlock x:Name="HttpsCertificateStatus" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="ProviderPage" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="32,28" Spacing="18">
            <StackPanel Spacing="4">
              <TextBlock x:Name="ProviderTitle" FontSize="22" FontWeight="SemiBold" />
              <TextBlock x:Name="ProviderDescription" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Classes="section-label" Text="CREDENTIAL" />
            <TextBlock x:Name="CredentialStatus" TextWrapping="Wrap" />
            <TextBox x:Name="ProviderApiKey" PlaceholderText="Paste API key" PasswordChar="●" Classes="mono" TextChanged="ProviderApiKeyChanged" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="SaveCredentialButton" Classes="primary" Content="Save key" Click="SaveCredential" IsEnabled="False" />
              <Button x:Name="RemoveCredentialButton" Classes="danger" Content="Remove key" Click="RemoveCredential" />
            </StackPanel>
            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4" />
            <TextBlock Classes="section-label" Text="AVAILABLE MODELS" />
            <TextBlock x:Name="ProviderModelsText" Classes="mono" TextWrapping="Wrap" />
            <TextBlock Text="The agent owns provider availability and model registration." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
  </Grid>
  </Border>
  </Border>
</Window>
