<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             x:Class="SunCode.Desktop.Controls.SCGroupComboBox"
             x:Name="SunCode"
             x:CompileBindings="False">
  <Button x:Name="GroupedButton"
          Classes="sc-button sc-combo-trigger"
          HorizontalAlignment="Stretch"
          HorizontalContentAlignment="Stretch"
          Foreground="{DynamicResource TextBrush}"
          Click="OpenGroupedMenu">
    <Grid ColumnDefinitions="*,12"
          ColumnSpacing="6">
      <TextBlock x:Name="GroupedLabel"
                 Foreground="{DynamicResource TextBrush}"
                 MinWidth="1"
                 FontSize="10"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Stretch"
                 TextTrimming="CharacterEllipsis" />
      <svg:Svg Grid.Column="1"
               Width="9"
               Height="9"
               Path="/Assets/icons/chevron-right.svg"
               Css="{DynamicResource IconSvgCss}"
               RenderTransformOrigin="50%,50%"
               RenderTransform="rotate(90deg)"
               VerticalAlignment="Center" />
    </Grid>
  </Button>
</UserControl>
