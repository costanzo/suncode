<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:SunCode.Desktop.Controls"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             x:Class="SunCode.Desktop.Controls.SCComboBox"
             x:Name="SunCode"
             x:CompileBindings="False">
  <Grid>
    <ComboBox x:Name="FlatCombo"
              IsVisible="False">
      <ComboBox.ItemTemplate>
        <DataTemplate x:DataType="controls:SCComboBoxItem">
          <StackPanel Spacing="2">
            <TextBlock Text="{Binding Label}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding SecondaryText}"
                       Classes="sc-text-hint"
                       FontSize="10"
                       IsVisible="{Binding HasSecondaryText}" />
          </StackPanel>
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
    <TextBlock x:Name="FlatLabel"
               IsVisible="False"
               IsHitTestVisible="False"
               Margin="8,0,28,0"
               VerticalAlignment="Center"
               Text="{Binding DisplayText, ElementName=SunCode}"
               TextTrimming="CharacterEllipsis"
               Foreground="{DynamicResource TextSecondaryBrush}" />

    <Button x:Name="GroupedButton"
            Classes="sc-button sc-combo-trigger"
            HorizontalContentAlignment="Stretch"
            Foreground="{DynamicResource TextBrush}"
            IsVisible="False"
            Click="OpenGroupedMenu">
      <Grid ColumnDefinitions="*,12"
            ColumnSpacing="6">
        <TextBlock x:Name="GroupedLabel"
                   Text="{Binding DisplayText, ElementName=SunCode}"
                   Foreground="{DynamicResource TextBrush}"
                   MinWidth="1"
                   FontSize="10"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Stretch"
                   TextTrimming="CharacterEllipsis" />
        <svg:Svg Grid.Column="1"
                 Width="9"
                 Height="9"
                 Path="/Assets/icons/chevron-right.svg"
                 Css="{DynamicResource IconSvgCss}"
                 RenderTransformOrigin="50%,50%"
                 RenderTransform="rotate(90deg)"
                 VerticalAlignment="Center" />
      </Grid>
    </Button>
  </Grid>
</UserControl>
