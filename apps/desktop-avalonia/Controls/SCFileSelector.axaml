<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             x:Class="SunCode.Desktop.Controls.SCFileSelector"
             x:CompileBindings="False">
  <Grid ColumnDefinitions="*">
    <TextBox x:Name="PathInput"
             Classes="mono"
             Padding="12,7,38,7" />
    <Button x:Name="BrowseButton"
            Classes="quiet sc-button"
            Width="28"
            Height="28"
            MinHeight="28"
            Padding="6"
            Margin="0,0,4,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center">
      <svg:Svg Width="16"
               Height="16"
               Path="/Assets/icons/folder.svg"
               Css="{DynamicResource IconSvgCss}" />
    </Button>
  </Grid>
</UserControl>
