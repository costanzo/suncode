<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SunCode.Desktop.Controls.SCStatusDot"
        x:CompileBindings="False"
        ClipToBounds="False">
  <Grid x:Name="DotGrid">
    <Ellipse Classes="status-dot-ring"/>
    <Ellipse Classes="status-dot-core"/>
  </Grid>
</UserControl>
