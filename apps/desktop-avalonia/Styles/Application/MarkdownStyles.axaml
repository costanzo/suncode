<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia">
  <StyleInclude Source="avares://LiveMarkdown.Avalonia/Styles.axaml" />
  <Style Selector="md|MarkdownRenderer">
    <Setter Property="MaxWidth" Value="760" />
  </Style>
  <Style Selector="md|MarkdownTextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontFamily" Value="Noto Sans, Noto Sans CJK SC, Noto Sans SC, PingFang SC, Helvetica Neue, Arial, sans-serif" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="22.4" />
  </Style>
  <Style Selector="md|MarkdownTextBlock.H1">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="md|MarkdownTextBlock.H2">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontSize" Value="19" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="md|MarkdownTextBlock.H3">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="md|MarkdownTextBlock.H4">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="md|MarkdownTextBlock.H5">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="md|MarkdownTextBlock.H6">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="md|CodeBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontFamily" Value="JetBrains Mono, SF Mono, Menlo, Monaco, Consolas, monospace" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Margin" Value="16,0" />
    <Setter Property="IsCodeWrapped" Value="False" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
  </Style>
  <Style Selector="md|CodeInline">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="2,0" />
    <Setter Property="Margin" Value="6,0" />
  </Style>
  <Style Selector="md|Link">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="TextDecorations" Value="Underline" />
  </Style>
  <Style Selector="md|MarkdownListGrid">
    <Setter Property="ColumnSpacing" Value="8" />
    <Setter Property="RowSpacing" Value="5" />
    <Setter Property="Margin" Value="0,5" />
  </Style>
  <Style Selector="md|MarkdownTableGrid">
    <Setter Property="ColumnSpacing" Value="0" />
    <Setter Property="RowSpacing" Value="0" />
    <Setter Property="Margin" Value="0,10" />
  </Style>
  <Style Selector="Border.QuoteBlock">
    <Setter Property="Background" Value="{DynamicResource AccentSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Margin" Value="0,8" />
  </Style>
  <Style Selector="Border.TableCell">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,1" />
    <Setter Property="Padding" Value="9,7" />
  </Style>
</Styles>
