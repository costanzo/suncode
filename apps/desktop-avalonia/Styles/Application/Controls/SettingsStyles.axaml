<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="StackPanel.settings-panel-content">
    <Setter Property="Margin" Value="32,28,32,34" />
    <Setter Property="MaxWidth" Value="720" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="StackPanel.settings-panel-heading">
    <Setter Property="Spacing" Value="4" />
    <Setter Property="Margin" Value="0,0,0,26" />
  </Style>
  <Style Selector="Grid.settings-shortcuts-heading">
    <Setter Property="ColumnSpacing" Value="18" />
  </Style>
  <Style Selector="StackPanel.settings-panel-heading-copy">
    <Setter Property="Spacing" Value="4" />
  </Style>
  <Style Selector="Border.settings-read-only-badge">
    <Setter Property="Margin" Value="0,2,0,0" />
    <Setter Property="Padding" Value="7,4" />
    <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector="Border.settings-read-only-badge TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="Border.settings-read-only-note">
    <Setter Property="Padding" Value="11,10" />
    <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="StackPanel.settings-shortcut-list">
    <Setter Property="Spacing" Value="0" />
  </Style>
  <Style Selector="Border.settings-shortcut-row">
    <Setter Property="MinHeight" Value="52" />
    <Setter Property="Padding" Value="4,8" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="TextBlock.settings-shortcut-action">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="StackPanel.settings-key-chord">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="5" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.settings-keycap">
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="7,3" />
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1,1,1,2" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.settings-keycap TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="StackPanel.settings-panel-section">
    <Setter Property="Spacing" Value="16" />
  </Style>
  <Style Selector="Grid.settings-row">
    <Setter Property="ColumnSpacing" Value="24" />
  </Style>
  <Style Selector="StackPanel.settings-row-copy">
    <Setter Property="Spacing" Value="4" />
  </Style>
  <Style Selector="TextBlock.settings-row-title">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.settings-row-hint">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="16" />
  </Style>
  <Style Selector="StackPanel.settings-actions">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="10" />
    <Setter Property="Margin" Value="0,22,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="WrapPanel.settings-actions">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="ItemSpacing" Value="10" />
    <Setter Property="Margin" Value="0,22,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.settings-divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="0,28" />
    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
  </Style>
  <Style Selector="Border.settings-subsection">
    <Setter Property="Margin" Value="0,-2,0,0" />
    <Setter Property="Padding" Value="18,14,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
  </Style>
  <Style Selector="Expander.settings-expander">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="4,4,4,18" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1"
                Background="Transparent">
          <StackPanel>
            <ToggleButton x:Name="ExpanderHeader"
                          IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}">
              <ToggleButton.Template>
                <ControlTemplate>
                  <Border Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="4"
                          Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                  </Border>
                </ControlTemplate>
              </ToggleButton.Template>
              <Grid ColumnDefinitions="12,*" ColumnSpacing="4">
                <PathIcon x:Name="DisclosureChevron"
                          Width="7"
                          Height="10"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource TextMutedBrush}"
                          Data="M 1,0 L 6,5 L 1,10 Z"
                          RenderTransformOrigin="50%,50%" />
                <ContentPresenter Grid.Column="1"
                                  Content="{TemplateBinding Header}"
                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                  VerticalAlignment="Center" />
              </Grid>
            </ToggleButton>
            <Border IsVisible="{TemplateBinding IsExpanded}"
                    Padding="{TemplateBinding Padding}"
                    Background="Transparent">
              <ContentPresenter Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
            </Border>
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Expander.settings-expander /template/ ToggleButton#ExpanderHeader">
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Expander.settings-expander /template/ ToggleButton#ExpanderHeader:pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Expander.settings-expander /template/ ToggleButton#ExpanderHeader:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Expander.settings-expander:expanded /template/ PathIcon#DisclosureChevron">
    <Setter Property="RenderTransform" Value="rotate(90deg)" />
  </Style>
  <Style Selector="Border.settings-warning">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="11,10" />
  </Style>
  <Style Selector="Border.settings-provider-status">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <Style Selector="TextBlock.settings-hint">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBox.sc-secret-input">
    <Setter Property="PasswordChar" Value="•" />
  </Style>
  <Style Selector="TextBox.sc-secret-input, TextBox.sc-secret-input:focus">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
  </Style>
  <Style Selector="TextBox.settings-proxy-bypass, TextBox.settings-proxy-bypass:focus">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="Padding" Value="9,8" />
  </Style>
  <!-- Status tones set by StatusToneProperties.Tone on settings status dots and text. -->
  <Style Selector="Ellipse.tone-muted">
    <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="Ellipse.tone-success">
    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
  </Style>
  <Style Selector="Ellipse.tone-warning">
    <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
  </Style>
  <Style Selector="Ellipse.tone-danger">
    <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
  </Style>
  <Style Selector="TextBlock.tone-success">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
  </Style>
  <Style Selector="TextBlock.tone-danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>
</Styles>
