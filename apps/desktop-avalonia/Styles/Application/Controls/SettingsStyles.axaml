<Styles xmlns="https://github.com/avaloniaui">
  <Style Selector="StackPanel.settings-panel-content">
    <Setter Property="Margin" Value="32,28,32,34" />
    <Setter Property="MaxWidth" Value="720" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="StackPanel.settings-panel-heading">
    <Setter Property="Spacing" Value="4" />
    <Setter Property="Margin" Value="0,0,0,26" />
  </Style>
  <Style Selector="Grid.settings-shortcuts-heading">
    <Setter Property="ColumnSpacing" Value="18" />
  </Style>
  <Style Selector="StackPanel.settings-panel-heading-copy">
    <Setter Property="Spacing" Value="4" />
  </Style>
  <Style Selector="Border.settings-read-only-badge">
    <Setter Property="Margin" Value="0,2,0,0" />
    <Setter Property="Padding" Value="7,4" />
    <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector="Border.settings-read-only-badge TextBlock">
    <Setter Property="FontFamily" Value="JetBrains Mono, SF Mono, Menlo, Monaco, Consolas, monospace" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="Border.settings-read-only-note">
    <Setter Property="Padding" Value="11,10" />
    <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="StackPanel.settings-shortcut-list">
    <Setter Property="Spacing" Value="0" />
  </Style>
  <Style Selector="Border.settings-shortcut-row">
    <Setter Property="MinHeight" Value="52" />
    <Setter Property="Padding" Value="4,8" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="TextBlock.settings-shortcut-action">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="StackPanel.settings-key-chord">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="5" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.settings-keycap">
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="7,3" />
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1,1,1,2" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.settings-keycap TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="StackPanel.settings-panel-section">
    <Setter Property="Spacing" Value="16" />
  </Style>
  <Style Selector="Grid.settings-row">
    <Setter Property="ColumnSpacing" Value="24" />
  </Style>
  <Style Selector="StackPanel.settings-row-copy">
    <Setter Property="Spacing" Value="4" />
  </Style>
  <Style Selector="TextBlock.settings-row-title">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.settings-row-hint">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="16" />
  </Style>
  <Style Selector="StackPanel.settings-actions">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="10" />
    <Setter Property="Margin" Value="0,22,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.settings-divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="0,28" />
    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
  </Style>
  <Style Selector="Border.settings-subsection">
    <Setter Property="Margin" Value="0,-2,0,0" />
    <Setter Property="Padding" Value="18,14,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
  </Style>
  <Style Selector="Border.settings-warning">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="11,10" />
  </Style>
  <Style Selector="Border.settings-provider-status">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <Style Selector="TextBlock.settings-hint">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBox.sc-secret-input">
    <Setter Property="PasswordChar" Value="•" />
  </Style>
  <Style Selector="TextBox.sc-secret-input, TextBox.sc-secret-input:focus">
    <Setter Property="FontFamily" Value="JetBrains Mono, SF Mono, Menlo, Monaco, Consolas, monospace" />
  </Style>
</Styles>
