<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:SunCode.Desktop.Controls">
  <Style Selector="controls|SCNumericInput">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="controls|SCNumericInput NumericUpDown.sc-numeric-input-inner">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontFamily" Value="JetBrains Mono, SF Mono, Menlo, Monaco, Consolas, monospace" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
  </Style>
  <Style Selector="controls|SCNumericInput NumericUpDown.sc-numeric-input-inner:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
  </Style>
  <Style Selector="controls|SCNumericInput NumericUpDown.sc-numeric-input-inner:pointerover /template/ ButtonSpinner#PART_Spinner">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
  </Style>
  <Style Selector="controls|SCNumericInput NumericUpDown.sc-numeric-input-inner:pointerover /template/ ButtonSpinner#PART_Spinner /template/ Border">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
  </Style>
  <Style Selector="controls|SCNumericInput NumericUpDown.sc-numeric-input-inner:focus">
    <Setter Property="Background" Value="{DynamicResource FieldFocusBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="controls|SCNumericInput NumericUpDown.sc-numeric-input-inner ButtonSpinner#PART_Spinner">
    <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="controls|SCNumericInput NumericUpDown.sc-numeric-input-inner /template/ ButtonSpinner#PART_Spinner /template/ Border">
    <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="controls|SCNumericInput NumericUpDown.sc-numeric-input-inner /template/ RepeatButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="controls|SCNumericInput NumericUpDown.sc-numeric-input-inner /template/ RepeatButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="controls|SCNumericInput NumericUpDown.sc-numeric-input-inner /template/ TextBox#PART_TextBox">
    <Setter Property="FocusAdorner" Value="{x:Null}" />
  </Style>
  <Style Selector="controls|SCNumericInput NumericUpDown.sc-numeric-input-inner /template/ TextBox#PART_TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="controls|SCNumericInput NumericUpDown.sc-numeric-input-inner /template/ TextBox#PART_TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
</Styles>
