<Styles xmlns="https://github.com/avaloniaui">
  <Style Selector="NumericUpDown.sc-numeric-input">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="NumericUpDown.sc-numeric-input:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="NumericUpDown.sc-numeric-input Button">
    <Setter Property="MinHeight" Value="16" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
</Styles>
