<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:SunCode.Desktop.Controls">
  <Style Selector="controls|SCStatusDot">
    <Setter Property="Width" Value="13"/>
    <Setter Property="Height" Value="13"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Focusable" Value="False"/>
  </Style>
  <Style Selector="controls|SCStatusDot Grid#DotGrid">
    <Setter Property="Width" Value="13"/>
    <Setter Property="Height" Value="13"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="RenderTransform">
      <Setter.Value>
        <ScaleTransform ScaleX="1" ScaleY="1"/>
      </Setter.Value>
    </Setter>
    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
  </Style>
  <Style Selector="controls|SCStatusDot Ellipse.status-dot-ring">
    <Setter Property="Width" Value="13"/>
    <Setter Property="Height" Value="13"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="controls|SCStatusDot Ellipse.status-dot-core">
    <Setter Property="Width" Value="7"/>
    <Setter Property="Height" Value="7"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <!-- running -->
  <Style Selector="controls|SCStatusDot Grid#DotGrid.running > Ellipse.status-dot-ring">
    <Setter Property="Fill" Value="{DynamicResource AccentAuraBrush}" />
  </Style>
  <Style Selector="controls|SCStatusDot Grid#DotGrid.running > Ellipse.status-dot-core">
    <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="controls|SCStatusDot Grid#DotGrid.running">
    <Style.Animations>
      <Animation Duration="0:0:1.4" IterationCount="INFINITE">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.72"/><Setter Property="ScaleTransform.ScaleX" Value="0.9"/><Setter Property="ScaleTransform.ScaleY" Value="0.9"/></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1"/><Setter Property="ScaleTransform.ScaleX" Value="1.15"/><Setter Property="ScaleTransform.ScaleY" Value="1.15"/></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.72"/><Setter Property="ScaleTransform.ScaleX" Value="0.9"/><Setter Property="ScaleTransform.ScaleY" Value="0.9"/></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <!-- quiet single dot -->
  <Style Selector="controls|SCStatusDot Grid#DotGrid.quiet > Ellipse.status-dot-core">
    <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
  </Style>
  <!-- compacting -->
  <Style Selector="controls|SCStatusDot Grid#DotGrid.compacting > Ellipse.status-dot-ring">
    <Setter Property="Fill" Value="{DynamicResource SuccessAuraBrush}" />
  </Style>
  <Style Selector="controls|SCStatusDot Grid#DotGrid.compacting > Ellipse.status-dot-core">
    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
  </Style>
  <Style Selector="controls|SCStatusDot Grid#DotGrid.compacting">
    <Style.Animations>
      <Animation Duration="0:0:1.6" IterationCount="INFINITE">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.72"/><Setter Property="ScaleTransform.ScaleX" Value="0.9"/><Setter Property="ScaleTransform.ScaleY" Value="0.9"/></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1"/><Setter Property="ScaleTransform.ScaleX" Value="1.15"/><Setter Property="ScaleTransform.ScaleY" Value="1.15"/></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.72"/><Setter Property="ScaleTransform.ScaleX" Value="0.9"/><Setter Property="ScaleTransform.ScaleY" Value="0.9"/></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <!-- approval -->
  <Style Selector="controls|SCStatusDot Grid#DotGrid.approval > Ellipse.status-dot-ring">
    <Setter Property="Fill" Value="{DynamicResource WarningAuraBrush}" />
  </Style>
  <Style Selector="controls|SCStatusDot Grid#DotGrid.approval > Ellipse.status-dot-core">
    <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
  </Style>
  <Style Selector="controls|SCStatusDot Grid#DotGrid.approval">
    <Style.Animations>
      <Animation Duration="0:0:1.6" IterationCount="INFINITE">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.72"/><Setter Property="ScaleTransform.ScaleX" Value="0.9"/><Setter Property="ScaleTransform.ScaleY" Value="0.9"/></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1"/><Setter Property="ScaleTransform.ScaleX" Value="1.15"/><Setter Property="ScaleTransform.ScaleY" Value="1.15"/></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.72"/><Setter Property="ScaleTransform.ScaleX" Value="0.9"/><Setter Property="ScaleTransform.ScaleY" Value="0.9"/></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <!-- question -->
  <Style Selector="controls|SCStatusDot Grid#DotGrid.question > Ellipse.status-dot-ring">
    <Setter Property="Fill" Value="{DynamicResource SuccessAuraBrush}" />
  </Style>
  <Style Selector="controls|SCStatusDot Grid#DotGrid.question > Ellipse.status-dot-core">
    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
  </Style>
  <Style Selector="controls|SCStatusDot Grid#DotGrid.question">
    <Style.Animations>
      <Animation Duration="0:0:1.8" IterationCount="INFINITE">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.72"/><Setter Property="ScaleTransform.ScaleX" Value="0.9"/><Setter Property="ScaleTransform.ScaleY" Value="0.9"/></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1"/><Setter Property="ScaleTransform.ScaleX" Value="1.15"/><Setter Property="ScaleTransform.ScaleY" Value="1.15"/></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.72"/><Setter Property="ScaleTransform.ScaleX" Value="0.9"/><Setter Property="ScaleTransform.ScaleY" Value="0.9"/></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <!-- failed -->
  <Style Selector="controls|SCStatusDot Grid#DotGrid.failed > Ellipse.status-dot-ring">
    <Setter Property="Fill" Value="{DynamicResource DangerAuraBrush}" />
  </Style>
  <Style Selector="controls|SCStatusDot Grid#DotGrid.failed > Ellipse.status-dot-core">
    <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
  </Style>
</Styles>
