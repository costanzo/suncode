<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
        xmlns:controls="using:SunCode.Desktop.Controls">
  <Style Selector="controls|SCModal">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="ZIndex" Value="1000" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid IsVisible="{TemplateBinding IsOpen}"
              Focusable="True"
              ZIndex="200">
          <Border x:Name="PART_Backdrop" Background="#99000000" />
          <Border x:Name="PART_Dialog"
                  Width="{TemplateBinding DialogWidth}"
                  Margin="24"
                  Padding="20,16,20,18"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Background="{DynamicResource SurfaceRaisedBrush}"
                  BorderBrush="{DynamicResource BorderStrongBrush}"
                  BorderThickness="1"
                  CornerRadius="10"
                  ClipToBounds="True">
            <Grid x:Name="PART_DialogLayout" RowDefinitions="Auto,*,Auto" RowSpacing="16">
              <Grid x:Name="PART_Header" Grid.Row="0" ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                  <TextBlock Text="{TemplateBinding Title}"
                             FontSize="17"
                             FontWeight="SemiBold" />
                  <TextBlock x:Name="PART_DescriptionText"
                             Text="{TemplateBinding Description}"
                             Classes="sc-text-hint" />
                </StackPanel>
                <Button x:Name="PART_CloseButton"
                        Grid.Column="1"
                        Classes="quiet sc-button icon-only"
                        Width="24"
                        Height="24"
                        MinHeight="24"
                        Padding="5">
                  <svg:Svg Path="/Assets/icons/close.svg"
                           Css="{DynamicResource IconSvgCss}" />
                </Button>
              </Grid>
              <ScrollViewer Grid.Row="1"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalContentAlignment="Stretch">
                <ContentPresenter Content="{TemplateBinding Content}"
                                  HorizontalContentAlignment="Stretch"
                                  VerticalContentAlignment="Stretch" />
              </ScrollViewer>
              <StackPanel Grid.Row="2"
                          Orientation="Horizontal"
                          HorizontalAlignment="Right"
                          Spacing="8">
                <Button x:Name="PART_SecondaryButton"
                        Classes="compact sc-button"
                        Content="{TemplateBinding SecondaryButtonText}" />
                <Button x:Name="PART_PrimaryButton"
                        Classes="compact sc-button primary"
                        Content="{TemplateBinding PrimaryButtonText}"
                        IsEnabled="{TemplateBinding PrimaryEnabled}" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
</Styles>
