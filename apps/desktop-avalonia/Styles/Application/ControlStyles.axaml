<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
        xmlns:controls="using:SunCode.Desktop.Controls">
  <Style Selector="Button.sc-button">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="14,6" />
  </Style>
  <Style Selector="Button.sc-button.compact">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="10,4" />
  </Style>
  <Style Selector="Button.sc-button.icon-only">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="6" />
  </Style>
  <Style Selector="Button.sc-combo-trigger">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.sc-combo-menu-item">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Regular" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="Button.sc-combo-menu-item /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.sc-combo-menu-item:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Button.sc-combo-menu-item.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="FlyoutPresenter.sc-combo-flyout">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="TextBlock.sc-text-title">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.sc-text-body">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.sc-text-hint">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.sc-text-status">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="StackPanel.settings-panel-content">
    <Setter Property="Margin" Value="32,28,32,34" />
    <Setter Property="MaxWidth" Value="720" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="StackPanel.settings-panel-heading">
    <Setter Property="Spacing" Value="4" />
    <Setter Property="Margin" Value="0,0,0,26" />
  </Style>
  <Style Selector="StackPanel.settings-panel-section">
    <Setter Property="Spacing" Value="16" />
  </Style>
  <Style Selector="Grid.settings-row">
    <Setter Property="ColumnSpacing" Value="24" />
  </Style>
  <Style Selector="StackPanel.settings-row-copy">
    <Setter Property="Spacing" Value="4" />
  </Style>
  <Style Selector="TextBlock.settings-row-title">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.settings-row-hint">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="16" />
  </Style>
  <Style Selector="StackPanel.settings-actions">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="10" />
    <Setter Property="Margin" Value="0,22,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.settings-divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="0,28" />
    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
  </Style>
  <Style Selector="Border.settings-subsection">
    <Setter Property="Margin" Value="0,-2,0,0" />
    <Setter Property="Padding" Value="18,14,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
  </Style>
  <Style Selector="Border.settings-warning">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="11,10" />
  </Style>
  <Style Selector="Border.settings-provider-status">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <Style Selector="TextBlock.settings-hint">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBox.sc-secret-input">
    <Setter Property="PasswordChar" Value="●" />
  </Style>
  <Style Selector="TextBox.sc-secret-input, TextBox.sc-secret-input:focus">
    <Setter Property="FontFamily" Value="JetBrains Mono, SF Mono, Menlo, Monaco, Consolas, monospace" />
  </Style>
  <Style Selector="NumericUpDown.sc-numeric-input">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="NumericUpDown.sc-numeric-input:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="NumericUpDown.sc-numeric-input Button">
    <Setter Property="MinHeight" Value="16" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ToggleSwitch.sc-toggle-switch">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="OnContent" Value="On" />
    <Setter Property="OffContent" Value="Off" />
  </Style>
  <Style Selector="ToggleSwitch.sc-toggle-switch:disabled">
    <Setter Property="Opacity" Value="0.72" />
  </Style>
  <Style Selector="controls|SCModal">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="ZIndex" Value="1000" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid IsVisible="{TemplateBinding IsOpen}"
              Focusable="True"
              ZIndex="200">
          <Border x:Name="PART_Backdrop"
                  Background="#99000000" />
          <Border x:Name="PART_Dialog"
                  Width="{TemplateBinding DialogWidth}"
                  Margin="24"
                  Padding="20,16,20,18"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Background="{DynamicResource SurfaceRaisedBrush}"
                  BorderBrush="{DynamicResource BorderStrongBrush}"
                  BorderThickness="1"
                  CornerRadius="10"
                  ClipToBounds="True">
            <Grid x:Name="PART_DialogLayout" RowDefinitions="Auto,*,Auto" RowSpacing="16">
              <Grid x:Name="PART_Header" Grid.Row="0" ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                  <TextBlock Text="{TemplateBinding Title}"
                             FontSize="17"
                             FontWeight="SemiBold" />
                  <TextBlock x:Name="PART_DescriptionText"
                             Text="{TemplateBinding Description}"
                             Classes="sc-text-hint" />
                </StackPanel>
                <Button x:Name="PART_CloseButton"
                        Grid.Column="1"
                        Classes="quiet sc-button icon-only"
                        Width="24"
                        Height="24"
                        MinHeight="24"
                        Padding="5">
                  <svg:Svg Path="/Assets/icons/close.svg"
                           Css="{DynamicResource IconSvgCss}" />
                </Button>
              </Grid>
              <ScrollViewer Grid.Row="1"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalContentAlignment="Stretch">
                <ContentPresenter Content="{TemplateBinding Content}"
                                  HorizontalContentAlignment="Stretch"
                                  VerticalContentAlignment="Stretch" />
              </ScrollViewer>
              <StackPanel Grid.Row="2"
                          Orientation="Horizontal"
                          HorizontalAlignment="Right"
                          Spacing="8">
                <Button x:Name="PART_SecondaryButton"
                        Classes="compact sc-button"
                        Content="{TemplateBinding SecondaryButtonText}" />
                <Button x:Name="PART_PrimaryButton"
                        Classes="compact sc-button primary"
                        Content="{TemplateBinding PrimaryButtonText}"
                        IsEnabled="{TemplateBinding PrimaryEnabled}" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
</Styles>
