<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>SunCode</AssemblyTitle>
    <AssemblyName>SunCode</AssemblyName>
    <Product>SunCode</Product>
    <Version>0.0.1</Version>
    <AssemblyVersion>0.0.1.0</AssemblyVersion>
    <FileVersion>0.0.1.0</FileVersion>
    <InformationalVersion>0.0.1</InformationalVersion>
    <AvaloniaVersion>12.1.1</AvaloniaVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest Condition="$([MSBuild]::IsOSPlatform('Windows'))">app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.15" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="LiveMarkdown.Avalonia" Version="2.3.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <AvaloniaResource Include="Assets/**" />
    <Content Include="Assets/logo/suncode-logo-1024.png" CopyToOutputDirectory="PreserveNewest" Link="suncode-logo-1024.png" />
  </ItemGroup>


  <PropertyGroup>
    <SunCodeRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../..'))</SunCodeRepositoryRoot>
    <SunCodeAgentDirectory>$(SunCodeRepositoryRoot)/agent</SunCodeAgentDirectory>
    <SunCodeAgentProfile Condition="'$(Configuration)' == 'Release'">release</SunCodeAgentProfile>
    <SunCodeAgentProfile Condition="'$(SunCodeAgentProfile)' == ''">debug</SunCodeAgentProfile>
    <SunCodeCargoProfileArgument Condition="'$(Configuration)' == 'Release'">--release</SunCodeCargoProfileArgument>
    <SunCodeAgentOutput>$(SunCodeAgentDirectory)/target/$(SunCodeAgentProfile)</SunCodeAgentOutput>
  </PropertyGroup>

  <Target Name="BuildSunCodeAgent" BeforeTargets="BeforeBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="cargo build --manifest-path &quot;$(SunCodeAgentDirectory)/Cargo.toml&quot; -p suncode-agent --lib $(SunCodeCargoProfileArgument)" />
    <ItemGroup>
      <SunCodeNativeLibrary Include="$(SunCodeAgentOutput)/libsuncode_agent.dylib" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
      <SunCodeNativeLibrary Include="$(SunCodeAgentOutput)/libsuncode_agent.so" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
      <SunCodeNativeLibrary Include="$(SunCodeAgentOutput)/suncode_agent.dll" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    </ItemGroup>
    <Copy SourceFiles="@(SunCodeNativeLibrary)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CreateMacOSAppBundle" AfterTargets="Publish" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <PropertyGroup>
      <SunCodeAppBundle>$(PublishDir)SunCode.app</SunCodeAppBundle>
    </PropertyGroup>
    <MakeDir Directories="$(SunCodeAppBundle)/Contents/MacOS;$(SunCodeAppBundle)/Contents/Resources" />
    <ItemGroup>
      <SunCodePublishedFiles Include="$(PublishDir)*" Exclude="$(SunCodeAppBundle)/**" />
      <SunCodeMacOSNativeLibrary Include="$(SunCodeAgentOutput)/libsuncode_agent.dylib" />
    </ItemGroup>
    <Copy SourceFiles="@(SunCodePublishedFiles)" DestinationFolder="$(SunCodeAppBundle)/Contents/MacOS/%(RecursiveDir)" />
    <Copy SourceFiles="@(SunCodeMacOSNativeLibrary)" DestinationFolder="$(SunCodeAppBundle)/Contents/MacOS" SkipUnchangedFiles="true" />
    <Copy SourceFiles="Info.plist" DestinationFolder="$(SunCodeAppBundle)/Contents" />
    <Copy SourceFiles="Assets/suncode-desktop.icns" DestinationFolder="$(SunCodeAppBundle)/Contents/Resources" />
  </Target>
</Project>
