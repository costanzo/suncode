<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows')) And '$(SunCodeForceWindowsTarget)' != 'true'">net10.0</TargetFramework>
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows')) Or '$(SunCodeForceWindowsTarget)' == 'true'">net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>SunCode</AssemblyTitle>
    <AssemblyName>SunCode</AssemblyName>
    <Product>SunCode</Product>
    <ApplicationIcon>Assets/suncode.ico</ApplicationIcon>
    <!-- One Desktop version for assembly metadata, native bundles and installers. -->
    <Version>0.1.0</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <AvaloniaVersion>12.1.5</AvaloniaVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest Condition="$([MSBuild]::IsOSPlatform('Windows'))">app.manifest</ApplicationManifest>
    <PowerShellRuntimeSource Condition="'$(RuntimeIdentifier)' == 'win-x64'">$(MSBuildProjectDirectory)/../../artifacts/runtimes/powershell/win-x64</PowerShellRuntimeSource>
    <PowerShellRuntimeDevelopmentSource Condition="$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))">$(MSBuildProjectDirectory)/../../artifacts/runtimes/powershell/win-x64</PowerShellRuntimeDevelopmentSource>
    <SunCodeUpdateDistributionFile Condition="'$(SunCodeUpdateDistributionFile)' == ''">$(MSBuildProjectDirectory)/Updates/update-distribution.json</SunCodeUpdateDistributionFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>None</DebugType>
  </PropertyGroup>

  <!-- Release publishes that specify a RID include the matching .NET runtime.
       Target machines usually do not have dotnet installed. Single-file and trimming stay off so the Rust SDK and managed dependencies remain separate files. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <!-- NuGet package timestamps can be older than files left by a previous publish.
       PreserveNewest then keeps those stale assemblies, and the app aborts while
       loading the version named in the new deps file. Clear the publish directory first. -->
  <Target Name="CleanReleasePublishDirectory" BeforeTargets="PrepareForPublish"
          Condition="'$(Configuration)' == 'Release' And '$(RuntimeIdentifier)' != '' And '$(PublishDir)' != ''">
    <RemoveDir Directories="$(PublishDir)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3"
                      Condition="'$(Configuration)' != 'Release'" />
    <ProjectReference Include="../../sdks/csharp/SunCode.Sdk.csproj" />
    <ProjectReference Include="ThirdParty/RoyalTerminal.Pty.Windows/RoyalTerminal.Pty.Windows.csproj" />
    <PackageReference Include="Costanzo.CefGlue.Avalonia" Version="1.0.0-preview.1" PrivateAssets="build;buildTransitive" />
    <!-- Exclude transitive Chromium assets. Desktop installs the runtime on demand. -->
    <PackageReference Include="chromiumembeddedframework.runtime" Version="152.0.6" IncludeAssets="none" PrivateAssets="all" />
    <PackageReference Include="chromiumembeddedframework.runtime.win-x64" Version="152.0.6" IncludeAssets="none" PrivateAssets="all" />
    <PackageReference Include="chromiumembeddedframework.runtime.win-arm64" Version="152.0.6" IncludeAssets="none" PrivateAssets="all" />
    <PackageReference Include="cef.runtime.linux-x64" Version="152.0.6" IncludeAssets="none" PrivateAssets="all" />
    <PackageReference Include="cef.runtime.linux-arm64" Version="152.0.6" IncludeAssets="none" PrivateAssets="all" />
    <PackageReference Include="cef.runtime.osx-x64" Version="152.0.6" IncludeAssets="none" PrivateAssets="all" />
    <PackageReference Include="cef.runtime.osx-arm64" Version="152.0.6" IncludeAssets="none" PrivateAssets="all" />
    <PackageReference Include="CefGlue.Next.Common" Version="152.7977.831" ExcludeAssets="build;buildTransitive" PrivateAssets="build;buildTransitive" />
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageReference Include="DiffPlex" Version="1.9.0" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="AvaloniaEdit.TextMate" Version="12.0.0" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.17" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="RoyalApps.RoyalTerminal.Avalonia" Version="0.7.2" />
    <PackageReference Include="LiveMarkdown.Avalonia" Version="2.5.1" />
    <PackageReference Include="LiveMarkdown.Avalonia.Math" Version="2.5.1" />
    <PackageReference Include="LiveMarkdown.Avalonia.Mermaid" Version="2.5.1" />
    <PackageReference Include="LiveMarkdown.Avalonia.Svg.Skia" Version="2.5.1" />
    <PackageReference Include="Mermaider" Version="0.15.1" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.14"
                      Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.2" />
  </ItemGroup>
  <Target Name="BuildMacOSNotificationBridge"
          BeforeTargets="Build"
          Condition="$([MSBuild]::IsOSPlatform('OSX')) And '$(DesignTimeBuild)' != 'true'"
          Inputs="$(MSBuildProjectDirectory)/Native/macOS/SunCodeNotifications.swift"
          Outputs="$(TargetDir)libsuncode_notifications.dylib">
    <Exec Command="/usr/bin/xcrun swiftc -parse-as-library -emit-library -o &quot;$(TargetDir)libsuncode_notifications.dylib&quot; &quot;$(MSBuildProjectDirectory)/Native/macOS/SunCodeNotifications.swift&quot;" />
  </Target>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Content Include="$(SunCodeUpdateDistributionFile)" Link="update-distribution.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Infrastructure/Browser/THIRD-PARTY-NOTICES.txt" Link="browser-third-party-notices.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Compile Remove="ThirdParty/**/*.cs" />
    <Compile Remove="Compatibility/**/*.cs" />
    <Compile Remove="artifacts/**/*.cs" />
    <AvaloniaResource Include="Assets/**" />
    <!-- The old variable Noto Sans SC face is intentionally removed by the
         font preparation script; keep stale incremental item caches from
         reintroducing it into Avalonia resource generation. -->
    <AvaloniaResource Remove="Assets/fonts/NotoSansSC-wght.ttf" />
    <AvaloniaResource Include="Resources/**" />
    <Content Include="Assets/suncode-macos-1024.png" CopyToOutputDirectory="PreserveNewest" Link="suncode-macos-1024.png" />
    <Content Include="packaging/linux/dev.suncode.desktop.desktop" CopyToOutputDirectory="PreserveNewest" Link="share/applications/dev.suncode.desktop.desktop" />
    <Content Include="packaging/linux/icons/hicolor/**/*" CopyToOutputDirectory="PreserveNewest" Link="share/icons/hicolor/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="PrepareBundledFonts" BeforeTargets="_GenerateAvaloniaResourcesDependencyCache;GenerateAvaloniaResources"
          Condition="'$(DesignTimeBuild)' != 'true' And '$(SkipFontPreparation)' != 'true'">
    <Exec Condition="$([MSBuild]::IsOSPlatform('Windows'))"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/../../scripts/prepare-fonts.ps1&quot;" />
    <Exec Condition="!$([MSBuild]::IsOSPlatform('Windows'))"
          Command="/bin/bash &quot;$(MSBuildProjectDirectory)/../../scripts/prepare-fonts.sh&quot;" />
    <!-- The initial Assets/** glob runs before downloads. Refresh font items
         before Avalonia hashes its inputs so a first build embeds new faces. -->
    <ItemGroup>
      <AvaloniaResource Remove="Assets/fonts/*.ttf" />
      <AvaloniaResource Include="Assets/fonts/*.ttf" Exclude="Assets/fonts/NotoSansSC-wght.ttf" />
    </ItemGroup>
  </Target>


  <Target Name="CreateMacOSAppBundle" AfterTargets="Publish" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <PropertyGroup>
      <SunCodeAppBundle>$(PublishDir)SunCode.app</SunCodeAppBundle>
    </PropertyGroup>
    <MakeDir Directories="$(SunCodeAppBundle)/Contents/MacOS;$(SunCodeAppBundle)/Contents/Resources" />
    <ItemGroup>
      <SunCodePublishedFiles Include="$(PublishDir)**/*" Exclude="$(SunCodeAppBundle)/**" />
    </ItemGroup>
    <Copy SourceFiles="@(SunCodePublishedFiles)" DestinationFolder="$(SunCodeAppBundle)/Contents/MacOS/%(RecursiveDir)" />
    <Copy SourceFiles="Info.plist" DestinationFolder="$(SunCodeAppBundle)/Contents" />
    <!-- Modify only the copied template, never the source plist. -->
    <Exec Command="/usr/libexec/PlistBuddy -c &quot;Set :CFBundleShortVersionString $(Version)&quot; &quot;$(SunCodeAppBundle)/Contents/Info.plist&quot;" />
    <Exec Command="/usr/libexec/PlistBuddy -c &quot;Set :CFBundleVersion $(Version)&quot; &quot;$(SunCodeAppBundle)/Contents/Info.plist&quot;" />
    <Copy SourceFiles="Assets/suncode-desktop.icns" DestinationFolder="$(SunCodeAppBundle)/Contents/Resources" />
    <Exec Command="/usr/bin/xcrun swiftc -parse-as-library -emit-library -o &quot;$(SunCodeAppBundle)/Contents/MacOS/libsuncode_notifications.dylib&quot; &quot;Native/macOS/SunCodeNotifications.swift&quot;" />
  </Target>

  <Target Name="RemoveReleasePublishSymbols" BeforeTargets="CreateMacOSAppBundle" AfterTargets="Publish"
          Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <ReleasePublishSymbols Include="$(PublishDir)**/*.pdb" />
    </ItemGroup>
    <Delete Files="@(ReleasePublishSymbols)" />
  </Target>

  <Target Name="FinalizeMacOSAppBundleSignature"
          AfterTargets="Publish"
          DependsOnTargets="CreateMacOSAppBundle;RemoveReleasePublishSymbols"
          Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Exec Command="/usr/bin/codesign --force --deep --sign - --identifier dev.suncode.desktop &quot;$(SunCodeAppBundle)&quot;" />
  </Target>
</Project>
