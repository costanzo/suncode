<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows')) And '$(SunCodeForceWindowsTarget)' != 'true'">net10.0</TargetFramework>
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows')) Or '$(SunCodeForceWindowsTarget)' == 'true'">net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>SunCode</AssemblyTitle>
    <AssemblyName>SunCode</AssemblyName>
    <Product>SunCode</Product>
    <Version>0.0.1</Version>
    <AssemblyVersion>0.0.1.0</AssemblyVersion>
    <FileVersion>0.0.1.0</FileVersion>
    <InformationalVersion>0.0.1</InformationalVersion>
    <AvaloniaVersion>12.1.1</AvaloniaVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest Condition="$([MSBuild]::IsOSPlatform('Windows'))">app.manifest</ApplicationManifest>
    <PowerShellRuntimeSource Condition="'$(RuntimeIdentifier)' == 'win-x64'">$(MSBuildProjectDirectory)/../../artifacts/runtimes/powershell/win-x64</PowerShellRuntimeSource>
    <PowerShellRuntimeDevelopmentSource Condition="$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))">$(MSBuildProjectDirectory)/../../artifacts/runtimes/powershell/win-x64</PowerShellRuntimeDevelopmentSource>
    <CefGlueForkRoot Condition="'$(CefGlueForkRoot)' == ''">$(MSBuildProjectDirectory)/../../../../github/costanzo/CefGlue</CefGlueForkRoot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>None</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3"
                      Condition="'$(Configuration)' != 'Release'" />
    <ProjectReference Include="../../sdks/csharp/SunCode.Sdk.csproj" />
    <ProjectReference Include="$(CefGlueForkRoot)/CefGlue.Avalonia/CefGlue.Avalonia.csproj" />
    <PackageReference Include="cef.runtime.osx-arm64" Version="152.0.6" Condition="'$(RuntimeIdentifier)' == 'osx-arm64'" PrivateAssets="all" />
    <PackageReference Include="cef.runtime.osx-x64" Version="152.0.6" Condition="'$(RuntimeIdentifier)' == 'osx-x64'" PrivateAssets="all" />
    <PackageReference Include="cef.runtime.linux-x64" Version="152.0.6" Condition="'$(RuntimeIdentifier)' == 'linux-x64'" PrivateAssets="all" />
    <PackageReference Include="chromiumembeddedframework.runtime.win-x64" Version="152.0.6" Condition="'$(RuntimeIdentifier)' == 'win-x64'" PrivateAssets="all" />
    <PackageReference Include="chromiumembeddedframework.runtime.win-arm64" Version="152.0.6" Condition="'$(RuntimeIdentifier)' == 'win-arm64'" PrivateAssets="all" />
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="AvaloniaEdit.TextMate" Version="12.0.0" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.15" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="LiveMarkdown.Avalonia" Version="2.4.3" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0"
                      Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.1" />
  </ItemGroup>
  <Target Name="EnsurePowerShellRuntimePresent" BeforeTargets="Publish"
          Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$(RuntimeIdentifier)' == 'win-x64'">
    <Error Condition="!Exists('$(PowerShellRuntimeSource)/pwsh.exe')"
           Text="The packaged PowerShell 7 runtime is missing. Run: dotnet build apps/desktop-avalonia/SunCode.Desktop.csproj -t:PreparePowerShellRuntime before publishing." />
  </Target>

  <Target Name="PreparePowerShellRuntime"
          Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Exec Command="npm --prefix &quot;$(MSBuildProjectDirectory)/../../runtimes/shell-runtime&quot; run package -- &quot;$(MSBuildProjectDirectory)/../../artifacts/runtimes/powershell/win-x64&quot;" />
  </Target>
  <Target Name="CopyWindowsPowerShellRuntime" AfterTargets="Publish"
          Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$(RuntimeIdentifier)' == 'win-x64' And Exists('$(PowerShellRuntimeSource)')">
    <RemoveDir Directories="$(PublishDir)runtimes/powershell" />
    <Exec Command="cmd /c &quot;robocopy &quot;&quot;$(PowerShellRuntimeSource)&quot;&quot; &quot;&quot;$(PublishDir)runtimes/powershell&quot;&quot; /E /NFL /NDL /NJH /NJS /NP &amp; IF ERRORLEVEL 8 exit /B 8 &amp; exit /B 0&quot;" />
  </Target>

  <Target Name="CopyWindowsCefRuntime" AfterTargets="Publish"
          Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$(RuntimeIdentifier)' == 'win-x64'">
    <PropertyGroup>
      <CefWindowsPackageRoot>$(NuGetPackageRoot)/chromiumembeddedframework.runtime.win-x64/152.0.6</CefWindowsPackageRoot>
    </PropertyGroup>
    <ItemGroup>
      <CefWindowsNativeFiles Include="$(CefWindowsPackageRoot)/runtimes/win-x64/native/*.*" />
      <CefWindowsAdditionalFiles Include="$(CefWindowsPackageRoot)/CEF/win-x64/**/*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(CefWindowsNativeFiles)"
          DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(CefWindowsAdditionalFiles)"
          DestinationFolder="$(PublishDir)%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="BuildMacOSNotificationBridge"
          BeforeTargets="Build"
          Condition="$([MSBuild]::IsOSPlatform('OSX')) And '$(DesignTimeBuild)' != 'true'"
          Inputs="$(MSBuildProjectDirectory)/Native/macOS/SunCodeNotifications.swift"
          Outputs="$(TargetDir)libsuncode_notifications.dylib">
    <Exec Command="/usr/bin/xcrun swiftc -parse-as-library -emit-library -o &quot;$(TargetDir)libsuncode_notifications.dylib&quot; &quot;$(MSBuildProjectDirectory)/Native/macOS/SunCodeNotifications.swift&quot;" />
  </Target>

  <!-- NativeLibrary probing finds CEF under runtimes/osx/native. Keep the
       development output there and remove the legacy root copy; loading both
       paths makes macOS register every CEF Objective-C class twice. -->
  <Target Name="CopyCefPreviewMacOSDevelopment"
          AfterTargets="Build"
          Condition="$([MSBuild]::IsOSPlatform('OSX')) And '$(RuntimeIdentifier)' == ''">
    <PropertyGroup>
      <CefPreviewMacArchitecture Condition="$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture) == 'Arm64'">arm64</CefPreviewMacArchitecture>
      <CefPreviewMacArchitecture Condition="$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture) == 'X64'">x64</CefPreviewMacArchitecture>
      <CefPreviewPackageRoot>$(NuGetPackageRoot)/cef.runtime.osx-$(CefPreviewMacArchitecture)/152.0.6/CEF</CefPreviewPackageRoot>
      <CefPreviewFrameworkSource>$(CefPreviewPackageRoot)/osx-$(CefPreviewMacArchitecture)/Chromium Embedded Framework.framework</CefPreviewFrameworkSource>
    </PropertyGroup>
    <Error Condition="'$(CefPreviewMacArchitecture)' == '' Or !Exists('$(CefPreviewFrameworkSource)')"
           Text="The CEF preview runtime for the current macOS architecture is unavailable. Restore cef.runtime.osx-arm64 or cef.runtime.osx-x64 before running the desktop app." />
    <ItemGroup>
      <CefPreviewMain Include="$(CefPreviewFrameworkSource)/Chromium Embedded Framework" />
      <CefPreviewLibraries Include="$(CefPreviewFrameworkSource)/Libraries/**/*.*" />
      <CefPreviewResources Include="$(CefPreviewFrameworkSource)/Resources/**/*.*" />
    </ItemGroup>
    <!-- CefGlue sets FrameworkDirPath to the directory holding libcef.dylib, and
         Chromium loads icudtl.dat, paks, and Libraries relative to it. They must
         sit beside libcef.dylib, not in the output root. -->
    <MakeDir Directories="$(TargetDir)runtimes/osx/native/Libraries;$(TargetDir)runtimes/osx/native/Resources" />
    <Delete Files="$(TargetDir)libcef.dylib" />
    <RemoveDir Directories="$(TargetDir)Libraries;$(TargetDir)Resources" />
    <Copy SourceFiles="@(CefPreviewMain)" DestinationFiles="$(TargetDir)runtimes/osx/native/libcef.dylib" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(CefPreviewLibraries)" DestinationFolder="$(TargetDir)runtimes/osx/native/Libraries/%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(CefPreviewResources)" DestinationFolder="$(TargetDir)runtimes/osx/native/Resources/%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="Compatibility/**/*.cs" />
    <AvaloniaResource Include="Assets/**" />
    <!-- The old variable Noto Sans SC face is intentionally removed by the
         font preparation script; keep stale incremental item caches from
         reintroducing it into Avalonia resource generation. -->
    <AvaloniaResource Remove="Assets/fonts/NotoSansSC-wght.ttf" />
    <AvaloniaResource Include="Resources/**" />
    <Content Include="Assets/logo/suncode-logo-1024.png" CopyToOutputDirectory="PreserveNewest" Link="suncode-logo-1024.png" />
    <Content Include="packaging/linux/dev.suncode.desktop.desktop" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="PrepareBundledFonts" BeforeTargets="GenerateAvaloniaResources"
          Condition="'$(DesignTimeBuild)' != 'true' And '$(SkipFontPreparation)' != 'true'">
    <Exec Condition="$([MSBuild]::IsOSPlatform('Windows'))"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/../../scripts/prepare-fonts.ps1&quot;" />
    <Exec Condition="!$([MSBuild]::IsOSPlatform('Windows'))"
          Command="/bin/bash &quot;$(MSBuildProjectDirectory)/../../scripts/prepare-fonts.sh&quot;" />
  </Target>


  <Target Name="CreateMacOSAppBundle" AfterTargets="Publish" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <PropertyGroup>
      <SunCodeAppBundle>$(PublishDir)SunCode.app</SunCodeAppBundle>
    </PropertyGroup>
    <MakeDir Directories="$(SunCodeAppBundle)/Contents/MacOS;$(SunCodeAppBundle)/Contents/Resources" />
    <ItemGroup>
      <SunCodePublishedFiles Include="$(PublishDir)**/*" Exclude="$(SunCodeAppBundle)/**" />
    </ItemGroup>
    <Copy SourceFiles="@(SunCodePublishedFiles)" DestinationFolder="$(SunCodeAppBundle)/Contents/MacOS/%(RecursiveDir)" />
    <Copy SourceFiles="Info.plist" DestinationFolder="$(SunCodeAppBundle)/Contents" />
    <Copy SourceFiles="Assets/suncode-desktop.icns" DestinationFolder="$(SunCodeAppBundle)/Contents/Resources" />
    <Exec Command="/usr/bin/xcrun swiftc -parse-as-library -emit-library -o &quot;$(SunCodeAppBundle)/Contents/MacOS/libsuncode_notifications.dylib&quot; &quot;Native/macOS/SunCodeNotifications.swift&quot;" />
    <Exec Command="/usr/bin/codesign --force --deep --sign - --identifier dev.suncode.desktop &quot;$(SunCodeAppBundle)&quot;" />
  </Target>

  <Target Name="DeployCefPreviewMacOS" AfterTargets="CreateMacOSAppBundle"
          Condition="$([MSBuild]::IsOSPlatform('OSX')) And '$(RuntimeIdentifier)' == 'osx-arm64'">
    <PropertyGroup>
      <CefPreviewPackageRoot>$(NuGetPackageRoot)/cef.runtime.osx-arm64/152.0.6/CEF</CefPreviewPackageRoot>
      <CefPreviewFrameworkSource>$(CefPreviewPackageRoot)/osx-arm64</CefPreviewFrameworkSource>
      <CefPreviewFrameworkDestination>$(SunCodeAppBundle)/Contents/Frameworks</CefPreviewFrameworkDestination>
    </PropertyGroup>
    <MakeDir Directories="$(CefPreviewFrameworkDestination)" />
    <Exec Command="chmod 755 &quot;$(CefPreviewPackageRoot)/deploy-cef-framework.sh&quot;" />
    <Exec Command="bash &quot;$(CefPreviewPackageRoot)/deploy-cef-framework.sh&quot; &quot;$(CefPreviewFrameworkSource)&quot; &quot;$(CefPreviewFrameworkDestination)&quot; &quot;SunCode&quot; &quot;dev.suncode.desktop&quot; &quot;-&quot; &quot;$(CefPreviewPackageRoot)/cef.entitlements&quot; &quot;$(MSBuildProjectDirectory)/Assets/suncode-desktop.icns&quot;" />
  </Target>

  <Target Name="RemoveReleasePublishSymbols" BeforeTargets="CreateMacOSAppBundle" AfterTargets="Publish"
          Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <ReleasePublishSymbols Include="$(PublishDir)**/*.pdb" />
    </ItemGroup>
    <Delete Files="@(ReleasePublishSymbols)" />
  </Target>

  <Target Name="FinalizeMacOSAppBundleSignature"
          AfterTargets="CreateMacOSAppBundle;DeployCefPreviewMacOS;RemoveReleasePublishSymbols"
          Condition="$([MSBuild]::IsOSPlatform('OSX')) And '$(RuntimeIdentifier)' == 'osx-arm64'">
    <Exec Command="/usr/bin/codesign --force --deep --sign - --identifier dev.suncode.desktop &quot;$(SunCodeAppBundle)&quot;" />
  </Target>
</Project>
